// The prelude: traits every program can rely on, loaded before its own code.
//
// These are ordinary Keal traits — there is nothing the compiler knows about
// them that you could not write yourself. What makes them special is only
// that the operators are wired to their methods:
//
//     a + b   is  a.plus(b)          -a  is  a.negate()
//     a - b   is  a.minus(b)         a == b  is  a.equals(b)
//     a * b   is  a.times(b)         a < b   is  a.compareTo(b) < 0
//     a / b   is  a.div(b)
//     a % b   is  a.rem(b)
//
// The built-in types already implement the ones that make sense for them, so
// `func total<T: Add>(xs: List<T>, zero: T): T` works at `Int` and at your own
// types alike. Operators on built-in types are evaluated directly; the
// rewrite only happens for a class or a bounded type parameter.

public trait Add {
    func plus(other: Self): Self
}

public trait Sub {
    func minus(other: Self): Self
}

public trait Mul {
    func times(other: Self): Self
}

public trait Div {
    func div(other: Self): Self
}

public trait Rem {
    func rem(other: Self): Self
}

public trait Neg {
    func negate(): Self
}

/// `a ** b` is `a.pow(b)` — power, right-associative, tighter than `*`.
public trait Pow {
    func pow(other: Self): Self
}

/// `a ^/ b` is `a.root(b)` — the b-th root, the inverse of `**`. (`//`
/// belongs to comments, so the root wears the power's hat.)
public trait Root {
    func root(other: Self): Self
}

/// Structural equality. Without it, `==` on two instances compares identity,
/// so two separately built values are never equal.
public trait Eq {
    func equals(other: Self): Bool
}

/// `a[i]` reads through `get`, and `a[i] = v` writes through `set`.
///
/// The trait carries no signature of its own, and that is deliberate: what
/// a class is indexed *by* and what it gives *back* differ from class to
/// class, and a trait here cannot yet hold those two types. So the trait
/// says a class is indexable and the class's own `get` says with what. The
/// checker holds it to that: a class declaring `Index` must have a `get`
/// taking one argument, and a `set` — which makes `a[i] = v` legal — must
/// take that same key type and the value `get` returns.
public trait Index {}

/// `a(x, y)` calls through `invoke`.
///
/// Same reasoning as `Index`: the parameters and the result are the class's
/// own, and the trait only says that calling one is meaningful.
public trait Invoke {}

// ---- ordering, spoken plainly -------------------------------------------
//
// `Comp` is a primitive, beside `Int`, `Float` and `Bool`. A three-valued
// answer is the same kind of thing as a two-valued one, so it costs the
// same: one word, nothing to retain, nothing to free. Its values are
// `less`, `equal` and `greater`, written the way `true` and `false` are —
// bare words, not members of a type.
//
// It carries no methods, for the reason `Bool` carries none: `b.isTrue()`
// would be a way of saying `b`, and `c.isLess()` is a way of saying
// `c == less`. A `when` over one needs no `else`, because three is all
// there is.

/// A total order. `compareTo` returns a negative number, zero, or a positive
/// number according as the receiver is less than, equal to, or greater than
/// `other` — the same convention as `Int.compareTo`.
public trait Ord {
    func compareTo(other: Self): Int
}

/// Compares two values of any ordered type — `Int`, `Float`, `String`, or
/// your own `: Ord` class — as a `Comp`.
public func compare<T: Ord>(a: T, b: T): Comp {
    val sign = a.compareTo(b)
    if (sign < 0) { return less }
    if (sign > 0) { return greater }
    return equal
}

// ---- tuples ------------------------------------------------------------
//
// `(a, b)` is one of these, and `(Int, String)` is its type. They are
// ordinary records, so they compare by value, render field by field, and
// destructure like anything else — `val (q, r) = divmod(7, 2)`.
//
// Beyond five, declare a record: past that many, positions stop being
// memorable and names start earning their keep.

public record Tuple2<A, B>(val first: A, val second: B)

public record Tuple3<A, B, C>(val first: A, val second: B, val third: C)

public record Tuple4<A, B, C, D>(val first: A, val second: B, val third: C, val fourth: D)

public record Tuple5<A, B, C, D, E>(
    val first: A,
    val second: B,
    val third: C,
    val fourth: D,
    val fifth: E
)

// ---- lazy sequences ------------------------------------------------------
//
// The pull-based, fusing pipeline — Keal's equivalent of Java's Stream and
// Kotlin's Sequence, written here in ordinary Keal: generic records, classes
// and closures are all it needs. Nothing runs until a terminal operation
// pulls, so `seq(xs).map(f).filter(p).take(3).toList()` calls `f` at most as
// many times as it takes to find three keepers, and an infinite source like
// `iterate(1, { it * 2 })` is fine as long as something downstream stops.
//
// Everything here is generic, so a program that never touches sequences
// pays nothing for them — the native backend only compiles what a program
// instantiates.

/// One pass over a sequence: whether an element remains, and the next one.
/// Calling `nextFn` without a true `hasNextFn` first is the caller's bug.
public class SeqIter<T>(val hasNextFn: () -> Bool, val nextFn: () -> T)

/// A recipe for iteration. Each terminal operation asks `iterFn` for a
/// fresh pass, so a sequence built from a stable source can be walked twice.
public class Sequence<T>(val iterFn: () -> SeqIter<T>) {
    public func iterator(): SeqIter<T> {
        val make = this.iterFn
        return make()
    }

    /// Transforms each element as it is pulled.
    public func map<R>(transform: (T) -> R): Sequence<R> {
        val makeIter = this.iterFn
        return Sequence({ ->
            val it = makeIter()
            val next = it.nextFn
            SeqIter(it.hasNextFn, { -> transform(next()) })
        })
    }

    /// Keeps the elements the predicate accepts. One element of lookahead,
    /// held in a one-slot buffer, is what makes `hasNext` honest.
    public func filter(predicate: (T) -> Bool): Sequence<T> {
        val makeIter = this.iterFn
        return Sequence({ ->
            val it = makeIter()
            val has = it.hasNextFn
            val next = it.nextFn
            val buf: List<T> = []
            val advance = { ->
                while (buf.size == 0 and has()) {
                    val v = next()
                    if (predicate(v)) { buf.add(v) }
                }
            }
            SeqIter({ ->
                advance()
                buf.size > 0
            }, { ->
                advance()
                buf.removeAt(0)
            })
        })
    }

    /// At most `n` elements, then stops pulling.
    public func take(n: Int): Sequence<T> {
        val makeIter = this.iterFn
        return Sequence({ ->
            val it = makeIter()
            val has = it.hasNextFn
            val next = it.nextFn
            var left = n
            SeqIter({ -> left > 0 and has() }, { ->
                left -= 1
                next()
            })
        })
    }

    /// Skips the first `n` elements, lazily: nothing is pulled until the
    /// downstream asks.
    public func drop(n: Int): Sequence<T> {
        val makeIter = this.iterFn
        return Sequence({ ->
            val it = makeIter()
            val has = it.hasNextFn
            val next = it.nextFn
            var toSkip = n
            val advance = { ->
                while (toSkip > 0 and has()) {
                    next()
                    toSkip -= 1
                }
            }
            SeqIter({ ->
                advance()
                has()
            }, { ->
                advance()
                next()
            })
        })
    }

    /// Elements while the predicate holds; the first refusal ends the
    /// sequence and nothing after it is pulled.
    public func takeWhile(predicate: (T) -> Bool): Sequence<T> {
        val makeIter = this.iterFn
        return Sequence({ ->
            val it = makeIter()
            val has = it.hasNextFn
            val next = it.nextFn
            val buf: List<T> = []
            var done = false
            val advance = { ->
                if (not done and buf.size == 0 and has()) {
                    val v = next()
                    if (predicate(v)) { buf.add(v) } else { done = true }
                }
            }
            SeqIter({ ->
                advance()
                buf.size > 0
            }, { ->
                advance()
                buf.removeAt(0)
            })
        })
    }

    /// Skips the leading run the predicate accepts, keeps everything after.
    public func dropWhile(predicate: (T) -> Bool): Sequence<T> {
        val makeIter = this.iterFn
        return Sequence({ ->
            val it = makeIter()
            val has = it.hasNextFn
            val next = it.nextFn
            val buf: List<T> = []
            var dropping = true
            val advance = { ->
                if (dropping) {
                    while (has()) {
                        val v = next()
                        unless (predicate(v)) {
                            buf.add(v)
                            break
                        }
                    }
                    dropping = false
                }
            }
            SeqIter({ ->
                advance()
                buf.size > 0 or has()
            }, { ->
                advance()
                if (buf.size > 0) { buf.removeAt(0) } else { next() }
            })
        })
    }

    /// Substitutes a whole sequence for each element and flattens, still
    /// pulling one element at a time.
    public func flatMap<R>(transform: (T) -> Sequence<R>): Sequence<R> {
        val makeIter = this.iterFn
        return Sequence({ ->
            val outer = makeIter()
            val oHas = outer.hasNextFn
            val oNext = outer.nextFn
            val inner: List<SeqIter<R>> = []
            val advance = { ->
                while (true) {
                    if (inner.size > 0) {
                        val cur = inner[0]
                        val curHas = cur.hasNextFn
                        if (curHas()) { break }
                        inner.removeAt(0)
                    } else {
                        unless (oHas()) { break }
                        val sub = transform(oNext())
                        val mk = sub.iterFn
                        inner.add(mk())
                    }
                }
            }
            SeqIter({ ->
                advance()
                inner.size > 0
            }, { ->
                advance()
                val cur = inner[0]
                val curNext = cur.nextFn
                curNext()
            })
        })
    }

    // -- terminal operations: these pull. --

    public func toList(): List<T> {
        val out: List<T> = []
        val it = this.iterator()
        val has = it.hasNextFn
        val next = it.nextFn
        while (has()) {
            out.add(next())
        }
        return out
    }

    public proc forEach(action: (T) -> Unit) {
        val it = this.iterator()
        val has = it.hasNextFn
        val next = it.nextFn
        while (has()) {
            action(next())
        }
    }

    public func fold<R>(initial: R, operation: (R, T) -> R): R {
        val it = this.iterator()
        val has = it.hasNextFn
        val next = it.nextFn
        var acc = initial
        while (has()) {
            acc = operation(acc, next())
        }
        return acc
    }

    public func count(): Int {
        val it = this.iterator()
        val has = it.hasNextFn
        val next = it.nextFn
        var n = 0
        while (has()) {
            next()
            n += 1
        }
        return n
    }

    /// True as soon as one element passes; pulls no further.
    public func any(predicate: (T) -> Bool): Bool {
        val it = this.iterator()
        val has = it.hasNextFn
        val next = it.nextFn
        while (has()) {
            if (predicate(next())) { return true }
        }
        return false
    }

    /// False as soon as one element fails; pulls no further.
    public func all(predicate: (T) -> Bool): Bool {
        val it = this.iterator()
        val has = it.hasNextFn
        val next = it.nextFn
        while (has()) {
            unless (predicate(next())) { return false }
        }
        return true
    }

    /// The first element, or null for an empty sequence.
    public func first(): T? {
        val it = this.iterator()
        val has = it.hasNextFn
        val next = it.nextFn
        if (has()) { return next() }
        return null
    }
}

// ---- two collections the built-in three do not cover -------------------
//
// Written in Keal, in the prelude, rather than added to the compiler. A
// standard library that can only grow by teaching the compiler a new type
// is a standard library with a ceiling; these two have none, and a program
// can write its own the same way.

/// A set: membership, without order and without duplicates.
///
/// Backed by a map, because a map is already a hash table and a set is a
/// map that only ever answers yes or no. Anything a map can key, a set can
/// hold.
public class Set<T>() : Index {
    package var seen: Map<T, Bool> = {}

    /// Whether the value is in the set. Also `s[x]`, through `Index`.
    public func get(value: T): Bool {
        return this.seen.contains(value)
    }

    /// Adds a value. Adding one already there changes nothing, which is
    /// what makes a set a set.
    public proc add(value: T) {
        this.seen[value] = true
    }

    /// `s[x] = true` adds, `s[x] = false` removes — so a set reads and
    /// writes with the same two brackets a list does.
    public proc set(value: T, present: Bool) {
        if (present) {
            this.seen[value] = true
        } else {
            this.seen.remove(value)
        }
    }

    public proc remove(value: T) {
        this.seen.remove(value)
    }

    public func size(): Int {
        return this.seen.size
    }

    public func isEmpty(): Bool {
        return this.seen.size == 0
    }

    /// The values, in the order they were first added.
    public func toList(): List<T> {
        return this.seen.keys()
    }
}

/// A set holding everything in `xs`, duplicates collapsed.
public func setOf<T>(xs: List<T>): Set<T> {
    val s: Set<T> = Set()
    for (x in xs) { s.add(x) }
    return s
}

/// A double-ended queue: add and take at either end, without the cost.
///
/// A list can do this already — `add` at the back, `removeAt(0)` at the
/// front — but `removeAt(0)` moves every remaining element, so a queue
/// built that way costs the square of its length. This one keeps a head
/// index and only compacts when the wasted front is most of the buffer, so
/// taking from the front is what it looks like.
public class Deque<T>() {
    package var items: List<T> = []
    package var head: Int = 0

    public func size(): Int {
        return this.items.size - this.head
    }

    public func isEmpty(): Bool {
        return this.items.size == this.head
    }

    public proc addLast(value: T) {
        this.items.add(value)
    }

    /// Adding at the front is the one operation that must move things, and
    /// it is the rare one; a queue is filled at the back.
    public proc addFirst(value: T) {
        if (this.head > 0) {
            this.head -= 1
            this.items[this.head] = value
            return
        }
        this.items.insert(0, value)
    }

    /// The front value, removed. Null when there is nothing to take —
    /// which is a question, not a failure, so it is answered rather than
    /// thrown.
    public func removeFirst(): T? {
        if (this.items.size == this.head) { return null }
        val v = this.items[this.head]
        this.head += 1
        // Half the buffer wasted is where copying once beats holding on.
        if (this.head > 32 and this.head * 2 > this.items.size) {
            this.items = this.items.slice(this.head, this.items.size)
            this.head = 0
        }
        return v
    }

    public func removeLast(): T? {
        if (this.items.size == this.head) { return null }
        return this.items.removeAt(this.items.size - 1)
    }

    public func first(): T? {
        if (this.items.size == this.head) { return null }
        return this.items[this.head]
    }

    public func toList(): List<T> {
        return this.items.slice(this.head, this.items.size)
    }
}

/// A queue holding everything in `xs`, front first.
public func dequeOf<T>(xs: List<T>): Deque<T> {
    val d: Deque<T> = Deque()
    for (x in xs) { d.addLast(x) }
    return d
}

// ---- the handful of list and string operations you reach for ------------
//
// Free functions rather than methods, because a class cannot be extended
// from outside itself here. That is a real cost and it is stated: the day
// extension methods exist, these move.

/// The values of `xs`, first occurrence kept, duplicates dropped.
public func distinct<T>(xs: List<T>): List<T> {
    val seen: Map<T, Bool> = {}
    val out: List<T> = []
    for (x in xs) {
        unless (seen.contains(x)) {
            seen[x] = true
            out.add(x)
        }
    }
    return out
}

/// Pairs off two lists, stopping at the shorter.
public func zip<A, B>(a: List<A>, b: List<B>): List<Tuple2<A, B>> {
    val out: List<Tuple2<A, B>> = []
    var i = 0
    while (i < a.size and i < b.size) {
        out.add(Tuple2(a[i], b[i]))
        i += 1
    }
    return out
}

/// Splits `xs` in two: what satisfies the test, and what does not. One
/// pass, and both halves come back — which is what a pair of `filter`s
/// costs twice over.
public func partition<T>(xs: List<T>, keep: (T) -> Bool): Tuple2<List<T>, List<T>> {
    val yes: List<T> = []
    val no: List<T> = []
    for (x in xs) {
        if (keep(x)) { yes.add(x) } else { no.add(x) }
    }
    return Tuple2(yes, no)
}

/// `xs` cut into runs of `n`, the last one short if it has to be.
public func chunked<T>(xs: List<T>, n: Int): List<List<T>> {
    if (n < 1) { throw "`chunked` needs a size of one or more" }
    val out: List<List<T>> = []
    var i = 0
    while (i < xs.size) {
        var end = i + n
        if (end > xs.size) { end = xs.size }
        out.add(xs.slice(i, end))
        i += n
    }
    return out
}

/// `s` with `pad` repeated in front until it is `width` wide. A string
/// already that wide comes back unchanged — padding never truncates.
public func padStart(s: String, width: Int, pad: String): String {
    if (pad == "") { throw "`padStart` needs a non-empty pad" }
    var out = s
    while (out.length < width) { out = pad + out }
    return out
}

/// The same, at the end.
public func padEnd(s: String, width: Int, pad: String): String {
    if (pad == "") { throw "`padEnd` needs a non-empty pad" }
    var out = s
    while (out.length < width) { out += pad }
    return out
}

/// The lines of `s`, without their newlines. A trailing newline does not
/// make a last empty line — a file ending in one has as many lines as it
/// looks like it has.
public func lines(s: String): List<String> {
    var text = s
    if (text.endsWith("\n")) { text = text.substring(0, text.length - 1) }
    if (text == "") { return [] }
    return text.split("\n")
}

// ---- dates and times ---------------------------------------------------
//
// Not one new primitive: `time()` already gives the seconds since the epoch,
// and a calendar is arithmetic. Written here rather than in the runtime, so
// all three engines get it by getting the prelude, and a program that wants
// a calendar of its own can read this one and write another.
//
// UTC only, and deliberately. A local time means asking the operating system
// what its offset is, and the only portable way through C reads `struct tm`,
// whose field order the C standard does not fix. A timestamp that is wrong
// by an hour on one platform is worse than one that is honestly UTC on all
// of them.

/// A moment, in the pieces a person reads, and how far east of UTC they
/// were read. `offset` is 0 for UTC, 7200 for a summer in Paris.
public record DateTime(
    val year: Int, val month: Int, val day: Int,
    val hour: Int, val minute: Int, val second: Int,
    /// 0 is Sunday, as C's `tm_wday` has it.
    val weekday: Int,
    /// Seconds east of UTC. Carried rather than assumed, so a moment always
    /// knows what its own numbers mean.
    val offset: Int
) {
    /// ISO 8601, to the second: `2026-09-01T14:23:05Z`, or
    /// `2026-09-01T16:23:05+02:00` away from UTC. The suffix is not
    /// decoration — it is the claim about which clock these numbers are on,
    /// and it is true either way.
    public func iso(): String {
        return "${this.date()}T${this.clock()}${this.zone()}"
    }

    /// `Z`, or `+02:00`, or `-05:30`.
    public func zone(): String {
        if (this.offset == 0) { return "Z" }
        var east = this.offset
        var sign = "+"
        if (east < 0) { sign = "-"; east = -east }
        return "${sign}${twoDigits(east / 3600)}:${twoDigits((east / 60) % 60)}"
    }

    /// `2026-09-01`
    public func date(): String {
        return "${padStart("${this.year}", 4, "0")}-${twoDigits(this.month)}-${twoDigits(this.day)}"
    }

    /// `14:23:05`
    public func clock(): String {
        return "${twoDigits(this.hour)}:${twoDigits(this.minute)}:${twoDigits(this.second)}"
    }

    public func toString(): String { return this.iso() }

    /// Back to seconds since the epoch, so a moment can make a round trip.
    /// The offset comes off again: these numbers are on a local clock, and
    /// the epoch is not.
    public func epochSeconds(): Int {
        val days = daysFromCivil(this.year, this.month, this.day)
        val ofDay = this.hour * 3600 + this.minute * 60 + this.second
        return days * 86400 + ofDay - this.offset
    }

    /// The same moment, read on the UTC clock.
    public func inUtc(): DateTime { return utcAt(this.epochSeconds()) }

    /// The same moment, read on this machine's clock.
    public func inLocalTime(): DateTime { return localAt(this.epochSeconds()) }
}

func twoDigits(n: Int): String { return padStart("${n}", 2, "0") }

/// Floor division, which is what a calendar needs: Keal's `/` truncates
/// toward zero, and a moment before 1970 would land on the wrong day.
func floorDiv(a: Int, b: Int): Int {
    var q = a / b
    if (a % b != 0 and ((a < 0) != (b < 0))) { q = q - 1 }
    return q
}

func floorMod(a: Int, b: Int): Int { return a - floorDiv(a, b) * b }

/// The moment `seconds` after the Unix epoch, in UTC.
///
/// The calendar arithmetic is Howard Hinnant's `civil_from_days`, which is
/// exact for every year a 64-bit count of seconds can reach, and has no
/// table and no leap-second fudge in it.
public func utcAt(seconds: Int): DateTime {
    val days = floorDiv(seconds, 86400)
    val rest = floorMod(seconds, 86400)

    val z = days + 719468
    val era = floorDiv(z, 146097)
    val doe = z - era * 146097
    val yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    val mp = (5 * doy + 2) / 153
    val d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if (mp >= 10) { m = mp - 9 }
    var y = yoe + era * 400
    if (m <= 2) { y = y + 1 }

    // 1970-01-01 was a Thursday, which is 4 with Sunday at 0.
    val weekday = floorMod(days + 4, 7)
    return DateTime(y, m, d, rest / 3600, (rest / 60) % 60, rest % 60, weekday, 0)
}

/// The moment `seconds` after the epoch, read on this machine's clock.
///
/// The offset is asked for that instant, not for now: a moment in July and
/// a moment in January are on different sides of a daylight-saving change
/// in most of the world, and a calendar that asks "what is the offset
/// today" gets the other half of the year wrong by an hour.
public func localAt(seconds: Int): DateTime {
    val east = localOffset(seconds)
    val shifted = utcAt(seconds + east)
    return DateTime(shifted.year, shifted.month, shifted.day,
                    shifted.hour, shifted.minute, shifted.second,
                    shifted.weekday, east)
}

/// The moment this is called, on this machine's clock.
public func localNow(): DateTime { return localAt(time().toInt()) }

/// The inverse: the day number for a civil date. Hinnant's
/// `days_from_civil`, and the exact undoing of the one above.
public func daysFromCivil(year: Int, month: Int, day: Int): Int {
    var y = year
    if (month <= 2) { y = y - 1 }
    val era = floorDiv(y, 400)
    val yoe = y - era * 400
    var mp = month - 3
    if (month <= 2) { mp = month + 9 }
    val doy = (153 * mp + 2) / 5 + day - 1
    val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

/// The moment this is called, in UTC.
public func utcNow(): DateTime { return utcAt(time().toInt()) }

/// The names, for a program that wants to print one. January is 1, and
/// Sunday is 0, so both are indexed the way the fields are numbered.
public func monthName(month: Int): String {
    val names = ["", "January", "February", "March", "April", "May", "June",
                 "July", "August", "September", "October", "November", "December"]
    if (month < 1 or month > 12) { return "?" }
    return names[month]
}

public func weekdayName(weekday: Int): String {
    val names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday",
                 "Friday", "Saturday"]
    if (weekday < 0 or weekday > 6) { return "?" }
    return names[weekday]
}

/// Whether a year has a 29th of February, by the rule the calendar above
/// already obeys.
public func isLeapYear(year: Int): Bool {
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
}

// ---- the file system ---------------------------------------------------
//
// Written over the four primitives — `listDir`, `pathKind`, `makeDir` and
// `removePath` — rather than beside them. A built-in name is reserved for
// good and a program can never declare its own; these are ordinary
// functions, so a program that wants its own `exists` may simply write one.

/// Whether anything is at `path` at all.
public func exists(path: String): Bool {
    return pathKind(path) != 0
}

/// Whether `path` names something that can be read with `readFile`.
public func isFile(path: String): Bool {
    return pathKind(path) == 1
}

/// Whether `path` names a directory, which is what `listDir` will open.
public func isDir(path: String): Bool {
    return pathKind(path) == 2
}

/// Every file under `path`, depth first, each as a path that can be read.
/// Directories are walked rather than listed, so what comes back is what
/// `readFile` will open; the order is `listDir`'s, which is sorted, so two
/// runs over the same tree agree.
///
/// A path that is not a directory yields nothing rather than failing: a
/// walk over what is not there is empty, which is what the caller would
/// have written anyway.
public func walkDir(path: String): List<String> {
    var out: List<String> = []
    val here = listDir(path)
    if (here == null) { return out }
    var base = path
    if (base.endsWith("/")) { base = base.substring(0, base.length - 1) }
    for (name in here) {
        val child = "${base}/${name}"
        if (isDir(child)) {
            out.addAll(walkDir(child))
        } else {
            out.add(child)
        }
    }
    return out
}

/// A sequence over a list. The list is read as the sequence is pulled, one
/// index at a time.
public func seq<T>(xs: List<T>): Sequence<T> {
    return Sequence({ ->
        var i = 0
        SeqIter({ -> i < xs.size }, { ->
            val v = xs[i]
            i += 1
            v
        })
    })
}

/// The infinite sequence `seed, step(seed), step(step(seed)), ...`. Pair it
/// with `take` or `takeWhile`; a plain `toList` on it will not come back.
public func iterate<T>(seed: T, step: (T) -> T): Sequence<T> {
    return Sequence({ ->
        var current = seed
        var started = false
        SeqIter({ -> true }, { ->
            if (started) {
                current = step(current)
            } else {
                started = true
            }
            current
        })
    })
}

// ---- actors --------------------------------------------------------------
//
// The concurrency model the language committed to: actors that own their
// state and talk only through messages. What lives here is the model itself —
// spawning, mailboxes, and a deterministic scheduler — which the two
// interpreters run as written: a legal schedule, and the semantic reference.
// Compiled natively, the same programs run each actor on its own OS thread
// (docs/threads.md): `keal build` swaps `send`, `post`, `drain` and `run`
// for a threaded scheduler with the same meaning, because `send` was always
// asynchronous and `run` was always the only synchronization point. A
// program whose output does not depend on ordering *between* actors — the
// only kind the model promises anything about — prints the same bytes on
// all three engines.
//
// One system carries one message type `M`; a protocol with several shapes
// of message is a record or a `when` over a small union the program defines.

/// The address of an actor: something to `send` to. Holds only the mailbox,
/// so references never form cycles through the system.
public class ActorRef<M>(val mailbox: List<M>) {
    /// Enqueues a **copy** of the message and returns immediately;
    /// delivery happens inside `run`. Messages cross by copy on every
    /// engine — under real threads they cross heaps, and the semantics
    /// must not depend on the scheduler — so mutating a value after
    /// sending it never reaches the receiver. An `ActorRef` inside a
    /// message is the exception: an address is shared, not duplicated.
    public proc send(msg: M) {
        this.mailbox.add(copy(msg))
    }
}

/// Where results leave the actor world: an outbox is an **address**, like
/// an `ActorRef` — capturing one shares it rather than copying it, so
/// actors post into the same box the spawner drains after `run`. Under a
/// threaded scheduler the posts interleave; treat the contents as a bag
/// unless one actor alone is posting.
public class Outbox<T>(val items: List<T>) {
    public proc post(v: T) {
        this.items.add(copy(v))
    }

    /// Everything posted so far, in arrival order — as **copies**: what
    /// leaves the box is yours alone, so draining twice aliases nothing,
    /// on any scheduler.
    public func drain(): List<T> {
        val out: List<T> = []
        for (v in this.items) {
            out.add(copy(v))
        }
        return out
    }
}

/// An empty outbox; `Outbox<Int>([])` written the readable way.
public func outbox<T>(): Outbox<T> {
    val items: List<T> = []
    return Outbox(items)
}

/// A set of actors and their mailboxes. `spawn` registers a handler; `run`
/// delivers until every mailbox is empty.
public class ActorSystem<M>() {
    public var handlers: List<(ActorRef<M>, M) -> Unit> = []
    public var mailboxes: List<List<M>> = []

    /// A new actor. The handler receives the actor's own ref — for replies
    /// and self-sends — and one message; its state lives in what the
    /// handler's closure captured, and **each actor gets its own copy of
    /// every capture**: an actor's state is its own, on every engine, so
    /// mutating a captured value after the spawn never reaches the actor,
    /// and two actors never share one. Aggregate the actor way — reply
    /// with messages — not through a captured collection.
    public func spawn(handler: (ActorRef<M>, M) -> Unit): ActorRef<M> {
        val box: List<M> = []
        this.handlers.add(copyClosure(handler))
        this.mailboxes.add(box)
        return ActorRef(box)
    }

    /// Delivers until every mailbox is drained and no handler is running.
    /// The interpreters deliver round-robin — one message per actor per
    /// pass, in spawn order — deterministically; compiled natively, each
    /// actor is an OS thread and only the order *within* one actor's
    /// mailbox is promised, which is the only order the model ever
    /// promised. A handler's panic ends `run` on the calling thread, so
    /// `try { sys.run() }` catches it on every engine.
    public proc run() {
        var progress = true
        while (progress) {
            progress = false
            var i = 0
            while (i < this.mailboxes.size) {
                val box = this.mailboxes[i]
                if (box.size > 0) {
                    val msg = box.removeAt(0)
                    val handle = this.handlers[i]
                    handle(ActorRef(box), msg)
                    progress = true
                }
                i += 1
            }
        }
    }
}
