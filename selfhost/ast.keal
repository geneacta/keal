// The abstract syntax tree, in Keal — the twin of src/ast.rs.
//
// Keal has no enums, so every node family is one class with a `kind` tag and
// nullable payload fields; only the fields a kind uses are ever set. Spans
// are `line`/`col` plus a `file` id stamped by whoever loaded the file, so
// the checker can sort diagnostics the way the oracle does.

import "./types.keal"

/// A type as written: kind is "named", "nullable" or "func".
package class TypeEx(package val kind: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var name: String = ""          // named
    package var args: List<TypeEx> = []    // named: type arguments; func: parameters
    package var inner: TypeEx? = null      // nullable
    package var ret: TypeEx? = null        // func
}

/// One piece of an interpolated string.
package class PartN(package val isLit: Bool) {
    package var text: String = ""          // lit
    package var ex: Ex? = null             // hole
}

package class ArgN(package val name: String, package val value: Ex)

package class ParamN(package val name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var tyEx: TypeEx? = null
    package var default: Ex? = null
    /// `var` before the name: this function may change what the parameter
    /// holds, and its caller can read that in the signature. Without it the
    /// contents are the caller's, and the checker keeps them that way.
    package var mutable: Bool = false
}

package class TParamN(package val name: String) {
    package var bounds: List<TypeEx> = []
}

package class BlockN() {
    package var stmts: List<StmtN> = []
}

/// `Name(a, _, c)`: "_" stands for a bind that names nothing.
package class DestrN(package val typeName: String, package val binds: List<String>, package val line: Int, package val col: Int) {
    package var file: Int = 0
}

/// Expressions. kind is one of: int float bool str interp null this ident
/// unary binary logical elvis notnull assign call field method index if when
/// list map lambda range is
///
/// `kind` is a `var` because the checker rewrites nodes in place: an integer
/// literal widens to a float, and an operator on a user type becomes the
/// method call it stands for.
package class Ex(package var kind: String, package var line: Int, package var col: Int) {
    package var file: Int = 0
    package var iVal: Int = 0              // int; variant: the ordinal
    /// Kind "variant": one value of an enum, already resolved. THE PARSER
    /// NEVER BUILDS ONE — `Suit.Hearts` parses as a field access, and the
    /// checker rewrites it once it knows `Suit` names an enum. That is why
    /// no engine below the checker has to learn the resolution rule.
    package var enumName: String = ""      // variant: which enum
    package var fVal: Float = 0.0          // float
    package var text: String = ""          // str value; ident/field/method name;
                                   // bool "true"/"false"; unary "neg"/"not";
                                   // binary/logical operator
    package var kids: List<Ex> = []        // operands, in dump order
    package var args: List<ArgN> = []      // call/method arguments
    package var parts: List<PartN> = []    // interp
    package var tyEx: TypeEx? = null       // is
    package var negated: Bool = false      // is
    package var safe: Bool = false         // field/method
    package var assignOp: String = "="     // assign: "=" or the compound op's symbol
    package var params: List<ParamN> = []  // lambda
    package var body: BlockN? = null       // lambda body; if: then-block
    package var els: BlockN? = null        // if: else-block
    package var elseif: Ex? = null         // if: else-if chain
    package var subject: Ex? = null        // when
    package var arms: List<ArmN> = []      // when
    package var keys: List<Ex> = []        // map
    package var values: List<Ex> = []      // map

    // Filled in by the checker.
    package var ty: Ty? = null
    package var inst: List<Ty>? = null
}

/// A `when` arm. Pattern kind: "else", "values", "is", "in".
package class ArmN(package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var patternKind: String = "values"
    package var values: List<Ex> = []      // values / in (values[0] is the range)
    package var patTyEx: TypeEx? = null    // is
    package var patNegated: Bool = false   // is / in
    package var binds: DestrN? = null      // is T(a, b)
    package var guard: Ex? = null
    package var body: BlockN = BlockN()
}

/// Statements. kind: let destructure expr return while for break continue
/// func class
package class StmtN(package var kind: String, package var line: Int, package var col: Int) {
    package var file: Int = 0
    package var vis: String = ""           // only ever set on a top-level let
    package var name: String = ""          // let / for: the bound name
    package var mutable: Bool = false      // let / destructure
    /// `constexpr` marks a binding whose initializer the compiler evaluates
    /// and writes back as a literal, or refuses by name. It is a promise
    /// about *when* the work happens, so it is part of the declaration.
    package var constexpr: Bool = false    // let
    package var tyEx: TypeEx? = null       // let / for: declared type
    package var init: Ex? = null           // let / destructure
    package var pattern: DestrN? = null    // destructure
    package var ex: Ex? = null             // expr / return value / while cond / for iter
    package var body: BlockN? = null       // while / for / try
    package var handler: BlockN? = null    // try: the catch block (`name` binds the message)
    package var catches: List<CatchN> = []  // try: every clause, in order
    /// A block on its own, with its own scope. Nothing writes one — a macro
    /// expanded at statement position becomes one, and the scope is what
    /// keeps the macro's own bindings out of the caller's way. Kind "block".
    package var blk: BlockN? = null
    package var funDecl: FunN? = null
    package var classDecl: ClassN? = null
}

/// One `catch` clause: what it binds, what it will catch, and what it runs.
package class CatchN(package val name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var tyEx: TypeEx? = null       // `catch (e: Overflow)`; null catches all
    package var handler: BlockN = BlockN()
}

package class FunN(package var name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""           // "", "package" or "public"
    /// `constexpr func`: callable from a `constexpr` binding, and held to
    /// what the compile-time evaluator can run.
    package var constexpr: Bool = false
    package var typeParams: List<TParamN> = []
    package var params: List<ParamN> = []
    package var ret: TypeEx? = null
    package var body: BlockN = BlockN()
}

package class CtorN(package val name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""
    package var tyEx: TypeEx? = null
    package var default: Ex? = null
    package var fieldKind: String = ""     // "val", "var" or "" for a plain parameter
    package var weak: Bool = false         // `weak val parent: Parent?`
}

package class FieldN(package val name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""
    package var tyEx: TypeEx? = null
    package var init: Ex? = null
    package var mutable: Bool = false
    package var weak: Bool = false         // `weak var next: Node?`
}

package class ClassN(package var name: String, package val isRecord: Bool, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""
    package var typeParams: List<TParamN> = []
    package var traits: List<TypeEx> = []
    package var ctor: List<CtorN> = []
    package var fields: List<FieldN> = []
    package var methods: List<FunN> = []
}

package class TraitMethodN(package val decl: FunN, package val hasDefault: Bool)

package class TraitN(package var name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""
    package var methods: List<TraitMethodN> = []
}

package class ExternN(package var name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""
    package var symbol: String = ""
    package var params: List<ParamN> = []
    package var ret: TypeEx? = null
}

/// Top-level items. kind: func class trait native extern import stmt
package class ItemN(package val kind: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var funDecl: FunN? = null
    package var classDecl: ClassN? = null
    package var traitDecl: TraitN? = null
    package var externDecl: ExternN? = null
    package var text: String = ""          // native code / import path
    package var alias: String = ""         // import: the name given with `as`
    package var stmt: StmtN? = null
    package var macroDecl: MacroN? = null
    package var enumDecl: EnumN? = null
}

/// `enum Suit { Hearts, Diamonds, Clubs, Spades }` — a closed set of names.
///
/// Closed is the whole of it: the checker knows every value the type has, so
/// a `when` over one needs no `else`, and the day a variant is added, every
/// `when` that forgot it is an error rather than a surprise at run time. A
/// variant carries nothing; one that wants fields is a `record`.
package class EnumN(package var name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""
    package var variants: List<VariantN> = []
}

package class VariantN(package val name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
}

/// `macro name(a, b) { ... }` — a named piece of syntax, expanded where it
/// is written. Not a value: it exists only while the program is compiled.
package class MacroN(package val name: String, package val line: Int, package val col: Int) {
    package var file: Int = 0
    package var vis: String = ""
    package var params: List<String> = []
    package var body: BlockN = BlockN()
}

package class ProgramN() {
    package var items: List<ItemN> = []
    /// Who imported whom, once the loader has resolved the paths to files.
    /// The declarations are all spliced into one list, so this is what is
    /// left of the shape they came in.
    package var imports: List<ImportEdge> = []
}

/// One `import`, resolved: the file that wrote it, the file it names, and
/// the alias it gave it, "" for none.
package class ImportEdge(
    package val from: Int,
    package val to: Int,
    package val alias: String
)

// ---- copying -----------------------------------------------------------
//
// A macro body is spliced once per call, so every expansion needs a tree of
// its own: two calls to one macro must not share nodes, or the second would
// find the first's substitutions already in place.

package func copyBlock(b: BlockN): BlockN {
    val out = BlockN()
    for (s in b.stmts) { out.stmts.add(copyStmt(s)) }
    return out
}

package func copyStmt(s: StmtN): StmtN {
    val out = StmtN(s.kind, s.line, s.col)
    out.file = s.file
    out.vis = s.vis
    out.name = s.name
    out.mutable = s.mutable
    out.constexpr = s.constexpr
    out.tyEx = s.tyEx
    val init = s.init
    if (init != null) { out.init = copyEx(init) }
    out.pattern = s.pattern
    val ex = s.ex
    if (ex != null) { out.ex = copyEx(ex) }
    val body = s.body
    if (body != null) { out.body = copyBlock(body) }
    val handler = s.handler
    if (handler != null) { out.handler = copyBlock(handler) }
    for (c in s.catches) {
        val cc = CatchN(c.name, c.line, c.col)
        cc.file = c.file
        cc.tyEx = c.tyEx
        cc.handler = copyBlock(c.handler)
        out.catches.add(cc)
    }
    val blk = s.blk
    if (blk != null) { out.blk = copyBlock(blk) }
    // A declaration inside a macro body is refused before it is ever
    // spliced, so these are carried across only to be reported by name.
    out.funDecl = s.funDecl
    out.classDecl = s.classDecl
    return out
}

package func copyEx(e: Ex): Ex {
    val out = Ex(e.kind, e.line, e.col)
    becomeEx(out, e)
    return out
}

/// Makes `target` the same node as `source`, in place — what a macro call
/// does when it becomes the expression it stood for. The position comes with
/// it: an expansion already carries the position of the call a person wrote,
/// which is the one a diagnostic should name.
package proc becomeEx(var target: Ex, source: Ex) {
    target.kind = source.kind
    target.line = source.line
    target.col = source.col
    target.file = source.file
    target.iVal = source.iVal
    target.fVal = source.fVal
    target.text = source.text
    target.negated = source.negated
    target.safe = source.safe
    target.assignOp = source.assignOp
    target.tyEx = source.tyEx
    target.params = source.params
    target.ty = source.ty
    target.inst = source.inst
    var kids: List<Ex> = []
    for (k in source.kids) { kids.add(copyEx(k)) }
    target.kids = kids
    var args: List<ArgN> = []
    for (a in source.args) { args.add(ArgN(a.name, copyEx(a.value))) }
    target.args = args
    var parts: List<PartN> = []
    for (p in source.parts) {
        val np = PartN(p.isLit)
        np.text = p.text
        val hole = p.ex
        if (hole != null) { np.ex = copyEx(hole) }
        parts.add(np)
    }
    target.parts = parts
    var keys: List<Ex> = []
    for (k in source.keys) { keys.add(copyEx(k)) }
    target.keys = keys
    var values: List<Ex> = []
    for (v in source.values) { values.add(copyEx(v)) }
    target.values = values
    val body = source.body
    target.body = if (body == null) { null } else { copyBlock(body) }
    val els = source.els
    target.els = if (els == null) { null } else { copyBlock(els) }
    val chain = source.elseif
    target.elseif = if (chain == null) { null } else { copyEx(chain) }
    val subj = source.subject
    target.subject = if (subj == null) { null } else { copyEx(subj) }
    var arms: List<ArmN> = []
    for (a in source.arms) {
        val na = ArmN(a.line, a.col)
        na.file = a.file
        na.patternKind = a.patternKind
        na.patTyEx = a.patTyEx
        na.patNegated = a.patNegated
        na.binds = a.binds
        var vals: List<Ex> = []
        for (v in a.values) { vals.add(copyEx(v)) }
        na.values = vals
        val g = a.guard
        na.guard = if (g == null) { null } else { copyEx(g) }
        na.body = copyBlock(a.body)
        arms.add(na)
    }
    target.arms = arms
}
