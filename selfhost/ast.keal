// The abstract syntax tree, in Keal — the twin of src/ast.rs.
//
// Keal has no enums, so every node family is one class with a `kind` tag and
// nullable payload fields; only the fields a kind uses are ever set. Spans
// are `line`/`col` plus a `file` id stamped by whoever loaded the file, so
// the checker can sort diagnostics the way the oracle does.

import "./types.keal"

/// A type as written: kind is "named", "nullable" or "fun".
package class TypeEx(val kind: String, val line: Int, val col: Int) {
    var file: Int = 0
    var name: String = ""          // named
    var args: List<TypeEx> = []    // named: type arguments; fun: parameters
    var inner: TypeEx? = null      // nullable
    var ret: TypeEx? = null        // fun
}

/// One piece of an interpolated string.
package class PartN(val isLit: Bool) {
    var text: String = ""          // lit
    var ex: Ex? = null             // hole
}

package class ArgN(val name: String, val value: Ex)

package class ParamN(val name: String, val line: Int, val col: Int) {
    var file: Int = 0
    var tyEx: TypeEx? = null
    var default: Ex? = null
}

package class TParamN(val name: String) {
    var bounds: List<TypeEx> = []
}

package class BlockN() {
    var stmts: List<StmtN> = []
}

/// `Name(a, _, c)`: "_" stands for a bind that names nothing.
package class DestrN(val typeName: String, val binds: List<String>, val line: Int, val col: Int) {
    var file: Int = 0
}

/// Expressions. kind is one of: int float bool str interp null this ident
/// unary binary logical elvis notnull assign call field method index if when
/// list map lambda range is
///
/// `kind` is a `var` because the checker rewrites nodes in place: an integer
/// literal widens to a float, and an operator on a user type becomes the
/// method call it stands for.
package class Ex(var kind: String, val line: Int, val col: Int) {
    var file: Int = 0
    var iVal: Int = 0              // int
    var fVal: Float = 0.0          // float
    var text: String = ""          // str value; ident/field/method name;
                                   // bool "true"/"false"; unary "neg"/"not";
                                   // binary/logical operator
    var kids: List<Ex> = []        // operands, in dump order
    var args: List<ArgN> = []      // call/method arguments
    var parts: List<PartN> = []    // interp
    var tyEx: TypeEx? = null       // is
    var negated: Bool = false      // is
    var safe: Bool = false         // field/method
    var assignOp: String = "="     // assign: "=" or the compound op's symbol
    var params: List<ParamN> = []  // lambda
    var body: BlockN? = null       // lambda body; if: then-block
    var els: BlockN? = null        // if: else-block
    var elseif: Ex? = null         // if: else-if chain
    var subject: Ex? = null        // when
    var arms: List<ArmN> = []      // when
    var keys: List<Ex> = []        // map
    var values: List<Ex> = []      // map

    // Filled in by the checker.
    var ty: Ty? = null
    var inst: List<Ty>? = null
}

/// A `when` arm. Pattern kind: "else", "values", "is", "in".
package class ArmN(val line: Int, val col: Int) {
    var file: Int = 0
    var patternKind: String = "values"
    var values: List<Ex> = []      // values / in (values[0] is the range)
    var patTyEx: TypeEx? = null    // is
    var patNegated: Bool = false   // is / in
    var binds: DestrN? = null      // is T(a, b)
    var guard: Ex? = null
    var body: BlockN = BlockN()
}

/// Statements. kind: let destructure expr return while for break continue
/// fun class
package class StmtN(val kind: String, val line: Int, val col: Int) {
    var file: Int = 0
    var vis: String = ""           // only ever set on a top-level let
    var name: String = ""          // let / for: the bound name
    var mutable: Bool = false      // let / destructure
    var tyEx: TypeEx? = null       // let / for: declared type
    var init: Ex? = null           // let / destructure
    var pattern: DestrN? = null    // destructure
    var ex: Ex? = null             // expr / return value / while cond / for iter
    var body: BlockN? = null       // while / for / try
    var handler: BlockN? = null    // try: the catch block (`name` binds the message)
    var funDecl: FunN? = null
    var classDecl: ClassN? = null
}

package class FunN(val name: String, val line: Int, val col: Int) {
    var file: Int = 0
    var vis: String = ""           // "", "package" or "public"
    var typeParams: List<TParamN> = []
    var params: List<ParamN> = []
    var ret: TypeEx? = null
    var body: BlockN = BlockN()
}

package class CtorN(val name: String, val line: Int, val col: Int) {
    var file: Int = 0
    var vis: String = ""
    var tyEx: TypeEx? = null
    var default: Ex? = null
    var fieldKind: String = ""     // "val", "var" or "" for a plain parameter
    var weak: Bool = false         // `weak val parent: Parent?`
}

package class FieldN(val name: String, val line: Int, val col: Int) {
    var file: Int = 0
    var vis: String = ""
    var tyEx: TypeEx? = null
    var init: Ex? = null
    var mutable: Bool = false
    var weak: Bool = false         // `weak var next: Node?`
}

package class ClassN(val name: String, val isRecord: Bool, val line: Int, val col: Int) {
    var file: Int = 0
    var vis: String = ""
    var typeParams: List<TParamN> = []
    var traits: List<TypeEx> = []
    var ctor: List<CtorN> = []
    var fields: List<FieldN> = []
    var methods: List<FunN> = []
}

package class TraitMethodN(val decl: FunN, val hasDefault: Bool)

package class TraitN(val name: String, val line: Int, val col: Int) {
    var file: Int = 0
    var vis: String = ""
    var methods: List<TraitMethodN> = []
}

package class ExternN(val name: String, val line: Int, val col: Int) {
    var file: Int = 0
    var vis: String = ""
    var symbol: String = ""
    var params: List<ParamN> = []
    var ret: TypeEx? = null
}

/// Top-level items. kind: fun class trait native extern import stmt
package class ItemN(val kind: String, val line: Int, val col: Int) {
    var file: Int = 0
    var funDecl: FunN? = null
    var classDecl: ClassN? = null
    var traitDecl: TraitN? = null
    var externDecl: ExternN? = null
    var text: String = ""          // native code / import path
    var stmt: StmtN? = null
}

package class ProgramN() {
    var items: List<ItemN> = []
}
