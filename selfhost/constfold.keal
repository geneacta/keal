// The compile-time evaluator behind `constexpr`, in Keal — the twin of
// src/constfold.rs.
//
// `constexpr val NAME = <expr>` is a promise about *when* the work happens:
// the compiler runs the expression and writes the answer back into the tree
// as a literal, so all three engines see a constant where the program wrote
// a computation. `constexpr func` is a function such a binding may call.
//
// It is deliberately not the tree-walking interpreter with a flag. What a
// `constexpr` may do has to be a promise a reader can hold in their head,
// and it has to be implementable twice — here and in src/constfold.rs —
// without either copy drifting. So this is a small evaluator over a small
// language, and everything outside that language is refused BY NAME rather
// than quietly left to run time: the whole value of the word is that it
// fails loudly when it cannot keep its promise.
//
// Where the Rust half returns a Result, this half reports through the
// checker it belongs to and returns null. Exactly one diagnostic comes out
// of a failed fold either way, which is what makes the two comparable.

import "./ast.keal"

/// The steps one `constexpr` binding may take. Generous enough that no
/// honest table-builder meets it, small enough that a mistake is a
/// diagnostic within a moment rather than a compiler that never returns.
package val CONST_BUDGET = 2000000

/// A value the compile-time evaluator can hold. Deliberately smaller than
/// the run-time value: what a `constexpr` produces has to be something the
/// compiler can write back as a literal, so this list *is* the promise.
package class CV(package val kind: String) {
    package var i: Int = 0
    package var f: Float = 0.0
    package var b: Bool = false
    package var s: String = ""
    package var items: List<CV> = []
    package var keys: List<CV> = []
    package var vals: List<CV> = []
}

package func cvInt(n: Int): CV {
    val v = CV("Int")
    v.i = n
    return v
}

package func cvFloat(x: Float): CV {
    val v = CV("Float")
    v.f = x
    return v
}

package func cvBool(x: Bool): CV {
    val v = CV("Bool")
    v.b = x
    return v
}

package func cvStr(x: String): CV {
    val v = CV("Str")
    v.s = x
    return v
}

package func cvUnit(): CV {
    return CV("Unit")
}

package func cvList(xs: List<CV>): CV {
    val v = CV("List")
    v.items = xs
    return v
}

package func cvMap(ks: List<CV>, vs: List<CV>): CV {
    val v = CV("Map")
    v.keys = ks
    v.vals = vs
    return v
}

/// Structural equality, which is what `==` gives every value this holds.
package func cvEq(a: CV, b: CV): Bool {
    unless (a.kind == b.kind) { return false }
    if (a.kind == "Int") { return a.i == b.i }
    if (a.kind == "Float") { return a.f == b.f }
    if (a.kind == "Bool") { return a.b == b.b }
    if (a.kind == "Str") { return a.s == b.s }
    if (a.kind == "Unit") { return true }
    if (a.kind == "List") {
        unless (a.items.size == b.items.size) { return false }
        var i = 0
        while (i < a.items.size) {
            unless (cvEq(a.items[i], b.items[i])) { return false }
            i += 1
        }
        return true
    }
    // A map compares entry by entry in insertion order, as two literals do.
    unless (a.keys.size == b.keys.size) { return false }
    var i = 0
    while (i < a.keys.size) {
        unless (cvEq(a.keys[i], b.keys[i])) { return false }
        unless (cvEq(a.vals[i], b.vals[i])) { return false }
        i += 1
    }
    return true
}

/// The escaping a string takes inside a container, matching the runtime's.
package func cvEscape(s: String): String {
    var out = ""
    for (c in s) {
        if (c == "\"") { out += "\\\"" }
        else if (c == "\\") { out += "\\\\" }
        else if (c == "\n") { out += "\\n" }
        else if (c == "\t") { out += "\\t" }
        else if (c == "\r") { out += "\\r" }
        else { out += c }
    }
    return out
}

/// How the value reads inside a string, which is what interpolation and
/// `toString` give. The same rendering the interpreters use, because a
/// folded constant must print what the unfolded program printed.
package func cvDisplay(v: CV): String {
    if (v.kind == "Int") { return "${v.i}" }
    if (v.kind == "Float") { return "${v.f}" }
    if (v.kind == "Bool") { return "${v.b}" }
    if (v.kind == "Str") { return v.s }
    if (v.kind == "Unit") { return "unit" }
    if (v.kind == "List") {
        var out = "["
        var i = 0
        while (i < v.items.size) {
            if (i > 0) { out += ", " }
            out += cvRepr(v.items[i])
            i += 1
        }
        return out + "]"
    }
    var out = "{"
    var i = 0
    while (i < v.keys.size) {
        if (i > 0) { out += ", " }
        out += cvRepr(v.keys[i]) + ": " + cvRepr(v.vals[i])
        i += 1
    }
    return out + "}"
}

/// How the value reads *inside* a container, where a string is quoted.
package func cvRepr(v: CV): String {
    if (v.kind == "Str") { return "\"" + cvEscape(v.s) + "\"" }
    return cvDisplay(v)
}

package func cvTypeName(v: CV): String {
    if (v.kind == "Str") { return "String" }
    return v.kind
}

/// What `return` inside a `constexpr func` does to the statement walk.
package class CFlow(package val kind: String) {  // "normal" "return" "break" "continue"
    package var value: CV? = null
}

/// One name bound during a fold.
package class CBind(package val name: String, package var value: CV) {}

/// The folded value, written back into the tree as the literal a program
/// could have written by hand. Null where no literal spells it — which the
/// folder's own value list makes unreachable, but a null is cheaper than a
/// crash if that ever stops being true.
package func cvLiteral(v: CV, file: Int, line: Int, col: Int): Ex? {
    if (v.kind == "Int") {
        val e = Ex("int", line, col)
        e.file = file
        e.iVal = v.i
        return e
    }
    if (v.kind == "Float") {
        val e = Ex("float", line, col)
        e.file = file
        e.fVal = v.f
        return e
    }
    if (v.kind == "Bool") {
        val e = Ex("bool", line, col)
        e.file = file
        // A bool node carries its word, as the parser writes it.
        e.text = if (v.b) { "true" } else { "false" }
        return e
    }
    if (v.kind == "Str") {
        val e = Ex("str", line, col)
        e.file = file
        e.text = v.s
        return e
    }
    // `Unit` is what a call with nothing to say gives; there is no literal
    // for it, and no binding wants one.
    if (v.kind == "Unit") { return null }
    if (v.kind == "List") {
        val e = Ex("list", line, col)
        e.file = file
        var out: List<Ex> = []
        for (item in v.items) {
            val lit = cvLiteral(item, file, line, col)
            if (lit == null) { return null }
            out.add(lit)
        }
        e.kids = out
        return e
    }
    val e = Ex("map", line, col)
    e.file = file
    var ks: List<Ex> = []
    var vs: List<Ex> = []
    var i = 0
    while (i < v.keys.size) {
        val k = cvLiteral(v.keys[i], file, line, col)
        if (k == null) { return null }
        val entry = cvLiteral(v.vals[i], file, line, col)
        if (entry == null) { return null }
        ks.add(k)
        vs.add(entry)
        i += 1
    }
    e.keys = ks
    e.values = vs
    return e
}

/// The evaluator. It reports through the checker that owns it, and reports
/// exactly once per fold — the Rust half returns its first error and stops,
/// so this one has to stop at its first too, or the two would not agree
/// about how many diagnostics a bad `constexpr` is worth.
package class Folder(package val funs: Map<String, FunN>) {
    /// The one diagnostic a failed fold is worth, kept here rather than
    /// pushed: this file knows nothing about the checker's error list, and
    /// the checker turns these five fields into its own diagnostic.
    package var errFile: Int = 0
    package var errLine: Int = 0
    package var errCol: Int = 0
    package var errMsg: String = ""
    package var errNote: String = ""
    /// Innermost last. A `constexpr func` call pushes a frame that sees only
    /// its own parameters, so a body cannot read a caller's names.
    package var scopes: List<List<CBind>> = [[]]
    /// The frame boundary: names below it are not in scope.
    package var frames: List<Int> = [0]
    package var budget: Int = CONST_BUDGET
    package var depth: Int = 0
    /// Set the moment something is refused, so nothing downstream reports
    /// a second diagnostic for the same fold.
    package var failed: Bool = false

    package proc report(file: Int, atLine: Int, atCol: Int, msg: String, note: String) {
        if (this.failed) { return }
        this.failed = true
        this.errFile = file
        this.errLine = atLine
        this.errCol = atCol
        this.errMsg = msg
        this.errNote = note
    }

    package func refuse(file: Int, atLine: Int, atCol: Int, what: String): CV? {
        this.report(
            file,
            atLine,
            atCol,
            "`constexpr` cannot evaluate " + what,
            "a `constexpr` runs at compile time, so it is held to arithmetic, strings, lists, maps and calls to other `constexpr func`s"
        )
        return null
    }

    package func plain(file: Int, atLine: Int, atCol: Int, msg: String): CV? {
        this.report(file, atLine, atCol, msg, "")
        return null
    }

    package func overBudget(file: Int, atLine: Int, atCol: Int): CV? {
        this.report(
            file,
            atLine,
            atCol,
            "this `constexpr` did not finish",
            "it ran past the compile-time step budget; a loop that does not end at compile time would be a compiler that does not end"
        )
        return null
    }

    /// One unit of work. False once the budget is gone, and the caller
    /// stops rather than pressing on.
    package func step(file: Int, atLine: Int, atCol: Int): Bool {
        if (this.failed) { return false }
        if (this.budget == 0) {
            this.overBudget(file, atLine, atCol)
            return false
        }
        this.budget -= 1
        return true
    }

    package func lookup(name: String): CV? {
        val floor = this.frames[this.frames.size - 1]
        var si = this.scopes.size - 1
        while (si >= floor) {
            val scope = this.scopes[si]
            var bi = scope.size - 1
            while (bi >= 0) {
                if (scope[bi].name == name) { return scope[bi].value }
                bi -= 1
            }
            si -= 1
        }
        return null
    }

    package func bindingOf(name: String): CBind? {
        val floor = this.frames[this.frames.size - 1]
        var si = this.scopes.size - 1
        while (si >= floor) {
            val scope = this.scopes[si]
            var bi = scope.size - 1
            while (bi >= 0) {
                if (scope[bi].name == name) { return scope[bi] }
                bi -= 1
            }
            si -= 1
        }
        return null
    }

    /// The one place a `constexpr` may change something: a container held
    /// by a name it bound itself. Building a table is what the word is for,
    /// and a table is built by adding to one — so `out.add(x)` and
    /// `out[k] = v` work, and only through a name, where the folder can see
    /// what it is changing.
    package func addTo(name: String, v: CV, file: Int, atLine: Int, atCol: Int): CV? {
        val b = this.bindingOf(name)
        if (b == null) { return this.plain(file, atLine, atCol, "`${name}` is not a `constexpr`") }
        val held = b.value
        unless (held.kind == "List") {
            return this.refuse(file, atLine, atCol, "changing a `${cvTypeName(held)}` in place")
        }
        held.items.add(v)
        return cvUnit()
    }

    package func setAt(name: String, k: CV, v: CV, file: Int, atLine: Int, atCol: Int): CV? {
        val b = this.bindingOf(name)
        if (b == null) { return this.plain(file, atLine, atCol, "`${name}` is not a `constexpr`") }
        val held = b.value
        if (held.kind == "List") {
            unless (k.kind == "Int") {
                return this.refuse(file, atLine, atCol, "changing a `List` in place")
            }
            if (k.i < 0 or k.i >= held.items.size) {
                return this.plain(
                    file, atLine, atCol,
                    "index ${k.i} is out of bounds for a list of ${held.items.size} element(s)"
                )
            }
            held.items[k.i] = v
            return cvUnit()
        }
        if (held.kind == "Map") {
            var j = 0
            while (j < held.keys.size) {
                if (cvEq(held.keys[j], k)) {
                    held.vals[j] = v
                    return cvUnit()
                }
                j += 1
            }
            held.keys.add(k)
            held.vals.add(v)
            return cvUnit()
        }
        return this.refuse(file, atLine, atCol, "changing a `${cvTypeName(held)}` in place")
    }

    package func assign(name: String, v: CV): Bool {
        val floor = this.frames[this.frames.size - 1]
        var si = this.scopes.size - 1
        while (si >= floor) {
            val scope = this.scopes[si]
            var bi = scope.size - 1
            while (bi >= 0) {
                if (scope[bi].name == name) {
                    scope[bi].value = v
                    return true
                }
                bi -= 1
            }
            si -= 1
        }
        return false
    }

    package proc bind(name: String, v: CV) {
        this.scopes[this.scopes.size - 1].add(CBind(name, v))
    }

    package func eval(e: Ex): CV? {
        unless (this.step(e.file, e.line, e.col)) { return null }
        val k = e.kind
        if (k == "int") { return cvInt(e.iVal) }
        if (k == "float") { return cvFloat(e.fVal) }
        if (k == "bool") { return cvBool(e.text == "true") }
        if (k == "str") { return cvStr(e.text) }
        if (k == "interp") {
            var out = ""
            for (p in e.parts) {
                if (p.isLit) {
                    out += p.text
                } else {
                    val v = this.eval(p.ex!!)
                    if (v == null) { return null }
                    out += cvDisplay(v)
                }
            }
            return cvStr(out)
        }
        if (k == "ident") {
            val v = this.lookup(e.text)
            if (v != null) { return v }
            this.report(
                e.file,
                e.line,
                e.col,
                "`${e.text}` is not a `constexpr`",
                "only another `constexpr val` in scope, or a name this `constexpr` bound itself, has a value at compile time"
            )
            return null
        }
        if (k == "unary") { return this.unary(e) }
        if (k == "binary") {
            val a = this.eval(e.kids[0])
            if (a == null) { return null }
            val b = this.eval(e.kids[1])
            if (b == null) { return null }
            return this.binary(e.text, a, b, e.file, e.line, e.col)
        }
        if (k == "logical") { return this.logical(e) }
        if (k == "list") {
            var out: List<CV> = []
            for (kid in e.kids) {
                val v = this.eval(kid)
                if (v == null) { return null }
                out.add(v)
            }
            return cvList(out)
        }
        if (k == "map") { return this.mapLit(e) }
        if (k == "index") { return this.index(e) }
        if (k == "field") {
            if (e.safe) { return this.refuse(e.file, e.line, e.col, "`?.` — nothing a `constexpr` holds can be null") }
            val subject = this.eval(e.kids[0])
            if (subject == null) { return null }
            return this.property(subject, e.text, e.file, e.line, e.col)
        }
        if (k == "method") {
            if (e.safe) { return this.refuse(e.file, e.line, e.col, "`?.` — nothing a `constexpr` holds can be null") }
            // `out.add(x)` on a name changes what that name holds. A value
            // that is not held by a name has nowhere to put the change, so
            // it is refused rather than silently dropped.
            if (e.text == "add" and e.args.size == 1 and e.args[0].name == "" and e.kids[0].kind == "ident") {
                val v = this.eval(e.args[0].value)
                if (v == null) { return null }
                return this.addTo(e.kids[0].text, v, e.file, e.line, e.col)
            }
            val subject = this.eval(e.kids[0])
            if (subject == null) { return null }
            var vals: List<CV> = []
            for (a in e.args) {
                if (a.name != "") { return this.refuse(e.file, e.line, e.col, "a named argument to a built-in method") }
                val v = this.eval(a.value)
                if (v == null) { return null }
                vals.add(v)
            }
            return this.method(subject, e.text, vals, e.file, e.line, e.col)
        }
        if (k == "if") { return this.ifValue(e) }
        if (k == "ternary") {
            val c = this.eval(e.kids[0])
            if (c == null) { return null }
            if (c.kind == "Bool" and e.kids.size == 3) {
                return this.eval(if (c.b) { e.kids[1] } else { e.kids[2] })
            }
            return this.refuse(e.file, e.line, e.col, "a three-valued `?:` at compile time")
        }
        if (k == "when") { return this.whenValue(e) }
        if (k == "call") {
            val callee = e.kids[0]
            unless (callee.kind == "ident") {
                return this.refuse(e.file, e.line, e.col, "calling something that is not a named function")
            }
            var vals: List<CV> = []
            for (a in e.args) {
                if (a.name != "") { return this.refuse(e.file, e.line, e.col, "a named argument to a `constexpr func`") }
                val v = this.eval(a.value)
                if (v == null) { return null }
                vals.add(v)
            }
            return this.call(callee.text, vals, e.file, e.line, e.col)
        }
        if (k == "range") { return this.refuse(e.file, e.line, e.col, "a range as a value") }
        if (k == "null") { return this.refuse(e.file, e.line, e.col, "`null`") }
        if (k == "lambda") { return this.refuse(e.file, e.line, e.col, "a lambda") }
        if (k == "this") { return this.refuse(e.file, e.line, e.col, "`this`") }
        if (k == "notnull") { return this.refuse(e.file, e.line, e.col, "`!!`") }
        if (k == "is") { return this.refuse(e.file, e.line, e.col, "`is`") }
        if (k == "elvis") { return this.refuse(e.file, e.line, e.col, "`?:`") }
        if (k == "assign") { return this.refuse(e.file, e.line, e.col, "an assignment as a value") }
        return this.refuse(e.file, e.line, e.col, "this kind of expression")
    }

    package func unary(e: Ex): CV? {
        val v = this.eval(e.kids[0])
        if (v == null) { return null }
        if (e.text == "neg") {
            if (v.kind == "Int") {
                try {
                    return cvInt(0 - v.i)
                } catch (m: String) {
                    return this.plain(e.file, e.line, e.col, m)
                }
            }
            if (v.kind == "Float") { return cvFloat(0.0 - v.f) }
        }
        if (e.text == "not" and v.kind == "Bool") { return cvBool(not v.b) }
        if (e.text == "bnot" and v.kind == "Int") { return cvInt(bnot v.i) }
        val sym = if (e.text == "neg") { "-" } else { e.text }
        return this.refuse(e.file, e.line, e.col, "`${sym}` on a `${cvTypeName(v)}`")
    }

    package func truth(e: Ex): Bool? {
        val v = this.eval(e)
        if (v == null) { return null }
        if (v.kind == "Bool") { return v.b }
        this.refuse(e.file, e.line, e.col, "a `${cvTypeName(v)}` where a `Bool` was wanted")
        return null
    }

    package func logical(e: Ex): CV? {
        val a = this.truth(e.kids[0])
        if (a == null) { return null }
        val op = e.text
        // The short-circuiting ones do not touch the right side, exactly as
        // they do not at run time.
        if (op == "and" and not a) { return cvBool(false) }
        if (op == "or" and a) { return cvBool(true) }
        val b = this.truth(e.kids[1])
        if (b == null) { return null }
        if (op == "and") { return cvBool(a and b) }
        if (op == "or") { return cvBool(a or b) }
        if (op == "xor") { return cvBool(a != b) }
        if (op == "xnor") { return cvBool(a == b) }
        if (op == "nand") { return cvBool(a nand b) }
        if (op == "nor") { return cvBool(a nor b) }
        return cvBool((not a) or b)
    }

    package func mapLit(e: Ex): CV? {
        var ks: List<CV> = []
        var vs: List<CV> = []
        var i = 0
        while (i < e.keys.size) {
            val k = this.eval(e.keys[i])
            if (k == null) { return null }
            val v = this.eval(e.values[i])
            if (v == null) { return null }
            // Insertion order, last write wins — the semantics a map literal
            // has at run time.
            var found = -1
            var j = 0
            while (j < ks.size) {
                if (cvEq(ks[j], k)) { found = j  break }
                j += 1
            }
            if (found >= 0) {
                vs[found] = v
            } else {
                ks.add(k)
                vs.add(v)
            }
            i += 1
        }
        return cvMap(ks, vs)
    }

    package func index(e: Ex): CV? {
        val subject = this.eval(e.kids[0])
        if (subject == null) { return null }
        val idx = this.eval(e.kids[1])
        if (idx == null) { return null }
        if (subject.kind == "List" and idx.kind == "Int") {
            if (idx.i < 0 or idx.i >= subject.items.size) {
                return this.plain(
                    e.file, e.line, e.col,
                    "index ${idx.i} is out of bounds for a list of ${subject.items.size} element(s)"
                )
            }
            return subject.items[idx.i]
        }
        if (subject.kind == "Map") {
            var j = 0
            while (j < subject.keys.size) {
                if (cvEq(subject.keys[j], idx)) { return subject.vals[j] }
                j += 1
            }
            return this.plain(e.file, e.line, e.col, "no entry for ${cvRepr(idx)} in this map")
        }
        if (subject.kind == "Str" and idx.kind == "Int") {
            var chars: List<String> = []
            for (c in subject.s) { chars.add(c) }
            if (idx.i < 0 or idx.i >= chars.size) {
                return this.plain(
                    e.file, e.line, e.col,
                    "index ${idx.i} is out of bounds for a string of ${chars.size} character(s)"
                )
            }
            return cvStr(chars[idx.i])
        }
        return this.refuse(e.file, e.line, e.col, "indexing a `${cvTypeName(subject)}`")
    }

    package func binary(op: String, a: CV, b: CV, file: Int, atLine: Int, atCol: Int): CV? {
        // Equality and its negation work on everything this holds, as they
        // do at run time.
        if (op == "==") { return cvBool(cvEq(a, b)) }
        if (op == "!=") { return cvBool(not cvEq(a, b)) }
        if (a.kind == "Int" and b.kind == "Int") {
            return this.intOp(op, a.i, b.i, file, atLine, atCol)
        }
        if (a.kind == "Float" and b.kind == "Float") {
            return this.floatOp(op, a.f, b.f, file, atLine, atCol)
        }
        // A string on the left takes anything on the right, rendering it —
        // the rule the interpreters follow for `+`.
        if (a.kind == "Str" and op == "+") { return cvStr(a.s + cvDisplay(b)) }
        if (a.kind == "Str" and b.kind == "Str") {
            if (op == "<") { return cvBool(a.s < b.s) }
            if (op == "<=") { return cvBool(a.s <= b.s) }
            if (op == ">") { return cvBool(a.s > b.s) }
            if (op == ">=") { return cvBool(a.s >= b.s) }
            return this.refuse(file, atLine, atCol, "`${op}` on two strings")
        }
        if (a.kind == "List" and b.kind == "List" and op == "+") {
            var out: List<CV> = []
            for (x in a.items) { out.add(x) }
            for (y in b.items) { out.add(y) }
            return cvList(out)
        }
        return this.refuse(
            file, atLine, atCol,
            "`${op}` between a `${cvTypeName(a)}` and a `${cvTypeName(b)}`"
        )
    }

    package func intOp(op: String, x: Int, y: Int, file: Int, atLine: Int, atCol: Int): CV? {
        if (op == "<") { return cvBool(x < y) }
        if (op == "<=") { return cvBool(x <= y) }
        if (op == ">") { return cvBool(x > y) }
        if (op == ">=") { return cvBool(x >= y) }
        if (op == "<=>") { return this.refuse(file, atLine, atCol, "`<=>`, whose value is a `Comp`") }
        // The arithmetic below is the arithmetic a run of the program would
        // do, failures included — overflow and division by zero are the
        // engine's own, caught here and reported as what they are at
        // compile time. Doing the checks by hand would be a second
        // implementation of them, and a second one is a chance to differ.
        try {
            if (op == "+") { return cvInt(x + y) }
            if (op == "-") { return cvInt(x - y) }
            if (op == "*") { return cvInt(x * y) }
            if (op == "/") { return cvInt(x / y) }
            if (op == "%") { return cvInt(x % y) }
            if (op == "**") { return cvInt(x ** y) }
            if (op == "^/") { return cvInt(x ^/ y) }
            // No overflow is possible here: these answer 64 bits, and 64
            // bits is what an Int holds. A shift count can still be wrong,
            // and the engine says so through the same `catch`.
            if (op == "band") { return cvInt(x band y) }
            if (op == "bor") { return cvInt(x bor y) }
            if (op == "bxor") { return cvInt(x bxor y) }
            if (op == "shl") { return cvInt(x shl y) }
            if (op == "shr") { return cvInt(x shr y) }
            if (op == "ushr") { return cvInt(x ushr y) }
        } catch (m: String) {
            return this.plain(file, atLine, atCol, m)
        }
        return this.refuse(file, atLine, atCol, "`${op}` between a `Int` and a `Int`")
    }

    package func floatOp(op: String, x: Float, y: Float, file: Int, atLine: Int, atCol: Int): CV? {
        if (op == "+") { return cvFloat(x + y) }
        if (op == "-") { return cvFloat(x - y) }
        if (op == "*") { return cvFloat(x * y) }
        if (op == "/") { return cvFloat(x / y) }
        if (op == "%") { return cvFloat(x % y) }
        if (op == "**") { return cvFloat(x ** y) }
        if (op == "^/") { return cvFloat(x ^/ y) }
        if (isBitOp(op)) {
            return this.refuse(file, atLine, atCol, "a bit operator on a `Float`")
        }
        if (op == "<") { return cvBool(x < y) }
        if (op == "<=") { return cvBool(x <= y) }
        if (op == ">") { return cvBool(x > y) }
        if (op == ">=") { return cvBool(x >= y) }
        if (op == "<=>") { return this.refuse(file, atLine, atCol, "`<=>`, whose value is a `Comp`") }
        return this.refuse(file, atLine, atCol, "`${op}` between a `Float` and a `Float`")
    }

    /// The properties a `constexpr` value answers to — the same ones the
    /// checker types, and no others.
    package func property(v: CV, name: String, file: Int, atLine: Int, atCol: Int): CV? {
        if (v.kind == "Str" and name == "length") {
            var n = 0
            for (c in v.s) { n += 1 }
            return cvInt(n)
        }
        if (v.kind == "List" and name == "size") { return cvInt(v.items.size) }
        if (v.kind == "Map" and name == "size") { return cvInt(v.keys.size) }
        if (v.kind == "List" and name == "isEmpty") { return cvBool(v.items.size == 0) }
        if (v.kind == "Map" and name == "isEmpty") { return cvBool(v.keys.size == 0) }
        if (v.kind == "Str" and name == "isEmpty") { return cvBool(v.s == "") }
        return this.refuse(file, atLine, atCol, "`.${name}` on a `${cvTypeName(v)}`")
    }

    /// The methods a `constexpr` value answers to. The list is short on
    /// purpose: every one of these has to give the same answer as its
    /// run-time twin, and a method nobody has checked against its twin is
    /// better refused than quietly different.
    package func method(v: CV, name: String, args: List<CV>, file: Int, atLine: Int, atCol: Int): CV? {
        if (name == "toString" and args.size == 0) { return cvStr(cvDisplay(v)) }
        if (v.kind == "Str" and args.size == 0) {
            if (name == "toUpper") { return cvStr(v.s.toUpper()) }
            if (name == "toLower") { return cvStr(v.s.toLower()) }
            if (name == "trim") { return cvStr(v.s.trim()) }
        }
        if (v.kind == "Str" and args.size == 1 and args[0].kind == "Str") {
            if (name == "contains") { return cvBool(v.s.contains(args[0].s)) }
            if (name == "startsWith") { return cvBool(v.s.startsWith(args[0].s)) }
            if (name == "endsWith") { return cvBool(v.s.endsWith(args[0].s)) }
        }
        if (v.kind == "Str" and name == "repeat" and args.size == 1 and args[0].kind == "Int") {
            val n = args[0].i
            if (n < 0) { return this.plain(file, atLine, atCol, "`repeat` needs a count of zero or more") }
            // Bounded by the budget, so a `constexpr` cannot ask the
            // compiler for a terabyte of string.
            var width = v.s.length
            if (width < 1) { width = 1 }
            if (n > this.budget / width) { return this.overBudget(file, atLine, atCol) }
            this.budget -= n
            return cvStr(v.s.repeat(n))
        }
        if (v.kind == "List" and name == "join" and args.size == 1 and args[0].kind == "Str") {
            var out = ""
            var i = 0
            while (i < v.items.size) {
                if (i > 0) { out += args[0].s }
                out += cvDisplay(v.items[i])
                i += 1
            }
            return cvStr(out)
        }
        if (v.kind == "List" and name == "contains" and args.size == 1) {
            for (x in v.items) {
                if (cvEq(x, args[0])) { return cvBool(true) }
            }
            return cvBool(false)
        }
        if (v.kind == "Map" and name == "contains" and args.size == 1) {
            for (k in v.keys) {
                if (cvEq(k, args[0])) { return cvBool(true) }
            }
            return cvBool(false)
        }
        if (v.kind == "Map" and name == "keys" and args.size == 0) { return cvList(v.keys) }
        if (v.kind == "Map" and name == "values" and args.size == 0) { return cvList(v.vals) }
        return this.refuse(file, atLine, atCol, "`.${name}(...)` on a `${cvTypeName(v)}`")
    }

    package func ifValue(e: Ex): CV? {
        val c = this.truth(e.kids[0])
        if (c == null) { return null }
        if (c) { return this.blockValue(e.body!!, e.file, e.line, e.col) }
        val chain = e.elseif
        if (chain != null) { return this.eval(chain) }
        val els = e.els
        if (els != null) { return this.blockValue(els, e.file, e.line, e.col) }
        return cvUnit()
    }

    /// Whether one `when` arm takes this subject. Null means the fold has
    /// already failed and the caller stops.
    package func armMatches(arm: ArmN, subj: CV?, file: Int, atLine: Int, atCol: Int): Bool? {
        if (arm.patternKind == "else") { return true }
        unless (arm.patternKind == "values") {
            this.refuse(file, atLine, atCol, "this kind of `when` arm")
            return null
        }
        for (v in arm.values) {
            if (subj == null) {
                val t = this.truth(v)
                if (t == null) { return null }
                if (t) { return true }
            } else {
                val got = this.eval(v)
                if (got == null) { return null }
                if (cvEq(got, subj)) { return true }
            }
        }
        return false
    }

    package func whenValue(e: Ex): CV? {
        var subj: CV? = null
        val s = e.subject
        if (s != null) {
            subj = this.eval(s)
            if (subj == null) { return null }
        }
        for (arm in e.arms) {
            val hit = this.armMatches(arm, subj, e.file, e.line, e.col)
            if (hit == null) { return null }
            unless (hit) { continue }
            val g = arm.guard
            if (g != null) {
                val ok = this.truth(g)
                if (ok == null) { return null }
                unless (ok) { continue }
            }
            return this.blockValue(arm.body, e.file, e.line, e.col)
        }
        return this.plain(e.file, e.line, e.col, "no arm of this `when` matched at compile time")
    }

    /// A block used for its value: its statements run, and the last
    /// expression is what it is worth.
    package func blockValue(b: BlockN, file: Int, atLine: Int, atCol: Int): CV? {
        this.scopes.add([])
        val out = this.blockValueInner(b, file, atLine, atCol)
        this.scopes.removeAt(this.scopes.size - 1)
        return out
    }

    package func blockValueInner(b: BlockN, file: Int, atLine: Int, atCol: Int): CV? {
        var last = cvUnit()
        var i = 0
        while (i < b.stmts.size) {
            val s = b.stmts[i]
            if (i + 1 == b.stmts.size and s.kind == "expr") {
                val v = this.eval(s.ex!!)
                if (v == null) { return null }
                return v
            }
            val flow = this.stmt(s)
            if (flow == null) { return null }
            // A block used for its value is inside an expression; a jump out
            // of one is not something a fold can represent.
            unless (flow.kind == "normal") {
                return this.refuse(file, atLine, atCol, "a jump out of an expression")
            }
            i += 1
        }
        return last
    }

    package func call(name: String, args: List<CV>, file: Int, atLine: Int, atCol: Int): CV? {
        unless (this.funs.contains(name)) {
            this.report(
                file, atLine, atCol,
                "`${name}` is not a `constexpr func`",
                "a `constexpr` can only call a function declared `constexpr`, because only those are held to what runs at compile time"
            )
            return null
        }
        val decl = this.funs[name]!!
        unless (args.size == decl.params.size) {
            return this.plain(
                file, atLine, atCol,
                "`${name}` takes ${decl.params.size} argument(s), given ${args.size}"
            )
        }
        // A depth limit as well as a step budget: recursion that never
        // bottoms out would eat the compiler's own stack before it ever
        // reached the budget.
        this.depth += 1
        if (this.depth > 256) {
            this.depth -= 1
            this.report(
                file, atLine, atCol,
                "`${name}` recursed too deep at compile time",
                "a `constexpr` gets 256 frames; past that it is a loop that does not end"
            )
            return null
        }
        var frame: List<CBind> = []
        var i = 0
        while (i < decl.params.size) {
            frame.add(CBind(decl.params[i].name, args[i]))
            i += 1
        }
        this.frames.add(this.scopes.size)
        this.scopes.add(frame)
        val out = this.body(decl.body, file, atLine, atCol)
        this.scopes.removeAt(this.scopes.size - 1)
        this.frames.removeAt(this.frames.size - 1)
        this.depth -= 1
        return out
    }

    /// A `constexpr func`'s body: statements until one returns.
    package func body(b: BlockN, file: Int, atLine: Int, atCol: Int): CV? {
        for (s in b.stmts) {
            val flow = this.stmt(s)
            if (flow == null) { return null }
            if (flow.kind == "return") { return flow.value!! }
            unless (flow.kind == "normal") {
                return this.refuse(file, atLine, atCol, "`break` or `continue` outside a loop")
            }
        }
        return cvUnit()
    }

    package func stmts(b: BlockN): CFlow? {
        this.scopes.add([])
        val out = this.stmtsInner(b)
        this.scopes.removeAt(this.scopes.size - 1)
        return out
    }

    package func stmtsInner(b: BlockN): CFlow? {
        for (s in b.stmts) {
            val flow = this.stmt(s)
            if (flow == null) { return null }
            unless (flow.kind == "normal") { return flow }
        }
        return CFlow("normal")
    }

    package func returning(v: CV): CFlow {
        val f = CFlow("return")
        f.value = v
        return f
    }

    package func stmt(s: StmtN): CFlow? {
        unless (this.step(s.file, s.line, s.col)) { return null }
        val k = s.kind
        if (k == "let") {
            val v = this.eval(s.init!!)
            if (v == null) { return null }
            this.bind(s.name, v)
            return CFlow("normal")
        }
        if (k == "expr") { return this.exprStmt(s) }
        if (k == "return") {
            val e = s.ex
            if (e == null) { return this.returning(cvUnit()) }
            val v = this.eval(e)
            if (v == null) { return null }
            return this.returning(v)
        }
        if (k == "while") {
            while (true) {
                val c = this.truth(s.ex!!)
                if (c == null) { return null }
                unless (c) { break }
                unless (this.step(s.file, s.line, s.col)) { return null }
                val flow = this.stmts(s.body!!)
                if (flow == null) { return null }
                if (flow.kind == "break") { break }
                if (flow.kind == "return") { return flow }
            }
            return CFlow("normal")
        }
        if (k == "for") { return this.forLoop(s) }
        if (k == "break") { return CFlow("break") }
        if (k == "continue") { return CFlow("continue") }
        this.refuse(s.file, s.line, s.col, "this kind of statement")
        return null
    }

    package func exprStmt(s: StmtN): CFlow? {
        val e = s.ex!!
        // An `if` written as a statement is still an `if` node, and a
        // `return` inside it has to leave the function rather than be an
        // expression's value.
        if (e.kind == "if") {
            val c = this.truth(e.kids[0])
            if (c == null) { return null }
            if (c) { return this.stmts(e.body!!) }
            val chain = e.elseif
            if (chain != null) {
                val inner = StmtN("expr", s.line, s.col)
                inner.file = s.file
                inner.ex = chain
                return this.stmt(inner)
            }
            val els = e.els
            if (els != null) { return this.stmts(els) }
            return CFlow("normal")
        }
        if (e.kind == "when") {
            var subj: CV? = null
            val sub = e.subject
            if (sub != null) {
                subj = this.eval(sub)
                if (subj == null) { return null }
            }
            for (arm in e.arms) {
                val hit = this.armMatches(arm, subj, e.file, e.line, e.col)
                if (hit == null) { return null }
                unless (hit) { continue }
                val g = arm.guard
                if (g != null) {
                    val ok = this.truth(g)
                    if (ok == null) { return null }
                    unless (ok) { continue }
                }
                return this.stmts(arm.body)
            }
            return CFlow("normal")
        }
        if (e.kind == "assign") {
            val target = e.kids[0]
            if (target.kind == "index") {
                unless (e.assignOp == "=") {
                    this.refuse(e.file, e.line, e.col, "a compound assignment into a container")
                    return null
                }
                unless (target.kids[0].kind == "ident") {
                    this.refuse(e.file, e.line, e.col, "assigning into a container no name holds")
                    return null
                }
                val key = this.eval(target.kids[1])
                if (key == null) { return null }
                val v = this.eval(e.kids[1])
                if (v == null) { return null }
                val done = this.setAt(target.kids[0].text, key, v, e.file, e.line, e.col)
                if (done == null) { return null }
                return CFlow("normal")
            }
            unless (target.kind == "ident") {
                this.refuse(e.file, e.line, e.col, "assigning to anything but a name")
                return null
            }
            var v: CV? = null
            if (e.assignOp == "=") {
                v = this.eval(e.kids[1])
            } else {
                val cur = this.lookup(target.text)
                if (cur == null) {
                    this.plain(target.file, target.line, target.col, "`${target.text}` is not a `constexpr`")
                    return null
                }
                val rhs = this.eval(e.kids[1])
                if (rhs == null) { return null }
                v = this.binary(e.assignOp, cur, rhs, e.file, e.line, e.col)
            }
            val value = v
            if (value == null) { return null }
            unless (this.assign(target.text, value)) {
                this.plain(target.file, target.line, target.col, "`${target.text}` is not a `constexpr`")
                return null
            }
            return CFlow("normal")
        }
        val v = this.eval(e)
        if (v == null) { return null }
        return CFlow("normal")
    }

    package func forLoop(s: StmtN): CFlow? {
        val iter = s.ex!!
        var items: List<CV> = []
        if (iter.kind == "range") {
            // A range is not a value a `constexpr` can hold, but it is the
            // ordinary way to write a bounded loop, so a `for` over one is
            // walked directly.
            val a = this.eval(iter.kids[0])
            if (a == null) { return null }
            val b = this.eval(iter.kids[1])
            if (b == null) { return null }
            unless (a.kind == "Int" and b.kind == "Int") {
                this.refuse(iter.file, iter.line, iter.col, "a range that is not of `Int`")
                return null
            }
            if (b.i > a.i and b.i - a.i > this.budget) {
                this.overBudget(s.file, s.line, s.col)
                return null
            }
            var n = a.i
            while (n < b.i) {
                items.add(cvInt(n))
                n += 1
            }
        } else {
            val subject = this.eval(iter)
            if (subject == null) { return null }
            if (subject.kind == "List") {
                items = subject.items
            } else if (subject.kind == "Str") {
                for (c in subject.s) { items.add(cvStr(c)) }
            } else {
                this.refuse(iter.file, iter.line, iter.col, "iterating a `${cvTypeName(subject)}`")
                return null
            }
        }
        for (item in items) {
            unless (this.step(s.file, s.line, s.col)) { return null }
            this.scopes.add([CBind(s.name, item)])
            val flow = this.stmtsInner(s.body!!)
            this.scopes.removeAt(this.scopes.size - 1)
            if (flow == null) { return null }
            if (flow.kind == "break") { break }
            if (flow.kind == "return") { return flow }
        }
        return CFlow("normal")
    }
}
