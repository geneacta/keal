// The C emitter, in Keal — the twin of src/cbackend.rs, and the fourth
// plank of self-hosting: a native compiler written in the language it
// compiles.
//
// It emits C from the tree the self-hosted checker typed, and the suite
// holds its output to byte-for-byte agreement with `keal cgen` — generated
// code, refusal diagnostics and exit codes alike. Anything the backend
// cannot compile is refused by name, never mis-compiled.
//
//     keal selfhost/cbackend.keal path/to/file.keal

import "./checking.keal"
import "./runtimesrc.keal"

/// The stand-in for one element inside a rendering template, spelled so
/// that it can never be part of a C identifier.
package val SHOW_HOLE = "@elem@"

// ---- names and small helpers --------------------------------------------

/// Prefixes every Keal name, so none can collide with C's own.
func mangle(name: String): String { "k_" + flatten(name) }

/// A Keal name as C can spell it. Only one character needs the treatment:
/// the `#` the checker mints when two files declare the same name, which is
/// unwritable in Keal and illegal in C.
func flatten(name: String): String {
    unless (name.contains("#")) { return name }
    var out = ""
    var i = 0
    while (i < name.length) {
        val c = name.get(i)
        if (c == "#") { out += "_dup" } else { out += c }
        i += 1
    }
    return out
}

/// A method's part of the function name it becomes.
func mangleMethod(name: String): String { "m_" + flatten(name) }

/// Whether the class declares the hook the runtime calls at death.
/// Whether this class declares that field `weak`. The declaration is the
/// single source of truth — the same one the interpreters read.
func classFieldIsWeak(c: ClassN, name: String): Bool {
    for (p in c.ctor) {
        if (p.fieldKind != "" and p.name == name and p.weak) { return true }
    }
    for (f in c.fields) {
        if (f.name == name and f.weak) { return true }
    }
    return false
}

func classHasDeinit(c: ClassN): Bool {
    for (m in c.methods) {
        if (m.name == "deinit") { return true }
    }
    return false
}

/// The C struct a class is emitted as.
func structName(class_: String): String { "K_" + flatten(class_) }

/// The `Keal_Name` mirror struct's exact text — the by-value contract a
/// record shares with C across an extern boundary.
func mirrorStructC(name: String, fields: List<SField>): String {
    var out = "#ifndef KEAL_MIRROR_${name}\n#define KEAL_MIRROR_${name}\ntypedef struct Keal_${name} {\n"
    for (f in fields) {
        val ct = when (f.ty.kind) {
            "Int" -> "int64_t"
            "Float" -> "double"
            "Bool" -> "bool"
            else -> ""
        }
        unless (ct == "") {
            out += "    ${ct} ${f.name};\n"
        }
    }
    out += "} Keal_${name};\n#endif\n"
    return out
}

/// A type as a C identifier fragment, for specialisation names.
func mangleType(t: Ty): String {
    return when (t.kind) {
        "Int" -> "Int"
        "Enum" -> flatten(t.name)
        "Float" -> "Float"
        "Bool" -> "Bool"
        "Str" -> "String"
        "Unit" -> "Unit"
        "Range" -> "Range"
        "Class" -> {
            if (t.args.size == 0) {
                t.name
            } else {
                var parts = ""
                var first = true
                for (a in t.args) {
                    unless (first) { parts += "_" }
                    parts += mangleType(a)
                    first = false
                }
                "${t.name}_${parts}"
            }
        }
        "List" -> "List_" + mangleType(t.args[0])
        "Map" -> "Map_${mangleType(t.args[0])}_${mangleType(t.args[1])}"
        "Nullable" -> "Opt_" + mangleType(t.args[0])
        "Fun" -> {
            var parts = ""
            var first = true
            for (p in t.params) {
                unless (first) { parts += "_" }
                parts += mangleType(p.ty)
                first = false
            }
            unless (first) { parts += "_" }
            parts += mangleType(t.ret!!)
            "Fn_" + parts
        }
        "Any" -> "Any"
        else -> "Unrepresentable"
    }
}

func structNameOf(class_: String, args: List<Ty>): String {
    if (args.size == 0) { return structName(class_) }
    var parts = ""
    var first = true
    for (a in args) {
        unless (first) { parts += "__" }
        parts += mangleType(a)
        first = false
    }
    return "K_${flatten(class_)}__${parts}"
}

/// What a written type is called, for a message about it. Unlike the
/// checker's version, a function type reads as just "a function" here.
func cTypeExName(te: TypeEx): String {
    return when (te.kind) {
        "named" -> te.name
        "nullable" -> cTypeExName(te.inner!!) + "?"
        "boundary" -> cTypeExName(te.inner!!)
        else -> "a function"
    }
}

func applyLogicalC(op: String, a: String, b: String): String {
    return when (op) {
        "and" -> "(${a} && ${b})"
        "or" -> "(${a} || ${b})"
        "xor" -> "(${a} != ${b})"
        "xnor" -> "(${a} == ${b})"
        "nand" -> "(!(${a} && ${b}))"
        "nor" -> "(!(${a} || ${b}))"
        else -> "((!${a}) || ${b})"
    }
}

/// When the left operand alone settles a connective, the result it forces.
/// Absent (null) for the pairs that always read the right operand.
func shortCircuitC(op: String, left: Bool): Bool? {
    if (op == "and" and not left) { return false }
    if (op == "or" and left) { return true }
    if (op == "nand" and not left) { return true }
    if (op == "nor" and left) { return false }
    if (op == "implies" and not left) { return true }
    return null
}

/// A double C will read back as exactly this value — and exactly the string
/// the oracle prints, since the oracle's two branches match Keal's own float
/// rendering.
func formatDouble(f: Float): String { "${f}" }

func utf8Bytes(cp: Int): List<Int> {
    if (cp < 128) { return [cp] }
    if (cp < 2048) {
        return [192 + cp / 64, 128 + cp % 64]
    }
    if (cp < 65536) {
        return [224 + cp / 4096, 128 + (cp / 64) % 64, 128 + cp % 64]
    }
    return [240 + cp / 262144, 128 + (cp / 4096) % 64, 128 + (cp / 64) % 64, 128 + cp % 64]
}

func hex2(b: Int): String {
    val digits = "0123456789abcdef"
    return digits[b / 16] + digits[b % 16]
}

func byteLen(s: String): Int {
    var n = 0
    for (c in s) { n += byteWidth(c) }
    return n
}

func cString(s: String): String {
    var out = "\""
    for (c in s) {
        for (b in utf8Bytes(c.code())) {
            if (b == 34) {
                out += "\\\""
            } else if (b == 92) {
                out += "\\\\"
            } else if (b == 10) {
                out += "\\n"
            } else if (b == 9) {
                out += "\\t"
            } else if (b == 13) {
                out += "\\r"
            } else if (b >= 32 and b <= 126) {
                out += b.toChar()
            } else {
                out += "\\x${hex2(b)}\"\""
            }
        }
    }
    out += "\""
    return out
}

/// True for an `Int` operator the runtime performs rather than C: the
/// arithmetic, because it is checked, and the shifts, because of the shift
/// count and because C leaves `<<` past the sign bit and `>>` on a negative
/// value to the implementation.
func isCheckedIntOp(op: String): Bool {
    return when (op) {
        "+", "-", "*", "/", "%", "**", "^/", "shl", "shr", "ushr" -> true
        else -> false
    }
}

/// Drops the parentheses that wrap a whole C expression, as many pairs as
/// wrap it. A string holding a `"` is left alone: the scan counts brackets
/// and a literal may hold one that closes nothing.
func stripOuterParens(s: String): String {
    if (s.contains("\"")) { return s }
    var cur = s
    while (true) {
        val cs = cur.chars()
        if (cs.size < 2 or cs[0] != "(" or cs[cs.size - 1] != ")") { break }
        var depth = 0
        var wraps = true
        var i = 0
        while (i < cs.size) {
            if (cs[i] == "(") {
                depth += 1
            } else {
                if (cs[i] == ")") {
                    depth -= 1
                    if (depth == 0 and i + 1 != cs.size) {
                        wraps = false
                        break
                    }
                }
            }
            i += 1
        }
        if (not wraps) { break }
        cur = cur.substring(1, cur.length - 1)
    }
    return cur
}

/// A one-line, comment-safe rendering, for the literal table.
func cComment(s: String): String {
    var flat = ""
    for (c in s) {
        val cp = c.code()
        val control = cp < 32 or (cp >= 127 and cp <= 159)
        if (control) { flat += " " } else { flat += c }
    }
    // Both halves of the delimiter, not just the closing one: a nested `/*`
    // is not an error but a warning every C compiler emits, and a file that
    // warns is a file whose real warnings are read past.
    flat = flat.replace("*/", "* /").replace("/*", "/ *")
    if (flat.length > 40) {
        return flat.take(40) + "…"
    }
    return flat
}

// ---- type predicates ----------------------------------------------------

/// True for a type whose values hold a reference that must be released.
func countedC(t: Ty): Bool {
    return when (t.kind) {
        "Str", "Class", "List", "Map", "Fun" -> true
        // Whether an `Any` counts depends on its tag; the calls decide.
        "Any" -> true
        "Nullable" -> countedC(t.args[0])
        else -> false
    }
}

/// The function that takes a reference to a value of this type.
func retainFn(t: Ty): String? {
    return when (t.kind) {
        "Str" -> "keal_str_retain"
        "Class" -> structNameOf(t.name, t.args) + "_retain"
        "List" -> "keal_list_retain"
        "Fun" -> "keal_fn_retain"
        "Map" -> "keal_map_retain"
        "Any" -> "keal_any_retain"
        "Nullable" -> retainFn(t.args[0])
        else -> null
    }
}

/// The function that gives one back.
func releaseFn(t: Ty): String? {
    return when (t.kind) {
        "Str" -> "keal_str_release"
        "Class" -> structNameOf(t.name, t.args) + "_release"
        "List" -> "keal_list_release"
        "Fun" -> "keal_fn_release"
        "Map" -> "keal_map_release"
        "Any" -> "keal_any_release"
        "Nullable" -> releaseFn(t.args[0])
        else -> null
    }
}

/// The walk that follows the same edges `releaseFn` releases. One name per
/// shape, and the same name the runtime gives its own, so a container's
/// element thunk pairs with its mark by construction. `Any` has none: it
/// travels by value, so the call site names it.
func markFn(t: Ty): String? {
    return when (t.kind) {
        "Str" -> "keal_str_mark"
        "Class" -> structNameOf(t.name, t.args) + "_mark"
        "List" -> "keal_list_mark"
        "Fun" -> "keal_fn_mark"
        "Map" -> "keal_map_mark"
        "Nullable" -> markFn(t.args[0])
        else -> null
    }
}

/// One field's contribution to a walk: `Any` by value, everything else by
/// the pointer its type's mark takes.
func markLine(t: Ty, expr: String): String? {
    if (t.kind == "Any") { return "keal_any_mark(${expr});" }
    val f = markFn(t)
    if (f == null) { return null }
    return "${f}(${expr});"
}

/// Wraps an expression in a retain, where the type needs one.
func retained(t: Ty, expr: String): String {
    val f = retainFn(t)
    if (f == null) { return expr }
    return "${f}(${expr})"
}

/// True when `T?` needs the tagged form rather than a pointer.
func isValueOpt(t: Ty): Bool {
    unless (t.kind == "Nullable") { return false }
    val inner = t.args[0].kind
    return inner == "Int" or inner == "Float" or inner == "Bool" or inner == "Enum"
}

/// True for a type held behind a pointer, which has null to spare.
func isReference(t: Ty): Bool {
    return when (t.kind) {
        "Str", "Class", "List", "Map", "Fun" -> true
        else -> false
    }
}

// The nullable-value helpers: how `Int?`, `Float?` and `Bool?` are built,
// tested and unwrapped.

func optWrap(inner: Ty, v: String): String {
    return when (inner.kind) {
        "Int", "Enum" -> "(KealOptI64){ true, ${v} }"
        "Float" -> "(KealOptF64){ true, ${v} }"
        "Bool" -> "(int8_t)((${v}) ? 1 : 0)"
        else -> v
    }
}

func optNull(inner: Ty): String {
    return when (inner.kind) {
        "Int", "Enum" -> "(KealOptI64){ false, 0 }"
        "Float" -> "(KealOptF64){ false, 0.0 }"
        "Bool" -> "(int8_t)2"
        else -> "NULL"
    }
}

// A tail here assumes a pointer, so every scalar has to be named — an enum
// that fell through would compile to a NULL test on an ordinal, and compile
// silently.
func optHas(inner: Ty, x: String): String {
    return when (inner.kind) {
        "Int", "Float", "Enum" -> "${x}.has"
        "Bool" -> "(${x} != 2)"
        else -> "(${x} != NULL)"
    }
}

func optGet(inner: Ty, x: String): String {
    return when (inner.kind) {
        "Int", "Float", "Enum" -> "${x}.v"
        "Bool" -> "(bool)(${x} == 1)"
        else -> x
    }
}

/// Names a construct the backend cannot compile.
func describeExprC(e: Ex): String {
    return when (e.kind) {
        "list" -> "list literals"
        "map" -> "map literals"
        "lambda" -> "lambdas"
        "index" -> "indexing"
        "elvis" -> "`?:`"
        "notnull" -> "`!!`"
        "is" -> "`is` tests"
        "range" -> "a range used as a value"
        "null" -> "`null`"
        else -> "this expression"
    }
}

// ---- the free-name analysis ---------------------------------------------
//
// Every name any lambda inside a frame mentions without binding it — the set
// of variables that must live in cells if they are mutable.

proc lambdaFreesInStmt(s: StmtN, var out: Map<String, Bool>) {
    if (s.kind == "let" or s.kind == "destructure") {
        lambdaFreesInExpr(s.init!!, out)
        return
    }
    if (s.kind == "expr") {
        lambdaFreesInExpr(s.ex!!, out)
        return
    }
    if (s.kind == "return") {
        val e = s.ex
        if (e != null) { lambdaFreesInExpr(e, out) }
        return
    }
    if (s.kind == "break" or s.kind == "continue") { return }
    if (s.kind == "throw") {
        lambdaFreesInExpr(s.ex!!, out)
        return
    }
    if (s.kind == "try") {
        for (st in s.body!!.stmts) { lambdaFreesInStmt(st, out) }
        for (c in s.catches) {
            for (st in c.handler.stmts) { lambdaFreesInStmt(st, out) }
        }
        return
    }
    if (s.kind == "while") {
        lambdaFreesInExpr(s.ex!!, out)
        for (st in s.body!!.stmts) { lambdaFreesInStmt(st, out) }
        return
    }
    if (s.kind == "for") {
        lambdaFreesInExpr(s.ex!!, out)
        for (st in s.body!!.stmts) { lambdaFreesInStmt(st, out) }
        return
    }
    if (s.kind == "func") {
        for (st in s.funDecl!!.body.stmts) { lambdaFreesInStmt(st, out) }
    }
}

proc lambdaFreesInExpr(e: Ex, var out: Map<String, Bool>) {
    if (e.kind == "lambda") {
        val bound: List<String> = []
        for (p in e.params) { bound.add(p.name) }
        val free: List<String> = []
        collectFree(e.body!!.stmts, bound, free)
        for (n in free) { out[n] = true }
        return
    }
    if (e.kind == "interp") {
        for (part in e.parts) {
            val inner = part.ex
            if (inner != null) { lambdaFreesInExpr(inner, out) }
        }
        return
    }
    if (e.kind == "unary" or e.kind == "notnull") {
        lambdaFreesInExpr(e.kids[0], out)
        return
    }
    if (e.kind == "binary" or e.kind == "logical" or e.kind == "elvis" or e.kind == "range" or e.kind == "index") {
        lambdaFreesInExpr(e.kids[0], out)
        lambdaFreesInExpr(e.kids[1], out)
        return
    }
    if (e.kind == "is") {
        lambdaFreesInExpr(e.kids[0], out)
        return
    }
    if (e.kind == "list") {
        for (i in e.kids) { lambdaFreesInExpr(i, out) }
        return
    }
    if (e.kind == "map") {
        var i = 0
        while (i < e.keys.size) {
            lambdaFreesInExpr(e.keys[i], out)
            lambdaFreesInExpr(e.values[i], out)
            i += 1
        }
        return
    }
    if (e.kind == "ternary") {
        for (k in e.kids) { lambdaFreesInExpr(k, out) }
        return
    }
    if (e.kind == "if") {
        lambdaFreesInExpr(e.kids[0], out)
        for (st in e.body!!.stmts) { lambdaFreesInStmt(st, out) }
        val els = e.els
        if (els != null) {
            for (st in els.stmts) { lambdaFreesInStmt(st, out) }
        }
        val elseif = e.elseif
        if (elseif != null) { lambdaFreesInExpr(elseif, out) }
        return
    }
    if (e.kind == "when") {
        val sub = e.subject
        if (sub != null) { lambdaFreesInExpr(sub, out) }
        for (arm in e.arms) {
            if (arm.patternKind == "values" or arm.patternKind == "in") {
                for (v in arm.values) { lambdaFreesInExpr(v, out) }
            }
            val g = arm.guard
            if (g != null) { lambdaFreesInExpr(g, out) }
            for (st in arm.body.stmts) { lambdaFreesInStmt(st, out) }
        }
        return
    }
    if (e.kind == "field") {
        lambdaFreesInExpr(e.kids[0], out)
        return
    }
    if (e.kind == "method") {
        lambdaFreesInExpr(e.kids[0], out)
        for (a in e.args) { lambdaFreesInExpr(a.value, out) }
        return
    }
    if (e.kind == "call") {
        lambdaFreesInExpr(e.kids[0], out)
        for (a in e.args) { lambdaFreesInExpr(a.value, out) }
        return
    }
    if (e.kind == "assign") {
        lambdaFreesInExpr(e.kids[0], out)
        lambdaFreesInExpr(e.kids[1], out)
    }
}

func lambdaFreeNames(stmts: List<StmtN>): Map<String, Bool> {
    val out: Map<String, Bool> = {}
    for (s in stmts) { lambdaFreesInStmt(s, out) }
    return out
}

/// Collects the names a lambda body mentions that it did not bind itself, in
/// first-mention order. Scoping is approximated by never removing a binding,
/// which can only shrink the free set.
proc collectFree(stmts: List<StmtN>, var bound: List<String>, var free: List<String>) {
    for (s in stmts) {
        if (s.kind == "let") {
            collectFreeExpr(s.init!!, bound, free)
            bound.add(s.name)
        } else if (s.kind == "destructure") {
            collectFreeExpr(s.init!!, bound, free)
            for (b in s.pattern!!.binds) {
                unless (b == "_") { bound.add(b) }
            }
        } else if (s.kind == "expr") {
            collectFreeExpr(s.ex!!, bound, free)
        } else if (s.kind == "return") {
            val e = s.ex
            if (e != null) { collectFreeExpr(e, bound, free) }
        } else if (s.kind == "throw") {
            collectFreeExpr(s.ex!!, bound, free)
        } else if (s.kind == "try") {
            collectFree(s.body!!.stmts, bound, free)
            for (c in s.catches) {
                bound.add(c.name)
                collectFree(c.handler.stmts, bound, free)
            }
        } else if (s.kind == "while") {
            collectFreeExpr(s.ex!!, bound, free)
            collectFree(s.body!!.stmts, bound, free)
        } else if (s.kind == "for") {
            collectFreeExpr(s.ex!!, bound, free)
            bound.add(s.name)
            collectFree(s.body!!.stmts, bound, free)
        } else if (s.kind == "func") {
            val f = s.funDecl!!
            bound.add(f.name)
            val inner: List<String> = []
            for (p in f.params) { inner.add(p.name) }
            inner.addAll(bound)
            collectFree(f.body.stmts, inner, free)
        }
    }
}

proc collectFreeExpr(e: Ex, var bound: List<String>, var free: List<String>) {
    if (e.kind == "ident") {
        if (not bound.contains(e.text) and not free.contains(e.text)) {
            free.add(e.text)
        }
        return
    }
    if (e.kind == "lambda") {
        val inner: List<String> = []
        for (p in e.params) { inner.add(p.name) }
        inner.addAll(bound)
        collectFree(e.body!!.stmts, inner, free)
        return
    }
    if (e.kind == "interp") {
        for (part in e.parts) {
            val ex = part.ex
            if (ex != null) { collectFreeExpr(ex, bound, free) }
        }
        return
    }
    if (e.kind == "unary" or e.kind == "notnull" or e.kind == "is") {
        collectFreeExpr(e.kids[0], bound, free)
        return
    }
    if (e.kind == "binary" or e.kind == "logical" or e.kind == "elvis" or e.kind == "range" or e.kind == "index") {
        collectFreeExpr(e.kids[0], bound, free)
        collectFreeExpr(e.kids[1], bound, free)
        return
    }
    if (e.kind == "list") {
        for (i in e.kids) { collectFreeExpr(i, bound, free) }
        return
    }
    if (e.kind == "map") {
        var i = 0
        while (i < e.keys.size) {
            collectFreeExpr(e.keys[i], bound, free)
            collectFreeExpr(e.values[i], bound, free)
            i += 1
        }
        return
    }
    if (e.kind == "ternary") {
        for (k in e.kids) { collectFreeExpr(k, bound, free) }
        return
    }
    if (e.kind == "if") {
        collectFreeExpr(e.kids[0], bound, free)
        collectFree(e.body!!.stmts, bound, free)
        val els = e.els
        if (els != null) { collectFree(els.stmts, bound, free) }
        val elseif = e.elseif
        if (elseif != null) { collectFreeExpr(elseif, bound, free) }
        return
    }
    if (e.kind == "when") {
        val sub = e.subject
        if (sub != null) { collectFreeExpr(sub, bound, free) }
        for (arm in e.arms) {
            if (arm.patternKind == "values" or arm.patternKind == "in") {
                for (v in arm.values) { collectFreeExpr(v, bound, free) }
            }
            if (arm.patternKind == "is") {
                val d = arm.binds
                if (d != null) {
                    for (b in d.binds) {
                        unless (b == "_") { bound.add(b) }
                    }
                }
            }
            val g = arm.guard
            if (g != null) { collectFreeExpr(g, bound, free) }
            collectFree(arm.body.stmts, bound, free)
        }
        return
    }
    if (e.kind == "field") {
        collectFreeExpr(e.kids[0], bound, free)
        return
    }
    if (e.kind == "method") {
        collectFreeExpr(e.kids[0], bound, free)
        for (a in e.args) { collectFreeExpr(a.value, bound, free) }
        return
    }
    if (e.kind == "call") {
        collectFreeExpr(e.kids[0], bound, free)
        for (a in e.args) { collectFreeExpr(a.value, bound, free) }
        return
    }
    if (e.kind == "assign") {
        collectFreeExpr(e.kids[0], bound, free)
        collectFreeExpr(e.kids[1], bound, free)
    }
}

// ---- small state records ------------------------------------------------

/// How a list element is stored in a `KealWord`: kind is "int", "bool",
/// "float" or "ptr" (with the C type pointed at and the retain prefix).
class CElem(val kind: String, val ctype: String, val prefix: String)

func elemWord(e: CElem, v: String): String {
    return when (e.kind) {
        "int" -> "(KealWord){ .i = ${v} }"
        "bool" -> "(KealWord){ .i = (int64_t)(${v}) }"
        "float" -> "(KealWord){ .d = ${v} }"
        "any" -> "(KealWord){ .p = keal_any_box(${v}) }"
        else -> "(KealWord){ .p = (${e.ctype}*)${v} }"
    }
}

func elemUnword(e: CElem, w: String): String {
    return when (e.kind) {
        "int" -> "${w}.i"
        "bool" -> "(bool)${w}.i"
        "float" -> "${w}.d"
        "any" -> "(((KealAnyBox*)${w}.p)->a)"
        else -> "((${e.ctype}*)${w}.p)"
    }
}

func keyEqFn(e: CElem): String {
    if (e.kind == "ptr") { return "keal_key_eq_str" }
    return "keal_key_eq_word"
}

/// A local the current block owns a reference to.
class OwnedC(val name: String, val release: String)

class UnwindTarget(val label: String) {
    var referenced: Bool = false
}

class UnwindMark(val at: Int, val pad: String) {
    var hoisted: List<String> = []
    var everOwned: List<OwnedC> = []
}

class LocalC(val name: String, val ty: Ty, val mutable: Bool)

class SField(val name: String, val ty: Ty)

class CellInfo(val ty: Ty, val elem: CElem)

class CapInfo(val field: String, val ty: Ty)

/// A lambda capture: its name, type, and whether it is taken as a cell.
class Capture(val name: String, val ty: Ty, val isCell: Bool)

func mapCopyTy(m: Map<String, Ty>): Map<String, Ty> {
    val out: Map<String, Ty> = {}
    for (k in m.keys()) { out[k] = m[k]!! }
    return out
}

// ---- the backend --------------------------------------------------------

class CBackend() {
    var decls: String = ""
    var defs: String = ""
    var body: List<String> = []
    var indent: Int = 1
    var nextTemp: Int = 0
    var scopes: List<List<OwnedC>> = []
    // Whether the program contains a `try` anywhere. Only then do the
    // unwind checks, labels and hoisted declarations below exist —
    // a program without one compiles byte-for-byte as before.
    var catchMode: Bool = false
    // Whether any class in the program declares `proc deinit()` — only
    // then are the per-statement drains and the pending queue emitted.
    var dropMode: Bool = false
    // Whether the user program touches the actor machinery — only then
    // do lambdas carry generated capture-copy functions.
    var actorsMode: Bool = false
    // Innermost last: the label a failed `keal_unwinding` check jumps to.
    var unwindTargets: List<UnwindTarget> = []
    // One entry per open scope: where hoisted declarations insert, plus
    // everything the scope ever owned — `disown` at a `return` must not
    // thin the unwind list.
    var unwindMarks: List<UnwindMark> = []
    var nextUnwind: Int = 0
    // The `return` the function's bottom label ends with.
    var poison: String = ""
    var loops: List<Int> = []
    var stringLiterals: List<String> = []
    var typesOut: String = ""
    var helpers: String = ""
    var thunks: Map<String, Bool> = {}
    // Deep-copy functions already generated, by name — memoized before
    // their bodies are written, so recursive types close the loop.
    var copyFns: Map<String, Bool> = {}
    var listShows: Map<String, String> = {}
    var pendingStructs: List<String> = []
    var shapes: Map<String, List<SField>> = {}
    var genericClasses: List<String> = []
    var thisName: String = ""
    var locals: List<List<LocalC>> = []
    var globalFuns: Map<String, Bool> = {}
    var globalVars: Map<String, Bool> = {}
    /// The top-level bindings whose declared type is `Any` — an `is` can
    /// narrow one inside any function, and the reader must still unwrap.
    var anyGlobals: Map<String, Bool> = {}
    var globalDecls: String = ""
    var atTopLevel: Bool = false
    /// True when the program declares a `weak` field: objects then carry a
    /// second count, and a weak field is stored, read, released and shown
    /// through the weak entry points. Off, every class keeps one count and
    /// the emitted C is what it always was.
    var weakMode: Bool = false
    /// `keal build --audit`: every class counts its live objects by name,
    /// and the program says at exit what it left behind. Off, none of the
    /// counting is emitted and no object pays for it.
    /// Every enum the program declares, and its variants in order — the
    /// names table a `${suit}` needs, and the list `values()` builds.
    var enumNamesOf: Map<String, List<String>> = {}
    package var auditMode: Bool = false
    /// Release-to-walk pairs the audit registers before its mark phase,
    /// and the top-level bindings that phase starts from.
    var auditPairs: List<List<String>> = []
    var auditRootNames: List<String> = []
    var auditRootTypes: List<Ty> = []
    /// Set just before a statement's expression is emitted: its value is
    /// discarded, so a branch join of `Any` — which the checker only ever
    /// produces where using the value would be refused — needs no slot.
    /// The branch emitters clear it, so nested expressions never see it.
    var discardJoin: Bool = false
    var lambdaDefs: String = ""
    var nextLambda: Int = 0
    var currentRet: Ty? = null
    var celled: Map<String, CellInfo> = {}
    var frameCells: Map<String, Bool> = {}
    var paramAlias: Map<String, String>? = null
    var captureEnv: Map<String, CapInfo>? = null
    var tsubst: Map<String, Ty> = {}
    var funDecls: Map<String, FunN> = {}
    var externs: Map<String, String> = {}
    var externDecls: Map<String, ExternN> = {}
    var mirrored: Map<String, Bool> = {}
    var classDecls: Map<String, ClassN> = {}
    var instantiated: Map<String, Bool> = {}
    var errors: List<DiagN> = []

    /// The checker's answer for `e`, with the current instantiation's
    /// substitution applied. Nothing in this backend reads `e.ty` raw.
    func ety(e: Ex): Ty? {
        val t = e.ty
        if (t == null) { return null }
        return substitute(t, this.tsubst)
    }

    /// The audit's verdict: register the pairs, mark from the roots, report.
    ///
    /// Emitted at the end of the top-level statements, and again before any
    /// `exit` written among them — because `exit` leaves through the C
    /// library and never comes back, and an audit that a program can silence
    /// by ending the ordinary way is not a verdict. The roots are `main`'s
    /// own locals, which is why this can only be emitted where they are in
    /// scope, and why `exit` inside a function is refused under the audit
    /// rather than quietly excused.
    proc auditTail() {
        this.line("keal_audit_pair_runtime();")
        this.line("keal_audit_pairs_program();")
        // Read rather than taken: an `exit` under an `if` emits this once
        // here and once at the natural end, and both need the same roots.
        var ri = 0
        while (ri < this.auditRootNames.size) {
            val ml = markLine(this.auditRootTypes[ri], this.auditRootNames[ri])
            if (ml != null) { this.line(ml) }
            ri += 1
        }
        this.line("keal_audit_report();")
        this.line("keal_audit_done();")
    }

    proc unsupported(file: Int, line: Int, col: Int, what: String) {
        this.refuse(
            file, line, col, what,
            "run it on the bytecode VM instead, which supports the whole language"
        )
    }

    proc refuse(file: Int, line: Int, col: Int, what: String, note: String) {
        val d = DiagN(file, line, col, "the C backend cannot compile ${what} yet")
        d.note = note
        this.errors.add(d)
    }

    proc truncateErrors(n: Int) {
        while (this.errors.size > n) {
            this.errors.removeAt(this.errors.size - 1)
        }
    }

    proc line(s: String) {
        this.body.add("    ".repeat(this.indent) + s)
    }

    func temp(): String {
        this.nextTemp += 1
        return "_t${this.nextTemp}"
    }

    /// A condition, bound to a name so the C never reads `if ((a == b))`.
    func condition(cond: Ex): String {
        val c = this.expr(cond)
        val t = this.temp()
        this.line("const bool ${t} = ${c};")
        return t
    }

    // ---- types ---------------------------------------------------------

    /// The C type a Keal type is emitted as, or null when this backend
    /// cannot represent it.
    func ctype(t: Ty, file: Int, atLine: Int, col: Int): String? {
        if (t.kind == "Int") { return "int64_t" }
        // One word holding an ordinal. With nothing to carry beside the
        // tag, a `KealAny` would spend two words and a heap box to hold a
        // permanent zero — the ordinal is the whole value.
        if (t.kind == "Enum") { return "int64_t" }
        if (t.kind == "Float") { return "double" }
        if (t.kind == "Bool") { return "bool" }
        if (t.kind == "Str") { return "KealStr*" }
        if (t.kind == "Unit") { return "void" }
        // A tag and a payload, two words — `keal layout`'s promise.
        if (t.kind == "Any") { return "KealAny" }
        if (t.kind == "Class" and this.shapes.contains(t.name)) {
            if (t.args.size == 0) {
                return structName(t.name) + "*"
            }
            val sn = this.instantiateClass(t.name, t.args, file, atLine, col)
            if (sn == null) { return null }
            return sn + "*"
        }
        if (t.kind == "Fun") {
            // Callable through a cast at each site; representable as one
            // pointer as long as its signature is.
            for (p in t.params) {
                if (this.ctype(p.ty, file, atLine, col) == null) { return null }
            }
            val ret = t.ret!!
            unless (ret.kind == "Unit") {
                if (this.ctype(ret, file, atLine, col) == null) { return null }
            }
            return "KealClosure*"
        }
        if (t.kind == "Map") {
            if (this.keyKind(t.args[0], file, atLine, col) == null) { return null }
            if (this.elemKind(t.args[1], file, atLine, col) == null) { return null }
            return "KealMap*"
        }
        if (t.kind == "List") {
            // The element type must itself be supported, or the list is
            // refused where it is declared rather than where it breaks.
            if (this.elemKind(t.args[0], file, atLine, col) != null) {
                return "KealList*"
            }
            return null
        }
        if (t.kind == "Nullable") {
            val inner = t.args[0]
            // `T?` over a reference is the same pointer, allowed to be null.
            if (isReference(inner)) { return this.ctype(inner, file, atLine, col) }
            if (inner.kind == "Int" or inner.kind == "Enum") { return "KealOptI64" }
            if (inner.kind == "Float") { return "KealOptF64" }
            if (inner.kind == "Bool") { return "int8_t" }
            this.unsupported(file, atLine, col, "the type `${tyShow(inner)}?`")
            return null
        }
        if (t.kind == "Null") { return "void*" }
        this.unsupported(file, atLine, col, "values of type `${tyShow(t)}`")
        return null
    }

    /// How a list element of this type is stored in a `KealWord`, or null
    /// when it cannot be one yet.
    func elemKind(t: Ty, file: Int, atLine: Int, col: Int): CElem? {
        // An empty literal types as `List<Nothing>`, and `Nothing` has no
        // values, so any representative will do.
        if (t.kind == "Never" or t.kind == "Int" or t.kind == "Enum") { return CElem("int", "", "") }
        if (t.kind == "Bool") { return CElem("bool", "", "") }
        if (t.kind == "Float") { return CElem("float", "", "") }
        if (t.kind == "Str") { return CElem("ptr", "KealStr", "keal_str") }
        if (t.kind == "Class") {
            if (t.args.size == 0) {
                val sn = structName(t.name)
                return CElem("ptr", sn, sn)
            }
            val sn = this.instantiateClass(t.name, t.args, file, atLine, col)
            if (sn == null) { return null }
            return CElem("ptr", sn, sn)
        }
        if (t.kind == "List") {
            if (this.elemKind(t.args[0], file, atLine, col) == null) { return null }
            return CElem("ptr", "KealList", "keal_list")
        }
        if (t.kind == "Map") {
            if (this.keyKind(t.args[0], file, atLine, col) == null) { return null }
            if (this.elemKind(t.args[1], file, atLine, col) == null) { return null }
            return CElem("ptr", "KealMap", "keal_map")
        }
        // A closure is one pointer too, as long as its signature is
        // representable — the same test `ctype` applies.
        if (t.kind == "Fun") {
            if (this.ctype(t, file, atLine, col) == null) { return null }
            return CElem("ptr", "KealClosure", "keal_fn")
        }
        // A nullable reference is the same pointer, allowed to be null;
        // retain and release both accept null, so the element machinery
        // never needs to know.
        if (t.kind == "Nullable" and isReference(t.args[0])) {
            return this.elemKind(t.args[0], file, atLine, col)
        }
        if (t.kind == "Any") { return CElem("any", "", "") }
        this.unsupported(file, atLine, col, "lists of `${tyShow(t)}`")
        return null
    }

    /// A key must have an equality the runtime can apply.
    /// The C expression that copies `v` of type `ty` at `depth` — a raw
    /// value for scalars, a retain for immutable strings, a generated
    /// per-type function for anything with structure. `null` when the type
    /// cannot cross, which the checker already refused.
    /// The class a weak field points at, as its C struct name.
    func weakTargetOf(t: Ty, file: Int, atLine: Int, col: Int): String? {
        var inner = t
        if (t.kind == "Nullable") { inner = t.args[0] }
        unless (inner.kind == "Class") { return null }
        if (inner.args.size == 0) { return structName(inner.name) }
        return this.instantiateClass(inner.name, inner.args, file, atLine, col)
    }

    /// A value on its way into a field: a weak field takes the second
    /// count, everything else takes the first.
    func storedFieldValue(c: ClassN, field: String, t: Ty, v: String, file: Int, atLine: Int, col: Int): String {
        if (this.weakMode and classFieldIsWeak(c, field)) {
            val target = this.weakTargetOf(t, file, atLine, col)
            if (target != null) { return "${target}_weak_retain(${v})" }
        }
        return retained(t, v)
    }

    /// The static type-info an `Any` tags this type's values with — what
    /// `is` compares, what `typeOf` names. Only types whose every value has
    /// one layout get a tag: scalars, strings, `List<Any>`, and classes at
    /// their all-`Any` (or arg-free) instantiation. That rule is what keeps
    /// native narrowing honest — the payload always is what the tag says.
    func anyTiOf(t: Ty, file: Int, atLine: Int, col: Int): String? {
        if (t.kind == "Int") { return "&keal_ti_int" }
        if (t.kind == "Float") { return "&keal_ti_float" }
        if (t.kind == "Bool") { return "&keal_ti_bool" }
        if (t.kind == "Str") { return "&keal_ti_str" }
        if (t.kind == "List" and t.args[0].kind == "Any") { return "&keal_ti_list" }
        if (t.kind == "Class" and this.shapes.contains(t.name)) {
            var allAny = true
            for (a in t.args) {
                unless (a.kind == "Any") { allAny = false }
            }
            unless (allAny) { return null }
            var sn = structName(t.name)
            if (t.args.size > 0) {
                val inst = this.instantiateClass(t.name, t.args, file, atLine, col)
                if (inst == null) { return null }
                sn = inst
            }
            this.ensureClassTi(sn, t.name)
            return "&${sn}_ti"
        }
        return null
    }

    /// Emits (once) a class's type-info: its show and retain behind the
    /// word-shaped signatures the info wants, identity equality — exactly
    /// how the interpreters compare dynamic instances.
    proc ensureClassTi(sn: String, bare: String) {
        val key = "ti|" + sn
        if (this.thunks.contains(key)) { return }
        this.thunks[key] = true
        val rel = this.releaserThunk(CElem("ptr", sn, sn))
        this.helpers += "static KealStr* ${sn}_ti_show(KealWord w) { return ${sn}_show((${sn}*)w.p); }\nstatic void ${sn}_ti_retain(void* p) { ${sn}_retain((${sn}*)p); }\nstatic const KealTypeInfo ${sn}_ti = { ${cString(bare)}, ${sn}_ti_retain, ${rel}, ${sn}_ti_show, keal_any_ptr_eq };\n"
    }

    /// A value crossing into an `Any` hole, borrowed in, borrowed out.
    /// What has no tag is refused by name, where it tries to cross.
    func anyOf(source: Ty?, v: String, file: Int, atLine: Int, col: Int): String {
        val src = source
        if (src == null) { return v }
        if (src.kind == "Any" or src.kind == "Error") { return v }
        if (src.kind == "Never" or src.kind == "Null") { return "keal_any_null()" }
        if (src.kind == "Int") {
            return "((KealAny){ .ti = &keal_ti_int, .w = { .i = ${v} } })"
        }
        if (src.kind == "Bool") {
            return "((KealAny){ .ti = &keal_ti_bool, .w = { .i = (int64_t)(${v}) } })"
        }
        if (src.kind == "Float") {
            return "((KealAny){ .ti = &keal_ti_float, .w = { .d = ${v} } })"
        }
        if (src.kind == "Nullable") {
            val inner = src.args[0]
            if (inner.kind == "Int") { return "keal_any_of_opt_i64(${v})" }
            if (inner.kind == "Float") { return "keal_any_of_opt_f64(${v})" }
            if (inner.kind == "Bool") { return "keal_any_of_opt_bool(${v})" }
            val ti = this.anyTiOf(inner, file, atLine, col)
            if (ti != null) { return "keal_any_of_ptr(${ti}, (void*)${v})" }
            this.refuse(
                file, atLine, col,
                "a `${tyShow(src)}` into an `Any`",
                "only a value whose layout its tag can name crosses; a container crosses at its `<Any>` element type"
            )
            return "keal_any_null()"
        }
        val ti = this.anyTiOf(src, file, atLine, col)
        if (ti != null) { return "keal_any_of_ptr(${ti}, (void*)${v})" }
        this.refuse(
            file, atLine, col,
            "a `${tyShow(src)}` into an `Any`",
            "only a value whose layout its tag can name crosses; a container crosses at its `<Any>` element type"
        )
        return "keal_any_null()"
    }

    /// Reads a narrowed `Any`'s payload, borrowed — the tagged variable
    /// keeps its reference for as long as the narrowed scope runs.
    func anyPayload(t: Ty, v: String, file: Int, atLine: Int, col: Int): String? {
        if (t.kind == "Int") { return "(${v}.w.i)" }
        if (t.kind == "Bool") { return "((bool)${v}.w.i)" }
        if (t.kind == "Float") { return "(${v}.w.d)" }
        if (t.kind == "Str") { return "((KealStr*)${v}.w.p)" }
        if (t.kind == "List" and t.args[0].kind == "Any") { return "((KealList*)${v}.w.p)" }
        if (t.kind == "Class" and this.shapes.contains(t.name)) {
            var allAny = true
            for (a in t.args) {
                unless (a.kind == "Any") { allAny = false }
            }
            if (allAny) {
                var sn = structName(t.name)
                if (t.args.size > 0) {
                    val inst = this.instantiateClass(t.name, t.args, file, atLine, col)
                    if (inst == null) { return null }
                    sn = inst
                }
                return "((${sn}*)${v}.w.p)"
            }
        }
        this.unsupported(file, atLine, col, "narrowing an `Any` to `${tyShow(t)}`")
        return null
    }

    /// What the checker resolved an `is` target to: bare containers test
    /// the container alone, a bare class tests the class alone — its
    /// arguments, if any, read back as `Any`.
    func isTarget(te: TypeEx, file: Int, atLine: Int, col: Int): Ty? {
        unless (te.kind == "named" and te.args.size == 0) {
            this.unsupported(file, atLine, col, "`is` on this type")
            return null
        }
        val name = te.name
        if (name == "Int") { return Ty("Int") }
        if (name == "Float") { return Ty("Float") }
        if (name == "Bool") { return Ty("Bool") }
        if (name == "String") { return Ty("Str") }
        if (name == "Any") { return Ty("Any") }
        if (name == "Unit") { return Ty("Unit") }
        if (name == "Nothing") { return Ty("Never") }
        if (name == "Range") { return Ty("Range") }
        if (name == "List") { return tyList(Ty("Any")) }
        if (name == "Map") { return tyMap(Ty("Any"), Ty("Any")) }
        val decl = this.classDecls[name]
        if (decl != null) {
            val args: List<Ty> = []
            var i = 0
            while (i < decl.typeParams.size) {
                args.add(Ty("Any"))
                i += 1
            }
            return tyClass(name, args)
        }
        this.unsupported(file, atLine, col, "`is ${name}`")
        return null
    }

    /// The `is` test itself: a tag compare. A type no value can carry
    /// natively — a payload the backend refused at every entry — tests
    /// false, which is exactly what it would have answered.
    func anyIsTest(target: Ty, v: String, file: Int, atLine: Int, col: Int): String {
        if (target.kind == "Any") { return "(${v}.ti != NULL)" }
        if (target.kind == "Unit" or target.kind == "Never" or target.kind == "Range" or target.kind == "Map" or target.kind == "Fun") {
            return "false"
        }
        val ti = this.anyTiOf(target, file, atLine, col)
        if (ti != null) { return "(${v}.ti == ${ti})" }
        this.unsupported(file, atLine, col, "`is ${tyShow(target)}`")
        return "false"
    }

    // The same test, asked of the value being unwound: a `catch` that
    // names a type takes only what that type can hold. A type no value
    // can carry natively tests false, which is what it would answer.
    func unwindTest(target: Ty, file: Int, atLine: Int, col: Int): String {
        if (target.kind == "Any") { return "keal_unwind_is_any()" }
        if (target.kind == "Unit" or target.kind == "Never" or target.kind == "Range" or target.kind == "Map" or target.kind == "Fun") {
            return "false"
        }
        val ti = this.anyTiOf(target, file, atLine, col)
        if (ti != null) { return "keal_unwind_is(${ti})" }
        this.unsupported(file, atLine, col, "catching a `${tyShow(target)}`")
        return "false"
    }

    func copyExprOf(t: Ty, v: String, depth: String, file: Int, atLine: Int, col: Int): String? {
        val k = t.kind
        if (k == "Int" or k == "Float" or k == "Bool" or k == "Unit" or k == "Range") {
            return v
        }
        if (k == "Str") { return "keal_str_retain(${v})" }
        if (k == "Nullable") {
            if (isValueOpt(t)) { return v }
            val inner = t.args[0]
            if (inner.kind == "Str") { return "keal_str_retain(${v})" }
            // The addresses stay addresses under `?` too — retain
            // is NULL-safe, so no guard is needed.
            if (inner.kind == "Class" and (inner.name == "ActorRef" or inner.name == "Outbox")) {
                var sn = structName(inner.name)
                if (inner.args.size > 0) {
                    val inst = this.instantiateClass(inner.name, inner.args, file, atLine, col)
                    if (inst == null) { return null }
                    sn = inst
                }
                return "${sn}_retain(${v})"
            }
            val f = this.ensureCopyFn(inner, file, atLine, col)
            if (f == null) { return null }
            return "(${v} == NULL ? NULL : ${f}(${v}, ${depth}))"
        }
        // An `ActorRef` is an address: it crosses by being shared,
        // never duplicated — a copied mailbox would swallow replies.
        if (k == "Class" and (t.name == "ActorRef" or t.name == "Outbox")) {
            var sn = structName(t.name)
            if (t.args.size > 0) {
                val inst = this.instantiateClass(t.name, t.args, file, atLine, col)
                if (inst == null) { return null }
                sn = inst
            }
            return "${sn}_retain(${v})"
        }
        if (k == "List" or k == "Map" or k == "Class") {
            val f = this.ensureCopyFn(t, file, atLine, col)
            if (f == null) { return null }
            return "${f}(${v}, ${depth})"
        }
        return null
    }

    /// Generates (once) the copy function for a structured type, and
    /// answers its name. Bodies check the same depth cap the interpreters
    /// check, with the same message; on an unwind they release what they
    /// built and poison-return, so a caught cycle panic leaks nothing.
    func ensureCopyFn(t: Ty, file: Int, atLine: Int, col: Int): String? {
        val name = "kcopy_" + mangleType(t)
        if (this.copyFns.contains(name)) { return name }
        this.copyFns[name] = true
        val cap = "if (depth > 10000) { keal_panic(\"`copy` went 10000 levels deep; is the value cyclic?\", 0); return NULL; }"
        if (t.kind == "List") {
            val elemTy = t.args[0]
            val elem = this.elemKind(elemTy, file, atLine, col)
            if (elem == null) { return null }
            val thunk = this.releaserThunk(elem)
            val cv = this.copyExprOf(elemTy, elemUnword(elem, "w"), "depth + 1", file, atLine, col)
            if (cv == null) { return null }
            this.decls += "KealList* ${name}(KealList* l, int64_t depth);\n"
            val bail = if (countedC(elemTy)) {
                "        if (keal_unwinding) { keal_list_release(out); return NULL; }\n"
            } else {
                ""
            }
            this.defs += "\nKealList* ${name}(KealList* l, int64_t depth) {\n    ${cap}\n    KealList* out = keal_list_new(${thunk});\n    for (int64_t i = 0; i < l->len; i++) {\n        KealWord w = l->data[i];\n        keal_list_push(out, ${elemWord(elem, cv)});\n${bail}    }\n    return out;\n}\n"
            return name
        }
        if (t.kind == "Map") {
            val kt = t.args[0]
            val vt = t.args[1]
            val kk = this.keyKind(kt, file, atLine, col)
            if (kk == null) { return null }
            val vk = this.elemKind(vt, file, atLine, col)
            if (vk == null) { return null }
            val relK = this.releaserThunk(kk)
            val relV = this.releaserThunk(vk)
            val ck = this.copyExprOf(kt, elemUnword(kk, "k"), "depth + 1", file, atLine, col)
            if (ck == null) { return null }
            val cv = this.copyExprOf(vt, elemUnword(vk, "v"), "depth + 1", file, atLine, col)
            if (cv == null) { return null }
            this.decls += "KealMap* ${name}(KealMap* m, int64_t depth);\n"
            val bail = if (countedC(vt)) {
                "        if (keal_unwinding) { keal_map_release(out); return NULL; }\n"
            } else {
                ""
            }
            this.defs += "\nKealMap* ${name}(KealMap* m, int64_t depth) {\n    ${cap}\n    KealMap* out = keal_map_new(${keyEqFn(kk)}, ${relK}, ${relV});\n    for (int64_t i = 0; i < m->len; i++) {\n        KealWord k = m->data[2 * i];\n        KealWord v = m->data[2 * i + 1];\n        keal_map_set(out, ${elemWord(kk, ck)}, ${elemWord(vk, cv)});\n${bail}    }\n    return out;\n}\n"
            return name
        }
        if (t.kind == "Class") {
            var sn = structName(t.name)
            if (t.args.size > 0) {
                val inst = this.instantiateClass(t.name, t.args, file, atLine, col)
                if (inst == null) { return null }
                sn = inst
            }
            val raw = this.shapes[t.name]
            if (raw == null) { return null }
            val subst: Map<String, Ty> = {}
            val decl = this.classDecls[t.name]
            if (decl != null) {
                var pi = 0
                while (pi < decl.typeParams.size and pi < t.args.size) {
                    subst[decl.typeParams[pi].name] = t.args[pi]
                    pi += 1
                }
            }
            this.decls += "${sn}* ${name}(${sn}* o, int64_t depth);\n"
            var body = "\n${sn}* ${name}(${sn}* o, int64_t depth) {\n    ${cap}\n    ${sn}* c = (${sn}*)keal_alloc(sizeof(${sn}));\n    memset((void*)c, 0, sizeof(*c));\n    c->rc = 1;\n"
            if (this.auditMode) {
                // A copy is a new object, and dies like one: without this the
                // audit counts every deep copy's death and none of its births.
                body += "    keal_audit_born(${cString(t.name)});\n"
            }
            for (f in raw) {
                val ft = substitute(substitute(f.ty, subst), this.tsubst)
                val cv = this.copyExprOf(ft, "o->" + mangle(f.name), "depth + 1", file, atLine, col)
                if (cv == null) { return null }
                body += "    c->${mangle(f.name)} = ${cv};\n"
                if (countedC(ft)) {
                    body += "    if (keal_unwinding) { ${sn}_release(c); return NULL; }\n"
                }
            }
            body += "    return c;\n}\n"
            this.defs += body
            return name
        }
        return null
    }

    func keyKind(t: Ty, file: Int, atLine: Int, col: Int): CElem? {
        if (t.kind == "Never" or t.kind == "Int" or t.kind == "Bool" or t.kind == "Float" or t.kind == "Str" or t.kind == "Enum") {
            return this.elemKind(t, file, atLine, col)
        }
        this.unsupported(file, atLine, col, "map keys of `${tyShow(t)}`")
        return null
    }

    /// The thunk handed to `keal_list_new`, generated once per pointer kind.
    func releaserThunk(elem: CElem): String {
        if (elem.kind == "any") { return "keal_any_box_release" }
        unless (elem.kind == "ptr") { return "NULL" }
        val name = "rel_" + elem.prefix
        unless (this.thunks.contains(name)) {
            this.thunks[name] = true
            this.helpers += "static void ${name}(void* p) { ${elem.prefix}_release((${elem.ctype}*)p); }\n"
            // The one funnel every container's element type passes through,
            // so pairing the walk here covers lists, maps, cells and the tag
            // an `Any` carries a class under.
            if (this.auditMode) {
                this.auditPairs.add([name, elem.prefix + "_mark"])
            }
        }
        return name
    }

    // ---- program -------------------------------------------------------

    proc emitProgram(program: ProgramN) {
        // The declaration tables come first: everything below looks callees
        // up in them.
        for (item in program.items) {
            if (item.kind == "func") {
                val f = item.funDecl!!
                this.globalFuns[f.name] = true
                this.funDecls[f.name] = f
            }
            if (item.kind == "class") {
                val c = item.classDecl!!
                this.classDecls[c.name] = c
            }
            // A top-level `Any` binding is known before any function body
            // compiles: an `is` inside one can narrow it, and the reader
            // must know to unwrap the tagged pair.
            if (item.kind == "stmt") {
                val st = item.stmt!!
                if (st.kind == "let") {
                    var saysAny = false
                    val te = st.tyEx
                    if (te != null and te.kind == "named" and te.args.size == 0 and te.name == "Any") {
                        saysAny = true
                    }
                    val it0 = st.init
                    if (it0 != null and it0.ty != null and it0.ty!!.kind == "Any") { saysAny = true }
                    if (saysAny) { this.anyGlobals[st.name] = true }
                }
            }
            // A `native` block goes into the output verbatim, before the
            // program's own declarations, so the externs' symbols exist.
            if (item.kind == "native") {
                this.helpers += item.text
                this.helpers += "\n"
            }
            if (item.kind == "extern") {
                val x = item.externDecl!!
                this.globalFuns[x.name] = true
                this.externs[x.name] = x.symbol
                this.externDecls[x.name] = x
                for (p in x.params) {
                    val te = p.tyEx
                    if (te != null) { this.mirrorFor(te) }
                }
                val rte = x.ret
                if (rte != null) { this.mirrorFor(rte) }
            }
        }
        // The variants, in order, before anything can name one.
        for (item in program.items) {
            if (item.kind == "enum") {
                val en = item.enumDecl!!
                val names: List<String> = []
                for (v in en.variants) { names.add(v.name) }
                this.enumNamesOf[en.name] = names
            }
        }
        // Structs next: a function signature may mention one.
        for (item in program.items) {
            if (item.kind == "class") { this.classStruct(item.classDecl!!) }
        }
        for (item in program.items) {
            if (item.kind == "class") { this.classFunctions(item.classDecl!!) }
        }
        for (item in program.items) {
            if (item.kind == "func") { this.function(item.funDecl!!) }
        }
        this.emitMain(program)
    }

    /// The `Keal_Name` mirror struct for a record named in an extern
    /// signature: the same fields in the same order, unmangled, headerless —
    /// the C side's half of the by-value contract. Emitted once, before the
    /// native blocks, so their code can use it.
    proc mirrorFor(te: TypeEx) {
        var name = ""
        if (te.kind == "boundary") {
            val inner = te.inner!!
            unless (inner.kind == "named" and inner.args.size == 0) { return }
            name = inner.name
        } else if (te.kind == "named" and te.args.size == 0) {
            name = te.name
        } else {
            return
        }
        val fields = this.shapes[name]
        if (fields == null) { return }
        if (this.mirrored.contains(name)) { return }
        this.mirrored[name] = true
        this.typesOut += mirrorStructC(name, fields)
    }

    /// A class becomes a struct headed by its reference count, its fields in
    /// declaration order.
    proc classStruct(c: ClassN) {
        // A generic class has no single layout; per instantiation, on demand.
        if (c.typeParams.size > 0) { return }
        val fields = this.shapes[c.name]
        if (fields == null) { return }
        this.emitStruct(structName(c.name), fields, c.file, c.line, c.col, classHasDeinit(c))
    }

    proc emitStruct(name: String, fields: List<SField>, file: Int, atLine: Int, col: Int, hasDeinit: Bool) {
        this.typesOut += "typedef struct ${name} ${name};\n"
        var sbody = "struct ${name} {\n"
        sbody += "    keal_rc_t rc;\n"
        if (this.weakMode) {
            // How many weak references name this object. The husk it leaves
            // behind when its strong count reaches zero lives until this
            // reaches zero too.
            sbody += "    keal_rc_t wc;\n"
        }
        if (hasDeinit) {
            // Set once the object's `deinit` has been queued: the hook runs
            // exactly once, resurrection or not.
            sbody += "    bool kdropped;\n"
        }
        for (f in fields) {
            val ct = this.ctype(f.ty, file, atLine, col)
            if (ct == null) { return }
            sbody += "    ${ct} ${mangle(f.name)};\n"
        }
        sbody += "};\n"
        this.pendingStructs.add(sbody)
    }

    /// Emits one specialisation of a generic class, and everything it
    /// carries, compiled under the substitution the arguments dictate.
    func instantiateClass(name: String, args0: List<Ty>, file: Int, atLine: Int, col: Int): String? {
        // Arguments may mention the parameters of whatever instantiation is
        // already in progress; resolve them before naming anything.
        val args: List<Ty> = []
        for (a in args0) { args.add(substitute(a, this.tsubst)) }
        val sn = structNameOf(name, args)
        if (this.instantiated.contains(sn)) { return sn }
        val c = this.classDecls[name]
        if (c == null) {
            this.unsupported(file, atLine, col, "the generic class `${name}`")
            return null
        }
        if (c.typeParams.size != args.size) { return null }
        this.instantiated[sn] = true

        val saved = this.tsubst
        this.tsubst = {}
        var i = 0
        while (i < c.typeParams.size) {
            this.tsubst[c.typeParams[i].name] = args[i]
            i += 1
        }
        val fields: List<SField> = []
        val raw = this.shapes[name]
        if (raw != null) {
            for (f in raw) { fields.add(SField(f.name, substitute(f.ty, this.tsubst))) }
        }

        // Instantiation can fire mid-emission, so the emitter's whole frame
        // state is fenced off.
        val savedBody = this.body
        this.body = []
        val savedScopes = this.scopes
        this.scopes = []
        val savedLocals = this.locals
        this.locals = []
        val savedUnwindT = this.unwindTargets
        this.unwindTargets = []
        val savedUnwindM = this.unwindMarks
        this.unwindMarks = []
        val savedPoison = this.poison
        this.poison = ""
        val savedLoops = this.loops
        this.loops = []
        val savedIndent = this.indent
        val savedTemp = this.nextTemp
        val savedThis = this.thisName
        this.thisName = ""
        val savedEnv = this.captureEnv
        this.captureEnv = null
        val savedCelled = this.celled
        this.celled = {}
        val savedCells = this.frameCells
        this.frameCells = {}
        val savedTop = this.atTopLevel
        this.atTopLevel = false
        val savedRet = this.currentRet
        this.currentRet = null
        this.emitStruct(sn, fields, file, atLine, col, classHasDeinit(c))
        this.classFunctionsNamed(c, fields, sn)
        this.currentRet = savedRet
        this.atTopLevel = savedTop
        this.celled = savedCelled
        this.frameCells = savedCells
        this.body = savedBody
        this.scopes = savedScopes
        this.locals = savedLocals
        this.unwindTargets = savedUnwindT
        this.unwindMarks = savedUnwindM
        this.poison = savedPoison
        this.loops = savedLoops
        this.indent = savedIndent
        this.nextTemp = savedTemp
        this.thisName = savedThis
        this.captureEnv = savedEnv
        this.tsubst = saved
        return sn
    }

    /// Emits one specialisation of a generic method, returning its C name.
    func instantiateMethod(class_: String, classArgs0: List<Ty>, method: String, margs0: List<Ty>, file: Int, atLine: Int, col: Int): String? {
        val margs: List<Ty> = []
        for (a in margs0) { margs.add(substitute(a, this.tsubst)) }
        val classArgs: List<Ty> = []
        for (a in classArgs0) { classArgs.add(substitute(a, this.tsubst)) }
        val sn = structNameOf(class_, classArgs)
        var parts = ""
        var first = true
        for (a in margs) {
            unless (first) { parts += "__" }
            parts += mangleType(a)
            first = false
        }
        val fnName = "${sn}_${mangleMethod(method)}__${parts}"
        if (this.instantiated.contains(fnName)) { return fnName }
        val c = this.classDecls[class_]
        if (c == null) { return null }
        var m0: FunN? = null
        for (cand in c.methods) {
            if (cand.name == method and m0 == null) { m0 = cand }
        }
        val m = m0
        if (m == null) {
            this.unsupported(file, atLine, col, "the generic method `${method}`")
            return null
        }
        if (m.typeParams.size != margs.size) { return null }
        this.instantiated[fnName] = true

        val saved = this.tsubst
        this.tsubst = {}
        var i = 0
        while (i < c.typeParams.size) {
            this.tsubst[c.typeParams[i].name] = classArgs[i]
            i += 1
        }
        i = 0
        while (i < m.typeParams.size) {
            this.tsubst[m.typeParams[i].name] = margs[i]
            i += 1
        }
        val savedBody = this.body
        this.body = []
        val savedScopes = this.scopes
        this.scopes = []
        val savedLocals = this.locals
        this.locals = []
        val savedUnwindT = this.unwindTargets
        this.unwindTargets = []
        val savedUnwindM = this.unwindMarks
        this.unwindMarks = []
        val savedPoison = this.poison
        this.poison = ""
        val savedLoops = this.loops
        this.loops = []
        val savedIndent = this.indent
        val savedTemp = this.nextTemp
        val savedThis = this.thisName
        this.thisName = ""
        val savedEnv = this.captureEnv
        this.captureEnv = null
        val savedCelled = this.celled
        this.celled = {}
        val savedCells = this.frameCells
        this.frameCells = {}
        val savedTop = this.atTopLevel
        this.atTopLevel = false
        val savedRet = this.currentRet
        this.currentRet = null
        this.methodNamed(c, m, sn, fnName)
        this.currentRet = savedRet
        this.atTopLevel = savedTop
        this.celled = savedCelled
        this.frameCells = savedCells
        this.body = savedBody
        this.scopes = savedScopes
        this.locals = savedLocals
        this.unwindTargets = savedUnwindT
        this.unwindMarks = savedUnwindM
        this.poison = savedPoison
        this.loops = savedLoops
        this.indent = savedIndent
        this.nextTemp = savedTemp
        this.thisName = savedThis
        this.captureEnv = savedEnv
        this.tsubst = saved
        return fnName
    }

    /// Emits one specialisation of a generic function, returning its C name.
    func instantiateFunction(name: String, args0: List<Ty>, file: Int, atLine: Int, col: Int): String? {
        val args: List<Ty> = []
        for (a in args0) { args.add(substitute(a, this.tsubst)) }
        var parts = ""
        var first = true
        for (a in args) {
            unless (first) { parts += "__" }
            parts += mangleType(a)
            first = false
        }
        val cname = "${mangle(name)}__${parts}"
        if (this.instantiated.contains(cname)) { return cname }
        val f = this.funDecls[name]
        if (f == null) {
            this.unsupported(file, atLine, col, "the generic function `${name}`")
            return null
        }
        if (f.typeParams.size != args.size) { return null }
        this.instantiated[cname] = true

        val saved = this.tsubst
        this.tsubst = {}
        var i = 0
        while (i < f.typeParams.size) {
            this.tsubst[f.typeParams[i].name] = args[i]
            i += 1
        }
        // The body being emitted right now must not be clobbered.
        val savedBody = this.body
        this.body = []
        val savedScopes = this.scopes
        this.scopes = []
        val savedLocals = this.locals
        this.locals = []
        val savedUnwindT = this.unwindTargets
        this.unwindTargets = []
        val savedUnwindM = this.unwindMarks
        this.unwindMarks = []
        val savedPoison = this.poison
        this.poison = ""
        val savedLoops = this.loops
        this.loops = []
        val savedIndent = this.indent
        val savedTemp = this.nextTemp
        val savedThis = this.thisName
        this.thisName = ""
        val savedEnv = this.captureEnv
        this.captureEnv = null
        val savedCelled = this.celled
        this.celled = {}
        val savedCells = this.frameCells
        this.frameCells = {}
        // A body being instantiated is not the top level, however it was
        // reached; a binding inside it must be a local.
        val savedTop = this.atTopLevel
        this.atTopLevel = false
        val savedRet = this.currentRet
        this.currentRet = null
        this.functionNamed(f, cname)
        this.currentRet = savedRet
        this.atTopLevel = savedTop
        this.celled = savedCelled
        this.frameCells = savedCells
        this.thisName = savedThis
        this.captureEnv = savedEnv
        this.body = savedBody
        this.scopes = savedScopes
        this.locals = savedLocals
        this.unwindTargets = savedUnwindT
        this.unwindMarks = savedUnwindM
        this.poison = savedPoison
        this.loops = savedLoops
        this.indent = savedIndent
        this.nextTemp = savedTemp
        this.tsubst = saved
        return cname
    }

    /// Everything a class needs at run time.
    proc classFunctions(c: ClassN) {
        if (c.typeParams.size > 0) { return }
        val fields = this.shapes[c.name]
        if (fields == null) { return }
        this.classFunctionsNamed(c, fields, structName(c.name))
    }

    proc classFunctionsNamed(c: ClassN, fields: List<SField>, name: String) {
        // retain / release
        this.decls += "${name}* ${name}_retain(${name}* o);\n"
        this.decls += "void ${name}_release(${name}* o);\n"
        this.defs += "\n${name}* ${name}_retain(${name}* o) {\n    if (o != NULL) { KEAL_RC_BUMP(o->rc); }\n    return o;\n}\n"
        if (this.weakMode) {
            // A weak reference names an object without owning it: it moves
            // the second count, never the first, and reads back NULL once
            // the object is dead — which is exactly `rc == 0`, because a
            // live object always holds at least one strong reference.
            this.decls += "${name}* ${name}_weak_retain(${name}* o);\n"
            this.decls += "void ${name}_weak_release(${name}* o);\n"
            this.decls += "${name}* ${name}_weak_get(${name}* o);\n"
            this.defs += "\n${name}* ${name}_weak_retain(${name}* o) {\n    if (o != NULL) { KEAL_RC_BUMP(o->wc); }\n    return o;\n}\n"
            this.defs += "\nvoid ${name}_weak_release(${name}* o) {\n    if (o == NULL) { return; }\n    if (KEAL_RC_DROP(o->wc)) { return; }\n    if (o->rc == 0) { free(o); }\n}\n"
            this.defs += "\n${name}* ${name}_weak_get(${name}* o) {\n    if (o == NULL || o->rc == 0) { return NULL; }\n    return ${name}_retain(o);\n}\n"
        }
        var rel = "\nvoid ${name}_release(${name}* o) {\n    if (o == NULL) { return; }\n    if (KEAL_RC_DROP(o->rc)) { return; }\n"
        if (classHasDeinit(c)) {
            // The first death queues the hook instead of freeing: the
            // object waits, whole and resurrected to one reference, for
            // the next statement boundary. The dropper releases it again;
            // by then `kdropped` is set and the plain path below runs —
            // unless `deinit` gave it away, in which case it lives on.
            rel += "    if (!o->kdropped) {\n        o->kdropped = true;\n        o->rc = 1;\n        keal_queue_drop((void*)o, ${name}_dropper);\n        return;\n    }\n"
        }
        if (this.auditMode) {
            // After the hook's turn, not before: an object that queues its
            // `deinit` comes back here once, and dies once.
            rel += "    keal_audit_died(${cString(c.name)});\n"
        }
        // The last reference to an object is also the last to each of the
        // references it held.
        //
        // Under `weak`, one of those releases can drop the last WEAK
        // reference to THIS object — a node whose neighbour holds a weak edge
        // back to it — and the header would be freed here, under the line
        // below that reads `o->wc`. So the object holds a weak reference to
        // itself across its own field releases, and lets it go afterwards.
        if (this.weakMode) {
            rel += "    KEAL_RC_BUMP(o->wc);\n"
        }
        for (f in fields) {
            if (this.weakMode and classFieldIsWeak(c, f.name)) {
                val target = this.weakTargetOf(f.ty, c.file, c.line, c.col)
                if (target != null) {
                    rel += "    ${target}_weak_release(o->${mangle(f.name)});\n"
                }
            } else {
                val rf = releaseFn(f.ty)
                if (rf != null) {
                    rel += "    ${rf}(o->${mangle(f.name)});\n"
                }
            }
        }
        if (this.weakMode) {
            // The fields are gone either way; the header waits for the last
            // weak reference, which is what makes a weak read a safe read.
            // The reference taken above comes back here: if it was not the
            // last, somebody still holds a weak edge and the header stays.
            rel += "    if (KEAL_RC_DROP(o->wc)) { return; }\n    if (o->rc == 0) { free(o); }\n}\n"
        } else {
            rel += "    free(o);\n}\n"
        }
        this.defs += rel
        if (this.auditMode) {
            // The walk over the same fields the release above frees, minus
            // the weak ones: a `weak` field holds nothing up, and following
            // one would let the back edge of a cycle report its own cycle
            // as reachable.
            this.decls += "void ${name}_mark(void* p);\n"
            var mk = "\nvoid ${name}_mark(void* p) {\n    ${name}* o = (${name}*)p;\n    if (o == NULL || !keal_audit_first(o)) { return; }\n    keal_audit_hold(${cString(c.name)});\n"
            for (f in fields) {
                if (this.weakMode and classFieldIsWeak(c, f.name)) {
                    continue
                }
                val ml = markLine(f.ty, "o->${mangle(f.name)}")
                if (ml != null) {
                    mk += "    ${ml}\n"
                }
            }
            mk += "}\n"
            this.defs += mk
        }
        if (classHasDeinit(c)) {
            this.decls += "void ${name}_dropper(void* p);\n"
            this.defs += "\nvoid ${name}_dropper(void* p) {\n    ${name}* o = (${name}*)p;\n    ${name}_${mangleMethod("deinit")}(o);\n    ${name}_release(o);\n}\n"
        }

        this.classShow(c, fields, name)
        this.constructor(c, fields, name)
        for (m in c.methods) {
            this.method(c, m, name)
        }
    }

    /// `Point(x=1, y=2)`, or whatever a user `toString` says instead.
    proc classShow(c: ClassN, fields: List<SField>, name: String) {
        this.decls += "KealStr* ${name}_show(${name}* o);\n"
        var f = "\nKealStr* ${name}_show(${name}* o) {\n"

        var hasToString = false
        for (m in c.methods) {
            if (m.name == "toString" and m.params.size == 0) { hasToString = true }
        }
        if (hasToString) {
            f += "    return ${name}_${mangleMethod("toString")}(o);\n}\n"
            this.defs += f
            return
        }

        // A tuple is written `(1, "one")`, so that is how it reads back.
        val arity = tupleArity(c.name)
        val tuple = arity != null and arity == fields.size
        f += "    (void)o;\n    KealBuf b;\n    keal_buf_init(&b);\n"
        val opening = if (tuple) { "(" } else { c.name + "(" }
        f += "    keal_buf_lit(&b, ${cString(opening)});\n"
        var i = 0
        while (i < fields.size) {
            val fname = fields[i].name
            val fty = fields[i].ty
            if (i > 0) {
                f += "    keal_buf_lit(&b, \", \");\n"
            }
            unless (tuple) {
                f += "    keal_buf_lit(&b, ${cString(fname + "=")});\n"
            }
            val fieldAccess = "o->${mangle(fname)}"
            // A weak field shows what it points at only while that is
            // alive: a husk is `rc == 0`, and reads as `null`.
            if (this.weakMode and classFieldIsWeak(c, fname)) {
                var winner = fty
                if (fty.kind == "Nullable") { winner = fty.args[0] }
                val present = this.tryRepr(winner, fieldAccess, c.file, c.line, c.col)
                if (present != null) {
                    f += "    if (${fieldAccess} == NULL || ${fieldAccess}->rc == 0) {\n        keal_buf_lit(&b, \"null\");\n    } else {\n        keal_buf_str(&b, ${present});\n    }\n"
                } else {
                    val bail = if (this.catchMode) { "    return keal_buf_finish(&b);\n" } else { "" }
                    f += "    keal_panic(${cString("cannot render a value of type `" + tyShow(fty) + "` natively")}, 0);\n" + bail
                }
                i += 1
                continue
            }
            // An absent field renders as `null`, which needs a branch.
            if (fty.kind == "Nullable") {
                val present = this.tryRepr(fty.args[0], fieldAccess, c.file, c.line, c.col)
                if (present != null) {
                    f += "    if (${fieldAccess} == NULL) {\n        keal_buf_lit(&b, \"null\");\n    } else {\n        keal_buf_str(&b, ${present});\n    }\n"
                } else {
                    val bail = if (this.catchMode) { "    return keal_buf_finish(&b);\n" } else { "" }
                    f += "    keal_panic(${cString("cannot render a value of type `" + tyShow(fty) + "` natively")}, 0);\n" + bail
                }
                i += 1
                continue
            }
            val rendered = this.tryRepr(fty, fieldAccess, c.file, c.line, c.col)
            if (rendered != null) {
                f += "    keal_buf_str(&b, ${rendered});\n"
            } else {
                val bail = if (this.catchMode) { "    return keal_buf_finish(&b);\n" } else { "" }
                f += "    keal_panic(${cString("cannot render a value of type `" + tyShow(fty) + "` natively")}, 0);\n" + bail
            }
            i += 1
        }
        f += "    keal_buf_lit(&b, \")\");\n    return keal_buf_finish(&b);\n}\n"
        this.defs += f
    }

    /// The program's top level becomes `main`.
    proc emitMain(program: ProgramN) {
        this.body = []
        this.indent = 1
        this.beginFunctionUnwind("int64_t")
        this.openScope()
        this.atTopLevel = true
        val topStmts: List<StmtN> = []
        for (item in program.items) {
            val s = item.stmt
            if (item.kind == "stmt" and s != null) { topStmts.add(s) }
        }
        this.frameCells = lambdaFreeNames(topStmts)
        for (s in topStmts) {
            this.seqStmt(s)
        }
        this.atTopLevel = false
        this.closeScope()
        if (this.auditMode) {
            // After the scope closed: what is still counted here is what
            // closing it could not free. The mark phase then says which of
            // those a top-level binding can still reach — those lived to
            // the end because the program said so — and what it cannot
            // reach outlived its last reference, which is a cycle.
            //
            // The program's own pairs are registered from a function
            // written after everything is emitted: a thunk can be made
            // while a function far below this one is compiled, and a pair
            // list read here would be the list as it stood too early.
            this.auditTail()
        }
        this.line("return 0;")
        this.endFunctionUnwind()
        val joined = this.body.join("\n")
        this.body = []
        this.defs += "\nint main(void) {\n${joined}\n}\n"
    }

    proc function(f: FunN) {
        // A generic function is emitted per instantiation, on demand.
        if (f.typeParams.size > 0) { return }
        this.functionNamed(f, mangle(f.name))
    }

    proc functionNamed(f: FunN, cname: String) {
        var retTy: Ty? = null
        val rte = f.ret
        if (rte != null) {
            retTy = this.resolvedTy(rte, f.file, f.line, f.col)
            if (retTy == null) { return }
        }
        var ret = "void"
        val rt = retTy
        if (rt != null) {
            val c = this.ctype(rt, f.file, f.line, f.col)
            if (c == null) { return }
            ret = c
        }
        this.currentRet = retTy

        val params: List<String> = []
        for (p in f.params) {
            val te = p.tyEx
            if (te == null) { return }
            val pty = this.resolvedTy(te, p.file, p.line, p.col)
            if (pty == null) { return }
            val c = this.ctype(pty, p.file, p.line, p.col)
            if (c == null) { return }
            params.add("${c} ${mangle(p.name)}")
        }
        val plist = if (params.size == 0) { "void" } else { params.join(", ") }
        val signature = "${ret} ${cname}(${plist})"
        this.decls += signature + ";\n"

        this.body = []
        this.indent = 1
        this.nextTemp = 0
        // A frame owns its celled variables. Without this, a `var` a closure
        // captured inside one function stayed in the map after that function
        // was emitted, and the next frame to use the same NAME read it as a
        // cell: a `val c = true` at the top level compiled to `k_c->w.i`
        // because a different `c`, three functions earlier, had been captured.
        val savedCelledFn = this.celled
        this.celled = {}
        this.beginFunctionUnwind(ret)
        this.openScope()
        for (p in f.params) {
            val te = p.tyEx
            if (te != null) {
                val pty = this.resolvedTy(te, p.file, p.line, p.col)
                if (pty != null) {
                    this.declareLocal(p.name, pty, false)
                }
            }
        }
        // Parameters are borrowed from the caller; the body releases only
        // what it creates itself.
        this.emitBody(f.body.stmts, ret)
        this.closeScope()
        if (ret == "void") {
            this.line("return;")
        }
        this.endFunctionUnwind()
        this.celled = savedCelledFn
        val joined = this.body.join("\n")
        this.body = []
        this.defs += "\n${signature} {\n${joined}\n}\n"
    }

    /// The constructor: allocate, fill the fields the parameters name, then
    /// run whatever the body declares.
    proc constructor(c: ClassN, fields: List<SField>, name: String) {
        val params: List<String> = []
        for (p in c.ctor) {
            var fty: Ty? = null
            for (f in fields) {
                if (f.name == p.name and fty == null) { fty = f.ty }
            }
            val ty0 = fty
            if (ty0 == null) {
                this.unsupported(p.file, p.line, p.col, "a constructor parameter that is not a field")
                return
            }
            val ct = this.ctype(ty0, p.file, p.line, p.col)
            if (ct == null) { return }
            params.add("${ct} ${mangle(p.name)}")
        }
        val plist = if (params.size == 0) { "void" } else { params.join(", ") }
        val signature = "${name}* ${name}_new(${plist})"
        this.decls += signature + ";\n"

        this.body = []
        this.indent = 1
        this.nextTemp = 0
        this.beginFunctionUnwind("void*")
        this.openScope()
        for (p in c.ctor) {
            for (f in fields) {
                if (f.name == p.name) {
                    this.declareLocal(p.name, f.ty, false)
                    break
                }
            }
        }
        this.line("${name}* self = (${name}*)keal_alloc(sizeof(${name}));")
        if (this.auditMode) {
            // Counted under the class's own name, not the struct's: a
            // generic's instantiations are one class to the reader, and one
            // class to the interpreters that count the same thing.
            this.line("keal_audit_born(${cString(c.name)});")
        }
        if (classHasDeinit(c)) {
            this.line("self->kdropped = false;")
        }
        if (this.catchMode) {
            // A field initializer can unwind mid-construction; zeroed
            // fields make the release of the half-built instance safe.
            this.line("memset((void*)self, 0, sizeof(*self));")
            if (this.unwindMarks.size > 0) {
                this.unwindMarks[this.unwindMarks.size - 1].everOwned.add(
                    OwnedC("self", "${name}_release")
                )
            }
        }
        this.line("self->rc = 1;")
        if (this.weakMode) {
            this.line("self->wc = 0;")
        }
        for (p in c.ctor) {
            var fty: Ty? = null
            for (f in fields) {
                if (f.name == p.name and fty == null) { fty = f.ty }
            }
            val ty0 = fty
            if (ty0 == null) { return }
            val v = this.storedFieldValue(c, p.name, ty0, mangle(p.name), p.file, p.line, p.col)
            this.line("self->${mangle(p.name)} = ${v};")
        }

        // A field declared in the body may read `this` and the fields above.
        this.thisName = "self"
        for (fd in c.fields) {
            var fty: Ty? = null
            for (f in fields) {
                if (f.name == fd.name and fty == null) { fty = f.ty }
            }
            val ty0 = fty
            if (ty0 == null) { continue }
            val init = fd.init
            if (init != null) {
                val v0 = this.expr(init)
                val v = this.storedFieldValue(c, fd.name, ty0, v0, fd.file, fd.line, fd.col)
                this.line("self->${mangle(fd.name)} = ${v};")
            } else {
                this.unsupported(fd.file, fd.line, fd.col, "a field with no initializer")
                return
            }
        }
        this.thisName = ""
        this.closeScope()
        this.line("return self;")
        this.endFunctionUnwind()
        val joined = this.body.join("\n")
        this.body = []
        this.defs += "\n${signature} {\n${joined}\n}\n"
    }

    /// A method is a function whose first parameter is the receiver.
    proc method(c: ClassN, m: FunN, name: String) {
        // A generic method is emitted per instantiation, on demand.
        if (m.typeParams.size > 0) { return }
        this.methodNamed(c, m, name, "${name}_${mangleMethod(m.name)}")
    }

    proc methodNamed(c: ClassN, m: FunN, name: String, fnName: String) {
        var retTy: Ty? = null
        val rte = m.ret
        if (rte != null) {
            retTy = this.resolvedTy(rte, m.file, m.line, m.col)
            if (retTy == null) { return }
        }
        var ret = "void"
        val rt = retTy
        if (rt != null) {
            val c = this.ctype(rt, m.file, m.line, m.col)
            if (c == null) { return }
            ret = c
        }
        this.currentRet = retTy
        val params: List<String> = ["${name}* self"]
        for (p in m.params) {
            val te = p.tyEx
            if (te == null) { return }
            val pty = this.resolvedTy(te, p.file, p.line, p.col)
            if (pty == null) { return }
            val ct = this.ctype(pty, p.file, p.line, p.col)
            if (ct == null) { return }
            params.add("${ct} ${mangle(p.name)}")
        }
        val signature = "${ret} ${fnName}(${params.join(", ")})"
        this.decls += signature + ";\n"

        // Under the actor machinery, the four operations through which
        // values cross threads are not compiled from the prelude's
        // deterministic bodies — they *are* the scheduler: `send` and
        // `post` deep-copy outside the actor lock and enqueue under it,
        // `drain` snapshots under it, and `run` puts every actor on its
        // own OS thread and joins at quiescence. Everything else about
        // the actor classes stays ordinary compiled Keal.
        if (this.actorsMode) {
            val ab = this.actorMethodBody(c, m.name, name, m.file, m.line, m.col)
            if (ab != null) {
                this.defs += "\n${signature} {\n${ab}}\n"
                return
            }
        }

        this.body = []
        this.indent = 1
        this.nextTemp = 0
        this.beginFunctionUnwind(ret)
        this.openScope()
        for (p in m.params) {
            val te = p.tyEx
            if (te != null) {
                val pty = this.resolvedTy(te, p.file, p.line, p.col)
                if (pty != null) {
                    this.declareLocal(p.name, pty, false)
                }
            }
        }
        this.thisName = "self"
        this.emitBody(m.body.stmts, ret)
        this.thisName = ""
        this.closeScope()
        if (ret == "void") {
            this.line("return;")
        }
        this.endFunctionUnwind()
        val joined = this.body.join("\n")
        this.body = []
        this.defs += "\n${signature} {\n${joined}\n}\n"
    }

    /// The four scheduler bodies, one per monomorphized actor class. `null`
    /// for every other method, which compiles as written. The message type
    /// is the class's own parameter, read out of the instantiation's
    /// substitution — the checker has already required it copyable.
    func actorMethodBody(c: ClassN, method: String, sn: String, file: Int, atLine: Int, col: Int): String? {
        var isOp = false
        if (c.name == "ActorRef" and method == "send") { isOp = true }
        if (c.name == "Outbox" and (method == "post" or method == "drain")) { isOp = true }
        if (c.name == "ActorSystem" and method == "run") { isOp = true }
        unless (isOp) { return null }
        if (c.typeParams.size == 0) { return null }
        unless (this.tsubst.contains(c.typeParams[0].name)) { return null }
        val mTy = this.tsubst[c.typeParams[0].name]!!
        val mc = this.ctype(mTy, file, atLine, col)
        if (mc == null) { return null }
        val elem = this.elemKind(mTy, file, atLine, col)
        if (elem == null) { return null }
        // Enqueue a deep copy. The copy runs outside the lock — it only
        // reads the sender's own values — and the mutex hand-off is what
        // orders it before the receiver's read.
        if (method == "send" or method == "post") {
            var field = "k_items"
            var arg = "k_v"
            if (method == "send") {
                field = "k_mailbox"
                arg = "k_msg"
            }
            val copied = this.copyExprOf(mTy, arg, "0", file, atLine, col)
            if (copied == null) { return null }
            var b = "    ${mc} c = ${copied};\n"
            if (this.catchMode) {
                b += "    if (keal_unwinding) { return; }\n"
            }
            b += "    keal_actor_lock();\n"
            b += "    keal_list_push(self->${field}, ${elemWord(elem, "c")});\n"
            if (method == "send") {
                b += "    keal_actor_signal();\n"
            }
            b += "    keal_actor_unlock();\n"
            return b
        }
        // Snapshot under the lock, as copies — what leaves the box is
        // the drainer's alone, whichever thread posted.
        if (method == "drain") {
            val thunk = this.releaserThunk(elem)
            val copied = this.copyExprOf(mTy, elemUnword(elem, "w"), "0", file, atLine, col)
            if (copied == null) { return null }
            var b = "    KealList* out = keal_list_new(${thunk});\n"
            b += "    keal_actor_lock();\n"
            b += "    for (int64_t i = 0; i < self->k_items->len; i++) {\n"
            b += "        KealWord w = self->k_items->data[i];\n"
            b += "        ${mc} c = ${copied};\n"
            if (this.catchMode) {
                b += "        if (keal_unwinding) { keal_actor_unlock(); keal_list_release(out); return NULL; }\n"
            }
            b += "        keal_list_push(out, ${elemWord(elem, "c")});\n"
            b += "    }\n"
            b += "    keal_actor_unlock();\n"
            b += "    return out;\n"
            return b
        }
        // One OS thread per actor; `run` starts them, waits until every
        // mailbox is empty with no handler in flight, and joins. A
        // handler's panic is carried back in the run state and rethrown
        // here, on the calling thread, where a `try` around `run` can
        // catch it — without one, the actor thread has already ended the
        // process at the panic site, message and line intact.
        val margs: List<Ty> = []
        margs.add(mTy)
        val refSn = this.instantiateClass("ActorRef", margs, file, atLine, col)
        if (refSn == null) { return null }
        val relMsg = releaseFn(mTy)
        this.typesOut += "typedef struct ${sn}_actctx { ${sn}* sys; KealRunState* st; } ${sn}_actctx;\n"
        // One worker, not one actor. It looks for an actor with a message
        // and nobody inside it, takes one message, runs it, and lets go —
        // so a program with ten thousand actors asks the operating system
        // for as many threads as the machine has cores, and not ten
        // thousand.
        var t = "static void* ${sn}_actor_main(void* argp) {\n"
        t += "    ${sn}_actctx* a = (${sn}_actctx*)argp;\n"
        t += "    int64_t n = a->st->actors;\n"
        t += "    keal_actor_lock();\n"
        t += "    for (;;) {\n"
        t += "        if (a->st->stop) { break; }\n"
        // The scan starts where the last one left off, so an actor late in
        // the list is not starved by one early in it.
        t += "        int64_t idx = -1;\n"
        t += "        for (int64_t k = 0; k < n; k++) {\n"
        t += "            int64_t i = (a->st->next + k) % n;\n"
        t += "            if (a->st->busy[i]) { continue; }\n"
        t += "            if (((KealList*)a->sys->k_mailboxes->data[i].p)->len > 0) { idx = i; break; }\n"
        t += "        }\n"
        t += "        if (idx >= 0) {\n"
        t += "            a->st->next = (idx + 1) % n;\n"
        t += "            KealList* box = (KealList*)a->sys->k_mailboxes->data[idx].p;\n"
        t += "            KealClosure* h = (KealClosure*)a->sys->k_handlers->data[idx].p;\n"
        t += "            KealWord w = box->data[0];\n"
        t += "            box->len -= 1;\n"
        t += "            memmove(box->data, box->data + 1, (size_t)box->len * sizeof(KealWord));\n"
        // Held for as long as the handler runs: an actor takes its messages
        // one at a time and in order, and that is the whole of what the
        // model promises.
        t += "            a->st->busy[idx] = 1;\n"
        t += "            a->st->workers += 1;\n"
        t += "            keal_actor_unlock();\n"
        t += "            ${refSn}* ref = ${refSn}_new(box);\n"
        t += "            ${mc} msg = ${elemUnword(elem, "w")};\n"
        if (this.catchMode) {
            t += "            keal_try_depth += 1;\n"
        }
        t += "            ((void (*)(KealClosure*, ${refSn}*, ${mc}))(void*)h->fn)(h, ref, msg);\n"
        if (this.catchMode) {
            t += "            keal_try_depth -= 1;\n"
        }
        t += "            ${refSn}_release(ref);\n"
        if (relMsg != null) {
            t += "            ${relMsg}(msg);\n"
        }
        if (this.catchMode) {
            // The panic is carried over and the unwind state cleared
            // *before* the deinit sweep below, so a queued `deinit`
            // runs whole instead of tripping on its own guards.
            t += "            if (keal_unwinding) {\n"
            t += "                keal_unwinding = false;\n"
            t += "                keal_actor_lock();\n"
            t += "                if (!a->st->panicked) { a->st->panicked = 1; a->st->panic_line = keal_unwind_line; snprintf(a->st->panic_msg, sizeof a->st->panic_msg, \"%s\", keal_unwind_msg); }\n"
            t += "                a->st->stop = 1;\n"
            t += "                keal_actor_unlock();\n"
            t += "            }\n"
        }
        if (this.dropMode) {
            t += "            keal_drain_drops();\n"
        }
        t += "            keal_actor_lock();\n"
        t += "            a->st->busy[idx] = 0;\n"
        t += "            a->st->workers -= 1;\n"
        t += "            keal_actor_signal();\n"
        t += "            continue;\n"
        t += "        }\n"
        // Nothing to take. Either the run is over — which the loop in `run`
        // decides, because it can see every mailbox at once — or a message
        // is about to land.
        t += "        if (a->st->workers == 0) { break; }\n"
        t += "        keal_actor_wait();\n"
        t += "    }\n"
        t += "    keal_actor_signal();\n"
        t += "    keal_actor_unlock();\n"
        t += "    return NULL;\n"
        t += "}\n"
        this.helpers += t

        var b = "    int64_t n = self->k_handlers->len;\n"
        b += "    if (n == 0) { return; }\n"
        b += "    KealRunState st;\n"
        b += "    st.workers = 0; st.stop = 0; st.panicked = 0; st.panic_line = 0; st.panic_msg[0] = '\\0';\n"
        b += "    st.actors = n; st.next = 0;\n"
        b += "    st.busy = (int8_t*)keal_alloc((size_t)n * sizeof(int8_t));\n"
        b += "    for (int64_t i = 0; i < n; i++) { st.busy[i] = 0; }\n"
        // As many threads as the machine has cores, capped at the number of
        // actors — not one per actor.
        b += "    int64_t w = keal_actor_worker_count(n);\n"
        b += "    ${sn}_actctx* ctxs = (${sn}_actctx*)keal_alloc((size_t)w * sizeof(${sn}_actctx));\n"
        b += "    pthread_t* ts = (pthread_t*)keal_alloc((size_t)w * sizeof(pthread_t));\n"
        b += "    for (int64_t i = 0; i < w; i++) {\n"
        b += "        ctxs[i].sys = self; ctxs[i].st = &st;\n"
        b += "        if (pthread_create(&ts[i], NULL, ${sn}_actor_main, &ctxs[i]) != 0) { keal_fatal(\"could not start an actor thread\"); }\n"
        b += "    }\n"
        b += "    keal_actor_lock();\n"
        b += "    for (;;) {\n"
        b += "        int64_t queued = 0;\n"
        b += "        for (int64_t i = 0; i < n; i++) { queued += ((KealList*)self->k_mailboxes->data[i].p)->len; }\n"
        b += "        if (st.workers == 0 && (st.stop || queued == 0)) { break; }\n"
        b += "        keal_actor_wait();\n"
        b += "    }\n"
        b += "    st.stop = 1;\n"
        b += "    keal_actor_signal();\n"
        b += "    keal_actor_unlock();\n"
        b += "    for (int64_t i = 0; i < w; i++) { pthread_join(ts[i], NULL); }\n"
        b += "    free(st.busy);\n"
        b += "    free(ctxs);\n"
        b += "    free(ts);\n"
        b += "    if (st.panicked) {\n"
        b += "        keal_panic(st.panic_msg, st.panic_line);\n"
        b += "        return;\n"
        b += "    }\n"
        return b
    }

    /// A function body, where the last expression is the result when the
    /// function does not say `return`.
    proc emitBody(stmts: List<StmtN>, ret: String) {
        this.frameCells = lambdaFreeNames(stmts)
        val last = stmts.size - 1
        var i = 0
        while (i < stmts.size) {
            val st = stmts[i]
            val implicit = ret != "void" and i == last
            if (implicit and st.kind == "expr") {
                val synthetic = StmtN("return", st.line, st.col)
                synthetic.file = st.file
                synthetic.ex = st.ex
                this.stmt(synthetic)
            } else {
                this.seqStmt(st)
            }
            i += 1
        }
    }

    /// A declared type, as the checker resolved it. Written types are rare
    /// in the supported subset, so the few shapes that appear are enough.
    func resolvedTy(te: TypeEx, file: Int, atLine: Int, col: Int): Ty? {
        if (te.kind == "boundary") {
            return this.resolvedTy(te.inner!!, file, atLine, col)
        }
        if (te.kind == "named" and te.args.size == 0) {
            val name = te.name
            if (name == "Int") { return Ty("Int") }
            if (name == "Float") { return Ty("Float") }
            if (name == "Bool") { return Ty("Bool") }
            if (name == "String") { return Ty("Str") }
            if (name == "Unit") { return Ty("Unit") }
            if (name == "Any") { return Ty("Any") }
            if (this.tsubst.contains(name)) {
                return this.tsubst[name]!!
            }
            if (this.shapes.contains(name)) {
                return tyClass(name, [])
            }
            if (this.enumNamesOf.contains(name)) {
                return tyEnum(name)
            }
            this.unsupported(file, atLine, col, "the type `${name}`")
            return null
        }
        if (te.kind == "nullable") {
            val inner = this.resolvedTy(te.inner!!, file, atLine, col)
            if (inner == null) { return null }
            val reference = isReference(inner)
            val opt = tyNullable(inner)
            // A reference is its own pointer; a value gets the tagged form;
            // anything else has no representation and says so.
            if (reference or isValueOpt(opt)) {
                return opt
            }
            this.unsupported(file, atLine, col, "the type `${cTypeExName(te.inner!!)}?`")
            return null
        }
        if (te.kind == "func") {
            val ps: List<Ty> = []
            for (p in te.args) {
                val t = this.resolvedTy(p, file, atLine, col)
                if (t == null) { return null }
                ps.add(t)
            }
            val r = this.resolvedTy(te.ret!!, file, atLine, col)
            if (r == null) { return null }
            return tyFunOf(ps, r)
        }
        // named, with type arguments
        if (this.shapes.contains(te.name)) {
            val resolved: List<Ty> = []
            for (a in te.args) {
                val t = this.resolvedTy(a, file, atLine, col)
                if (t == null) { return null }
                resolved.add(t)
            }
            return tyClass(te.name, resolved)
        }
        if (te.name == "Map" and te.args.size == 2) {
            val k = this.resolvedTy(te.args[0], file, atLine, col)
            if (k == null) { return null }
            val v = this.resolvedTy(te.args[1], file, atLine, col)
            if (v == null) { return null }
            if (this.keyKind(k, file, atLine, col) == null) { return null }
            if (this.elemKind(v, file, atLine, col) == null) { return null }
            return tyMap(k, v)
        }
        if (te.name == "List" and te.args.size == 1) {
            val inner = this.resolvedTy(te.args[0], file, atLine, col)
            if (inner == null) { return null }
            // Whether the element is supported is checked here, so the
            // refusal points at the declaration.
            if (this.elemKind(inner, file, atLine, col) == null) { return null }
            return tyList(inner)
        }
        this.unsupported(file, atLine, col, "the type `${te.name}` with type arguments")
        return null
    }

    // ---- scopes and ownership ------------------------------------------

    proc openScope() {
        val sc: List<OwnedC> = []
        this.scopes.add(sc)
        val lc: List<LocalC> = []
        this.locals.add(lc)
        if (this.catchMode) {
            val id = this.nextUnwind
            this.nextUnwind += 1
            this.unwindTargets.add(UnwindTarget("KU${id}"))
            this.unwindMarks.add(UnwindMark(this.body.size, "    ".repeat(this.indent)))
        }
    }

    /// Emits the releases this block owes, and drops it. In catch mode the
    /// block also gets its unwind label — releases everything the block
    /// ever owned (all NULL-initialized up top, so order of arrival cannot
    /// matter) and chains to the enclosing label — and its hoisted
    /// declarations are inserted where the block began.
    proc closeScope() {
        if (this.locals.size > 0) {
            this.locals.removeAt(this.locals.size - 1)
        }
        if (this.scopes.size == 0) { return }
        val scope = this.scopes.removeAt(this.scopes.size - 1)
        var i = scope.size - 1
        while (i >= 0) {
            this.line("${scope[i].release}(${scope[i].name});")
            i -= 1
        }
        if (this.catchMode) {
            val target = this.unwindTargets.removeAt(this.unwindTargets.size - 1)
            val mark = this.unwindMarks.removeAt(this.unwindMarks.size - 1)
            if (target.referenced) {
                val parent = this.unwindTargets[this.unwindTargets.size - 1]
                parent.referenced = true
                val done = "KD" + target.label.substring(2, target.label.length)
                this.line("goto ${done};")
                this.line("${target.label}:;")
                var j = mark.everOwned.size - 1
                while (j >= 0) {
                    this.line("${mark.everOwned[j].release}(${mark.everOwned[j].name});")
                    j -= 1
                }
                this.line("goto ${parent.label};")
                this.line("${done}:;")
            }
            var k = 0
            while (k < mark.hoisted.size) {
                this.body.insert(mark.at + k, mark.hoisted[k])
                k += 1
            }
        }
    }

    /// Enters a function's emission in catch mode: the bottom unwind label
    /// and the poisoned `return` under it. Call before the body scope opens.
    proc beginFunctionUnwind(retC: String) {
        unless (this.catchMode) { return }
        val id = this.nextUnwind
        this.nextUnwind += 1
        this.unwindTargets.add(UnwindTarget("KUF${id}"))
        this.poison = when (retC) {
            "void" -> "return;"
            "int64_t" -> "return 0;"
            "double" -> "return 0.0;"
            "bool" -> "return false;"
            else -> {
                if (retC.endsWith("*")) { "return NULL;" } else { "return (${retC}){0};" }
            }
        }
    }

    /// Closes what `beginFunctionUnwind` opened, after the body's last
    /// normal `return`.
    proc endFunctionUnwind() {
        unless (this.catchMode) { return }
        val target = this.unwindTargets.removeAt(this.unwindTargets.size - 1)
        if (target.referenced) {
            this.line("${target.label}:;")
            this.line(this.poison)
        }
    }

    /// The check every possibly-panicking operation is followed by: a set
    /// flag unwinds to the innermost live label. Nothing is emitted when
    /// the program has no `try`.
    proc checkUnwind() {
        unless (this.catchMode) { return }
        if (this.unwindTargets.size == 0) { return }
        val last = this.unwindTargets[this.unwindTargets.size - 1]
        last.referenced = true
        this.line("if (keal_unwinding) { goto ${last.label}; }")
    }

    /// Rewrites the declaration just emitted for `name` into a plain
    /// assignment, hoisting a NULL-initialized declaration to the top of
    /// the block — the unwind label releases every name the block ever
    /// owns, so each must be a valid pointer on every path to it.
    proc hoistDeclaration(name: String) {
        unless (this.catchMode) { return }
        if (this.body.size == 0) {
            this.errors.add(DiagN(0, 0, 0, "internal: no declaration to hoist for `${name}`"))
            return
        }
        val last = this.body[this.body.size - 1]
        var padLen = 0
        while (padLen < last.length and last.get(padLen) == " ") { padLen += 1 }
        val pad = last.substring(0, padLen)
        val rest = last.substring(padLen, last.length)
        val assignPat = " ${name} = "
        val barePat = " ${name};"
        val pos = rest.indexOf(assignPat)
        var ctype = ""
        var replacement = ""
        var hasReplacement = false
        if (pos >= 0) {
            ctype = rest.substring(0, pos)
            replacement = pad + rest.substring(pos + 1, rest.length)
            hasReplacement = true
        } else if (rest.endsWith(barePat)) {
            ctype = rest.substring(0, rest.length - barePat.length)
        } else {
            this.errors.add(DiagN(0, 0, 0, "internal: cannot hoist the declaration of `${name}`"))
            return
        }
        val mark = this.unwindMarks[this.unwindMarks.size - 1]
        // A tagged pair is a struct; its empty value is the null `Any`.
        val init = if (ctype.trim() == "KealAny") { "keal_any_null()" } else { "NULL" }
        mark.hoisted.add("${mark.pad}${ctype} ${name} = ${init};")
        this.body.removeAt(this.body.size - 1)
        if (hasReplacement) { this.body.add(replacement) }
    }

    /// Emits the releases owed by the innermost `depth` blocks without
    /// dropping them, for a jump that leaves them early.
    proc releaseThrough(depth: Int) {
        var start = this.scopes.size - depth
        if (start < 0) { start = 0 }
        val calls: List<String> = []
        var i = this.scopes.size - 1
        while (i >= start) {
            val s = this.scopes[i]
            var j = s.size - 1
            while (j >= 0) {
                calls.add("${s[j].release}(${s[j].name});")
                j -= 1
            }
            i -= 1
        }
        for (c in calls) {
            this.line(c)
        }
    }

    /// Records a name of the frame being emitted.
    proc declareLocal(name: String, t: Ty, mutable: Bool) {
        if (this.locals.size > 0) {
            this.locals[this.locals.size - 1].add(LocalC(name, t, mutable))
        }
    }

    /// Resolves a name: an alias set up for a default argument wins, then a
    /// capture reads through the environment, then the C variable itself.
    /// True when a name is bound where the code being emitted stands: a
    /// local, a parameter, an alias standing in for one while a default
    /// argument is emitted, or something a lambda captured. Such a binding
    /// hides anything global of the same name.
    func inScope(name: String): Bool {
        val aliases = this.paramAlias
        if (aliases != null) {
            if (aliases.contains(name)) { return true }
        }
        val env = this.captureEnv
        if (env != null) {
            if (env.contains(name)) { return true }
        }
        for (scope in this.locals) {
            for (l in scope) {
                if (l.name == name) { return true }
            }
        }
        return false
    }

    func varRef(name: String): String {
        val aliases = this.paramAlias
        if (aliases != null) {
            val v = aliases[name]
            if (v != null) { return v }
        }
        val env = this.captureEnv
        if (env != null) {
            val cap = env[name]
            if (cap != null) { return "env->${cap.field}" }
        }
        return mangle(name)
    }

    proc ownCell(name: String) {
        this.hoistDeclaration(name)
        val o = OwnedC(name, "keal_cell_release")
        if (this.unwindMarks.size > 0) {
            this.unwindMarks[this.unwindMarks.size - 1].everOwned.add(o)
        }
        if (this.scopes.size > 0) {
            this.scopes[this.scopes.size - 1].add(o)
        }
    }

    proc own(name: String, t: Ty) {
        val release = releaseFn(t)
        if (release == null) { return }
        this.hoistDeclaration(name)
        val o = OwnedC(name, release)
        if (this.unwindMarks.size > 0) {
            this.unwindMarks[this.unwindMarks.size - 1].everOwned.add(o)
        }
        if (this.scopes.size > 0) {
            this.scopes[this.scopes.size - 1].add(o)
        }
    }

    /// Hands a reference to whoever is receiving it, so this block no
    /// longer releases it.
    /// Hands ownership of `name` out of this frame, and says whether this
    /// frame had any to hand.
    ///
    /// `false` means the value was BORROWED — `this`, a parameter, a field
    /// read that took no reference — and a caller that becomes its owner has
    /// to be given a reference of its own.
    func disown(name: String): Bool {
        var owned = false
        var i = 0
        while (i < this.scopes.size) {
            val kept: List<OwnedC> = []
            for (o in this.scopes[i]) {
                unless (o.name == name) { kept.add(o) }
            }
            if (kept.size != this.scopes[i].size) { owned = true }
            this.scopes[i] = kept
            i += 1
        }
        return owned
    }

    /// Binds a counted expression to a temp this block owns.
    func ownTemp(expr: String): String {
        return this.ownTempOf(Ty("Str"), expr)
    }

    func ownTempOf(t: Ty, expr: String): String {
        val tv = this.temp()
        val c = this.ctype(t, 0, 0, 0) ?: "void*"
        this.line("${c} ${tv} = ${expr};")
        this.own(tv, t)
        this.checkUnwind()
        return tv
    }

    // ---- statements ----------------------------------------------------

    proc block(stmts: List<StmtN>) {
        this.openScope()
        for (s in stmts) {
            this.seqStmt(s)
        }
        this.closeScope()
    }

    /// Emits one statement of a sequence. With a `deinit` in the program,
    /// the statement's expression temporaries are released right after it —
    /// a value they pinned dies at the boundary, exactly when the
    /// interpreters kill it — and the pending `deinit`s run. A program
    /// without one compiles byte-for-byte as before.
    proc seqStmt(s: StmtN) {
        var mark = 0
        if (this.scopes.size > 0) { mark = this.scopes[this.scopes.size - 1].size }
        this.stmt(s)
        this.drainAfterStmt(s, mark)
    }

    proc drainAfterStmt(s: StmtN, mark: Int) {
        unless (this.dropMode) { return }
        if (s.kind == "return" or s.kind == "break" or s.kind == "continue" or s.kind == "throw") {
            return
        }
        // The statement's own temps: everything it registered in this
        // scope, except locals (they live to the block's end) and cells
        // (a later lambda may still capture one).
        val released: List<OwnedC> = []
        if (this.scopes.size > 0) {
            val scope = this.scopes[this.scopes.size - 1]
            val kept: List<OwnedC> = []
            var i = 0
            while (i < scope.size) {
                val o = scope[i]
                if (i >= mark and o.name.startsWith("_t") and o.release != "keal_cell_release") {
                    released.add(o)
                } else {
                    kept.add(o)
                }
                i += 1
            }
            this.scopes[this.scopes.size - 1] = kept
        }
        for (o in released) {
            this.line("${o.release}(${o.name});")
            if (this.catchMode) {
                // The unwind label still lists the name; empty keeps it safe.
                if (o.release == "keal_any_release") {
                    this.line("${o.name} = keal_any_null();")
                } else {
                    this.line("${o.name} = NULL;")
                }
            }
        }
        this.line("keal_drain_drops();")
        this.checkUnwind()
    }

    proc stmt(s: StmtN) {
        // What a macro expanded to: its own scope, so the bindings it made
        // are gone at the closing brace.
        if (s.kind == "block") {
            this.line("{")
            this.indent += 1
            this.openScope()
            for (st in s.blk!!.stmts) {
                this.seqStmt(st)
            }
            this.closeScope()
            this.indent -= 1
            this.line("}")
            return
        }
        if (s.kind == "let") {
            // The declared type wins where it exists: `val x: Int? = 5`
            // stores a wrapped value, not a bare one.
            val init = s.init!!
            var declared: Ty? = null
            val ann = s.tyEx
            if (ann != null) {
                val before = this.errors.size
                declared = this.resolvedTy(ann, s.file, s.line, s.col)
                if (declared == null) {
                    this.truncateErrors(before)
                }
            }
            var ty0 = declared
            if (ty0 == null) { ty0 = this.ety(init) }
            val ty = ty0
            if (ty == null) { return }
            val c = this.ctype(ty, s.file, s.line, s.col)
            if (c == null) { return }
            val varName = mangle(s.name)
            // A binding at the program's top level is a C global, living for
            // the program; nothing releases it.
            if (this.atTopLevel and this.scopes.size == 1) {
                if (this.auditMode) {
                    this.auditRootNames.add(varName)
                    this.auditRootTypes.add(ty)
                }
                this.globalVars[s.name] = true
                if (ty.kind == "Any") { this.anyGlobals[s.name] = true }
                this.declareLocal(s.name, ty, s.mutable)
                this.globalDecls += "static ${c} ${varName};\n"
                val value = this.coercedTo(init, ty)
                this.line("${varName} = ${retained(ty, value)};")
                return
            }
            this.declareLocal(s.name, ty, s.mutable)
            // A `var` some lambda captures lives in a shared cell, so the
            // frame and its closures see one variable.
            if (s.mutable and this.frameCells.contains(s.name)) {
                val kind = this.elemKind(ty, s.file, s.line, s.col)
                if (kind == null) { return }
                val thunk = this.releaserThunk(kind)
                this.line("KealCell* ${varName} = keal_cell_new(${thunk});")
                this.ownCell(varName)
                val value = this.expr(init)
                val stored = retained(ty, value)
                this.line("${varName}->w = ${elemWord(kind, stored)};")
                this.celled[s.name] = CellInfo(ty, kind)
                return
            }
            val value = this.coercedTo(init, ty)
            if (countedC(ty)) {
                this.line("${c} ${varName} = ${retained(ty, value)};")
                this.own(varName, ty)
            } else {
                this.line("${c} ${varName} = ${value};")
            }
            return
        }
        if (s.kind == "expr") {
            this.discardJoin = true
            val value = this.expr(s.ex!!)
            this.discardJoin = false
            // A call for its effect still has to be emitted; a bare value
            // does not, and C would warn about it.
            if (value.endsWith(")") or value.startsWith("_t")) {
                this.line("(void)(${value});")
            }
            return
        }
        if (s.kind == "return") {
            val e = s.ex
            if (e != null) {
                val target = this.currentRet
                var ty0 = target
                if (ty0 == null) { ty0 = this.ety(e) }
                val ty = ty0
                if (ty == null) { return }
                val v = if (target != null) {
                    this.coercedTo(e, target)
                } else {
                    this.expr(e)
                }
                val c = this.ctype(ty, e.file, e.line, e.col)
                if (c == null) { return }
                if (countedC(ty)) {
                    // The caller becomes the owner; stop releasing it, but
                    // still release everything else before leaving.
                    //
                    // If this frame owned no reference to it, the value was
                    // borrowed: `return this`, or returning a parameter. The
                    // caller will release what it is given, so it has to be
                    // given a reference of its own — without this, every
                    // `return this` in a builder handed back one release more
                    // than it handed out, and the object died while its
                    // bindings still pointed at it.
                    val owned = this.disown(v)
                    var out = v
                    unless (owned) {
                        val t = this.temp()
                        this.line("${c} ${t} = ${retained(ty, v)};")
                        out = t
                    }
                    val depth = this.scopes.size
                    this.releaseThrough(depth)
                    this.line("return ${out};")
                } else {
                    val t = this.temp()
                    this.line("${c} ${t} = ${v};")
                    val depth = this.scopes.size
                    this.releaseThrough(depth)
                    this.line("return ${t};")
                }
            } else {
                val depth = this.scopes.size
                this.releaseThrough(depth)
                this.line("return;")
            }
            return
        }
        if (s.kind == "while") {
            this.line("while (1) {")
            this.indent += 1
            this.openScope()
            val c = this.condition(s.ex!!)
            this.line("if (!${c}) {")
            this.indent += 1
            this.releaseThrough(1)
            this.line("break;")
            this.indent -= 1
            this.line("}")
            this.loops.add(this.scopes.size)
            this.block(s.body!!.stmts)
            this.loops.removeAt(this.loops.size - 1)
            this.closeScope()
            this.indent -= 1
            this.line("}")
            return
        }
        if (s.kind == "for") {
            this.forLoop(s.name, s.ex!!, s.body!!, s.file, s.line, s.col)
            return
        }
        if (s.kind == "throw") {
            // A thrown message is the same panic every built-in failure
            // raises; uncaught, it ends the program identically on all
            // three engines. A value of any other type crosses whole as an
            // `Any`, and renders to that same message, so a `catch (e)`
            // reads the same text either way.
            val ety = this.ety(s.ex!!)
            if (ety != null and ety.kind == "Str") {
                val m = this.expr(s.ex!!)
                this.line("keal_panic(${m}->bytes, ${s.line});")
            } else {
                val v = this.expr(s.ex!!)
                val any = this.anyOf(ety, v, s.file, s.ex!!.line, s.ex!!.col)
                this.line("keal_throw_value(${any}, ${s.line});")
            }
            this.checkUnwind()
            return
        }
        if (s.kind == "try") {
            if (s.catches.size == 0) { return }
            // The body runs under a counted `try`; any panic in its
            // dynamic extent unwinds — every frame releasing its own
            // holdings on the way — to the catch label, which adopts
            // the message and runs the handler.
            val id = this.nextUnwind
            this.nextUnwind += 1
            this.line("keal_try_depth++;")
            this.line("{")
            this.indent += 1
            this.unwindTargets.add(UnwindTarget("KC${id}"))
            this.openScope()
            for (st in s.body!!.stmts) {
                this.seqStmt(st)
            }
            this.closeScope()
            val tryTarget = this.unwindTargets.removeAt(this.unwindTargets.size - 1)
            val caught = tryTarget.referenced
            this.indent -= 1
            this.line("}")
            this.line("keal_try_depth--;")
            this.line("goto KE${id};")
            if (caught) {
                this.line("KC${id}:;")
                this.line("keal_try_depth--;")
            }
            // The clauses are tried in order, as the interpreters try
            // them: the first whose type the thrown value answers to takes
            // it whole, and a clause naming no type takes the message.
            // With nothing in the body able to panic, all of this is dead
            // code behind the unconditional jump — but it still compiles,
            // so its diagnostics and its names stay real.
            val last = s.catches.size - 1
            var ci = 0
            while (ci < s.catches.size) {
                val c = s.catches[ci]
                var target: Ty? = null
                if (c.tyEx != null) {
                    target = this.isTarget(c.tyEx!!, s.file, c.line, c.col)
                    if (target == null) { return }
                    val test = this.unwindTest(target!!, s.file, c.line, c.col)
                    this.line("if (${test}) {")
                } else {
                    this.line("{")
                }
                this.indent += 1
                this.openScope()
                val eVar = mangle(c.name)
                if (target != null) {
                    val a = this.temp()
                    val src = if (caught) { "keal_unwind_value_take()" } else { "keal_any_null()" }
                    this.line("KealAny ${a} = ${src};")
                    val payload = this.anyPayload(target!!, a, s.file, c.line, c.col)
                    if (payload == null) { return }
                    val ct = this.ctype(target!!, s.file, c.line, c.col)
                    if (ct == null) { return }
                    this.line("${ct} ${eVar} = ${payload};")
                    this.own(eVar, target!!)
                    this.declareLocal(c.name, target!!, false)
                } else {
                    val src = if (caught) { "keal_unwind_take()" } else { "keal_str_empty()" }
                    this.line("KealStr* ${eVar} = ${src};")
                    this.own(eVar, Ty("Str"))
                    this.declareLocal(c.name, Ty("Str"), false)
                }
                for (st in c.handler.stmts) {
                    this.seqStmt(st)
                }
                this.closeScope()
                // The last clause falls through to the end on its own; an
                // earlier one has to jump past the clauses under it.
                if (ci != last) {
                    this.line("goto KE${id};")
                }
                this.indent -= 1
                this.line("}")
                ci += 1
            }
            // Nothing matched: it goes on unwinding, unchanged. A clause
            // naming no type always matches, so this is only emitted when
            // every clause names one.
            if (s.catches[last].tyEx != null) {
                this.checkUnwind()
            }
            this.line("KE${id}:;")
            return
        }
        if (s.kind == "break" or s.kind == "continue") {
            var depth = 1
            if (this.loops.size > 0) {
                depth = this.scopes.size - this.loops[this.loops.size - 1] + 1
            }
            this.releaseThrough(depth)
            this.line(if (s.kind == "break") { "break;" } else { "continue;" })
            return
        }
        if (s.kind == "func") {
            val f = s.funDecl!!
            this.unsupported(f.file, f.line, f.col, "nested functions")
            return
        }
        if (s.kind == "class") {
            val c = s.classDecl!!
            this.unsupported(c.file, c.line, c.col, "classes and records")
            return
        }
        // destructure
        val pattern = s.pattern!!
        val init = s.init!!
        val ity = this.ety(init)
        if (ity == null or ity.kind != "Class") {
            this.unsupported(pattern.file, pattern.line, pattern.col, "destructuring this value")
            return
        }
        // The constructor fields, in order, at the value's arguments.
        val subst: Map<String, Ty> = {}
        val cd = this.classDecls[ity.name]
        if (cd != null) {
            var i = 0
            while (i < cd.typeParams.size and i < ity.args.size) {
                subst[cd.typeParams[i].name] = ity.args[i]
                i += 1
            }
        }
        val fields: List<SField> = []
        val raw = this.shapes[ity.name]
        if (raw != null) {
            for (f in raw) { fields.add(SField(f.name, substitute(f.ty, subst))) }
        }
        val v = this.expr(init)
        var i = 0
        while (i < pattern.binds.size and i < fields.size) {
            val bind = pattern.binds[i]
            if (bind == "_") {
                i += 1
                continue
            }
            val fty = fields[i].ty
            val ct = this.ctype(fty, pattern.file, pattern.line, pattern.col)
            if (ct == null) { return }
            this.declareLocal(bind, fty, false)
            val access = "${v}->${mangle(fields[i].name)}"
            val value = retained(fty, access)
            this.line("${ct} ${mangle(bind)} = ${value};")
            if (countedC(fty)) {
                this.own(mangle(bind), fty)
            }
            i += 1
        }
    }

    proc forLoop(varName: String, iter: Ex, body: BlockN, file: Int, atLine: Int, col: Int) {
        val ity = this.ety(iter)
        if (ity != null and ity.kind == "List") {
            this.listLoop(varName, iter, ity.args[0], body, file, atLine, col)
            return
        }
        // A map yields its keys, in insertion order, over a snapshot.
        if (ity != null and ity.kind == "Map") {
            val kt = ity.args[0]
            val kk = this.keyKind(kt, file, atLine, col)
            if (kk == null) { return }
            val ct = this.ctype(kt, file, atLine, col)
            if (ct == null) { return }
            this.openScope()
            val m = this.expr(iter)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_map_keys_snapshot(${m});")
            this.own(snap, tyList(kt))
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            this.openScope()
            this.declareLocal(varName, kt, false)
            this.line("${ct} ${mangle(varName)} = ${elemUnword(kk, "${snap}->data[${i}]")};")
            this.loops.add(this.scopes.size)
            for (st in body.stmts) {
                this.stmt(st)
            }
            this.loops.removeAt(this.loops.size - 1)
            this.closeScope()
            this.indent -= 1
            this.line("}")
            this.closeScope()
            return
        }
        // A string yields its characters, over a snapshot of them.
        if (ity != null and ity.kind == "Str") {
            this.openScope()
            val s = this.expr(iter)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_str_chars(${s});")
            this.own(snap, tyList(Ty("Str")))
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            this.openScope()
            this.declareLocal(varName, Ty("Str"), false)
            // The loop variable borrows from the character list, whose
            // lifetime spans the loop.
            this.line("KealStr* ${mangle(varName)} = ((KealStr*)${snap}->data[${i}].p);")
            this.loops.add(this.scopes.size)
            for (st in body.stmts) {
                this.stmt(st)
            }
            this.loops.removeAt(this.loops.size - 1)
            this.closeScope()
            this.indent -= 1
            this.line("}")
            this.closeScope()
            return
        }
        // A range compiles to a plain C loop with no allocation.
        unless (iter.kind == "range") {
            this.unsupported(file, atLine, col, "iterating over anything but a range or a list")
            return
        }
        val from = this.expr(iter.kids[0])
        val to = this.expr(iter.kids[1])
        val limit = this.temp()
        this.declareLocal(varName, Ty("Int"), false)
        val v = mangle(varName)
        this.line("const int64_t ${limit} = ${to};")
        this.line("for (int64_t ${v} = ${from}; ${v} < ${limit}; ${v}++) {")
        this.indent += 1
        this.loops.add(this.scopes.size + 1)
        this.block(body.stmts)
        this.loops.removeAt(this.loops.size - 1)
        this.indent -= 1
        this.line("}")
    }

    /// A `for` over a list walks a snapshot, so the loop sees what the list
    /// held when it started, whatever the body does to it.
    proc listLoop(varName: String, iter: Ex, elemTy: Ty, body: BlockN, file: Int, atLine: Int, col: Int) {
        val elem = this.elemKind(elemTy, file, atLine, col)
        if (elem == null) { return }
        val ct = this.ctype(elemTy, file, atLine, col)
        if (ct == null) { return }

        this.openScope()
        val l = this.expr(iter)
        val snap = this.temp()
        this.line("KealList* ${snap} = keal_list_snapshot(${l});")
        this.own(snap, tyList(elemTy))

        val i = this.temp()
        this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
        this.indent += 1
        this.openScope()
        this.declareLocal(varName, elemTy, false)
        val v = mangle(varName)
        this.line("${ct} ${v} = ${elemUnword(elem, "${snap}->data[${i}]")};")
        // The loop variable borrows from the snapshot, whose lifetime spans
        // the loop, so it is not retained per turn.
        this.loops.add(this.scopes.size)
        for (st in body.stmts) {
            this.stmt(st)
        }
        this.loops.removeAt(this.loops.size - 1)
        this.closeScope()
        this.indent -= 1
        this.line("}")
        this.closeScope()
    }

    // ---- expressions ---------------------------------------------------

    /// Emits whatever `e` needs as statements and returns a C rvalue for it.
    /// A counted result is always an owned reference; the receiving block
    /// releases it.
    func expr(e: Ex): String {
        if (e.kind == "int") { return "INT64_C(${e.iVal})" }
        // The ordinal, and a comment so the C reads as the program did.
        if (e.kind == "variant") {
            return "INT64_C(${e.iVal}) /* ${e.enumName}.${e.text} */"
        }
        if (e.kind == "float") { return formatDouble(e.fVal) }
        if (e.kind == "bool") { return e.text }
        if (e.kind == "str") {
            val idx = this.intern(e.text)
            return this.ownTemp("keal_str_retain(_str${idx})")
        }
        if (e.kind == "ident") {
            val name = e.text
            // Smart casts change the type without changing the variable: the
            // declared type says whether to unwrap the tagged form.
            var declared: Ty? = null
            var si = this.locals.size - 1
            while (si >= 0 and declared == null) {
                val sc = this.locals[si]
                var j = sc.size - 1
                while (j >= 0 and declared == null) {
                    if (sc[j].name == name) { declared = sc[j].ty }
                    j -= 1
                }
                si -= 1
            }
            val declTy = declared
            if (declTy != null) {
                if (isValueOpt(declTy)) {
                    val et = this.ety(e)
                    var narrowed = false
                    if (et != null) {
                        narrowed = not isValueOpt(tyNullable(et)) or et.kind != "Nullable"
                    }
                    val inner = declTy.args[0]
                    var same = false
                    if (et != null) { same = tyEq(et, inner) }
                    if (narrowed and same) {
                        val v = this.varRef(name)
                        return optGet(inner, v)
                    }
                }
            }
            // An `is` narrowed this `Any`: the C local is still the
            // tagged pair, and the payload is read out borrowed — the
            // variable keeps its reference for the narrowed scope.
            var declaredAny = declTy != null and declTy.kind == "Any"
            if (declTy == null and this.anyGlobals.contains(name)) { declaredAny = true }
            if (declaredAny) {
                val t = this.ety(e)
                if (t != null and t.kind != "Any" and t.kind != "Error") {
                    val v = this.varRef(name)
                    val read = this.anyPayload(t, v, e.file, e.line, e.col)
                    if (read == null) { return "0" }
                    if (countedC(t)) {
                        val call = retained(t, read)
                        return this.ownTempOf(t, call)
                    }
                    return read
                }
            }
            val cell = this.celled[name]
            if (cell != null) {
                val access = elemUnword(cell.elem, "${this.varRef(name)}->w")
                if (countedC(cell.ty)) {
                    val call = retained(cell.ty, access)
                    return this.ownTempOf(cell.ty, call)
                }
                return access
            }
            val v = this.varRef(name)
            val ty = this.ety(e)
            if (ty != null and countedC(ty)) {
                val call = retained(ty, v)
                return this.ownTempOf(ty, call)
            }
            return v
        }
        if (e.kind == "unary") {
            val r = this.expr(e.kids[0])
            if (e.text == "not") { return "(!${r})" }
            // `~` on `int64_t` is total: it is `-x - 1`, and `~INT64_MIN` is
            // `INT64_MAX`. Nothing to check.
            if (e.text == "bnot") { return "(~${r})" }
            return "(-${r})"
        }
        if (e.kind == "binary") { return this.binary(e) }
        if (e.kind == "logical") { return this.logical(e) }
        if (e.kind == "if") { return this.ifExpr(e) }
        if (e.kind == "ternary") { return this.ternary(e) }
        if (e.kind == "call") { return this.call(e) }
        if (e.kind == "interp") { return this.interpolate(e) }
        if (e.kind == "assign") {
            this.assign(e.kids[0], e.assignOp, e.kids[1], e)
            return "0"
        }
        if (e.kind == "null") { return "NULL" }
        if (e.kind == "elvis") { return this.elvis(e) }
        if (e.kind == "notnull") {
            val inner = e.kids[0]
            val it0 = this.ety(inner)
            if (it0 != null and it0.kind == "Any") {
                val v = this.expr(inner)
                val t = this.temp()
                this.line("const KealAny ${t} = ${v};")
                this.line("if (${t}.ti == NULL) { keal_panic(\"`!!` was applied to a null value\", ${e.line}); }")
                this.checkUnwind()
                return t
            }
            if (it0 != null and it0.kind == "Nullable") {
                if (isValueOpt(it0)) {
                    val it = it0.args[0]
                    val v = this.expr(inner)
                    this.line("if (!${optHas(it, v)}) { keal_panic(\"`!!` was applied to a null value\", ${e.line}); }")
                    this.checkUnwind()
                    return optGet(it, v)
                }
            }
            val v = this.expr(inner)
            this.line("if (${v} == NULL) { keal_panic(\"`!!` was applied to a null value\", ${e.line}); }")
            this.checkUnwind()
            return v
        }
        if (e.kind == "this") {
            unless (this.thisName == "") { return this.thisName }
            this.unsupported(e.file, e.line, e.col, "`this` outside a method")
            return "0"
        }
        if (e.kind == "lambda") { return this.lambda(e) }
        if (e.kind == "list") { return this.listLiteral(e) }
        if (e.kind == "map") { return this.mapLiteral(e) }
        if (e.kind == "index") { return this.indexGet(e, e.kids[0], e.kids[1]) }
        if (e.kind == "field") { return this.field(e) }
        if (e.kind == "method") { return this.methodCall(e) }
        if (e.kind == "when") { return this.whenExpr(e) }
        if (e.kind == "is") {
            val value = e.kids[0]
            val vt = this.ety(value)
            unless (vt != null and vt.kind == "Any") {
                this.unsupported(e.file, e.line, e.col, "`is` on anything but an `Any`")
                return "0"
            }
            val v = this.expr(value)
            val target = this.isTarget(e.tyEx!!, e.file, e.line, e.col)
            if (target == null) { return "0" }
            val test = this.anyIsTest(target, v, e.file, e.line, e.col)
            if (e.negated) { return "(!${test})" }
            return test
        }
        this.unsupported(e.file, e.line, e.col, describeExprC(e))
        return "0"
    }

    /// A lambda becomes a top-level C function and an environment struct.
    func lambda(e: Ex): String {
        val ft0 = this.ety(e)
        if (ft0 == null or ft0.kind != "Fun") {
            this.unsupported(e.file, e.line, e.col, "a lambda with no inferred type")
            return "0"
        }
        val ft = ft0

        // Free names of the body, classified against the enclosing frame.
        val free: List<String> = []
        val bound: List<String> = []
        for (p in e.params) { bound.add(p.name) }
        collectFree(e.body!!.stmts, bound, free)
        val captures: List<Capture> = []
        for (name in free) {
            var seen = false
            for (cap in captures) {
                if (cap.name == name) { seen = true }
            }
            if (seen) { continue }
            // A celled `var` is captured as its cell.
            val cell = this.celled[name]
            if (cell != null) {
                captures.add(Capture(name, cell.ty, true))
                continue
            }
            // What is in scope wins over what is global — the local and the
            // enclosing lambda's environment are looked up FIRST, and the
            // global only answers for a name neither claims.
            //
            // The other order was a silent miscompile. `Sequence.take(n)` has
            // a parameter `n` and its inner lambda calls a captured `next`; a
            // program with a top-level `n` or `next` made those reach the
            // PROGRAM's, so `take(2)` took as many as the program's `n` said
            // and the sequence yielded values from somewhere else entirely.
            //
            // At the top level the "local" found below IS the global: the
            // program's own bindings live in that frame's scope. Only inside
            // a function or another lambda does a local of the same name mean
            // a different binding, and only there does it win.
            var local: LocalC? = null
            var si = this.locals.size - 1
            while (si >= 0 and local == null) {
                val sc = this.locals[si]
                var j = sc.size - 1
                while (j >= 0 and local == null) {
                    if (sc[j].name == name) { local = sc[j] }
                    j -= 1
                }
                si -= 1
            }
            var inScope = local != null
            val envNow = this.captureEnv
            if (envNow != null and envNow[name] != null) { inScope = true }
            if ((!inScope or this.atTopLevel) and this.globalVars.contains(name)) { continue }
            val loc = local
            if (loc != null) {
                if (loc.mutable) {
                    // A `var` no lambda was seen to capture cannot be here.
                    this.unsupported(e.file, e.line, e.col, "capturing the `var` `${name}`")
                    return "0"
                }
                captures.add(Capture(name, loc.ty, false))
                continue
            }
            // A capture of the enclosing lambda's own environment.
            val env = this.captureEnv
            var fromEnv: CapInfo? = null
            if (env != null) { fromEnv = env[name] }
            val fe = fromEnv
            if (fe != null) {
                captures.add(Capture(name, fe.ty, false))
                continue
            }
            val two: List<Ty?> = [null, null]
            val global = this.globalFuns.contains(name) or this.globalVars.contains(name) or this.shapes.contains(name) or globalSig(name, two) != null
            unless (global) {
                // Guessing here is how a capture silently becomes a dangling
                // C identifier; refusing names the gap.
                this.unsupported(e.file, e.line, e.col, "capturing `${name}`, which this backend cannot see")
                return "0"
            }
        }

        val id = this.nextLambda
        this.nextLambda += 1
        val envName = "K_Lam${id}"

        // The environment struct: the closure header, then the captures.
        var st = "typedef struct ${envName} {\n    KealClosure head;\n"
        for (cap in captures) {
            var ct = "KealCell*"
            unless (cap.isCell) {
                val c = this.ctype(cap.ty, e.file, e.line, e.col)
                if (c == null) { return "0" }
                ct = c
            }
            st += "    ${ct} ${mangle(cap.name)};\n"
        }
        st += "} ${envName};\n"

        // The drop: release counted captures, free the struct.
        var dropText = "static void ${envName}_drop(KealClosure* c) {\n    ${envName}* env = (${envName}*)c;\n"
        for (cap in captures) {
            var rel: String? = "keal_cell_release"
            unless (cap.isCell) { rel = releaseFn(cap.ty) }
            val r = rel
            if (r != null) {
                dropText += "    ${r}(env->${mangle(cap.name)});\n"
            }
        }
        dropText += "    (void)env;\n    free(c);\n}\n"
        if (this.auditMode) {
            // A closure's captures live in a struct only this code knows the
            // shape of, so its walk is paired with its `drop` — the one
            // function the closure header already carries that names it.
            var walk = "static void ${envName}_walk(void* p) {\n    ${envName}* env = (${envName}*)p;\n"
            for (cap in captures) {
                var ml: String? = "keal_cell_mark(env->${mangle(cap.name)});"
                unless (cap.isCell) { ml = markLine(cap.ty, "env->" + mangle(cap.name)) }
                val m = ml
                if (m != null) {
                    walk += "    ${m}\n"
                }
            }
            walk += "    (void)env;\n}\n"
            dropText += walk
            this.auditPairs.add([envName + "_drop", envName + "_walk"])
        }

        // The body, compiled as its own function with `env` in scope.
        val fret = ft.ret!!
        var retC = "void"
        unless (fret.kind == "Unit") {
            val c = this.ctype(fret, e.file, e.line, e.col)
            if (c == null) { return "0" }
            retC = c
        }
        var lambdaRet: Ty? = null
        unless (fret.kind == "Unit") { lambdaRet = fret }
        var sig = "static ${retC} ${envName}_call(KealClosure* _c"
        var pi = 0
        while (pi < e.params.size and pi < ft.params.size) {
            val ct = this.ctype(ft.params[pi].ty, e.file, e.line, e.col)
            if (ct == null) { return "0" }
            sig += ", ${ct} ${mangle(e.params[pi].name)}"
            pi += 1
        }
        sig += ")"

        val savedBody = this.body
        this.body = []
        val savedScopes = this.scopes
        this.scopes = []
        val savedLocals = this.locals
        this.locals = []
        val savedUnwindT = this.unwindTargets
        this.unwindTargets = []
        val savedUnwindM = this.unwindMarks
        this.unwindMarks = []
        val savedPoison = this.poison
        this.poison = ""
        val savedEnv = this.captureEnv
        val savedIndent = this.indent
        val savedLoops = this.loops
        this.loops = []
        this.indent = 1
        this.beginFunctionUnwind(retC)
        this.openScope()
        pi = 0
        while (pi < e.params.size and pi < ft.params.size) {
            this.declareLocal(e.params[pi].name, ft.params[pi].ty, false)
            pi += 1
        }
        val newEnv: Map<String, CapInfo> = {}
        for (cap in captures) {
            newEnv[cap.name] = CapInfo(mangle(cap.name), cap.ty)
        }
        this.captureEnv = newEnv
        val savedCelled = this.celled
        this.celled = {}
        val savedCells = this.frameCells
        this.frameCells = {}
        for (cap in captures) {
            if (cap.isCell) {
                val kind = this.elemKind(cap.ty, e.file, e.line, e.col)
                if (kind == null) { return "0" }
                this.celled[cap.name] = CellInfo(cap.ty, kind)
            }
        }
        val savedTop = this.atTopLevel
        this.atTopLevel = false
        val savedRet = this.currentRet
        this.currentRet = lambdaRet
        this.line("${envName}* env = (${envName}*)_c;\n    (void)env;")
        this.emitBody(e.body!!.stmts, retC)
        this.currentRet = savedRet
        this.closeScope()
        if (retC == "void") {
            this.line("return;")
        }
        this.endFunctionUnwind()
        val compiled = this.body.join("\n")
        this.atTopLevel = savedTop
        this.celled = savedCelled
        this.frameCells = savedCells
        this.body = savedBody
        this.scopes = savedScopes
        this.locals = savedLocals
        this.unwindTargets = savedUnwindT
        this.unwindMarks = savedUnwindM
        this.poison = savedPoison
        this.captureEnv = savedEnv
        this.indent = savedIndent
        this.loops = savedLoops

        // The capture copy, when the actor machinery is in play and every
        // capture can cross: a fresh environment whose values are deep
        // copies — `spawn`'s semantics that an actor's state is its own.
        var copyFnText: String? = null
        if (this.actorsMode) {
            val copyLines: List<String> = []
            var allCopyable = true
            for (cap in captures) {
                if (cap.isCell) {
                    val kind = this.elemKind(cap.ty, e.file, e.line, e.col)
                    if (kind == null) {
                        allCopyable = false
                        break
                    }
                    val cv = this.copyExprOf(cap.ty, elemUnword(kind, "env->${mangle(cap.name)}->w"), "0", e.file, e.line, e.col)
                    if (cv == null) {
                        allCopyable = false
                        break
                    }
                    copyLines.add("    out->${mangle(cap.name)} = keal_cell_new(env->${mangle(cap.name)}->release_inner);\n    out->${mangle(cap.name)}->w = ${elemWord(kind, cv)};\n")
                } else {
                    val cv = this.copyExprOf(cap.ty, "env->${mangle(cap.name)}", "0", e.file, e.line, e.col)
                    if (cv == null) {
                        allCopyable = false
                        break
                    }
                    copyLines.add("    out->${mangle(cap.name)} = ${cv};\n")
                }
            }
            if (allCopyable) {
                var cf = "static KealClosure* ${envName}_copy(KealClosure* c) {\n    ${envName}* env = (${envName}*)c;\n    ${envName}* out = (${envName}*)keal_alloc(sizeof(${envName}));\n    out->head.rc = 1;\n    out->head.fn = (KealCode)${envName}_call;\n    out->head.drop = ${envName}_drop;\n    out->head.copy = ${envName}_copy;\n"
                for (l in copyLines) { cf += l }
                cf += "    return &out->head;\n}\n"
                copyFnText = cf
            }
        }

        this.lambdaDefs += "\n${st}${dropText}${sig} {\n${compiled}\n}\n"
        val cft = copyFnText
        if (cft != null) {
            this.lambdaDefs += cft
        }

        // Creation: allocate, fill the header, copy the captures in.
        val t = this.temp()
        this.line("${envName}* ${t}_env = (${envName}*)keal_alloc(sizeof(${envName}));")
        this.line("${t}_env->head.rc = 1;")
        this.line("${t}_env->head.fn = (KealCode)${envName}_call;")
        this.line("${t}_env->head.drop = ${envName}_drop;")
        if (copyFnText != null) {
            this.line("${t}_env->head.copy = ${envName}_copy;")
        } else {
            this.line("${t}_env->head.copy = NULL;")
        }
        for (cap in captures) {
            val source = this.varRef(cap.name)
            val v = if (cap.isCell) {
                "keal_cell_retain(${source})"
            } else {
                retained(cap.ty, source)
            }
            this.line("${t}_env->${mangle(cap.name)} = ${v};")
        }
        this.line("KealClosure* ${t} = (KealClosure*)&${t}_env->head;")
        this.own(t, ft)
        return t
    }

    /// Calls a closure value with already-rendered arguments, through the
    /// cast its static type dictates.
    /// The type of a class's field, with the class's own type arguments
    /// substituted in. `null` when the class has no field by that name.
    func classFieldType(class_: String, classArgs: List<Ty>, name: String): Ty? {
        val decl = this.classDecls[class_]
        if (decl == null) { return null }
        unless (this.shapes.contains(class_)) { return null }
        val subst: Map<String, Ty> = {}
        var i = 0
        while (i < decl.typeParams.size and i < classArgs.size) {
            subst[decl.typeParams[i].name] = classArgs[i]
            i += 1
        }
        for (f in this.shapes[class_]!!) {
            if (f.name == name) { return substitute(f.ty, subst) }
        }
        return null
    }

    func callClosure(ft: Ty, closure: String, args: List<String>, file: Int, atLine: Int, col: Int): String? {
        val fret = ft.ret!!
        var retC = "void"
        unless (fret.kind == "Unit") {
            val c = this.ctype(fret, file, atLine, col)
            if (c == null) { return null }
            retC = c
        }
        val sigParams: List<String> = ["KealClosure*"]
        for (p in ft.params) {
            val c = this.ctype(p.ty, file, atLine, col)
            if (c == null) { return null }
            sigParams.add(c)
        }
        var call = "((${retC} (*)(${sigParams.join(", ")}))(void*)${closure}->fn)(${closure}"
        for (a in args) {
            call += ", ${a}"
        }
        call += ")"
        return call
    }

    /// The map methods: membership, and the keys and values as lists.
    /// How one element of a list renders as a string, with the hole below
    /// standing for the element. The same rendering an interpolation would
    /// give, so `join` and `"${xs}"` cannot disagree about a number.
    func elemShow(t: Ty, file: Int, atLine: Int, atCol: Int): String? {
        // The thunk `join` pushes into a list of strings needs to exist.
        val _thunk = this.releaserThunk(CElem("ptr", "KealStr", "keal_str"))
        if (t.kind == "Int") { return "keal_str_from_int(" + SHOW_HOLE + ")" }
        if (t.kind == "Float") { return "keal_str_from_float(" + SHOW_HOLE + ")" }
        if (t.kind == "Bool") { return "keal_str_from_bool(" + SHOW_HOLE + ")" }
        if (t.kind == "Str") { return "keal_str_retain(" + SHOW_HOLE + ")" }
        if (t.kind == "Class") {
            return structNameOf(t.name, t.args) + "_show(" + SHOW_HOLE + ")"
        }
        this.unsupported(file, atLine, atCol, "`join` on a list of `${tyShow(t)}`")
        return null
    }

    func mapMethod(e: Ex, obj: Ex, name: String): String? {
        unless (name == "contains" or name == "containsKey" or name == "keys" or name == "values" or name == "remove" or name == "get" or name == "set" or name == "isEmpty" or name == "clear") {
            return null
        }
        val ot = this.ety(obj)
        if (ot == null or ot.kind != "Map") { return null }
        val kt = ot.args[0]
        val vt = ot.args[1]
        val kk = this.keyKind(kt, e.file, e.line, e.col)
        if (kk == null) { return null }
        val vk = this.elemKind(vt, e.file, e.line, e.col)
        if (vk == null) { return null }
        val m = this.expr(obj)
        // `m.get(k)` is `m[k]`, and `m.set(k, v)` is `m[k] = v` — the
        // interpreters route the method and the operator through one
        // implementation, so these route through the one that emits it.
        if (name == "get") {
            return this.mapGet(e, obj, e.args[0].value, null)
        }
        if (name == "set") {
            val key = this.expr(e.args[0].value)
            val value = this.coercedTo(e.args[1].value, vt)
            val sk = retained(kt, key)
            val sv = retained(vt, value)
            this.line("keal_map_set(${m}, ${elemWord(kk, sk)}, ${elemWord(vk, sv)});")
            return "0"
        }
        if (name == "isEmpty") {
            val t = this.temp()
            this.line("const bool ${t} = ${m}->len == 0;")
            return t
        }
        if (name == "clear") {
            // The releasers the map was built with know what its keys and
            // values are; the backend need not say it twice.
            this.line("keal_map_clear(${m});")
            return "0"
        }
        if (name == "contains" or name == "containsKey") {
            val key = this.expr(e.args[0].value)
            val t = this.temp()
            this.line("const bool ${t} = keal_map_find(${m}, ${elemWord(kk, key)}) >= 0;")
            return t
        }
        // The interpreters answer with what was there, or null. The value is
        // dropped far more often than it is read, so it is fetched only when
        // the call is used for it.
        if (name == "remove") {
            val key = this.expr(e.args[0].value)
            val t = this.temp()
            val vc = this.ctype(tyNullable(vt), e.file, e.line, e.col)
            if (vc == null) { return null }
            val at = this.temp()
            this.line("const int64_t ${at} = keal_map_find(${m}, ${elemWord(kk, key)});")
            this.line("${vc} ${t};")
            // Owned here rather than after the branch below: `own` in catch
            // mode rewrites the declaration it was just handed, and it can
            // only rewrite the line immediately behind it. Doing it at the
            // end made `m.remove(k)` inside a `try` an internal error about a
            // temporary nobody could see.
            this.own(t, tyNullable(vt))
            this.line("if (${at} >= 0) {")
            this.indent += 1
            val held = this.temp()
            val vcb = this.ctype(vt, e.file, e.line, e.col)
            if (vcb == null) { return null }
            this.line("${vcb} ${held} = ${elemUnword(vk, "${m}->data[2 * ${at} + 1]")};")
            this.line("${t} = ${optWrap(vt, retained(vt, held))};")
            this.indent -= 1
            this.line("} else {")
            this.indent += 1
            this.line("${t} = ${optNull(vt)};")
            this.indent -= 1
            this.line("}")
            this.line("keal_map_remove(${m}, ${elemWord(kk, key)});")
            return t
        }
        // keys / values
        val valSlot = name == "values"
        val ty = if (valSlot) { vt } else { kt }
        val kind = if (valSlot) { vk } else { kk }
        val thunk = this.releaserThunk(kind)
        val out = this.temp()
        this.line("KealList* ${out} = keal_list_new(${thunk});")
        this.own(out, tyList(ty))
        val i = this.temp()
        this.line("for (int64_t ${i} = 0; ${i} < ${m}->len; ${i}++) {")
        this.indent += 1
        val offset = if (valSlot) { "2 * ${i} + 1" } else { "2 * ${i}" }
        val item = elemUnword(kind, "${m}->data[${offset}]")
        val stored = retained(ty, item)
        this.line("keal_list_push(${out}, ${elemWord(kind, stored)});")
        this.indent -= 1
        this.line("}")
        return out
    }

    /// `map`, `filter`, `fold` and `forEach` on a list, as inline loops.
    func listHigherOrder(e: Ex, obj: Ex, name: String, elemTy: Ty): String? {
        unless (name == "map" or name == "filter" or name == "fold" or name == "forEach") {
            return null
        }
        val elem = this.elemKind(elemTy, e.file, e.line, e.col)
        if (elem == null) { return null }

        val l = this.expr(obj)
        val snap = this.temp()
        this.line("KealList* ${snap} = keal_list_snapshot(${l});")
        this.own(snap, tyList(elemTy))

        if (name == "map") {
            val rty = this.ety(e)
            if (rty == null or rty.kind != "List") { return "0" }
            val outTy = rty.args[0]
            val outElem = this.elemKind(outTy, e.file, e.line, e.col)
            if (outElem == null) { return null }
            val thunk = this.releaserThunk(outElem)
            val f = this.expr(e.args[0].value)
            val out = this.temp()
            this.line("KealList* ${out} = keal_list_new(${thunk});")
            this.own(out, tyList(outTy))

            val ft = tyFunOf([elemTy], outTy)
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            this.openScope()
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            val v = if (countedC(outTy)) {
                this.ownTempOf(outTy, call)
            } else {
                val t = this.temp()
                val ct = this.ctype(outTy, e.file, e.line, e.col)
                if (ct == null) { return null }
                this.line("const ${ct} ${t} = ${call};")
                t
            }
            val stored = retained(outTy, v)
            this.line("keal_list_push(${out}, ${elemWord(outElem, stored)});")
            this.closeScope()
            this.indent -= 1
            this.line("}")
            return out
        }
        if (name == "filter") {
            val thunk = this.releaserThunk(elem)
            val f = this.expr(e.args[0].value)
            val out = this.temp()
            this.line("KealList* ${out} = keal_list_new(${thunk});")
            this.own(out, tyList(elemTy))

            val ft = tyFunOf([elemTy], Ty("Bool"))
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            this.line("if (${call}) {")
            this.indent += 1
            val stored = retained(elemTy, item)
            this.line("keal_list_push(${out}, ${elemWord(elem, stored)});")
            this.indent -= 1
            this.line("}")
            this.indent -= 1
            this.line("}")
            return out
        }
        if (name == "fold") {
            val accTy = this.ety(e)
            if (accTy == null) { return "0" }
            val accC = this.ctype(accTy, e.file, e.line, e.col)
            if (accC == null) { return null }
            val init = this.expr(e.args[0].value)
            val f = this.expr(e.args[1].value)
            val acc = this.temp()
            this.line("${accC} ${acc} = ${retained(accTy, init)};")
            if (countedC(accTy)) {
                this.own(acc, accTy)
            }

            val ft = tyFunOf([accTy, elemTy], accTy)
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [acc, item], e.file, e.line, e.col)
            if (call == null) { return null }
            // The new accumulator is owned by the call; the old one is
            // released before the name moves on to it.
            val next = this.temp()
            this.line("${accC} ${next} = ${call};")
            val rel = releaseFn(accTy)
            if (rel != null) {
                this.line("${rel}(${acc});")
            }
            this.line("${acc} = ${next};")
            this.indent -= 1
            this.line("}")
            return acc
        }
        // forEach
        val f = this.expr(e.args[0].value)
        val ft = tyFunOf([elemTy], Ty("Unit"))
        val i = this.temp()
        this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
        this.indent += 1
        val item = elemUnword(elem, "${snap}->data[${i}]")
        val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
        if (call == null) { return null }
        this.line("${call};")
        this.indent -= 1
        this.line("}")
        return "0"
    }

    /// The string methods the self-hosted compiler uses, each backed by a
    /// runtime function mirroring the interpreters' semantics.
    func builtinOperatorMethod(e: Ex, obj: Ex, name: String, receiverTy: Ty): String? {
        val n = e.args.size
        if (receiverTy.kind == "Int") {
            if ((name == "plus" or name == "minus" or name == "times" or name == "div" or name == "rem") and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val f = when (name) {
                    "plus" -> "keal_add"
                    "minus" -> "keal_sub"
                    "times" -> "keal_mul"
                    "div" -> "keal_div"
                    else -> "keal_rem"
                }
                val t = this.temp()
                this.line("const int64_t ${t} = ${f}(${a}, ${b}, ${e.line});")
                return t
            }
            if (name == "negate" and n == 0) {
                val a = this.expr(obj)
                val t = this.temp()
                this.line("const int64_t ${t} = keal_sub(INT64_C(0), ${a}, ${e.line});")
                return t
            }
            if (name == "equals" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val t = this.temp()
                this.line("const bool ${t} = (${a} == ${b});")
                return t
            }
            if (name == "compareTo" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val t = this.temp()
                this.line("const int64_t ${t} = ${a} < ${b} ? INT64_C(-1) : (${a} > ${b} ? INT64_C(1) : INT64_C(0));")
                return t
            }
            return null
        }
        if (receiverTy.kind == "Float") {
            if ((name == "plus" or name == "minus" or name == "times" or name == "div") and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val c = when (name) {
                    "plus" -> "+"
                    "minus" -> "-"
                    "times" -> "*"
                    else -> "/"
                }
                val t = this.temp()
                this.line("const double ${t} = (${a} ${c} ${b});")
                return t
            }
            if (name == "rem" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val t = this.temp()
                this.line("const double ${t} = fmod(${a}, ${b});")
                return t
            }
            if (name == "negate" and n == 0) {
                val a = this.expr(obj)
                val t = this.temp()
                this.line("const double ${t} = (-(${a}));")
                return t
            }
            if (name == "equals" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val t = this.temp()
                this.line("const bool ${t} = (${a} == ${b});")
                return t
            }
            if (name == "compareTo" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val t = this.temp()
                this.line("const int64_t ${t} = ${a} < ${b} ? INT64_C(-1) : (${a} > ${b} ? INT64_C(1) : INT64_C(0));")
                return t
            }
            return null
        }
        if (receiverTy.kind == "Str") {
            if (name == "plus" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                return this.ownTemp("keal_concat(${a}, ${b})")
            }
            if (name == "equals" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val t = this.temp()
                this.line("const bool ${t} = (keal_str_cmp(${a}, ${b}) == 0);")
                return t
            }
            if (name == "compareTo" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val c = this.temp()
                this.line("const int ${c} = keal_str_cmp(${a}, ${b});")
                val t = this.temp()
                this.line("const int64_t ${t} = ${c} < 0 ? INT64_C(-1) : (${c} > 0 ? INT64_C(1) : INT64_C(0));")
                return t
            }
            return null
        }
        if (receiverTy.kind == "Bool") {
            if (name == "equals" and n == 1) {
                val a = this.expr(obj)
                val b = this.expr(e.args[0].value)
                val t = this.temp()
                this.line("const bool ${t} = (${a} == ${b});")
                return t
            }
            return null
        }
        return null
    }

    func stringBuiltin(e: Ex, obj: Ex, name: String): String? {
        val n = e.args.size
        if (name == "substring" and n == 2) {
            val s = this.expr(obj)
            val a = this.expr(e.args[0].value)
            val b = this.expr(e.args[1].value)
            return this.ownTemp("keal_str_substring(${s}, ${a}, ${b}, ${e.line})")
        }
        if ((name == "take" or name == "drop") and n == 1) {
            val s = this.expr(obj)
            val cnt = this.expr(e.args[0].value)
            val f = if (name == "take") { "keal_str_take" } else { "keal_str_drop" }
            return this.ownTemp("${f}(${s}, ${cnt})")
        }
        if ((name == "contains" or name == "startsWith" or name == "endsWith") and n == 1) {
            val s = this.expr(obj)
            val needle = this.expr(e.args[0].value)
            val f = when (name) {
                "contains" -> "keal_str_contains"
                "startsWith" -> "keal_str_starts_with"
                else -> "keal_str_ends_with"
            }
            val t = this.temp()
            this.line("const bool ${t} = ${f}(${s}, ${needle});")
            return t
        }
        if (name == "indexOf" and n == 1) {
            val s = this.expr(obj)
            val needle = this.expr(e.args[0].value)
            val t = this.temp()
            this.line("const int64_t ${t} = keal_str_index_of(${s}, ${needle});")
            return t
        }
        if (name == "replace" and n == 2) {
            val s = this.expr(obj)
            val old = this.expr(e.args[0].value)
            val newer = this.expr(e.args[1].value)
            return this.ownTemp("keal_str_replace(${s}, ${old}, ${newer}, ${e.line})")
        }
        if (name == "repeat" and n == 1) {
            val s = this.expr(obj)
            val cnt = this.expr(e.args[0].value)
            return this.ownTemp("keal_str_repeat(${s}, ${cnt}, ${e.line})")
        }
        if (name == "split" and n == 1) {
            val s = this.expr(obj)
            val sep = this.expr(e.args[0].value)
            return this.ownTempOf(tyList(Ty("Str")), "keal_str_split(${s}, ${sep})")
        }
        if (name == "chars" and n == 0) {
            val s = this.expr(obj)
            return this.ownTempOf(tyList(Ty("Str")), "keal_str_chars(${s})")
        }
        if (name == "get" and n == 1) {
            val s = this.expr(obj)
            val i = this.expr(e.args[0].value)
            return this.ownTemp("keal_str_get(${s}, ${i}, ${e.line})")
        }
        if (name == "code" and n == 0) {
            val s = this.expr(obj)
            val t = this.temp()
            this.line("const int64_t ${t} = keal_str_code(${s});")
            return t
        }
        if (name == "toInt" and n == 0) {
            val s = this.expr(obj)
            val t = this.temp()
            this.line("const KealOptI64 ${t} = keal_str_to_int(${s});")
            return t
        }
        if (name == "toFloat" and n == 0) {
            val s = this.expr(obj)
            val t = this.temp()
            this.line("const KealOptF64 ${t} = keal_str_to_float(${s});")
            return t
        }
        if (name == "isEmpty" and n == 0) {
            val v = this.expr(obj)
            val t = this.temp()
            this.line("const bool ${t} = ${v}->len == 0;")
            return t
        }
        if (name == "reversed" and n == 0) {
            val v = this.expr(obj)
            return this.ownTemp("keal_str_reversed(${v})")
        }
        if ((name == "toLower" or name == "toUpper" or name == "trim") and n == 0) {
            val s = this.expr(obj)
            val f = when (name) {
                "toLower" -> "keal_str_to_lower"
                "toUpper" -> "keal_str_to_upper"
                else -> "keal_str_trim"
            }
            return this.ownTemp("${f}(${s})")
        }
        return null
    }

    func intBuiltin(e: Ex, obj: Ex, name: String): String? {
        val n = e.args.size
        if (name == "toFloat" and n == 0) {
            val v = this.expr(obj)
            return "(double)(${v})"
        }
        if ((name == "min" or name == "max") and n == 1) {
            val a = this.expr(obj)
            val b = this.expr(e.args[0].value)
            val f = if (name == "min") { "keal_int_min" } else { "keal_int_max" }
            val t = this.temp()
            this.line("const int64_t ${t} = ${f}(${a}, ${b});")
            return t
        }
        if (name == "toChar" and n == 0) {
            val v = this.expr(obj)
            return this.ownTemp("keal_int_to_char(${v}, ${e.line})")
        }
        if (name == "abs" and n == 0) {
            val v = this.expr(obj)
            val t = this.temp()
            this.line("const int64_t ${t} = keal_int_abs(${v});")
            return t
        }
        if ((name == "pow" or name == "root") and n == 1) {
            val a = this.expr(obj)
            val b = this.expr(e.args[0].value)
            val f = if (name == "pow") { "keal_int_pow" } else { "keal_int_root" }
            val t = this.temp()
            this.line("const int64_t ${t} = ${f}(${a}, ${b}, ${e.line});")
            this.checkUnwind()
            return t
        }
        return null
    }

    func floatBuiltin(e: Ex, obj: Ex, name: String): String? {
        val n = e.args.size
        if ((name == "toInt" or name == "floor" or name == "ceil" or name == "round") and n == 0) {
            val v = this.expr(obj)
            val inner = when (name) {
                "toInt" -> v
                "floor" -> "floor(${v})"
                "ceil" -> "ceil(${v})"
                else -> "round(${v})"
            }
            val t = this.temp()
            this.line("const int64_t ${t} = keal_f2i(${inner});")
            return t
        }
        if ((name == "abs" or name == "sqrt") and n == 0) {
            val v = this.expr(obj)
            val f = if (name == "abs") { "fabs" } else { "sqrt" }
            val t = this.temp()
            this.line("const double ${t} = ${f}(${v});")
            return t
        }
        if ((name == "min" or name == "max" or name == "pow" or name == "root") and n == 1) {
            val a = this.expr(obj)
            val b = this.expr(e.args[0].value)
            val f = when (name) {
                "min" -> "fmin"
                "max" -> "fmax"
                "root" -> "keal_f_root"
                else -> "pow"
            }
            val t = this.temp()
            this.line("const double ${t} = ${f}(${a}, ${b});")
            return t
        }
        if (name == "isNaN" and n == 0) {
            val v = this.expr(obj)
            val t = this.temp()
            this.line("const bool ${t} = (bool)isnan(${v});")
            return t
        }
        return null
    }

    /// The equality a `contains` scan or a list comparison applies, by
    /// element kind; anything deeper than a word or a string is refused
    /// rather than guessed. `what` names the construct in the refusal.
    func elemEqFn(elemTy: Ty, file: Int, atLine: Int, col: Int, what: String): String? {
        if (elemTy.kind == "Str") { return "keal_key_eq_str" }
        if (elemTy.kind == "Float") { return "keal_key_eq_f64" }
        if (elemTy.kind == "Int" or elemTy.kind == "Bool" or elemTy.kind == "Never") {
            return "keal_key_eq_word"
        }
        // Instances and closures compare by identity inside a container —
        // exactly what the interpreters' `values_equal` does — and a
        // pointer is a word.
        if (elemTy.kind == "Class" or elemTy.kind == "Fun") { return "keal_key_eq_word" }
        // Boxed `Any`s compare through their tags, recursively.
        if (elemTy.kind == "Any") { return "keal_any_box_eq" }
        if (elemTy.kind == "Nullable") {
            val inner = elemTy.args[0]
            if (inner.kind == "Str") { return "keal_key_eq_opt_str" }
            if (inner.kind == "Class" or inner.kind == "Fun") { return "keal_key_eq_word" }
            this.unsupported(file, atLine, col, "${what} `${tyShow(inner)}?`")
            return null
        }
        this.unsupported(file, atLine, col, "${what} `${tyShow(elemTy)}`")
        return null
    }

    func listBuiltin(e: Ex, obj: Ex, name: String, elemTy: Ty): String? {
        val n = e.args.size
        if (name == "removeAt" and n == 1) {
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val i = this.expr(e.args[0].value)
            val w = this.temp()
            this.line("const KealWord ${w} = keal_list_remove_at(${l}, ${i}, ${e.line});")
            this.checkUnwind()
            val value = elemUnword(elem, w)
            if (countedC(elemTy)) {
                // The list's own reference travels out with the element, so
                // the temp owns it without a fresh retain.
                val t = this.temp()
                val ct = this.ctype(elemTy, e.file, e.line, e.col)
                if (ct == null) { return null }
                this.line("${ct} ${t} = ${value};")
                this.own(t, elemTy)
                return t
            }
            return value
        }
        if (name == "addAll" and n == 1) {
            val l = this.expr(obj)
            val other = this.expr(e.args[0].value)
            this.line("keal_list_add_all(${l}, ${other});")
            return "0"
        }
        if (name == "insert" and n == 2) {
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val i = this.expr(e.args[0].value)
            val v = this.expr(e.args[1].value)
            val stored = if (this.catchMode and countedC(elemTy)) {
                // The insert can panic before it takes the reference;
                // owning it in a temp keeps the unwind path exact, and
                // a clean call transfers it by NULLing the temp.
                this.ownTempOf(elemTy, retained(elemTy, v))
            } else {
                retained(elemTy, v)
            }
            this.line("keal_list_insert_at(${l}, ${i}, ${elemWord(elem, stored)}, ${e.line});")
            this.checkUnwind()
            if (this.catchMode and countedC(elemTy)) {
                this.line("${stored} = NULL;")
            }
            return "0"
        }
        if (name == "set" and n == 2) {
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val i = this.expr(e.args[0].value)
            val v = this.coercedTo(e.args[1].value, elemTy)
            val stored = if (this.catchMode and countedC(elemTy)) {
                // The set can panic before it takes the reference; owning
                // it in a temp keeps the unwind path exact, and a clean
                // call transfers it by NULLing the temp.
                this.ownTempOf(elemTy, retained(elemTy, v))
            } else {
                retained(elemTy, v)
            }
            val release = releaseFn(elemTy)
            if (release != null) {
                val old = this.temp()
                this.line("const KealWord ${old} = keal_list_set_at(${l}, ${i}, ${elemWord(elem, stored)}, ${e.line});")
                this.checkUnwind()
                if (this.catchMode) {
                    if (elemTy.kind == "Any") {
                        this.line("${stored} = keal_any_null();")
                    } else {
                        this.line("${stored} = NULL;")
                    }
                }
                // A boxed element's displaced word is the box itself.
                if (elem.kind == "any") {
                    this.line("keal_any_box_release(${old}.p);")
                } else {
                    this.line("${release}(${elemUnword(elem, old)});")
                }
            } else {
                // Nothing to release, so the displaced word is discarded.
                this.line("(void)keal_list_set_at(${l}, ${i}, ${elemWord(elem, stored)}, ${e.line});")
                this.checkUnwind()
            }
            return "0"
        }
        if (name == "clear" and n == 0) {
            // The releaser the list was built with knows what its elements
            // are; the backend need not say it twice.
            val l = this.expr(obj)
            this.line("keal_list_clear(${l});")
            return "0"
        }
        if (name == "contains" and n == 1) {
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val eq = this.elemEqFn(elemTy, e.file, e.line, e.col, "`contains` on a list of")
            if (eq == null) { return null }
            val l = this.expr(obj)
            val v = this.expr(e.args[0].value)
            val t = this.temp()
            this.line("const bool ${t} = keal_list_contains(${l}, ${elemWord(elem, v)}, ${eq});")
            return t
        }
        if (name == "indexOf" and n == 1) {
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val eq = this.elemEqFn(elemTy, e.file, e.line, e.col, "`indexOf` on a list of")
            if (eq == null) { return null }
            val l = this.expr(obj)
            val v = this.expr(e.args[0].value)
            val t = this.temp()
            this.line("const int64_t ${t} = keal_list_index_of(${l}, ${elemWord(elem, v)}, ${eq});")
            return t
        }
        if (name == "isEmpty" and n == 0) {
            val l = this.expr(obj)
            val t = this.temp()
            this.line("const bool ${t} = ${l}->len == 0;")
            return t
        }
        // `xs.get(i)` is `xs[i]`, down to the bounds message — the
        // interpreters route both through the one `indexGet`, so this
        // routes through the one that emits it.
        if (name == "get" and n == 1) {
            return this.indexGet(e, obj, e.args[0].value)
        }
        if ((name == "first" or name == "last") and n == 0) {
            // `T?` over an element the list may not have: an empty list
            // answers null, exactly as the interpreters do.
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val optTy = tyNullable(elemTy)
            val ct = this.ctype(optTy, e.file, e.line, e.col)
            if (ct == null) { return null }
            val l = this.expr(obj)
            var empty = optNull(elemTy)
            if (elemTy.kind == "Any") { empty = "keal_any_null()" }
            val t = this.temp()
            this.line("${ct} ${t} = ${empty};")
            this.own(t, optTy)
            this.line("if (${l}->len > 0) {")
            this.indent += 1
            var at = "0"
            if (name == "last") { at = "${l}->len - 1" }
            val item = elemUnword(elem, "${l}->data[${at}]")
            this.line("${t} = ${optWrap(elemTy, retained(elemTy, item))};")
            this.indent -= 1
            this.line("}")
            return t
        }
        if (name == "join" and n <= 1) {
            val l = this.expr(obj)
            val sep = if (n == 1) {
                this.expr(e.args[0].value)
            } else {
                this.ownTemp("keal_str_static(\", \", 2)")
            }
            if (elemTy.kind == "Str") {
                return this.ownTemp("keal_list_join_str(${l}, ${sep})")
            }
            // Anything else is rendered element by element, the way an
            // interpolation renders it — so `[1, 2].join("-")` says what a
            // reader expects instead of being refused.
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return "0" }
            val show = this.elemShow(elemTy, e.file, e.line, e.col)
            if (show == null) { return "0" }
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            val parts = this.temp()
            this.line("KealList* ${parts} = keal_list_new(rel_keal_str);")
            this.own(parts, tyList(Ty("Str")))
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val rendered = show.replace(SHOW_HOLE, item)
            this.line("keal_list_push(${parts}, (KealWord){ .p = (void*)${rendered} });")
            this.indent -= 1
            this.line("}")
            return this.ownTemp("keal_list_join_str(${parts}, ${sep})")
        }
        if (name == "any" and n == 1) {
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            val f = this.expr(e.args[0].value)
            val ft = tyFunOf([elemTy], Ty("Bool"))
            val t = this.temp()
            this.line("bool ${t} = false;")
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            this.line("if (${call}) {")
            this.indent += 1
            this.line("${t} = true;")
            this.line("break;")
            this.indent -= 1
            this.line("}")
            this.indent -= 1
            this.line("}")
            return t
        }
        if ((name == "all" or name == "none") and n == 1) {
            // The walk `any` makes, with the sense the name asks for:
            // `all` stops at the first element that fails, `none` at the
            // first that passes, and an empty list answers true to both —
            // which is what the interpreters answer.
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            val f = this.expr(e.args[0].value)
            val ft = tyFunOf([elemTy], Ty("Bool"))
            val t = this.temp()
            this.line("bool ${t} = true;")
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            val test = if (name == "all") { "!(${call})" } else { call }
            this.line("if (${test}) {")
            this.indent += 1
            this.line("${t} = false;")
            this.line("break;")
            this.indent -= 1
            this.line("}")
            this.indent -= 1
            this.line("}")
            return t
        }
        if (name == "find" and n == 1) {
            // The first element the predicate accepts, or null — and the
            // scan stops there, so a predicate with an effect runs exactly
            // as often as it does in the interpreters.
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            val f = this.expr(e.args[0].value)
            val ft = tyFunOf([elemTy], Ty("Bool"))
            val resTy = this.ety(e)
            if (resTy == null) { return "0" }
            val rc = this.ctype(resTy, e.file, e.line, e.col)
            if (rc == null) { return null }
            val inner = tyNonNull(resTy)
            val t = this.temp()
            // Nothing found is `T?`'s absent value: a reference's null
            // pointer, a value's tagged empty, an `Any`'s null tag.
            val empty = if (resTy.kind == "Any") { "keal_any_null()" } else { optNull(inner) }
            this.line("${rc} ${t} = ${empty};")
            if (countedC(resTy)) { this.own(t, resTy) }
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            this.line("if (${call}) {")
            this.indent += 1
            this.line("${t} = ${optWrap(inner, retained(inner, item))};")
            this.line("break;")
            this.indent -= 1
            this.line("}")
            this.indent -= 1
            this.line("}")
            return t
        }
        if (name == "count" and n == 1) {
            // Every element is asked; the answer is how many said yes.
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            val f = this.expr(e.args[0].value)
            val ft = tyFunOf([elemTy], Ty("Bool"))
            val t = this.temp()
            this.line("int64_t ${t} = 0;")
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            this.line("if (${call}) {")
            this.indent += 1
            this.line("${t}++;")
            this.indent -= 1
            this.line("}")
            this.indent -= 1
            this.line("}")
            return t
        }
        if (name == "flatMap" and n == 1) {
            // The transform's own return type decides the shape: a list is
            // concatenated, anything else is appended as one element. The
            // interpreters decide that per value; here it is decided once,
            // from the type — so a transform typed `Any`, whose answer
            // could be either, is refused rather than guessed.
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val rty = this.ety(e)
            if (rty == null or rty.kind != "List") { return "0" }
            val outTy = rty.args[0]
            val outElem = this.elemKind(outTy, e.file, e.line, e.col)
            if (outElem == null) { return null }
            val lam = this.ety(e.args[0].value)
            if (lam == null or lam.kind != "Fun") { return "0" }
            val retTy = lam.ret!!
            if (retTy.kind == "Any") {
                this.unsupported(
                    e.file, e.line, e.col,
                    "`flatMap` with a transform whose return type is `Any`"
                )
                return "0"
            }
            val l = this.expr(obj)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            val thunk = this.releaserThunk(outElem)
            val f = this.expr(e.args[0].value)
            val out = this.temp()
            this.line("KealList* ${out} = keal_list_new(${thunk});")
            this.own(out, tyList(outTy))

            val ft = tyFunOf([elemTy], retTy)
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            this.openScope()
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            if (retTy.kind == "List") {
                // Each element carried over takes a reference of its own;
                // the piece itself dies at the iteration's end.
                val piece = this.ownTempOf(retTy, call)
                this.line("keal_list_add_all(${out}, ${piece});")
            } else {
                val v = if (countedC(retTy)) {
                    this.ownTempOf(retTy, call)
                } else {
                    val t = this.temp()
                    val ct = this.ctype(retTy, e.file, e.line, e.col)
                    if (ct == null) { return null }
                    this.line("const ${ct} ${t} = ${call};")
                    t
                }
                val stored = retained(retTy, v)
                this.line("keal_list_push(${out}, ${elemWord(outElem, stored)});")
            }
            this.closeScope()
            this.indent -= 1
            this.line("}")
            return out
        }
        if ((name == "take" or name == "drop") and n == 1) {
            val l = this.expr(obj)
            val cnt = this.expr(e.args[0].value)
            val f = if (name == "take") { "keal_list_take" } else { "keal_list_drop" }
            return this.ownTempOf(tyList(elemTy), "${f}(${l}, ${cnt})")
        }
        if (name == "slice" and n == 2) {
            val l = this.expr(obj)
            val a = this.expr(e.args[0].value)
            val b = this.expr(e.args[1].value)
            return this.ownTempOf(tyList(elemTy), "keal_list_slice(${l}, ${a}, ${b})")
        }
        if (name == "reversed" and n == 0) {
            val l = this.expr(obj)
            return this.ownTempOf(tyList(elemTy), "keal_list_reversed(${l})")
        }
        if (name == "sorted" and n == 0) {
            var cmp = ""
            if (elemTy.kind == "Int" or elemTy.kind == "Bool" or elemTy.kind == "Never") {
                cmp = "keal_cmp_i64"
            } else if (elemTy.kind == "Str") {
                cmp = "keal_cmp_str"
            } else {
                this.unsupported(e.file, e.line, e.col, "`sorted` on a list of `${tyShow(elemTy)}`")
                return "0"
            }
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            this.line("keal_list_sort_words(${snap}, ${cmp});")
            val thunk = this.releaserThunk(elem)
            val out = this.temp()
            this.line("KealList* ${out} = keal_list_new(${thunk});")
            this.own(out, tyList(elemTy))
            val j = this.temp()
            this.line("for (int64_t ${j} = 0; ${j} < ${snap}->len; ${j}++) {")
            this.indent += 1
            val sortedItem = elemUnword(elem, "${snap}->data[${j}]")
            val stored = retained(elemTy, sortedItem)
            this.line("keal_list_push(${out}, ${elemWord(elem, stored)});")
            this.indent -= 1
            this.line("}")
            return out
        }
        if (name == "sum" and n == 0) {
            // `sum` exists only on `List<Int>` and `List<Float>` —
            // `listSig` gives no signature for anything else — so the
            // two shapes here are the whole surface.
            val l = this.expr(obj)
            val t = this.temp()
            if (elemTy.kind == "Float") {
                this.line("const double ${t} = keal_list_sum_f64(${l});")
            } else {
                this.line("const int64_t ${t} = keal_list_sum_i64(${l}, ${e.line});")
                this.checkUnwind()
            }
            return t
        }
        if (name == "sortedBy" and n == 1) {
            // The key's type is whatever the lambda actually returns; only
            // Int keys are compiled, which is all the compiler needs.
            val fty = this.ety(e.args[0].value)
            var keyOk = false
            if (fty != null and fty.kind == "Fun") {
                if (fty.ret!!.kind == "Int") { keyOk = true }
            }
            unless (keyOk) {
                this.unsupported(e.file, e.line, e.col, "`sortedBy` with a key that is not an Int")
                return "0"
            }
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return null }
            val l = this.expr(obj)
            val snap = this.temp()
            this.line("KealList* ${snap} = keal_list_snapshot(${l});")
            this.own(snap, tyList(elemTy))
            val f = this.expr(e.args[0].value)
            val keys = this.temp()
            this.line("KealList* ${keys} = keal_list_new(NULL);")
            this.own(keys, tyList(Ty("Int")))
            val ft = tyFunOf([elemTy], Ty("Int"))
            val i = this.temp()
            this.line("for (int64_t ${i} = 0; ${i} < ${snap}->len; ${i}++) {")
            this.indent += 1
            val item = elemUnword(elem, "${snap}->data[${i}]")
            val call = this.callClosure(ft, f, [item], e.file, e.line, e.col)
            if (call == null) { return null }
            val k = this.temp()
            this.line("const int64_t ${k} = ${call};")
            this.line("keal_list_push(${keys}, (KealWord){ .i = ${k} });")
            this.indent -= 1
            this.line("}")
            this.line("keal_list_sort_by_i64(${snap}, ${keys});")
            val thunk = this.releaserThunk(elem)
            val out = this.temp()
            this.line("KealList* ${out} = keal_list_new(${thunk});")
            this.own(out, tyList(elemTy))
            val j = this.temp()
            this.line("for (int64_t ${j} = 0; ${j} < ${snap}->len; ${j}++) {")
            this.indent += 1
            val sortedItem = elemUnword(elem, "${snap}->data[${j}]")
            val stored = retained(elemTy, sortedItem)
            this.line("keal_list_push(${out}, ${elemWord(elem, stored)});")
            this.indent -= 1
            this.line("}")
            return out
        }
        return null
    }

    func mapLiteral(e: Ex): String {
        val mt = this.ety(e)
        if (mt == null or mt.kind != "Map") { return "0" }
        val kt = mt.args[0]
        val vt = mt.args[1]
        val kk = this.keyKind(kt, e.file, e.line, e.col)
        if (kk == null) { return "0" }
        val vk = this.elemKind(vt, e.file, e.line, e.col)
        if (vk == null) { return "0" }
        val relK = this.releaserThunk(kk)
        val relV = this.releaserThunk(vk)
        val t = this.temp()
        this.line("KealMap* ${t} = keal_map_new(${keyEqFn(kk)}, ${relK}, ${relV});")
        this.own(t, tyMap(kt, vt))
        var i = 0
        while (i < e.keys.size) {
            val kv = this.expr(e.keys[i])
            val vv = this.coercedTo(e.values[i], vt)
            val sk = retained(kt, kv)
            val sv = retained(vt, vv)
            this.line("keal_map_set(${t}, ${elemWord(kk, sk)}, ${elemWord(vk, sv)});")
            i += 1
        }
        return t
    }

    /// Like `reprCall`, but failure is the caller's to handle: no error is
    /// recorded.
    func tryRepr(t: Ty, expr: String, file: Int, atLine: Int, col: Int): String? {
        val before = this.errors.size
        val r = this.reprCall(t, expr, file, atLine, col)
        if (r == null) {
            this.truncateErrors(before)
        }
        return r
    }

    /// How a value of `t` is rendered *inside* another value — quoted for
    /// strings, recursive for containers.
    func reprCall(t: Ty, expr: String, file: Int, atLine: Int, col: Int): String? {
        if (t.kind == "Any") { return "keal_any_repr(${expr})" }
        if (t.kind == "Str") { return "keal_str_repr(keal_str_retain(${expr}))" }
        if (t.kind == "Int") { return "keal_str_from_int(${expr})" }
        if (t.kind == "Float") { return "keal_str_from_float(${expr})" }
        if (t.kind == "Bool") { return "keal_str_from_bool(${expr})" }
        if (t.kind == "Class") {
            return "${structNameOf(t.name, t.args)}_show(${expr})"
        }
        if (t.kind == "List") {
            val f = this.listShow(t.args[0], file, atLine, col)
            if (f == null) { return null }
            return "${f}(${expr})"
        }
        if (t.kind == "Map") {
            val f = this.mapShow(t.args[0], t.args[1], file, atLine, col)
            if (f == null) { return null }
            return "${f}(${expr})"
        }
        // A `T?` inside a container. The statement form of this lives in
        // `toStringValue`, which can open a branch; here the answer has to be
        // one expression, so it is a conditional. `expr` is read twice, which
        // is safe because every caller passes an element access rather than a
        // call.
        if (t.kind == "Nullable") {
            val inner = t.args[0]
            val shown = this.reprCall(inner, optGet(inner, expr), file, atLine, col)
            if (shown == null) { return null }
            return "(${optHas(inner, expr)} ? ${shown} : keal_str_static(\"null\", 4))"
        }
        this.unsupported(file, atLine, col, "rendering a value of type `${tyShow(t)}`")
        return null
    }

    /// The function that renders a `Map<K, V>`, generated once per pair.
    func mapShow(kt: Ty, vt: Ty, file: Int, atLine: Int, col: Int): String? {
        val key = "map|${tyShow(kt)}|${tyShow(vt)}"
        val cached = this.listShows[key]
        if (cached != null) { return cached }
        val kk = this.keyKind(kt, file, atLine, col)
        if (kk == null) { return null }
        val vk = this.elemKind(vt, file, atLine, col)
        if (vk == null) { return null }
        val name = "show_map_${this.listShows.size}"
        this.listShows[key] = name

        val keyR = this.reprCall(kt, elemUnword(kk, "m->data[2 * i]"), file, atLine, col)
        if (keyR == null) { return null }
        val valR = this.reprCall(vt, elemUnword(vk, "m->data[2 * i + 1]"), file, atLine, col)
        if (valR == null) { return null }
        this.helpers += "static KealStr* ${name}(KealMap* m) {\n    KealBuf b;\n    keal_buf_init(&b);\n    keal_buf_lit(&b, \"{\");\n    for (int64_t i = 0; i < m->len; i++) {\n        if (i > 0) { keal_buf_lit(&b, \", \"); }\n        keal_buf_str(&b, ${keyR});\n        keal_buf_lit(&b, \": \");\n        keal_buf_str(&b, ${valR});\n    }\n    keal_buf_lit(&b, \"}\");\n    return keal_buf_finish(&b);\n}\n"
        return name
    }

    func listLiteral(e: Ex): String {
        val lt = this.ety(e)
        if (lt == null or lt.kind != "List") { return "0" }
        val elemTy = lt.args[0]
        val elem = this.elemKind(elemTy, e.file, e.line, e.col)
        if (elem == null) { return "0" }
        val thunk = this.releaserThunk(elem)
        val t = this.temp()
        this.line("KealList* ${t} = keal_list_new(${thunk});")
        this.own(t, tyList(elemTy))
        for (item in e.kids) {
            val v = this.coercedTo(item, elemTy)
            // The list takes its own reference; the temp the element came
            // from is still released by this block.
            val stored = retained(elemTy, v)
            this.line("keal_list_push(${t}, ${elemWord(elem, stored)});")
        }
        return t
    }

    func indexGet(e: Ex, obj: Ex, index: Ex): String {
        val ot = this.ety(obj)
        if (ot != null and ot.kind == "Map") {
            return this.mapGet(e, obj, index, null)
        }
        // `s[i]` is one character, as a string.
        if (ot != null and ot.kind == "Str") {
            val s = this.expr(obj)
            val i = this.expr(index)
            return this.ownTemp("keal_str_get(${s}, ${i}, ${e.line})")
        }
        if (ot == null or ot.kind != "List") {
            this.unsupported(e.file, e.line, e.col, "indexing anything but a list or a map")
            return "0"
        }
        val elemTy = ot.args[0]
        val elem = this.elemKind(elemTy, e.file, e.line, e.col)
        if (elem == null) { return "0" }
        val l = this.expr(obj)
        val i = this.expr(index)
        val w = this.temp()
        this.line("const KealWord ${w} = keal_list_get(${l}, ${i}, ${e.line});")
        this.checkUnwind()
        val value = elemUnword(elem, w)
        if (countedC(elemTy)) {
            val call = retained(elemTy, value)
            return this.ownTempOf(elemTy, call)
        }
        return value
    }

    /// The function that renders a `List<elem>`, generated once per element
    /// type. Inside a list, a string is quoted, as the interpreters print it.
    func listShow(elemTy: Ty, file: Int, atLine: Int, col: Int): String? {
        val key = tyShow(elemTy)
        val cached = this.listShows[key]
        if (cached != null) { return cached }
        val elem = this.elemKind(elemTy, file, atLine, col)
        if (elem == null) { return null }
        val name = "show_list_${this.listShows.size}"
        this.listShows[key] = name

        val item = elemUnword(elem, "l->data[i]")
        // The name is reserved before the body is written, and the body can
        // still be refused — a list whose elements cannot be rendered. The
        // reservation has to come back out when that happens: a cached name
        // with no definition is worse than the refusal, because the SECOND
        // caller finds the name, reports nothing, and the C fails to compile
        // on a function that was never written.
        val rendered = this.reprCall(elemTy, item, file, atLine, col)
        if (rendered == null) {
            this.listShows.remove(key)
            return null
        }
        this.helpers += "static KealStr* ${name}(KealList* l) {\n    KealBuf b;\n    keal_buf_init(&b);\n    keal_buf_lit(&b, \"[\");\n    for (int64_t i = 0; i < l->len; i++) {\n        if (i > 0) { keal_buf_lit(&b, \", \"); }\n        keal_buf_str(&b, ${rendered});\n    }\n    keal_buf_lit(&b, \"]\");\n    return keal_buf_finish(&b);\n}\n"
        return name
    }

    /// `m[k]`, with `?: fallback` fused in when the caller supplies one.
    func mapGet(e: Ex, obj: Ex, index: Ex, fallback: Ex?): String {
        val ot = this.ety(obj)
        if (ot == null or ot.kind != "Map") { return "0" }
        val kt = ot.args[0]
        val vt = ot.args[1]
        val kk = this.keyKind(kt, e.file, e.line, e.col)
        if (kk == null) { return "0" }
        val vk = this.elemKind(vt, e.file, e.line, e.col)
        if (vk == null) { return "0" }
        val m = this.expr(obj)
        val key = this.expr(index)
        val at = this.temp()
        this.line("const int64_t ${at} = keal_map_find(${m}, ${elemWord(kk, key)});")

        val hit = elemUnword(vk, "${m}->data[2 * ${at} + 1]")
        if (fallback != null) {
            val ct = this.ctype(vt, e.file, e.line, e.col)
            if (ct == null) { return "0" }
            val slot = this.temp()
            this.line("${ct} ${slot};")
            if (countedC(vt)) {
                this.own(slot, vt)
            }
            this.line("if (${at} >= 0) {")
            this.indent += 1
            this.line("${slot} = ${retained(vt, hit)};")
            this.indent -= 1
            this.line("} else {")
            this.indent += 1
            this.openScope()
            val fv = this.coercedTo(fallback, vt)
            this.line("${slot} = ${retained(vt, fv)};")
            this.closeScope()
            this.indent -= 1
            this.line("}")
            return slot
        }
        // Without a fallback the result is `V?`: a reference carries absence
        // as its null pointer, an `Any` as its null tag, and an `Int` or a
        // `Float` in the tagged form every other `T?` in the backend already
        // uses.
        val optTy = tyNullable(vt)
        val ct = this.ctype(optTy, e.file, e.line, e.col)
        if (ct == null) { return "0" }
        val slot = this.temp()
        var empty = optNull(vt)
        if (vt.kind == "Any") { empty = "keal_any_null()" }
        this.line("${ct} ${slot} = ${empty};")
        this.own(slot, optTy)
        this.line("if (${at} >= 0) {")
        this.indent += 1
        this.line("${slot} = ${optWrap(vt, retained(vt, hit))};")
        this.indent -= 1
        this.line("}")
        return slot
    }

    /// `a ?: b` reaches `b` only when `a` is absent, so the fallback is
    /// emitted inside the branch rather than before it.
    func elvis(e: Ex): String {
        val lhs = e.kids[0]
        val rhs = e.kids[1]
        // The map idiom `m[k] ?: fallback` compiles as one lookup.
        if (lhs.kind == "index") {
            val iobj = lhs.kids[0]
            val iot = this.ety(iobj)
            if (iot != null and iot.kind == "Map") {
                return this.mapGet(e, iobj, lhs.kids[1], rhs)
            }
        }
        // An `Any` holding null takes the fallback, boxed to `Any` too.
        val lt0 = this.ety(lhs)
        if (lt0 != null and lt0.kind == "Any") {
            val a = this.expr(lhs)
            val slot = this.temp()
            this.line("KealAny ${slot};")
            this.own(slot, Ty("Any"))
            this.line("if (${a}.ti != NULL) {")
            this.indent += 1
            this.line("${slot} = keal_any_retain(${a});")
            this.indent -= 1
            this.line("} else {")
            this.indent += 1
            this.openScope()
            val fb = this.coercedTo(rhs, Ty("Any"))
            this.line("${slot} = keal_any_retain(${fb});")
            this.closeScope()
            this.indent -= 1
            this.line("}")
            return slot
        }
        // A tagged value: test the tag, take the value or the fallback.
        val lt = this.ety(lhs)
        if (lt != null and lt.kind == "Nullable") {
            if (isValueOpt(lt)) {
                val inner = lt.args[0]
                val resultTy = this.ety(e)
                if (resultTy == null) { return "0" }
                val ct = this.ctype(resultTy, e.file, e.line, e.col)
                if (ct == null) { return "0" }
                val v = this.expr(lhs)
                val slot = this.temp()
                this.line("${ct} ${slot};")
                this.line("if (${optHas(inner, v)}) {")
                this.indent += 1
                var taken = optGet(inner, v)
                if (isValueOpt(resultTy)) {
                    taken = optWrap(inner, taken)
                }
                this.line("${slot} = ${taken};")
                this.indent -= 1
                this.line("} else {")
                this.indent += 1
                this.openScope()
                val fb = this.coercedTo(rhs, resultTy)
                this.line("${slot} = ${fb};")
                this.closeScope()
                this.indent -= 1
                this.line("}")
                return slot
            }
        }
        val ty = this.ety(e)
        if (ty == null) { return "0" }
        val c = this.ctype(ty, e.file, e.line, e.col)
        if (c == null) { return "0" }
        val a = this.expr(lhs)
        val slot = this.temp()
        this.line("${c} ${slot};")
        if (countedC(ty)) {
            this.own(slot, ty)
        }
        this.line("if (${a} != NULL) {")
        this.indent += 1
        this.line("${slot} = ${retained(ty, a)};")
        this.indent -= 1
        this.line("} else {")
        this.indent += 1
        this.openScope()
        val b = this.expr(rhs)
        this.line("${slot} = ${retained(ty, b)};")
        this.closeScope()
        this.indent -= 1
        this.line("}")
        return slot
    }

    /// Reading a field yields an owned reference when the field is counted.
    func field(e: Ex): String {
        val obj = e.kids[0]
        val name = e.text
        // The built-in properties, which are fields of the runtime structs.
        // Under `?.` the receiver's own type is still nullable; the property
        // belongs to what it points at, so the target's type is what names it.
        val ot = this.ety(obj)
        if (ot != null) {
            val rt = if (e.safe) { tyNonNull(ot) } else { ot }
            val isSize = (rt.kind == "List" or rt.kind == "Map") and name == "size"
            val isLength = rt.kind == "Str" and name == "length"
            if (isSize or isLength) {
                val r = this.expr(obj)
                val access = if (isSize) { "${r}->len" } else { "keal_str_length(${r})" }
                if (e.safe) {
                    return this.guarded(e, r, access)
                }
                return access
            }
        }
        // `c.bump` where `bump` is a METHOD, not a field: a bound method
        // reference. The interpreters make a closure that remembers the
        // receiver; nothing here does, and emitting the field access anyway
        // produced C that names a struct member the struct has not got. A
        // refusal by name is the answer the rest of this backend gives, and
        // the one a reader can act on.
        val recvTy = if (ot != null and e.safe) { tyNonNull(ot) } else { ot }
        if (recvTy != null and recvTy.kind == "Class") {
            val cd = this.classDecls[recvTy.name]
            if (cd != null) {
                var isMethod = false
                for (m in cd.methods) { if (m.name == name) { isMethod = true } }
                for (fd in cd.fields) { if (fd.name == name) { isMethod = false } }
                for (cp in cd.ctor) { if (cp.name == name) { isMethod = false } }
                if (isMethod) {
                    this.unsupported(e.file, e.line, e.col, "a method used as a value")
                    return "0"
                }
            }
        }
        // A weak field is read by upgrading it: the target while it lives,
        // NULL from the moment its last strong reference went.
        if (this.weakMode and ot != null) {
            val base = tyNonNull(ot)
            if (base.kind == "Class") {
                val decl = this.classDecls[base.name]
                if (decl != null and classFieldIsWeak(decl, name)) {
                    val wty = this.ety(e)
                    if (wty == null) { return "0" }
                    val target = this.weakTargetOf(wty, e.file, e.line, e.col)
                    if (target == null) { return "0" }
                    val recv = this.expr(obj)
                    val slotAccess = "${recv}->${mangle(name)}"
                    val call = "${target}_weak_get(${slotAccess})"
                    if (e.safe) {
                        val ct = this.ctype(wty, e.file, e.line, e.col)
                        if (ct == null) { return "0" }
                        val slot = this.temp()
                        this.line("${ct} ${slot} = NULL;")
                        this.own(slot, wty)
                        this.line("if (${recv} != NULL) {")
                        this.indent += 1
                        this.line("${slot} = ${call};")
                        this.indent -= 1
                        this.line("}")
                        return slot
                    }
                    return this.ownTempOf(wty, call)
                }
            }
        }
        val receiver = this.expr(obj)
        val access = "${receiver}->${mangle(name)}"
        if (e.safe) {
            return this.guarded(e, receiver, access)
        }
        val ty = this.ety(e)
        if (ty != null and countedC(ty)) {
            val call = retained(ty, access)
            return this.ownTempOf(ty, call)
        }
        return access
    }

    /// The body of a `?.`: the access happens only when the receiver is
    /// there, and the whole thing is null when it is not.
    func guarded(e: Ex, receiver: String, access: String): String {
        val ty = this.ety(e)
        if (ty == null) { return "0" }
        val c = this.ctype(ty, e.file, e.line, e.col)
        if (c == null) { return "0" }
        // `Int?`, `Float?` and `Bool?` are not pointers: their absent value is
        // the tagged one, and the present value has to be wrapped into it.
        val inner = tyNonNull(ty)
        val slot = this.temp()
        this.line("${c} ${slot} = ${optNull(inner)};")
        if (countedC(ty)) {
            this.own(slot, ty)
        }
        this.line("if (${receiver} != NULL) {")
        this.indent += 1
        val value = optWrap(inner, retained(ty, access))
        this.line("${slot} = ${value};")
        this.indent -= 1
        this.line("}")
        return slot
    }

    func methodCall(e: Ex): String {
        val obj = e.kids[0]
        val name = e.text
        val safe = e.safe
        val rt0 = this.ety(obj)
        val receiverTy = if (rt0 != null and safe) { tyNonNull(rt0) } else { rt0 }
        // The one built-in method the subset supports so far.
        if (receiverTy != null and receiverTy.kind == "List" and name == "add" and e.args.size == 1 and not safe) {
            val elemTy = receiverTy.args[0]
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem != null) {
                val l = this.expr(obj)
                val v = this.coercedTo(e.args[0].value, elemTy)
                val stored = retained(elemTy, v)
                this.line("keal_list_push(${l}, ${elemWord(elem, stored)});")
                return "0"
            }
            return "0"
        }
        // An `Any` answers `toString` through the builtin path below; the
        // guarded `?.` machinery is pointer-shaped, so it is refused here.
        if (receiverTy != null and receiverTy.kind == "Any" and safe) {
            this.unsupported(e.file, e.line, e.col, "`?.` on an `Any`")
            return "0"
        }
        // `?.` on any other built-in receiver. The built-in paths below are
        // all unguarded: they emit a dereference of the receiver, so a null
        // one is read rather than answered with null. Refused by name until
        // they are guarded, because a crash is the one answer a backend must
        // never give — the interpreters print `null` here.
        if (safe and receiverTy != null and receiverTy.kind != "Class") {
            this.unsupported(e.file, e.line, e.col, "`?.` on a built-in type")
            return "0"
        }
        // The map methods the subset covers.
        if (receiverTy != null and receiverTy.kind == "Map") {
            val v = this.mapMethod(e, obj, name)
            if (v != null) { return v }
        }
        // The higher-order list methods compile to plain loops.
        if (receiverTy != null and receiverTy.kind == "List") {
            val v = this.listHigherOrder(e, obj, name, receiverTy.args[0])
            if (v != null) { return v }
        }
        // `toString` renders any value the way interpolation would.
        if (name == "toString" and e.args.size == 0 and receiverTy != null) {
            return this.toStringValue(obj)
        }
        // The operator methods the built-in types carry for generic code:
        // a bound like `<T: Ord>` rewrites `a < b` into `a.compareTo(b)`,
        // and at `T = Int` that call must land somewhere real.
        if (receiverTy != null) {
            val v = this.builtinOperatorMethod(e, obj, name, receiverTy)
            if (v != null) { return v }
        }
        // The rest of the built-in surface the self-hosted compiler leans on.
        if (receiverTy != null) {
            if (receiverTy.kind == "Str") {
                val v = this.stringBuiltin(e, obj, name)
                if (v != null) { return v }
            }
            if (receiverTy.kind == "Int") {
                val v = this.intBuiltin(e, obj, name)
                if (v != null) { return v }
            }
            if (receiverTy.kind == "Float") {
                val v = this.floatBuiltin(e, obj, name)
                if (v != null) { return v }
            }
            if (receiverTy.kind == "List") {
                val v = this.listBuiltin(e, obj, name, receiverTy.args[0])
                if (v != null) { return v }
            }
        }
        // `x in a..b` as an expression: the desugared `contains` on a range
        // literal is two comparisons, no allocation.
        if (receiverTy != null and receiverTy.kind == "Range" and name == "contains" and e.args.size == 1 and obj.kind == "range") {
            val lo = this.expr(obj.kids[0])
            val hi = this.expr(obj.kids[1])
            val v = this.expr(e.args[0].value)
            val t = this.temp()
            this.line("const bool ${t} = (${v} >= ${lo} && ${v} < ${hi});")
            return t
        }
        if (receiverTy == null or receiverTy.kind != "Class") {
            this.unsupported(e.file, e.line, e.col, "the method `${name}` on a built-in type")
            return "0"
        }
        val class_ = receiverTy.name
        val classArgs = receiverTy.args

        // `b.f(21)` where `f` is a FIELD holding a closure. The parser reads
        // `x.name(...)` as a method call whatever `name` turns out to be, so
        // the class deciding it has no such method does not end the matter:
        // the checker already types this as calling the field's value, and
        // the two interpreters already run it. Nothing a declaration carries
        // applies — no named arguments, no defaults — so this leaves the
        // method path rather than borrowing it with an empty parameter list,
        // which is what indexed out of a zero-length slot table before.
        var declaresMethod = false
        val cd0 = this.classDecls[class_]
        if (cd0 != null) {
            for (m in cd0.methods) {
                if (m.name == name) { declaresMethod = true }
            }
        }
        unless (declaresMethod) {
            val fieldTy = this.classFieldType(class_, classArgs, name)
            if (fieldTy != null and fieldTy.kind == "Fun") {
                val read = Ex("field", e.line, e.col)
                read.file = e.file
                read.text = name
                read.safe = e.safe
                read.kids = [obj]
                read.ty = fieldTy
                val c = this.expr(read)
                val rendered0: List<String> = []
                for (a in e.args) { rendered0.add(this.expr(a.value)) }
                val call0 = this.callClosure(fieldTy, c, rendered0, e.file, e.line, e.col)
                if (call0 == null) { return "0" }
                return this.finishCall(e, call0)
            }
        }

        for (a in e.args) {
            unless (a.name == "") {
                this.unsupported(e.file, e.line, e.col, "named arguments")
                return "0"
            }
        }
        val receiver = this.expr(obj)
        var declParams: List<ParamN> = []
        val cd = this.classDecls[class_]
        if (cd != null) {
            for (m in cd.methods) {
                if (m.name == name and declParams.size == 0) { declParams = m.params }
            }
        }
        val calleeSubst: List<SubstPair> = []
        if (cd != null) {
            var i = 0
            while (i < cd.typeParams.size and i < classArgs.size) {
                calleeSubst.add(SubstPair(cd.typeParams[i].name, classArgs[i]))
                i += 1
            }
        }
        val rendered = this.renderArgsWithDefaults(declParams, calleeSubst, e.args, e.file, e.line, e.col)
        if (rendered == null) { return "0" }
        rendered.insert(0, receiver)
        val margs = e.inst
        var fnName = ""
        if (margs != null) {
            val n = this.instantiateMethod(class_, classArgs, name, margs, e.file, e.line, e.col)
            if (n == null) { return "0" }
            fnName = n
        } else {
            fnName = "${structNameOf(class_, classArgs)}_${mangleMethod(name)}"
        }
        val call = "${fnName}(${rendered.join(", ")})"
        if (safe) {
            return this.guarded(e, receiver, call)
        }

        val ty = this.ety(e)
        if (ty == null) { return call }
        if (ty.kind == "Unit") {
            this.line("${call};")
            return "0"
        }
        if (countedC(ty)) {
            return this.ownTempOf(ty, call)
        }
        val c = this.ctype(ty, e.file, e.line, e.col)
        if (c == null) { return "0" }
        val t = this.temp()
        this.line("const ${c} ${t} = ${call};")
        return t
    }

    /// A `when` compiles to a chain of tests inside `do { } while (0)`.
    func whenExpr(e: Ex): String {
        // A branch join of `Any` is a value like any other — the slot is
        // the tagged pair, and each branch boxes into it on the way in —
        // except in statement position, where the value is discarded and
        // the branches may not even be values.
        val discard = this.discardJoin
        this.discardJoin = false
        val ety0 = this.ety(e)
        var produces = ety0 != null and ety0.kind != "Unit" and ety0.kind != "Never"
        if (discard and ety0 != null and ety0.kind == "Any") { produces = false }
        var slot = ""
        if (produces) {
            val ty = ety0
            if (ty == null) { return "0" }
            val c = this.ctype(ty, e.file, e.line, e.col)
            if (c == null) { return "0" }
            val t = this.temp()
            // An `Any` slot starts empty: a branch whose last statement is
            // not a value — which the join makes `Any` and the checker then
            // refuses to *use* — simply leaves it null, and releasing a
            // null tag is nothing.
            if (ty.kind == "Any") {
                this.line("${c} ${t} = keal_any_null();")
            } else {
                this.line("${c} ${t};")
            }
            if (countedC(ty)) {
                this.own(t, ty)
            }
            slot = t
        }
        var slotTy: Ty? = null
        unless (slot == "") { slotTy = this.ety(e) }

        var subjectSlot = ""
        var subjectTy: Ty? = null
        val subject = e.subject
        if (subject != null) {
            val ty = this.ety(subject)
            if (ty == null) { return "0" }
            val c = this.ctype(ty, subject.file, subject.line, subject.col)
            if (c == null) { return "0" }
            val v = this.expr(subject)
            val t = this.temp()
            // Not `const` when counted: a release mutates the count.
            val qualifier = if (countedC(ty)) { "" } else { "const " }
            this.line("${qualifier}${c} ${t} = ${v};")
            subjectSlot = t
            subjectTy = ty
        }

        this.line("do {")
        this.indent += 1
        for (arm in e.arms) {
            // `is C(a, b)` binds fields the guard and body both see, so it
            // cannot ride the plain condition chain; it gets its own shape.
            val binds0 = arm.binds
            if (arm.patternKind == "is" and not arm.patNegated and binds0 != null) {
                this.isArmWithBinds(arm, arm.patTyEx!!, binds0, subjectSlot, subjectTy, slot, slotTy)
                continue
            }
            // The test gets a scope of its own, closed before the branch;
            // only the boolean crosses over.
            this.openScope()
            val taken = this.armTest(arm, subjectSlot, subjectTy)
            var cond = ""
            if (taken != "") {
                val t = this.temp()
                this.line("const bool ${t} = ${taken};")
                cond = t
            }
            this.closeScope()
            unless (cond == "") {
                this.line("if (${cond}) {")
                this.indent += 1
            }
            // The body's scope closes before the `break`, so its releases
            // run on the way out.
            this.openScope()
            this.branchBody(arm.body.stmts, slot, slotTy)
            this.closeScope()
            this.line("break;")
            unless (cond == "") {
                this.indent -= 1
                this.line("}")
            }
            if (cond == "") {
                // An unguarded `else` takes everything; nothing follows it.
                break
            }
        }
        this.indent -= 1
        this.line("} while (0);")
        if (slot == "") { return "0" }
        return slot
    }

    /// `is C(a, b)`: the tag test opens the arm, the payload is cast once,
    /// and each field binds borrowed — the subject's own temp keeps the
    /// instance alive for the whole `when`. The guard runs after the binds,
    /// inside the tag test; when it fails, the chain simply falls through.
    proc isArmWithBinds(arm: ArmN, te: TypeEx, d: DestrN, subjectSlot: String, subjectTy: Ty?, slot: String, slotTy: Ty?) {
        if (subjectSlot == "") {
            this.unsupported(te.file, te.line, te.col, "`is` without a `when` subject")
            return
        }
        unless (subjectTy != null and subjectTy.kind == "Any") {
            this.unsupported(te.file, te.line, te.col, "`is` on anything but an `Any` subject")
            return
        }
        val target = this.isTarget(te, te.file, te.line, te.col)
        if (target == null) { return }
        unless (target.kind == "Class") {
            this.unsupported(te.file, te.line, te.col, "destructuring a value that is not a class")
            return
        }
        val decl = this.classDecls[target.name]
        if (decl == null) { return }
        val subst: Map<String, Ty> = {}
        var pi = 0
        while (pi < decl.typeParams.size and pi < target.args.size) {
            subst[decl.typeParams[pi].name] = target.args[pi]
            pi += 1
        }
        val raw = this.shapes[target.name]
        val fields: List<SField> = []
        if (raw != null) {
            for (f in raw) { fields.add(SField(f.name, substitute(f.ty, subst))) }
        }
        var sn = structName(target.name)
        if (target.args.size > 0) {
            val inst = this.instantiateClass(target.name, target.args, te.file, te.line, te.col)
            if (inst == null) { return }
            sn = inst
        }
        val test = this.anyIsTest(target, subjectSlot, te.file, te.line, te.col)
        this.line("if (${test}) {")
        this.indent += 1
        this.openScope()
        val p = this.temp()
        this.line("${sn}* ${p} = (${sn}*)${subjectSlot}.w.p;")
        var bi = 0
        while (bi < d.binds.size and bi < fields.size) {
            val bname = d.binds[bi]
            val f = fields[bi]
            unless (bname == "_") {
                val ct = this.ctype(f.ty, te.file, te.line, te.col)
                if (ct != null) {
                    this.line("const ${ct} ${mangle(bname)} = ${p}->${mangle(f.name)};")
                    this.declareLocal(bname, f.ty, false)
                }
            }
            bi += 1
        }
        var guardSlot = ""
        val g = arm.guard
        if (g != null) {
            this.openScope()
            val c = this.expr(g)
            val t = this.temp()
            this.line("const bool ${t} = ${c};")
            this.closeScope()
            guardSlot = t
        }
        unless (guardSlot == "") {
            this.line("if (${guardSlot}) {")
            this.indent += 1
        }
        this.openScope()
        this.branchBody(arm.body.stmts, slot, slotTy)
        this.closeScope()
        this.line("break;")
        unless (guardSlot == "") {
            this.indent -= 1
            this.line("}")
        }
        this.closeScope()
        this.indent -= 1
        this.line("}")
    }

    /// Emits an arm's test against the subject, returning the condition to
    /// branch on, or "" for an unguarded `else`.
    func armTest(arm: ArmN, subjectSlot: String, subjectTy: Ty?): String {
        val conds: List<String> = []
        if (arm.patternKind == "values") {
            val hits: List<String> = []
            for (v in arm.values) {
                if (subjectTy != null) {
                    val rhs = this.expr(v)
                    hits.add(this.equality(subjectTy, subjectSlot, rhs, v))
                } else {
                    hits.add(this.expr(v))
                }
            }
            conds.add("(${hits.join(" || ")})")
        } else if (arm.patternKind == "is") {
            val te = arm.patTyEx!!
            if (subjectTy != null and subjectTy.kind == "Any") {
                val target = this.isTarget(te, te.file, te.line, te.col)
                if (target == null) {
                    conds.add("false")
                } else {
                    val test = this.anyIsTest(target, subjectSlot, te.file, te.line, te.col)
                    conds.add(if (arm.patNegated) { "(!${test})" } else { test })
                }
            } else {
                this.unsupported(te.file, te.line, te.col, "`is` on anything but an `Any` subject")
                conds.add("false")
            }
        } else if (arm.patternKind == "in") {
            val range = arm.values[0]
            if (subjectSlot == "") { return "false" }
            unless (range.kind == "range") {
                this.unsupported(range.file, range.line, range.col, "`in` over anything but a range")
                return "false"
            }
            val lo = this.expr(range.kids[0])
            val hi = this.expr(range.kids[1])
            val test = "(${subjectSlot} >= ${lo} && ${subjectSlot} < ${hi})"
            conds.add(if (arm.patNegated) { "(!${test})" } else { test })
        }
        val guard = arm.guard
        if (guard != null) {
            conds.add(this.expr(guard))
        }
        if (conds.size == 0) { return "" }
        return conds.join(" && ")
    }

    /// `subject == candidate`, spelled correctly for the subject's type.
    func equality(t: Ty, slot: String, rhs: String, at: Ex): String {
        if (t.kind == "Str") { return "(keal_str_cmp(${slot}, ${rhs}) == 0)" }
        if (t.kind == "Int" or t.kind == "Float" or t.kind == "Bool" or t.kind == "Enum") {
            return "(${slot} == ${rhs})"
        }
        if (t.kind == "Any") {
            val rt = this.ety(at)
            val r = this.anyOf(rt, rhs, at.file, at.line, at.col)
            return "keal_any_eq(${slot}, ${r})"
        }
        // A nullable subject is two questions, and `null` is one of the
        // values it can be matched against — so `when (s) { null -> ... }`
        // reads the tag, and every other arm reads the tag and then the
        // value under it.
        if (t.kind == "Nullable") {
            val inner = t.args[0]
            if (at.kind == "null") { return "(!" + optHas(inner, slot) + ")" }
            val got = optGet(inner, slot)
            val innerEq = this.equality(inner, got, rhs, at)
            return "(${optHas(inner, slot)} && ${innerEq})"
        }
        this.unsupported(at.file, at.line, at.col, "matching on a value of type `${tyShow(t)}`")
        return "false"
    }

    /// An arm's body: its last expression fills the slot when there is one.
    proc branchBody(stmts: List<StmtN>, slot: String, slotTy: Ty?) {
        val last = stmts.size - 1
        var i = 0
        while (i < stmts.size) {
            val s = stmts[i]
            if (s.kind == "expr" and slot != "" and i == last) {
                this.fillSlot(s.ex!!, slot, slotTy)
            } else {
                this.seqStmt(s)
            }
            i += 1
        }
    }

    /// Assigns a branch's value into the enclosing slot. A counted value
    /// takes a reference of its own before this branch's is released, and a
    /// value meeting a tagged nullable slot wraps on the way in.
    proc fillSlot(e: Ex, slot: String, slotTy: Ty?) {
        // A statement-shaped expression cannot fill an `Any` slot; it runs
        // for its effect and the slot stays as it started.
        val ity0 = this.ety(e)
        if (slotTy != null and slotTy.kind == "Any" and (ity0 == null or ity0.kind == "Unit" or ity0.kind == "Never")) {
            val v0 = this.expr(e)
            if (v0.endsWith(")") or v0.startsWith("_t")) {
                this.line("(void)(${v0});")
            }
            return
        }
        val ity = this.ety(e)
        val counted = ity != null and countedC(ity)
        if (counted) {
            val v = if (slotTy != null) {
                this.coercedTo(e, slotTy)
            } else {
                this.expr(e)
            }
            // Boxed into an `Any` slot, the retain is the `Any`'s own;
            // otherwise the value keeps its type's retain, as before.
            var ty2: Ty? = this.ety(e)
            if (slotTy != null and slotTy.kind == "Any") { ty2 = Ty("Any") }
            val rt = ty2
            if (rt != null) {
                this.line("${slot} = ${retained(rt, v)};")
            } else {
                this.line("${slot} = ${v};")
            }
        } else {
            val v = if (slotTy != null) {
                this.coercedTo(e, slotTy)
            } else {
                this.expr(e)
            }
            this.line("${slot} = ${v};")
        }
    }

    func intern(s: String): Int {
        var i = 0
        while (i < this.stringLiterals.size) {
            if (this.stringLiterals[i] == s) { return i }
            i += 1
        }
        this.stringLiterals.add(s)
        return this.stringLiterals.size - 1
    }

    func binary(e: Ex): String {
        val op = e.text
        val lhs = e.kids[0]
        val rhs = e.kids[1]
        val lty = this.ety(lhs)
        // String concatenation allocates, so it goes through the runtime.
        if (op == "+" and lty != null and lty.kind == "Str") {
            val a = this.expr(lhs)
            val b = this.toStringValue(rhs)
            return this.ownTemp("keal_concat(${a}, ${b})")
        }

        val a = this.expr(lhs)
        val b = this.expr(rhs)
        // Integer arithmetic is checked, matching the other two engines.
        if (lty != null and lty.kind == "Int" and isCheckedIntOp(op)) {
            val t = this.temp()
            val helper = when (op) {
                "+" -> "keal_add"
                "-" -> "keal_sub"
                "*" -> "keal_mul"
                "/" -> "keal_div"
                "**" -> "keal_int_pow"
                "^/" -> "keal_int_root"
                // The shifts take the same shape for the shift count, and
                // because C leaves `<<` past the sign bit and `>>` on a
                // negative value to the implementation. `band`, `bor` and
                // `bxor` need none of that and stay operators.
                "shl" -> "keal_shl"
                "shr" -> "keal_shr"
                "ushr" -> "keal_ushr"
                else -> "keal_rem"
            }
            this.line("const int64_t ${t} = ${helper}(${a}, ${b}, ${e.line});")
            this.checkUnwind()
            return t
        }
        // `Any` equality is dynamic: same tag, then the interpreters'
        // values_equal — structure for data, identity for instances. A null
        // literal against an `Any` is a tag test.
        if (op == "==" or op == "!=") {
            val rty = this.ety(rhs)
            val lAny = lty != null and lty.kind == "Any"
            val rAny = rty != null and rty.kind == "Any"
            if (lAny or rAny) {
                var test = ""
                if (rhs.kind == "null") {
                    test = "(${a}.ti == NULL)"
                } else if (lhs.kind == "null") {
                    test = "(${b}.ti == NULL)"
                } else {
                    var av = a
                    unless (lAny) { av = this.anyOf(lty, a, lhs.file, lhs.line, lhs.col) }
                    var bv = b
                    unless (rAny) { bv = this.anyOf(rty, b, rhs.file, rhs.line, rhs.col) }
                    test = "keal_any_eq(${av}, ${bv})"
                }
                if (op == "!=") { return "(!${test})" }
                return test
            }
        }
        // `x == null` on a tagged value is a presence test, not a compare.
        if (op == "==" or op == "!=") {
            var optSide: Ex? = null
            if (rhs.kind == "null") {
                optSide = lhs
            } else if (lhs.kind == "null") {
                optSide = rhs
            }
            val side = optSide
            if (side != null) {
                val st = this.ety(side)
                if (st != null and st.kind == "Nullable") {
                    if (isValueOpt(st)) {
                        val inner = st.args[0]
                        val v = this.expr(side)
                        val has = optHas(inner, v)
                        if (op == "==") { return "(!${has})" }
                        return has
                    }
                }
            }
        }
        // A tagged optional against a value, or against another optional.
        //
        // `m[k] == 2` asks "present, and equal"; two optionals are equal when
        // both are absent, or both present with equal values. Nothing
        // compared them before, because the only way to hold an `Int?` was
        // `m[k]` and that was refused — so generalising the lookup made this
        // path reachable and the emitted C compared a struct with an integer.
        if ((op == "==" or op == "!=") and lhs.kind != "null" and rhs.kind != "null") {
            val rtE = this.ety(rhs)
            var lInner: Ty? = null
            var rInner: Ty? = null
            if (lty != null and isValueOpt(lty)) { lInner = lty.args[0] }
            if (rtE != null and isValueOpt(rtE)) { rInner = rtE.args[0] }
            val li = lInner
            val ri = rInner
            if (li != null or ri != null) {
                var test = ""
                if (li != null and ri != null) {
                    test = "((${optHas(li, a)} == ${optHas(ri, b)}) && (!${optHas(li, a)} || ${optGet(li, a)} == ${optGet(ri, b)}))"
                } else if (li != null) {
                    test = "(${optHas(li, a)} && ${optGet(li, a)} == ${b})"
                } else if (ri != null) {
                    test = "(${optHas(ri, b)} && ${optGet(ri, b)} == ${a})"
                }
                if (op == "!=") { return "(!${test})" }
                return test
            }
        }
        // Lists compare structurally, as the interpreters compare them; a
        // pointer comparison would be a silent lie. Maps are refused by name
        // until they earn the same treatment.
        if ((op == "==" or op == "!=") and lhs.kind != "null" and rhs.kind != "null") {
            val rt0 = this.ety(rhs)
            var lbase0: Ty? = null
            if (lty != null) { lbase0 = tyNonNull(lty) }
            var rbase0: Ty? = null
            if (rt0 != null) { rbase0 = tyNonNull(rt0) }
            val lbase = lbase0
            val rbase = rbase0
            var listElem: Ty? = null
            if (lbase != null) {
                if (lbase.kind == "List") { listElem = lbase.args[0] }
            }
            val le0 = listElem
            var listElem2: Ty? = le0
            if (le0 == null and rbase != null) {
                if (rbase.kind == "List") { listElem2 = rbase.args[0] }
            }
            val le = listElem2
            if (le != null) {
                val eq = this.elemEqFn(le, e.file, e.line, e.col, "comparing a list of")
                if (eq == null) { return "0" }
                val t = this.temp()
                val negate = if (op == "!=") { "!" } else { "" }
                this.line("const bool ${t} = ${negate}keal_list_eq(${a}, ${b}, ${eq});")
                return t
            }
            var mapVal0: Ty? = null
            if (lbase != null) {
                if (lbase.kind == "Map") { mapVal0 = lbase.args[1] }
            }
            val mv0 = mapVal0
            var mapVal1: Ty? = mv0
            if (mv0 == null and rbase != null) {
                if (rbase.kind == "Map") { mapVal1 = rbase.args[1] }
            }
            val vt = mapVal1
            if (vt != null) {
                val eq = this.elemEqFn(vt, e.file, e.line, e.col, "comparing map values of")
                if (eq == null) { return "0" }
                val t = this.temp()
                val negate = if (op == "!=") { "!" } else { "" }
                this.line("const bool ${t} = ${negate}keal_map_eq(${a}, ${b}, ${eq});")
                return t
            }
        }
        val rty = this.ety(rhs)
        var nullableStr = false
        if (lty != null and lty.kind == "Nullable") {
            if (lty.args[0].kind == "Str") { nullableStr = true }
        }
        if (rty != null and rty.kind == "Nullable") {
            if (rty.args[0].kind == "Str") { nullableStr = true }
        }
        val againstNull = lhs.kind == "null" or rhs.kind == "null"
        if (nullableStr and not againstNull and (op == "==" or op == "!=")) {
            val t = this.temp()
            val negate = if (op == "!=") { "!" } else { "" }
            this.line("const bool ${t} = ${negate}keal_opt_str_eq(${a}, ${b});")
            return t
        }
        if (lty != null and lty.kind == "Str" and op != "+") {
            val t = this.temp()
            val cmp = when (op) {
                "==" -> "== 0"
                "!=" -> "!= 0"
                "<" -> "< 0"
                "<=" -> "<= 0"
                ">" -> "> 0"
                else -> ">= 0"
            }
            this.line("const bool ${t} = keal_str_cmp(${a}, ${b}) ${cmp};")
            return t
        }
        // C's `%` is integer-only; the float remainder is `fmod`, which is
        // also what Rust's `%` on f64 computes. Power and root are calls too.
        if (op == "%" and lty != null and lty.kind == "Float") {
            return "fmod(${a}, ${b})"
        }
        if (op == "**" and lty != null and lty.kind == "Float") {
            return "pow(${a}, ${b})"
        }
        if (op == "^/" and lty != null and lty.kind == "Float") {
            return "keal_f_root(${a}, ${b})"
        }
        // `band`, `bor` and `bxor` are C operators under other names; every
        // other operator that reaches here spells itself.
        val cOp = when (op) {
            "band" -> "&"
            "bor" -> "|"
            "bxor" -> "^"
            else -> op
        }
        return "(${a} ${cOp} ${b})"
    }

    /// Emits a value rendered as an owned string, for concatenation and
    /// interpolation.
    /// The function turning one of an enum's ordinals back into its name,
    /// emitted once per enum and only for an enum a program actually shows.
    /// An enum nobody prints costs not one byte of table.
    func enumNames(name: String): String {
        val f = "K_" + flatten(name) + "_name"
        if (this.thunks.contains(f)) { return f }
        this.thunks[f] = true
        var names: List<String> = []
        if (this.enumNamesOf.contains(name)) { names = this.enumNamesOf[name]!! }
        this.decls += "KealStr* ${f}(int64_t v);\n"
        var out = "\nKealStr* ${f}(int64_t v) {\n"
        out += "    switch (v) {\n"
        var i = 0
        while (i < names.size) {
            out += "    case ${i}: return keal_str_static(${cString(names[i])}, ${names[i].length});\n"
            i += 1
        }
        // Unreachable: an ordinal only ever comes from a variant of this
        // enum. Spelled out anyway, because a C compiler wants a value on
        // every path and a silent one would be a lie.
        out += "    }\n"
        out += "    return keal_str_static(\"?\", 1);\n"
        out += "}\n"
        this.defs += out
        return f
    }

    func toStringValue(e: Ex): String {
        val ty = this.ety(e)
        val v = this.expr(e)
        if (ty == null) {
            this.unsupported(e.file, e.line, e.col, "rendering a value of type `?`")
            return "keal_str_empty()"
        }
        if (ty.kind == "Str") { return v }
        var call = ""
        if (ty.kind == "Any") {
            call = "keal_any_display(${v})"
        } else if (ty.kind == "Int") {
            call = "keal_str_from_int(${v})"
        } else if (ty.kind == "Float") {
            call = "keal_str_from_float(${v})"
        } else if (ty.kind == "Bool") {
            call = "keal_str_from_bool(${v})"
        } else if (ty.kind == "Enum") {
            // The names table, emitted once per enum that is ever shown.
            call = this.enumNames(ty.name) + "(${v})"
        } else if (ty.kind == "Class") {
            call = "${structNameOf(ty.name, ty.args)}_show(${v})"
        } else if (ty.kind == "List") {
            val f = this.listShow(ty.args[0], e.file, e.line, e.col)
            if (f == null) {
                return "keal_str_empty()"
            }
            call = "${f}(${v})"
        } else if (ty.kind == "Map") {
            val f = this.mapShow(ty.args[0], ty.args[1], e.file, e.line, e.col)
            if (f == null) {
                return "keal_str_empty()"
            }
            call = "${f}(${v})"
        } else if (ty.kind == "Null") {
            call = "keal_str_static(\"null\", 4)"
        } else if (ty.kind == "Nullable") {
            // Absent renders as `null`; present renders as itself.
            val inner = ty.args[0]
            val slot = this.temp()
            this.line("KealStr* ${slot} = NULL;")
            this.own(slot, Ty("Str"))
            this.line("if (!${optHas(inner, v)}) {")
            this.indent += 1
            this.line("${slot} = keal_str_static(\"null\", 4);")
            this.indent -= 1
            this.line("} else {")
            this.indent += 1
            var rendered = ""
            if (inner.kind == "Str") {
                rendered = "keal_str_retain(${v})"
            } else if (inner.kind == "Class") {
                rendered = "${structNameOf(inner.name, inner.args)}_show(${v})"
            } else if (inner.kind == "Int") {
                rendered = "keal_str_from_int(${optGet(inner, v)})"
            } else if (inner.kind == "Float") {
                rendered = "keal_str_from_float(${optGet(inner, v)})"
            } else if (inner.kind == "Bool") {
                rendered = "keal_str_from_bool(${optGet(inner, v)})"
            } else if (inner.kind == "List") {
                // A nullable container is a plain pointer, so once the absent
                // case is out of the way the renderer for the container
                // itself is the one that already exists.
                val f = this.listShow(inner.args[0], e.file, e.line, e.col)
                if (f == null) { return "keal_str_empty()" }
                rendered = "${f}(${v})"
            } else if (inner.kind == "Map") {
                val f = this.mapShow(inner.args[0], inner.args[1], e.file, e.line, e.col)
                if (f == null) { return "keal_str_empty()" }
                rendered = "${f}(${v})"
            } else {
                this.unsupported(e.file, e.line, e.col, "rendering a value of type `${tyShow(inner)}?`")
                return "keal_str_empty()"
            }
            this.line("${slot} = ${rendered};")
            this.indent -= 1
            this.line("}")
            return slot
        } else {
            this.unsupported(e.file, e.line, e.col, "rendering a value of type `${tyShow(ty)}`")
            return "keal_str_empty()"
        }
        return this.ownTemp(call)
    }

    func interpolate(e: Ex): String {
        var acc = ""
        var hasAcc = false
        for (part in e.parts) {
            var piece = ""
            if (part.isLit) {
                val idx = this.intern(part.text)
                piece = "keal_str_retain(_str${idx})"
            } else {
                piece = this.toStringValue(part.ex!!)
            }
            if (hasAcc) {
                acc = this.ownTemp("keal_concat(${acc}, ${piece})")
            } else {
                acc = piece
                hasAcc = true
            }
        }
        if (hasAcc) { return acc }
        return "keal_str_empty()"
    }

    func logical(e: Ex): String {
        val op = e.text
        val lhs = e.kids[0]
        val rhs = e.kids[1]
        val a = this.expr(lhs)
        val t = this.temp()
        // A connective that can be settled by its left operand keeps its
        // short-circuit: the right operand is emitted inside a branch.
        val onTrue = shortCircuitC(op, true)
        val onFalse = shortCircuitC(op, false)
        if (onTrue != null or onFalse != null) {
            val settlesOn = if (onTrue != null) { "" } else { "!" }
            val settled = if (onTrue != null) { onTrue } else { onFalse!! }
            this.line("bool ${t};")
            // The operand already carries the parentheses `binary` puts
            // around what it builds; a second pair here is what a C
            // compiler reads as "yes, this assignment was deliberate",
            // and it says so about every comparison that lands in one.
            val bare = stripOuterParens(a)
            val cond = if (settlesOn == "") { bare } else { "!(${bare})" }
            this.line("if (${cond}) {")
            this.indent += 1
            this.line("${t} = ${settled};")
            this.indent -= 1
            this.line("} else {")
            this.indent += 1
            this.openScope()
            val b = this.expr(rhs)
            this.line("${t} = ${applyLogicalC(op, a, b)};")
            this.closeScope()
            this.indent -= 1
            this.line("}")
        } else {
            val b = this.expr(rhs)
            this.line("const bool ${t} = ${applyLogicalC(op, a, b)};")
        }
        return t
    }

    /// `c ? a : b` and `c ? less : equal : greater`: the `if` expression's
    /// slot mechanics, with expressions for branches. The condition is
    /// emitted once; a `Comp` reads its sign into a temp for the split.
    func ternary(e: Ex): String {
        val discard = this.discardJoin
        this.discardJoin = false
        val ety0 = this.ety(e)
        var produces = ety0 != null and ety0.kind != "Unit" and ety0.kind != "Never"
        if (discard and ety0 != null and ety0.kind == "Any") { produces = false }
        var slot = ""
        if (produces) {
            val ty = ety0
            if (ty == null) { return "0" }
            val c = this.ctype(ty, e.file, e.line, e.col)
            if (c == null) { return "0" }
            val t = this.temp()
            // An `Any` slot starts empty: a branch whose last statement is
            // not a value — which the join makes `Any` and the checker then
            // refuses to *use* — simply leaves it null, and releasing a
            // null tag is nothing.
            if (ty.kind == "Any") {
                this.line("${c} ${t} = keal_any_null();")
            } else {
                this.line("${c} ${t};")
            }
            if (countedC(ty)) {
                this.own(t, ty)
            }
            slot = t
        }
        var slotTy: Ty? = null
        unless (slot == "") { slotTy = this.ety(e) }
        val condTy = this.ety(e.kids[0])
        val comp = condTy != null and condTy.kind == "Class" and condTy.name == "Comp" and condTy.args.size == 0
        unless (comp) {
            val c = this.condition(e.kids[0])
            this.line("if (${c}) {")
            this.indent += 1
            this.exprBranch(e.kids[1], slot, slotTy)
            this.indent -= 1
            this.line("} else {")
            this.indent += 1
            this.exprBranch(e.kids[2], slot, slotTy)
            this.indent -= 1
            this.line("}")
        }
        if (comp) {
            val c = this.expr(e.kids[0])
            val s = this.temp()
            this.line("const int64_t ${s} = ${c}->${mangle("sign")};")
            this.line("if (${s} < 0) {")
            this.indent += 1
            this.exprBranch(e.kids[1], slot, slotTy)
            this.indent -= 1
            this.line("} else if (${s} == 0) {")
            this.indent += 1
            this.exprBranch(e.kids[2], slot, slotTy)
            this.indent -= 1
            this.line("} else {")
            this.indent += 1
            this.exprBranch(e.kids[3], slot, slotTy)
            this.indent -= 1
            this.line("}")
        }
        if (slot == "") { return "0" }
        return slot
    }

    /// One ternary branch: its own scope, its value into the slot.
    proc exprBranch(b: Ex, slot: String, slotTy: Ty?) {
        this.openScope()
        if (slot == "") {
            this.expr(b)
        } else {
            this.fillSlot(b, slot, slotTy)
        }
        this.closeScope()
    }

    func ifExpr(e: Ex): String {
        // A branch join of `Any` is a value like any other — the slot is
        // the tagged pair, and each branch boxes into it on the way in —
        // except in statement position, where the value is discarded and
        // the branches may not even be values.
        val discard = this.discardJoin
        this.discardJoin = false
        val ety0 = this.ety(e)
        var produces = ety0 != null and ety0.kind != "Unit" and ety0.kind != "Never"
        if (discard and ety0 != null and ety0.kind == "Any") { produces = false }
        var slot = ""
        if (produces) {
            val ty = ety0
            if (ty == null) { return "0" }
            val c = this.ctype(ty, e.file, e.line, e.col)
            if (c == null) { return "0" }
            val t = this.temp()
            // An `Any` slot starts empty: a branch whose last statement is
            // not a value — which the join makes `Any` and the checker then
            // refuses to *use* — simply leaves it null, and releasing a
            // null tag is nothing.
            if (ty.kind == "Any") {
                this.line("${c} ${t} = keal_any_null();")
            } else {
                this.line("${c} ${t};")
            }
            if (countedC(ty)) {
                this.own(t, ty)
            }
            slot = t
        }
        var slotTy: Ty? = null
        unless (slot == "") { slotTy = this.ety(e) }

        val c = this.condition(e.kids[0])
        this.line("if (${c}) {")
        this.indent += 1
        this.branch(e.body!!.stmts, slot, slotTy)
        this.indent -= 1
        val els = e.els
        val elseif = e.elseif
        if (els != null) {
            this.line("} else {")
            this.indent += 1
            this.branch(els.stmts, slot, slotTy)
            this.indent -= 1
            this.line("}")
        } else if (elseif != null) {
            this.line("} else {")
            this.indent += 1
            this.openScope()
            if (slot == "") {
                this.expr(elseif)
            } else {
                this.fillSlot(elseif, slot, slotTy)
            }
            this.closeScope()
            this.indent -= 1
            this.line("}")
        } else {
            this.line("}")
        }
        if (slot == "") { return "0" }
        return slot
    }

    /// A branch of an `if`, whose value is that of its last statement.
    proc branch(stmts: List<StmtN>, slot: String, slotTy: Ty?) {
        this.openScope()
        val last = stmts.size - 1
        var i = 0
        while (i < stmts.size) {
            val s = stmts[i]
            if (s.kind == "expr" and slot != "" and i == last) {
                this.fillSlot(s.ex!!, slot, slotTy)
            } else {
                this.seqStmt(s)
            }
            i += 1
        }
        this.closeScope()
    }

    func call(e: Ex): String {
        val callee = e.kids[0]
        val args = e.args
        // Anything of function type is callable through its closure; a name
        // that is a program function, class or built-in dispatches directly.
        // A local of the same name wins, exactly as it does for the checker
        // and for both interpreters. Without this the backend read past the
        // binding in scope to the global function behind it and emitted a
        // direct call to the wrong thing — which C then refused, because a
        // Keal local and a Keal global mangle to the same C name and the
        // local is a closure pointer rather than a function. A `cc` error is
        // not a refusal by name, and one shape of this is a program the
        // checker accepted and the backend would not build.
        var named = false
        if (callee.kind == "ident") {
            val n = callee.text
            val two: List<Ty?> = [null, null]
            unless (this.inScope(n)) {
                named = this.globalFuns.contains(n) or this.shapes.contains(n) or globalSig(n, two) != null
            }
        }
        unless (named) {
            val ct = this.ety(callee)
            if (ct != null and ct.kind == "Fun") {
                val c = this.expr(callee)
                val rendered: List<String> = []
                for (a in args) {
                    rendered.add(this.expr(a.value))
                }
                val call = this.callClosure(ct, c, rendered, e.file, e.line, e.col)
                if (call == null) { return "0" }
                return this.finishCall(e, call)
            }
        }
        unless (callee.kind == "ident") {
            this.unsupported(e.file, e.line, e.col, "calling this expression")
            return "0"
        }
        val name = callee.text
        // The host built-ins.
        if (name == "args" and args.size == 0) {
            return this.ownTempOf(tyList(Ty("Str")), "keal_args()")
        }
        if (name == "readFile" and args.size == 1) {
            val p = this.expr(args[0].value)
            return this.ownTempOf(tyNullable(Ty("Str")), "keal_read_file(${p})")
        }
        if (name == "time" and args.size == 0) {
            val t = this.temp()
            this.line("const double ${t} = keal_time();")
            return t
        }
        if (name == "localOffset" and args.size == 1) {
            val at = this.expr(args[0].value)
            val t = this.temp()
            this.line("const int64_t ${t} = keal_local_offset(${at});")
            return t
        }
        if (name == "listDir" and args.size == 1) {
            val p = this.expr(args[0].value)
            return this.ownTempOf(tyNullable(tyList(Ty("Str"))), "keal_list_dir(${p})")
        }
        val prims = [["pathKind", "keal_path_kind", "int64_t"],
                     ["makeDir", "keal_make_dir", "bool"],
                     ["removePath", "keal_remove_path", "bool"]]
        for (pr in prims) {
            if (name == pr[0] and args.size == 1) {
                val p = this.expr(args[0].value)
                val t = this.temp()
                this.line("const ${pr[2]} ${t} = ${pr[1]}(${p});")
                return t
            }
        }
        if (name == "writeFile" and args.size == 2) {
            val p = this.expr(args[0].value)
            val c = this.expr(args[1].value)
            val t = this.temp()
            this.line("const bool ${t} = keal_write_file(${p}, ${c});")
            return t
        }
        if (name == "runCommand" and args.size == 1) {
            val v = this.expr(args[0].value)
            return this.ownTempOf(tyNullable(tyList(Ty("Str"))), "keal_run_command(${v})")
        }
        if (name == "readLine" and args.size == 0) {
            return this.ownTempOf(tyNullable(Ty("Str")), "keal_read_line()")
        }
        if (name == "random" and args.size == 0) {
            val t = this.temp()
            this.line("const double ${t} = keal_random();")
            return t
        }
        if (name == "randomInt" and args.size == 2) {
            val lo = this.expr(args[0].value)
            val hi = this.expr(args[1].value)
            val t = this.temp()
            this.line("const int64_t ${t} = keal_random_int(${lo}, ${hi}, ${e.line});")
            this.checkUnwind()
            return t
        }
        // `abs`, `min` and `max` take Ints or Floats and give back that type,
        // which the checker has already settled — so the emitted C only has
        // to pick the arithmetic that matches it.
        if ((name == "abs" or name == "min" or name == "max") and args.size > 0) {
            val et = this.ety(e)
            val isFloat = et != null and et.kind == "Float"
            var ct = "int64_t"
            if (isFloat) { ct = "double" }
            val a = this.expr(args[0].value)
            val t = this.temp()
            if (name == "abs") {
                var call = "keal_abs_i64(${a})"
                if (isFloat) { call = "fabs(${a})" }
                this.line("const ${ct} ${t} = ${call};")
            } else {
                val b = this.expr(args[1].value)
                var call = ""
                if (isFloat) {
                    var fn = "fmax"
                    if (name == "min") { fn = "fmin" }
                    call = "${fn}(${a}, ${b})"
                } else {
                    var op = ">"
                    if (name == "min") { op = "<" }
                    call = "(${a} ${op} ${b} ? ${a} : ${b})"
                }
                this.line("const ${ct} ${t} = ${call};")
            }
            return t
        }
        if (name == "panic" and args.size == 1) {
            // `panic` never returns, so nothing after it is reachable and
            // there is no value to hand back — the same shape as `exit`,
            // except that the audit still gets to speak, because `keal_panic`
            // unwinds through the program rather than leaving through the C
            // library.
            val m = this.expr(args[0].value)
            this.line("keal_panic(${m}->bytes, ${e.line});")
            this.checkUnwind()
            return "0"
        }
        if (name == "exit" and args.size == 1) {
            val c = this.expr(args[0].value)
            if (this.auditMode) {
                if (this.atTopLevel) {
                    this.auditTail()
                } else {
                    this.refuse(
                        e.file, e.line, e.col,
                        "`exit` inside a function under `--audit`",
                        "the audit marks from the program's top-level bindings, which only exist while the top level runs: call `exit` there, or return the code from `func main(): Int`"
                    )
                }
            }
            // Skipping the releases is fine: the operating system reclaims
            // the whole process at once.
            this.line("exit((int)(${c}));")
            return "0"
        }
        // `typeOf`: dynamic for an `Any` — the tag names itself — and a
        // compile-time constant for everything else, spelled exactly as the
        // interpreters' `type_name` spells it.
        if (name == "typeOf" and args.size == 1) {
            val t = this.ety(args[0].value)
            if (t != null and t.kind == "Any") {
                val v = this.expr(args[0].value)
                return this.ownTempOf(Ty("Str"), "keal_any_type_name(${v})")
            }
            var named = ""
            var hasName = false
            if (t != null) {
                if (t.kind == "Int") { named = "Int" }
                if (t.kind == "Float") { named = "Float" }
                if (t.kind == "Bool") { named = "Bool" }
                if (t.kind == "Str") { named = "String" }
                if (t.kind == "List") { named = "List" }
                if (t.kind == "Map") { named = "Map" }
                if (t.kind == "Range") { named = "Range" }
                if (t.kind == "Fun") { named = "Function" }
                if (t.kind == "Null") { named = "Null" }
                if (t.kind == "Class") { named = t.name }
                // An enum names itself, as a class does.
                if (t.kind == "Enum") { named = t.name }
                hasName = named != ""
            }
            unless (hasName) {
                this.unsupported(e.file, e.line, e.col, "`typeOf` of this value")
                return "0"
            }
            val v = this.expr(args[0].value)
            if (v.endsWith(")") or v.startsWith("_t")) {
                this.line("(void)(${v});")
            }
            return this.ownTempOf(Ty("Str"), "keal_str_static(${cString(named)}, ${named.length})")
        }
        // `assert`: the message, when given, is evaluated eagerly — the
        // interpreters evaluate arguments before the call, and so does this.
        // `copyClosure(f)`: a fresh closure whose captured values are
        // deep copies — what `spawn` calls so an actor's state is its own.
        if (name == "copyClosure" and args.size == 1) {
            val t = this.ety(args[0].value)
            if (t == null) {
                this.unsupported(e.file, e.line, e.col, "the built-in `copyClosure` on this value")
                return "0"
            }
            val v = this.expr(args[0].value)
            return this.ownTempOf(t, "keal_fn_copy_captures(${v})")
        }
        // `copy(value)`: data crosses, code does not — and now it crosses
        // natively, through per-type generated copies.
        if (name == "copy" and args.size == 1) {
            val t = this.ety(args[0].value)
            if (t == null) {
                this.unsupported(e.file, e.line, e.col, "the built-in `copy` on this value")
                return "0"
            }
            val v = this.expr(args[0].value)
            val expr0 = this.copyExprOf(t, v, "0", e.file, e.line, e.col)
            if (expr0 == null) {
                this.unsupported(e.file, e.line, e.col, "copying a value of type `${tyShow(t)}`")
                return "0"
            }
            if (countedC(t)) {
                return this.ownTempOf(t, expr0)
            }
            val ct = this.ctype(t, e.file, e.line, e.col)
            if (ct == null) { return "0" }
            val tmp = this.temp()
            val qual = if (this.catchMode) { "" } else { "const " }
            this.line("${qual}${ct} ${tmp} = ${expr0};")
            this.checkUnwind()
            return tmp
        }
        if (name == "assert" and (args.size == 1 or args.size == 2)) {
            val c = this.expr(args[0].value)
            if (args.size == 2) {
                val m = this.expr(args[1].value)
                this.line("if (!(${c})) { keal_panic(${m}->bytes, ${e.line}); }")
            } else {
                this.line("if (!(${c})) { keal_panic(\"assertion failed\", ${e.line}); }")
            }
            this.checkUnwind()
            return "0"
        }
        // The float globals map straight onto the C math library.
        if (name == "sqrt" and args.size == 1) {
            val v = this.expr(args[0].value)
            val t = this.temp()
            this.line("const double ${t} = sqrt(${v});")
            return t
        }
        if (name == "pow" and args.size == 2) {
            val a = this.expr(args[0].value)
            val b = this.expr(args[1].value)
            val t = this.temp()
            this.line("const double ${t} = pow(${a}, ${b});")
            return t
        }
        if ((name == "floor" or name == "ceil" or name == "round") and args.size == 1) {
            val v = this.expr(args[0].value)
            val t = this.temp()
            this.line("const int64_t ${t} = keal_f2i(${name}(${v}));")
            return t
        }
        // The two built-ins the subset needs.
        if (name == "println" or name == "print") {
            var text = "keal_str_empty()"
            if (args.size > 0) {
                text = this.toStringValue(args[0].value)
            }
            val isLn = if (name == "println") { "true" } else { "false" }
            this.line("keal_print(${text}, ${isLn});")
            return "0"
        }
        if (this.shapes.contains(name)) {
            var generic = false
            for (g in this.genericClasses) {
                if (g == name) { generic = true }
            }
            var sn = ""
            var ty = tyClass(name, [])
            if (generic) {
                val inst = e.inst
                if (inst == null) {
                    this.unsupported(e.file, e.line, e.col, "a generic construction the checker left unsolved")
                    return "0"
                }
                val targs: List<Ty> = []
                for (t in inst) { targs.add(substitute(t, this.tsubst)) }
                val sn0 = this.instantiateClass(name, targs, e.file, e.line, e.col)
                if (sn0 == null) { return "0" }
                sn = sn0
                ty = tyClass(name, targs)
            } else {
                sn = structName(name)
            }
            val decl = this.classDecls[name]
            val ctorParams: List<ParamN> = []
            val calleeSubst: List<SubstPair> = []
            if (decl != null) {
                for (cp in decl.ctor) {
                    val p = ParamN(cp.name, cp.line, cp.col)
                    p.file = cp.file
                    p.tyEx = cp.tyEx
                    p.default = cp.default
                    ctorParams.add(p)
                }
                var i = 0
                while (i < decl.typeParams.size and i < ty.args.size) {
                    calleeSubst.add(SubstPair(decl.typeParams[i].name, ty.args[i]))
                    i += 1
                }
            }
            val rendered = this.renderArgsWithDefaults(ctorParams, calleeSubst, args, e.file, e.line, e.col)
            if (rendered == null) { return "0" }
            val call = "${sn}_new(${rendered.join(", ")})"
            return this.ownTempOf(ty, call)
        }
        val two2: List<Ty?> = [null, null]
        if (globalSig(name, two2) != null) {
            this.unsupported(e.file, e.line, e.col, "the built-in `${name}`")
            return "0"
        }

        val symbol = this.externs[name]
        if (symbol != null) {
            val decl = this.externDecls[name]
            val rendered: List<String> = []
            var ai = 0
            while (ai < args.size) {
                val v = this.expr(args[ai].value)
                var paramTe: TypeEx? = null
                if (decl != null) {
                    if (ai < decl.params.size) { paramTe = decl.params[ai].tyEx }
                }
                val te = paramTe
                if (te == null) {
                    rendered.add(v)
                    ai += 1
                    continue
                }
                var mode = ""
                var inner = te
                if (te.kind == "boundary") {
                    mode = te.name
                    inner = te.inner!!
                }
                if (mode == "borrow") {
                    // C reads the bytes for the duration of the call; the
                    // temp that owns the string outlives it.
                    rendered.add("${v}->bytes")
                    ai += 1
                    continue
                }
                var marshalled = false
                if (inner.kind == "named" and inner.args.size == 0) {
                    val fields = this.shapes[inner.name]
                    if (fields != null) {
                        var lit = "(Keal_${inner.name}){ "
                        var fi = 0
                        while (fi < fields.size) {
                            if (fi > 0) { lit += ", " }
                            lit += ".${fields[fi].name} = ${v}->${mangle(fields[fi].name)}"
                            fi += 1
                        }
                        lit += " }"
                        rendered.add(lit)
                        marshalled = true
                    }
                }
                unless (marshalled) { rendered.add(v) }
                ai += 1
            }
            val call = "${symbol}(${rendered.join(", ")})"
            var retTe: TypeEx? = null
            if (decl != null) { retTe = decl.ret }
            val rte = retTe
            if (rte != null) {
                var mode = ""
                var inner = rte
                if (rte.kind == "boundary") {
                    mode = rte.name
                    inner = rte.inner!!
                }
                if (mode == "own") {
                    // C hands the buffer over; adopting it makes it a
                    // counted string that frees the bytes at the end.
                    return this.finishCall(e, "keal_str_adopt(${call})")
                }
                if (inner.kind == "named" and inner.args.size == 0) {
                    val fields = this.shapes[inner.name]
                    if (fields != null) {
                        val raw = this.temp()
                        this.line("const Keal_${inner.name} ${raw} = ${call};")
                        var ctorArgs = ""
                        var fi = 0
                        while (fi < fields.size) {
                            if (fi > 0) { ctorArgs += ", " }
                            ctorArgs += "${raw}.${fields[fi].name}"
                            fi += 1
                        }
                        val make = "K_${inner.name}_new(${ctorArgs})"
                        return this.ownTempOf(tyClass(inner.name, []), make)
                    }
                }
            }
            return this.finishCall(e, call)
        }
        var cname = mangle(name)
        val calleeSubst: List<SubstPair> = []
        val inst = e.inst
        if (inst != null) {
            val targs: List<Ty> = []
            for (t in inst) { targs.add(substitute(t, this.tsubst)) }
            val n = this.instantiateFunction(name, targs, e.file, e.line, e.col)
            if (n == null) { return "0" }
            cname = n
            val fd = this.funDecls[name]
            if (fd != null) {
                var i = 0
                while (i < fd.typeParams.size and i < targs.size) {
                    calleeSubst.add(SubstPair(fd.typeParams[i].name, targs[i]))
                    i += 1
                }
            }
        }
        var declParams: List<ParamN> = []
        val fd = this.funDecls[name]
        if (fd != null) { declParams = fd.params }
        val rendered = this.renderArgsWithDefaults(declParams, calleeSubst, args, e.file, e.line, e.col)
        if (rendered == null) { return "0" }
        val call = "${cname}(${rendered.join(", ")})"
        return this.finishCall(e, call)
    }

    /// Renders a call's arguments against the declaration's parameters:
    /// positional first, then named into their slots, then each missing slot
    /// filled by emitting its default at the call site.
    func renderArgsWithDefaults(params: List<ParamN>, calleeSubst: List<SubstPair>, args: List<ArgN>, file: Int, atLine: Int, col: Int): List<String>? {
        val slots: List<String> = []
        val filled: List<Bool> = []
        for (p in params) {
            slots.add("")
            filled.add(false)
        }
        var next = 0
        // Written arguments run first, in written order.
        for (a in args) {
            var idx = -1
            if (a.name == "") {
                idx = next
                next += 1
            } else {
                var i = 0
                while (i < params.size) {
                    if (params[i].name == a.name and idx < 0) { idx = i }
                    i += 1
                }
                if (idx < 0) { return null }
            }
            // The declared parameter type decides whether a wrap is needed.
            var target: Ty? = null
            if (idx < params.size) {
                val te = params[idx].tyEx
                if (te != null) {
                    val before = this.errors.size
                    target = this.resolvedTy(te, file, atLine, col)
                    if (target == null) {
                        this.truncateErrors(before)
                    }
                }
            }
            val tg = target
            val v = if (tg != null) {
                this.coercedTo(a.value, tg)
            } else {
                this.expr(a.value)
            }
            if (idx < slots.size) {
                slots[idx] = v
                filled[idx] = true
            }
        }

        val savedSubst = mapCopyTy(this.tsubst)
        for (pair in calleeSubst) {
            this.tsubst[pair.name] = pair.ty
        }
        var i = 0
        while (i < params.size) {
            if (filled[i]) {
                i += 1
                continue
            }
            val default = params[i].default
            if (default == null) {
                this.tsubst = savedSubst
                this.unsupported(file, atLine, col, "a call the checker left short")
                return null
            }
            val aliases: Map<String, String> = {}
            var j = 0
            while (j < i) {
                if (filled[j]) {
                    aliases[params[j].name] = slots[j]
                }
                j += 1
            }
            val savedAlias = this.paramAlias
            this.paramAlias = aliases
            val v = this.expr(default)
            this.paramAlias = savedAlias
            slots[i] = v
            filled[i] = true
            i += 1
        }
        this.tsubst = savedSubst
        return slots
    }

    /// Emits `e` coerced to `target`: `Int` into `Int?`, `null` into the
    /// absent form. Everywhere a plain value meets a nullable slot goes
    /// through here.
    func coercedTo(e: Ex, target: Ty): String {
        if (target.kind == "Any") {
            val src = this.ety(e)
            val v = this.expr(e)
            return this.anyOf(src, v, e.file, e.line, e.col)
        }
        if (isValueOpt(target)) {
            val inner = target.args[0]
            if (e.kind == "null") {
                return optNull(inner)
            }
            val t = this.ety(e)
            if (t != null and tyEq(t, inner)) {
                val v = this.expr(e)
                return optWrap(inner, v)
            }
        }
        return this.expr(e)
    }

    /// Binds a call's result according to its type, or emits it for effect.
    func finishCall(e: Ex, call: String): String {
        val ty = this.ety(e)
        if (ty == null) { return call }
        if (ty.kind == "Unit") {
            this.line("${call};")
            this.checkUnwind()
            // Arguments were borrowed; anything owned for the call is
            // released by whichever block created it.
            return "0"
        }
        val c = this.ctype(ty, e.file, e.line, e.col)
        if (c == null) { return "0" }
        val t = this.temp()
        // A counted result is not `const`: releasing it mutates the object.
        // In catch mode nothing is `const`, because the declaration hoists
        // to the top of the block for the unwind label's sake.
        val qualifier = if (countedC(ty) or this.catchMode) { "" } else { "const " }
        this.line("${qualifier}${c} ${t} = ${call};")
        if (countedC(ty)) {
            this.own(t, ty)
        }
        this.checkUnwind()
        return t
    }

    proc assign(target: Ex, op: String, value: Ex, e: Ex) {
        if (target.kind == "index") {
            val obj = target.kids[0]
            val index = target.kids[1]
            val ot = this.ety(obj)
            if (ot != null and ot.kind == "Map") {
                unless (op == "=") {
                    this.unsupported(e.file, e.line, e.col, "compound assignment into a map entry")
                    return
                }
                val kt = ot.args[0]
                val vt = ot.args[1]
                val kk = this.keyKind(kt, e.file, e.line, e.col)
                if (kk == null) { return }
                val vk = this.elemKind(vt, e.file, e.line, e.col)
                if (vk == null) { return }
                val m = this.expr(obj)
                val k = this.expr(index)
                val v = this.coercedTo(value, vt)
                val sk = retained(kt, k)
                val sv = retained(vt, v)
                this.line("keal_map_set(${m}, ${elemWord(kk, sk)}, ${elemWord(vk, sv)});")
                return
            }
            unless (op == "=") {
                // A compound assignment reads and writes the same element;
                // emitting the receiver twice would run its side effects
                // twice, so this is refused rather than quietly reordered.
                this.unsupported(e.file, e.line, e.col, "compound assignment into an element")
                return
            }
            if (ot == null or ot.kind != "List") {
                this.unsupported(e.file, e.line, e.col, "assigning into anything but a list")
                return
            }
            val elemTy = ot.args[0]
            val elem = this.elemKind(elemTy, e.file, e.line, e.col)
            if (elem == null) { return }
            val l = this.expr(obj)
            val i = this.expr(index)
            val v = this.coercedTo(value, elemTy)
            val stored = if (this.catchMode and countedC(elemTy)) {
                // The set can panic before it takes the reference; owning
                // it in a temp keeps the unwind path exact, and a clean
                // call transfers it by NULLing the temp.
                this.ownTempOf(elemTy, retained(elemTy, v))
            } else {
                retained(elemTy, v)
            }
            val release = releaseFn(elemTy)
            if (release != null) {
                val old = this.temp()
                this.line("const KealWord ${old} = keal_list_set(${l}, ${i}, ${elemWord(elem, stored)}, ${e.line});")
                this.checkUnwind()
                if (this.catchMode) {
                    if (elemTy.kind == "Any") {
                        this.line("${stored} = keal_any_null();")
                    } else {
                        this.line("${stored} = NULL;")
                    }
                }
                // A boxed element's displaced word is the box itself.
                if (elem.kind == "any") {
                    this.line("keal_any_box_release(${old}.p);")
                } else {
                    this.line("${release}(${elemUnword(elem, old)});")
                }
            } else {
                // Nothing to release; the displaced word is discarded.
                this.line("(void)keal_list_set(${l}, ${i}, ${elemWord(elem, stored)}, ${e.line});")
                this.checkUnwind()
            }
            return
        }
        if (target.kind == "ident") {
            val cell = this.celled[target.text]
            if (cell != null) {
                // Compound assignment reads through the same cell first.
                val v = if (op == "=") {
                    this.coercedTo(value, cell.ty)
                } else {
                    val synthetic = Ex("binary", e.line, e.col)
                    synthetic.file = e.file
                    synthetic.text = op
                    synthetic.kids = [target, value]
                    synthetic.ty = cell.ty
                    this.expr(synthetic)
                }
                val cellRef = this.varRef(target.text)
                if (cell.elem.kind == "any") {
                    this.line("keal_any_box_release(${cellRef}->w.p);")
                } else {
                    val rel = releaseFn(cell.ty)
                    if (rel != null) {
                        this.line("${rel}(${elemUnword(cell.elem, "${cellRef}->w")});")
                    }
                }
                val stored = retained(cell.ty, v)
                this.line("${cellRef}->w = ${elemWord(cell.elem, stored)};")
                return
            }
        }
        var varC = ""
        if (target.kind == "ident") {
            val env = this.captureEnv
            if (env != null) {
                if (env.contains(target.text)) {
                    this.unsupported(e.file, e.line, e.col, "assigning to a captured variable")
                    return
                }
            }
            varC = mangle(target.text)
        } else if (target.kind == "field" and not target.safe) {
            // A weak field's assignment moves the second count: the old
            // target loses a weak reference, the new one gains one, and
            // neither's life is changed by it.
            val ot0 = this.ety(target.kids[0])
            if (this.weakMode and ot0 != null) {
                val base = tyNonNull(ot0)
                if (base.kind == "Class") {
                    val decl = this.classDecls[base.name]
                    if (decl != null and classFieldIsWeak(decl, target.text)) {
                        unless (op == "=") {
                            this.unsupported(e.file, e.line, e.col, "compound assignment to a `weak` field")
                            return
                        }
                        val wty = this.ety(target)
                        if (wty == null) { return }
                        val t = this.weakTargetOf(wty, e.file, e.line, e.col)
                        if (t == null) { return }
                        val recv = this.expr(target.kids[0])
                        val slotAccess = "${recv}->${mangle(target.text)}"
                        val v = this.coercedTo(value, wty)
                        val held = this.temp()
                        this.line("${t}* ${held} = ${v};")
                        this.line("${t}_weak_release(${slotAccess});")
                        this.line("${slotAccess} = ${t}_weak_retain(${held});")
                        return
                    }
                }
            }
            val receiver = this.expr(target.kids[0])
            varC = "${receiver}->${mangle(target.text)}"
        } else {
            this.unsupported(e.file, e.line, e.col, "assigning to this target")
            return
        }
        val ty = this.ety(target)
        if (op == "=") {
            val v = if (ty != null) {
                this.coercedTo(value, ty)
            } else {
                this.expr(value)
            }
            if (ty != null and countedC(ty)) {
                val release = releaseFn(ty)!!
                this.line("${release}(${varC});")
                this.line("${varC} = ${retained(ty, v)};")
            } else {
                this.line("${varC} = ${v};")
            }
            return
        }
        // `a += b` is `a = a + b`, built from the same pieces.
        val synthetic = Ex("binary", e.line, e.col)
        synthetic.file = e.file
        synthetic.text = op
        synthetic.kids = [target, value]
        synthetic.ty = target.ty
        val v = this.expr(synthetic)
        if (ty != null and countedC(ty)) {
            val release = releaseFn(ty)!!
            this.line("${release}(${varC});")
            this.line("${varC} = ${retained(ty, v)};")
        } else {
            this.line("${varC} = ${v};")
        }
    }

    // ---- assembly ------------------------------------------------------

    func finish(): String {
        var out = ""
        out += "/* Generated by the Keal compiler. Do not edit. */\n"
        if (this.actorsMode) {
            // The one switch that puts actors on real threads: under it the
            // runtime's counts go atomic and its pthread machinery exists.
            out += "#define KEAL_ACTORS 1\n"
        }
        if (this.weakMode) {
            // The one switch that gives objects a weak count.
            out += "#define KEAL_WEAK 1\n"
        }
        if (this.auditMode) {
            // The one switch that makes a class count its live objects.
            out += "#define KEAL_AUDIT 1\n"
        }
        out += runtimeSource()
        out += "\n"

        var i = 0
        while (i < this.stringLiterals.size) {
            out += "static KealStr* _str${i} = NULL;  /* ${cComment(this.stringLiterals[i])} */\n"
            i += 1
        }
        out += "\nstatic void keal_init_literals(void) {\n"
        i = 0
        while (i < this.stringLiterals.size) {
            val s = this.stringLiterals[i]
            out += "    _str${i} = keal_str_static(${cString(s)}, ${byteLen(s)});\n"
            i += 1
        }
        out += "}\n\n"

        out += this.typesOut
        out += "\n"
        for (st in this.pendingStructs) {
            out += st
        }
        out += "\n"
        out += this.globalDecls
        out += "\n"
        if (this.auditMode) {
            out += "void keal_audit_pairs_program(void);\n"
        }
        out += this.decls
        out += "\n"
        out += this.helpers
        out += this.lambdaDefs
        out += this.defs
        if (this.auditMode) {
            // Written last, when every thunk and every lambda that will
            // exist does: a shape and the walk over it are registered as one
            // pair, and `main` calls this before it marks the roots.
            out += "\nvoid keal_audit_pairs_program(void) {\n"
            for (pair in this.auditPairs) {
                out += "    keal_audit_pair((void*)${pair[0]}, ${pair[1]});\n"
            }
            out += "}\n"
        }

        // `main` was emitted without the host setup, so it is wrapped, and
        // the program's own arguments start after its path.
        out = out.replace(
            "int main(void) {\n",
            "int main(int argc, char** argv) {\n    keal_argc = argc > 1 ? argc - 1 : 0;\n    keal_argv = argv + 1;\n    keal_init_literals();\n"
        )
        return out
    }
}

class SubstPair(val name: String, val ty: Ty)

// ---- driver -------------------------------------------------------------

val rawArgv = args()
// `--audit` is the build's switch, not the program's: a binary cannot grow
// counters after it is compiled. The interpreters take the same question
// from `KEAL_AUDIT` in the environment.
val argv: List<String> = []
var wantsAudit = false
for (a in rawArgv) {
    if (a == "--audit") { wantsAudit = true } else { argv.add(a) }
}
if (argv.size != 1) {
    println("usage: keal selfhost/cbackend.keal [--audit] <file.keal>")
    exit(2)
}
parseNoteMode = true
val loaded = Loader().load(argv[0])
val checker = Checker()
checker.learnPackages(loaded.paths)
checker.checkProgram(loaded.program)

if (checker.errors.size > 0) {
    val sorted = checker.errors.sortedBy({ d ->
        (d.file * 1048576 + d.line) * 1048576 + d.col
    })
    for (d in sorted) {
        var line = "error ${loaded.paths[d.file]}:${d.line}:${d.col} ${d.msg}"
        unless (d.note == "") { line += " -- ${d.note}" }
        println(line)
    }
    exit(1)
}

/// Whether any `try` appears anywhere — including inside lambdas and the
/// blocks that `if`/`when` expressions carry. Only such a program pays for
/// the unwind machinery.
func hasTryStmts(stmts: List<StmtN>): Bool {
    for (s in stmts) {
        if (hasTryStmt(s)) { return true }
    }
    return false
}

func hasTryStmt(s: StmtN): Bool {
    if (s.kind == "try") { return true }
    val init = s.init
    if (init != null and hasTryExpr(init)) { return true }
    val ex = s.ex
    if (ex != null and hasTryExpr(ex)) { return true }
    val b = s.body
    if (b != null and hasTryStmts(b.stmts)) { return true }
    for (c in s.catches) {
        if (hasTryStmts(c.handler.stmts)) { return true }
    }
    val fd = s.funDecl
    if (fd != null and hasTryStmts(fd.body.stmts)) { return true }
    val cd = s.classDecl
    if (cd != null) {
        for (m in cd.methods) {
            if (hasTryStmts(m.body.stmts)) { return true }
        }
    }
    return false
}

func hasTryExpr(e: Ex): Bool {
    for (k in e.kids) {
        if (hasTryExpr(k)) { return true }
    }
    for (a in e.args) {
        if (hasTryExpr(a.value)) { return true }
    }
    for (p in e.parts) {
        val inner = p.ex
        if (inner != null and hasTryExpr(inner)) { return true }
    }
    for (k in e.keys) {
        if (hasTryExpr(k)) { return true }
    }
    for (v in e.values) {
        if (hasTryExpr(v)) { return true }
    }
    val b = e.body
    if (b != null and hasTryStmts(b.stmts)) { return true }
    val els = e.els
    if (els != null and hasTryStmts(els.stmts)) { return true }
    val chain = e.elseif
    if (chain != null and hasTryExpr(chain)) { return true }
    val subj = e.subject
    if (subj != null and hasTryExpr(subj)) { return true }
    for (arm in e.arms) {
        if (hasTryStmts(arm.body.stmts)) { return true }
        for (v in arm.values) {
            if (hasTryExpr(v)) { return true }
        }
        val g = arm.guard
        if (g != null and hasTryExpr(g)) { return true }
    }
    return false
}

func programHasTry(program: ProgramN): Bool {
    for (item in program.items) {
        val s = item.stmt
        if (s != null and hasTryStmt(s)) { return true }
        val f = item.funDecl
        if (f != null and hasTryStmts(f.body.stmts)) { return true }
        val c = item.classDecl
        if (c != null) {
            for (m in c.methods) {
                if (hasTryStmts(m.body.stmts)) { return true }
            }
        }
    }
    return false
}

for (d in checker.warnings.sortedBy({ w ->
    (w.file * 1048576 + w.line) * 1048576 + w.col
})) {
    var wline = "warning ${loaded.paths[d.file]}:${d.line}:${d.col} ${d.msg}"
    unless (d.note == "") { wline += " -- ${d.note}" }
    println(wline)
}

/// Whether the user program touches the actor machinery — the types, the
/// system, or the capture-copying primitive `spawn` leans on. The prelude
/// alone never triggers it: unused generics are not emitted.
func actorNameHits(n: String): Bool {
    return n == "ActorSystem" or n == "ActorRef" or n == "copyClosure"
}

func actorInType(t: TypeEx): Bool {
    if (t.kind == "named") {
        if (actorNameHits(t.name)) { return true }
        for (a in t.args) {
            if (actorInType(a)) { return true }
        }
        return false
    }
    if (t.kind == "boundary" or t.kind == "nullable") {
        val inner = t.inner
        if (inner != null) { return actorInType(inner) }
        return false
    }
    if (t.kind == "func") {
        for (a in t.args) {
            if (actorInType(a)) { return true }
        }
        val r = t.ret
        if (r != null) { return actorInType(r) }
        return false
    }
    return false
}

func actorInStmts(stmts: List<StmtN>): Bool {
    for (s in stmts) {
        if (actorInStmt(s)) { return true }
    }
    return false
}

func actorInStmt(s: StmtN): Bool {
    val te = s.tyEx
    if (te != null and actorInType(te)) { return true }
    val init = s.init
    if (init != null and actorInExpr(init)) { return true }
    val ex = s.ex
    if (ex != null and actorInExpr(ex)) { return true }
    val b = s.body
    if (b != null and actorInStmts(b.stmts)) { return true }
    for (c in s.catches) {
        if (actorInStmts(c.handler.stmts)) { return true }
    }
    val fd = s.funDecl
    if (fd != null and actorInFun(fd)) { return true }
    val cd = s.classDecl
    if (cd != null and actorInClass(cd)) { return true }
    return false
}

func actorInFun(f: FunN): Bool {
    for (p in f.params) {
        val te = p.tyEx
        if (te != null and actorInType(te)) { return true }
    }
    val r = f.ret
    if (r != null and actorInType(r)) { return true }
    return actorInStmts(f.body.stmts)
}

func actorInClass(c: ClassN): Bool {
    for (p in c.ctor) {
        val te = p.tyEx
        if (te != null and actorInType(te)) { return true }
    }
    for (f in c.fields) {
        val te = f.tyEx
        if (te != null and actorInType(te)) { return true }
    }
    for (m in c.methods) {
        if (actorInFun(m)) { return true }
    }
    return false
}

func actorInExpr(e: Ex): Bool {
    if (e.kind == "ident" and actorNameHits(e.text)) { return true }
    val ite = e.tyEx
    if (ite != null and actorInType(ite)) { return true }
    for (k in e.kids) {
        if (actorInExpr(k)) { return true }
    }
    for (a in e.args) {
        if (actorInExpr(a.value)) { return true }
    }
    for (p in e.parts) {
        val inner = p.ex
        if (inner != null and actorInExpr(inner)) { return true }
    }
    for (k in e.keys) {
        if (actorInExpr(k)) { return true }
    }
    for (v in e.values) {
        if (actorInExpr(v)) { return true }
    }
    for (lp in e.params) {
        val te = lp.tyEx
        if (te != null and actorInType(te)) { return true }
    }
    val b = e.body
    if (b != null and actorInStmts(b.stmts)) { return true }
    val els = e.els
    if (els != null and actorInStmts(els.stmts)) { return true }
    val chain = e.elseif
    if (chain != null and actorInExpr(chain)) { return true }
    val subj = e.subject
    if (subj != null and actorInExpr(subj)) { return true }
    for (arm in e.arms) {
        for (v in arm.values) {
            if (actorInExpr(v)) { return true }
        }
        val g = arm.guard
        if (g != null and actorInExpr(g)) { return true }
        if (actorInStmts(arm.body.stmts)) { return true }
    }
    return false
}

func programUsesActors(program: ProgramN): Bool {
    // The prelude *declares* the actor classes, so mentioning them there is
    // not using them: the file that declares `ActorSystem` is excluded, and
    // a program that never names an actor keeps plain counts and no pthread.
    var preludeFile = -1
    for (item in program.items) {
        val c0 = item.classDecl
        if (c0 != null and c0.name == "ActorSystem" and preludeFile < 0) {
            preludeFile = c0.file
        }
    }
    for (item in program.items) {
        val s = item.stmt
        if (s != null and s.file != preludeFile and actorInStmt(s)) { return true }
        val f = item.funDecl
        if (f != null and f.file != preludeFile and actorInFun(f)) { return true }
        val c = item.classDecl
        if (c != null and c.file != preludeFile and actorInClass(c)) { return true }
    }
    return false
}

/// Whether any class in the program declares a `weak` field.
func programUsesWeak(program: ProgramN): Bool {
    for (item in program.items) {
        val c = item.classDecl
        if (item.kind == "class" and c != null) {
            for (p in c.ctor) {
                if (p.fieldKind != "" and p.weak) { return true }
            }
            for (f in c.fields) {
                if (f.weak) { return true }
            }
        }
    }
    return false
}

val backend = CBackend()
backend.catchMode = programHasTry(loaded.program)
for (item in loaded.program.items) {
    val cd = item.classDecl
    if (item.kind == "class" and cd != null) {
        for (m in cd.methods) {
            if (m.name == "deinit") { backend.dropMode = true }
        }
    }
}
// A `weak` field observes *when* its target dies, exactly as `deinit`
// does, so both put statement temps on the same short leash.
if (programUsesWeak(loaded.program)) { backend.dropMode = true }
backend.actorsMode = programUsesActors(loaded.program)
backend.weakMode = programUsesWeak(loaded.program)
backend.auditMode = wantsAudit
for (name in checker.classes.keys()) {
    val info = checker.classes[name]!!
    val fields: List<SField> = []
    for (f in info.fields) { fields.add(SField(f.name, f.ty)) }
    backend.shapes[name] = fields
    if (info.typeParams.size > 0) { backend.genericClasses.add(name) }
}
backend.emitProgram(loaded.program)
if (backend.errors.size > 0) {
    for (d in backend.errors) {
        var line = "error ${loaded.paths[d.file]}:${d.line}:${d.col} ${d.msg}"
        unless (d.note == "") { line += " -- ${d.note}" }
        println(line)
    }
    exit(1)
}
print(backend.finish())
