// The typed-tree dump driver: `keal selfhost/checker.keal file` prints what
// `keal types file` prints, byte for byte — the checked tree with every
// expression's type on it, or the diagnostics, sorted as the oracle sorts
// them. The checking itself lives in checking.keal, shared with the emitter.

import "./checking.keal"

val argv = args()
if (argv.size != 1) {
    println("usage: keal selfhost/checker.keal <file.keal>")
    exit(2)
}
parseNoteMode = true
val loaded = Loader().load(argv[0])
val checker = Checker()
checker.learnPackages(loaded.paths)
checker.checkProgram(loaded.program)

if (checker.errors.size > 0) {
    // The phases visit declarations before bodies; sort back into source
    // order. The sort is stable, keeping ties in the order found.
    val sorted = checker.errors.sortedBy({ d ->
        (d.file * 1048576 + d.line) * 1048576 + d.col
    })
    for (d in sorted) {
        var line = "error ${loaded.paths[d.file]}:${d.line}:${d.col} ${d.msg}"
        unless (d.note == "") { line += " -- ${d.note}" }
        println(line)
    }
    exit(1)
}

for (d in checker.warnings.sortedBy({ w ->
    (w.file * 1048576 + w.line) * 1048576 + w.col
})) {
    var wline = "warning ${loaded.paths[d.file]}:${d.line}:${d.col} ${d.msg}"
    unless (d.note == "") { wline += " -- ${d.note}" }
    println(wline)
}

typedDump = true
val shown = ProgramN()
for (i in loaded.program.items) {
    unless (i.file == 0) { shown.items.add(i) }
}
println(printProgram(shown))
