// The Keal parser, in Keal — the second piece of the self-hosted compiler.
//
// It mirrors src/parser.rs decision for decision and prints the tree as it
// parses, in the format `keal ast` prints; the suite holds the two to
// byte-for-byte agreement, error messages and exit codes included. There is
// no AST datatype yet — the dump is the deliverable, and the datatype comes
// with the checker.
//
// Failure is loud by default: print the error the oracle prints, and stop.
// The two places the grammar backtracks — is `{` a lambda or a map, is this
// a lambda parameter list — run with `quiet` raised, where a failure only
// sets a flag for the caller to roll back on.
//
//     keal selfhost/parser.keal path/to/file.keal

import "./lexing.keal"

fun indentBlock(s: String): String {
    val lines = s.split("\n")
    var out = ""
    var first = true
    for (l in lines) {
        unless (first) { out += "\n" }
        out += "  " + l
        first = false
    }
    // The oracle's indent() ends in trim_end(), so no node's last line keeps
    // trailing whitespace — visible when an interpolation part ends in a space.
    while (out.endsWith(" ") or out.endsWith("\t")) {
        out = out.substring(0, out.length - 1)
    }
    return out
}

/// `tag` with `child` indented under it.
fun wrap(tag: String, child: String): String { tag + "\n" + indentBlock(child) }

/// How an expected token reads in an error message.
fun describeKind(kind: String): String {
    return when (kind) {
        "eof" -> "end of file"
        ";" -> "end of statement"
        else -> "`${kind}`"
    }
}

/// The word an operator token contributes to a `binary` node.
fun binaryOpOf(kind: String): String {
    return when (kind) {
        "==", "!=", "<", "<=", ">", ">=", "+", "-", "*", "/", "%" -> kind
        else -> ""
    }
}

fun binaryPowerOf(kind: String): Int {
    return when (kind) {
        "==", "!=" -> 2
        "<", "<=", ">", ">=" -> 3
        "+", "-" -> 6
        "*", "/", "%" -> 7
        else -> 0
    }
}

/// The connective a token spells, with `&&`, `||` and `^` as aliases.
fun logicalOpOf(kind: String): String {
    return when (kind) {
        "and", "&&" -> "and"
        "or", "||" -> "or"
        "xor", "^" -> "xor"
        "xnor" -> "xnor"
        "nand" -> "nand"
        "nor" -> "nor"
        "implies" -> "implies"
        else -> ""
    }
}

fun isAssignOp(kind: String): Bool {
    return when (kind) {
        "=", "+=", "-=", "*=", "/=", "%=" -> true
        else -> false
    }
}

/// What a compound assignment contributes to the dump: `+=` reads as `+`,
/// and plain `=` as itself.
fun assignOpName(kind: String): String {
    return when (kind) {
        "+=" -> "+"
        "-=" -> "-"
        "*=" -> "*"
        "/=" -> "/"
        "%=" -> "%"
        else -> "="
    }
}

class Parser(val toks: List<Token>) {
    var pos: Int = 0
    var quiet: Int = 0
    var failed: Bool = false

    fun peek(): Token {
        val i = this.pos.min(this.toks.size - 1)
        return this.toks[i]
    }

    fun peekAt(k: Int): Token {
        val i = (this.pos + k).min(this.toks.size - 1)
        return this.toks[i]
    }

    fun advance(): Token {
        val t = this.peek()
        if (this.pos < this.toks.size - 1) { this.pos += 1 }
        return t
    }

    fun at(kind: String): Bool { this.peek().kind == kind }

    fun eat(kind: String): Bool {
        if (this.at(kind)) {
            this.advance()
            return true
        }
        return false
    }

    proc fail(atLine: Int, atCol: Int, msg: String) {
        if (this.quiet > 0) {
            this.failed = true
            return
        }
        println("error ${atLine}:${atCol} ${msg}")
        exit(1)
    }

    proc failHere(msg: String) {
        val t = this.peek()
        this.fail(t.line, t.col, msg)
    }

    proc expect(kind: String, ctx: String) {
        if (this.at(kind)) {
            this.advance()
            return
        }
        this.failHere(
            "expected ${describeKind(kind)} ${ctx}, found ${describeToken(this.peek())}"
        )
    }

    /// The name, or "" after a quiet failure.
    fun expectIdent(ctx: String): String {
        if (this.at("ident")) {
            return this.advance().text
        }
        this.failHere("expected ${ctx}, found ${describeToken(this.peek())}")
        return ""
    }

    proc skipSemis() {
        while (this.at(";")) { this.advance() }
    }

    fun sp(): String { "${this.peek().line}:${this.peek().col}" }

    /// True when the token after this one could name a declaration.
    fun namesDeclaration(): Bool { this.peekAt(1).kind == "ident" }

    // ---- program --------------------------------------------------------

    fun program(): String {
        var out = "program"
        while (true) {
            this.skipSemis()
            if (this.at("eof")) { return out }
            out += "\n" + indentBlock(this.item())
        }
        return out
    }

    fun item(): String {
        val t = this.peek()
        if (t.kind == "fun" or t.kind == "proc") { return this.funDecl("fun") }
        if (t.kind == "class") { return this.classDecl(false) }
        if (t.kind == "ident" and t.text == "record" and this.namesDeclaration()) {
            this.advance()
            return this.classDecl(true)
        }
        if (t.kind == "ident" and t.text == "trait" and this.namesDeclaration()) {
            return this.traitDecl()
        }
        if (t.kind == "ident" and t.text == "native" and this.peekAt(1).kind == "str") {
            val spn = this.sp()
            this.advance()
            val strTok = this.advance()
            if (strTok.parts.size == 1 and strTok.parts[0].isLit) {
                return "native ${esc(strTok.parts[0].text)} ${spn}"
            }
            this.fail(t.line, t.col, "a `native` block cannot interpolate")
            return ""
        }
        if (t.kind == "ident" and t.text == "extern" and this.peekAt(1).kind == "fun") {
            return this.externDecl()
        }
        if (t.kind == "import") {
            val spn = this.sp()
            this.advance()
            val next = this.peek()
            if (next.kind == "str") {
                this.advance()
                if (next.parts.size == 1 and next.parts[0].isLit) {
                    return "import ${esc(next.parts[0].text)} ${spn}"
                }
                this.fail(t.line, t.col, "import path must be a plain string literal")
                return ""
            }
            this.failHere(
                "expected an import path string, found ${describeToken(next)}"
            )
            return ""
        }
        return this.stmt()
    }

    // ---- declarations ---------------------------------------------------

    fun funDecl(tag: String): String {
        val spn = this.sp()
        val isFun = this.at("fun")
        this.advance() // fun or proc
        val name = this.expectIdent(if (isFun) { "a function name" } else { "a name" })
        var out = "${tag} ${name} ${spn}"
        for (tp in this.typeParamList()) {
            out += "\n" + indentBlock(tp)
        }
        for (p in this.paramList()) {
            out += "\n" + indentBlock(p)
        }
        val ret = this.returnType(isFun, name)
        unless (ret == "") { out += "\n" + indentBlock("ret " + ret) }
        out += "\n" + indentBlock(this.block("body"))
        return out
    }

    /// The `: T` after a parameter list — required on `fun`, rejected on
    /// `proc`, which is the point of the split.
    fun returnType(isFun: Bool, name: String): String {
        unless (isFun) {
            if (this.at(":")) {
                this.failHere("`proc ${name}` cannot declare a return type")
            }
            return ""
        }
        unless (this.at(":")) {
            this.failHere("`fun ${name}` must declare what it returns")
            return ""
        }
        this.advance()
        val (line, _, _) = this.typeExpr()
        return line
    }

    fun typeParamList(): List<String> {
        val out: List<String> = []
        unless (this.at("<")) { return out }
        this.advance()
        while (not this.at(">")) {
            val name = this.expectIdent("a type parameter name")
            var bounds = ""
            if (this.eat(":")) {
                var going = true
                while (going) {
                    val (line, _, _) = this.typeExpr()
                    if (bounds == "") { bounds = line } else { bounds += " + " + line }
                    going = this.eat("+")
                }
            }
            if (bounds == "") {
                out.add("tparam ${name}")
            } else {
                out.add("tparam ${name}: ${bounds}")
            }
            unless (this.eat(",")) { break }
        }
        this.expect(">", "to close the type parameter list")
        if (out.size == 0) {
            this.failHere("a type parameter list cannot be empty")
        }
        return out
    }

    fun paramList(): List<String> {
        this.expect("(", "to start a parameter list")
        val out: List<String> = []
        while (not this.at(")")) {
            val pspn = this.sp()
            val name = this.expectIdent("a parameter name")
            this.expect(":", "after a parameter name")
            val (line, _, _) = this.typeExpr()
            var node = "param ${name}: ${line} ${pspn}"
            if (this.eat("=")) {
                node += "\n" + indentBlock(this.expr())
            }
            out.add(node)
            unless (this.eat(",")) { break }
        }
        this.expect(")", "to close the parameter list")
        return out
    }

    fun classDecl(isRecord: Bool): String {
        val spn = this.sp()
        unless (isRecord) { this.expect("class", "to start a class declaration") }
        val name = this.expectIdent(
            if (isRecord) { "a record name" } else { "a class name" }
        )
        var out = "${if (isRecord) { "record" } else { "class" }} ${name} ${spn}"
        for (tp in this.typeParamList()) {
            out += "\n" + indentBlock(tp)
        }

        val ctors: List<String> = []
        if (this.at("(")) {
            this.advance()
            while (not this.at(")")) {
                val pspn = this.sp()
                var kw = ""
                if (this.eat("val")) {
                    kw = "val "
                } else if (this.at("var")) {
                    if (isRecord) {
                        this.failHere("a record's fields cannot be `var`")
                    }
                    this.advance()
                    kw = "var "
                } else if (isRecord) {
                    // In a record every parameter is a field; `val` is implied.
                    kw = "val "
                }
                val pname = this.expectIdent("a constructor parameter name")
                this.expect(":", "after a constructor parameter name")
                val (line, _, _) = this.typeExpr()
                var node = "ctor ${kw}${pname}: ${line} ${pspn}"
                if (this.eat("=")) {
                    node += "\n" + indentBlock(this.expr())
                }
                ctors.add(node)
                unless (this.eat(",")) { break }
            }
            this.expect(")", "to close the constructor parameter list")
        }

        val impls: List<String> = []
        if (this.eat(":")) {
            var going = true
            while (going) {
                val (line, _, _) = this.typeExpr()
                impls.add("impl " + line)
                going = this.eat(",")
            }
        }
        for (i in impls) { out += "\n" + indentBlock(i) }
        for (c in ctors) { out += "\n" + indentBlock(c) }

        // A class whose state is entirely in its constructor needs no body.
        unless (this.at("{")) { return out }
        this.advance()
        val fields: List<String> = []
        val methods: List<String> = []
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            val m = this.peek()
            if (m.kind == "fun" or m.kind == "proc") {
                methods.add(this.funDecl("method"))
            } else if (m.kind == "val" or m.kind == "var") {
                val fspn = this.sp()
                val mutable = this.advance().kind == "var"
                if (mutable and isRecord) {
                    this.fail(m.line, m.col, "a record's fields cannot be `var`")
                }
                val fname = this.expectIdent("a field name")
                var node = "field ${if (mutable) { "var" } else { "val" }} ${fname}"
                var hasTy = false
                if (this.eat(":")) {
                    val (line, _, _) = this.typeExpr()
                    node += ": " + line
                    hasTy = true
                }
                node += " " + fspn
                var hasInit = false
                if (this.eat("=")) {
                    node += "\n" + indentBlock(this.expr())
                    hasInit = true
                }
                unless (hasTy or hasInit) {
                    this.fail(
                        m.line,
                        m.col,
                        "field `${fname}` needs either a type or an initializer"
                    )
                }
                fields.add(node)
            } else {
                this.failHere(
                    "expected `fun`, `proc`, `val` or `var` in a class body, found ${describeToken(m)}"
                )
            }
        }
        this.expect("}", "to close the class body")
        for (f in fields) { out += "\n" + indentBlock(f) }
        for (m2 in methods) { out += "\n" + indentBlock(m2) }
        return out
    }

    fun traitDecl(): String {
        val spn = this.sp()
        this.advance() // trait
        val name = this.expectIdent("a trait name")
        var out = "trait ${name} ${spn}"
        this.expect("{", "to open the trait body")
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            val mspn = this.sp()
            val isFun = this.at("fun")
            if (isFun) {
                this.advance()
            } else {
                this.expect("proc", "to start a trait member")
            }
            val mname = this.expectIdent("a method name")
            var node = ""
            val tps = this.typeParamList()
            val ps = this.paramList()
            val ret = this.returnType(isFun, mname)
            val hasDefault = this.at("{")
            node = "${if (hasDefault) { "default" } else { "required" }} ${mname} ${mspn}"
            for (tp in tps) { node += "\n" + indentBlock(tp) }
            for (p in ps) { node += "\n" + indentBlock(p) }
            unless (ret == "") { node += "\n" + indentBlock("ret " + ret) }
            if (hasDefault) {
                node += "\n" + indentBlock(this.block("body"))
            } else {
                node += "\n" + indentBlock("body")
            }
            out += "\n" + indentBlock(node)
        }
        this.expect("}", "to close the trait body")
        return out
    }

    fun externDecl(): String {
        val startTok = this.peek()
        val spn = this.sp()
        this.advance() // extern
        this.expect("fun", "after `extern`")
        val name = this.expectIdent("a function name")
        val ps = this.paramList()
        val ret = this.returnType(true, name)
        var symbol = name
        if (this.eat("=")) {
            // The token is consumed before it is judged, so a bad one is
            // reported at whatever follows it — as the oracle does.
            val t = this.advance()
            if (t.kind == "str") {
                if (t.parts.size == 1 and t.parts[0].isLit) {
                    symbol = t.parts[0].text
                } else {
                    this.fail(
                        startTok.line,
                        startTok.col,
                        "a symbol name cannot interpolate"
                    )
                }
            } else {
                this.failHere(
                    "expected a C symbol string, found ${describeToken(t)}"
                )
            }
        }
        var out = "extern ${name} = ${esc(symbol)} ${spn}"
        for (p in ps) { out += "\n" + indentBlock(p) }
        unless (ret == "") { out += "\n" + indentBlock("ret " + ret) }
        return out
    }

    // ---- statements -----------------------------------------------------

    fun block(tag: String): String {
        this.expect("{", "to open a block")
        var out = tag
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            out += "\n" + indentBlock(this.stmt())
        }
        this.expect("}", "to close the block")
        return out
    }

    fun stmt(): String {
        val spn = this.sp()
        val t = this.peek()
        if (t.kind == "val" or t.kind == "var") {
            val kw = this.advance().kind
            // `val (a, b) = t` names a tuple's elements.
            if (this.at("(")) {
                val pspn = this.peek()
                val binds = this.bindList(pspn.line, pspn.col)
                if (binds.size < 2 or binds.size > 5) {
                    this.fail(
                        pspn.line,
                        pspn.col,
                        "a tuple pattern names between 2 and 5 values"
                    )
                }
                this.expect("=", "in a destructuring declaration")
                val init = this.expr()
                return "destructure ${kw} Tuple${binds.size}(${binds.join(", ")}) ${spn}\n" + indentBlock(init)
            }
            // `val Point(x, y) = p` destructures; `val p = ...` binds.
            if (this.at("ident") and this.peekAt(1).kind == "(") {
                val nameTok = this.advance()
                val typeName = nameTok.text
                val binds = this.bindList(nameTok.line, nameTok.col)
                this.expect("=", "in a destructuring declaration")
                val init = this.expr()
                return "destructure ${kw} ${typeName}(${binds.join(", ")}) ${spn}\n" + indentBlock(init)
            }
            val name = this.expectIdent("a variable name")
            var head = "let ${kw} ${name}"
            if (this.eat(":")) {
                val (line, _, _) = this.typeExpr()
                head += ": " + line
            }
            this.expect("=", "in a variable declaration")
            return head + " " + spn + "\n" + indentBlock(this.expr())
        }
        if (t.kind == "return") {
            this.advance()
            if (this.at(";") or this.at("}") or this.at("eof")) {
                return "return " + spn
            }
            var value = this.expr()
            // `return a, b` returns both, as a tuple.
            if (this.at(",")) {
                val items: List<String> = [value]
                while (this.eat(",")) {
                    items.add(this.expr())
                }
                value = this.tuple(items, spn, t.line, t.col)
            }
            return "return " + spn + "\n" + indentBlock(value)
        }
        if (t.kind == "break") {
            this.advance()
            return "break " + spn
        }
        if (t.kind == "continue") {
            this.advance()
            return "continue " + spn
        }
        if (t.kind == "while") {
            this.advance()
            this.expect("(", "after `while`")
            val cond = this.expr()
            this.expect(")", "after the `while` condition")
            val body = this.block("body")
            return "while ${spn}\n" + indentBlock(wrap("cond", cond)) + "\n" + indentBlock(body)
        }
        if (t.kind == "for") {
            this.advance()
            this.expect("(", "after `for`")
            val v = this.expectIdent("a loop variable name")
            var head = "for ${v}"
            if (this.eat(":")) {
                val (line, _, _) = this.typeExpr()
                head += ": " + line
            }
            this.expect("in", "after the loop variable")
            val iter = this.expr()
            this.expect(")", "after the `for` iterable")
            val body = this.block("body")
            return head + " " + spn + "\n" + indentBlock(wrap("iter", iter)) + "\n" + indentBlock(body)
        }
        if (t.kind == "fun" or t.kind == "proc") { return this.funDecl("fun") }
        if (t.kind == "class") { return this.classDecl(false) }

        val target = this.expr()
        val opTok = this.peek()
        unless (isAssignOp(opTok.kind)) {
            return "expr " + spn + "\n" + indentBlock(target)
        }
        this.advance()
        val head = firstWord(target)
        unless (head == "ident" or head == "field" or head == "safefield" or head == "index") {
            this.fail(
                opTok.line,
                opTok.col,
                "left side of an assignment is not assignable"
            )
        }
        val value = this.expr()
        val assign = "assign ${assignOpName(opTok.kind)} ${spn}\n" + indentBlock(target) + "\n" + indentBlock(value)
        return "expr " + spn + "\n" + indentBlock(assign)
    }

    /// `(a, _, c)` — the shared half of every destructuring form. An empty
    /// list is reported at the pattern's head — the type name, or the `(`
    /// of a tuple pattern — which is why the position comes from the caller.
    fun bindList(atLine: Int, atCol: Int): List<String> {
        this.expect("(", "to start a destructuring pattern")
        val out: List<String> = []
        while (not this.at(")")) {
            if (this.at("(")) {
                this.failHere("a pattern cannot nest inside another")
            }
            val name = this.expectIdent("a field name, or `_` to skip one")
            out.add(name)
            unless (this.eat(",")) { break }
        }
        this.expect(")", "to close the destructuring pattern")
        if (out.size == 0) {
            this.fail(atLine, atCol, "a destructuring pattern needs at least one name")
        }
        return out
    }

    // ---- expressions ----------------------------------------------------

    fun expr(): String { this.binary(0) }

    fun binary(minBp: Int): String {
        var lhs = this.unary()
        while (true) {
            val t = this.peek()
            val spn = "${t.line}:${t.col}"

            val logical = logicalOpOf(t.kind)
            unless (logical == "") {
                if (1 < minBp) { return lhs }
                this.advance()
                val rhs = this.binary(2)
                lhs = "logical ${logical} ${spn}\n" + indentBlock(lhs) + "\n" + indentBlock(rhs)
                // No connective outranks another; only an associative repeat
                // may chain.
                val next = logicalOpOf(this.peek().kind)
                unless (next == "") {
                    val repeats = next == logical and (logical == "and" or logical == "or" or logical == "xor" or logical == "xnor")
                    unless (repeats) {
                        if (next == logical) {
                            this.failHere("`${logical}` does not chain")
                        } else {
                            this.failHere(
                                "`${logical}` and `${next}` need parentheses to say which applies first"
                            )
                        }
                    }
                }
                continue
            }

            if (t.kind == "?:" and 4 >= minBp) {
                this.advance()
                val rhs = this.binary(4)
                lhs = "elvis ${spn}\n" + indentBlock(lhs) + "\n" + indentBlock(rhs)
                continue
            }
            if (t.kind == ".." and 5 >= minBp) {
                this.advance()
                val rhs = this.binary(6)
                lhs = "range ${spn}\n" + indentBlock(lhs) + "\n" + indentBlock(rhs)
                continue
            }
            if (t.kind == "is" and 3 >= minBp) {
                this.advance()
                val (line, _, _) = this.typeExpr()
                lhs = "is ${line} ${spn}\n" + indentBlock(lhs)
                continue
            }
            if (t.kind == "!" and 3 >= minBp and (this.peekAt(1).kind == "is" or this.peekAt(1).kind == "in")) {
                this.advance()
                if (this.eat("is")) {
                    val (line, _, _) = this.typeExpr()
                    lhs = "isnot ${line} ${spn}\n" + indentBlock(lhs)
                } else {
                    this.advance() // in
                    val rhs = this.binary(4)
                    val call = "method contains ${spn}\n" + indentBlock(rhs) + "\n" + indentBlock(wrap("arg", lhs))
                    lhs = "unary not ${spn}\n" + indentBlock(call)
                }
                continue
            }
            if (t.kind == "in" and 3 >= minBp) {
                this.advance()
                val rhs = this.binary(4)
                // `x in xs` is `xs.contains(x)`.
                lhs = "method contains ${spn}\n" + indentBlock(rhs) + "\n" + indentBlock(wrap("arg", lhs))
                continue
            }

            val op = binaryOpOf(t.kind)
            if (op == "") { return lhs }
            val bp = binaryPowerOf(t.kind)
            if (bp < minBp) { return lhs }
            this.advance()
            val rhs = this.binary(bp + 1)
            lhs = "binary ${op} ${spn}\n" + indentBlock(lhs) + "\n" + indentBlock(rhs)
        }
        return lhs
    }

    fun unary(): String {
        val t = this.peek()
        val spn = this.sp()
        val op = when (t.kind) {
            "-" -> "neg"
            "!", "not" -> "not"
            else -> ""
        }
        if (op == "") { return this.postfix() }
        this.advance()
        val rhs = this.binary(8)
        return "unary ${op} ${spn}\n" + indentBlock(rhs)
    }

    fun postfix(): String {
        // Errors about a call or an index point at the whole expression.
        val startSpn = this.sp()
        var e = this.primary()
        while (true) {
            val t = this.peek()
            if (t.kind == "." or t.kind == "?.") {
                val safe = this.advance().kind == "?."
                val nameTok = this.peek()
                val name = this.expectIdent("a field or method name")
                val nspn = "${nameTok.line}:${nameTok.col}"
                if (this.at("(")) {
                    val argsDump = this.argList()
                    val tag = if (safe) { "safemethod" } else { "method" }
                    e = "${tag} ${name} ${nspn}\n" + indentBlock(e) + argsDump
                } else {
                    val tag = if (safe) { "safefield" } else { "field" }
                    e = "${tag} ${name} ${nspn}\n" + indentBlock(e)
                }
            } else if (t.kind == "!!") {
                this.advance()
                e = "notnull ${startSpn}\n" + indentBlock(e)
            } else if (t.kind == "(") {
                val argsDump = this.argList()
                e = "call ${startSpn}\n" + indentBlock(e) + argsDump
            } else if (t.kind == "[") {
                this.advance()
                val index = this.expr()
                this.expect("]", "to close an index expression")
                e = "index ${startSpn}\n" + indentBlock(e) + "\n" + indentBlock(index)
            } else {
                return e
            }
        }
        return e
    }

    /// The rendered `arg` children, each on its own indented lines, with a
    /// leading newline — ready to append to a call head.
    fun argList(): String {
        this.expect("(", "to start an argument list")
        var out = ""
        while (not this.at(")")) {
            // `name = value` is a named argument; `name == value` is not.
            var name = ""
            if (this.at("ident") and this.peekAt(1).kind == "=") {
                name = this.advance().text
                this.advance()
            }
            val value = this.expr()
            if (name == "") {
                out += "\n" + indentBlock(wrap("arg", value))
            } else {
                out += "\n" + indentBlock("arg ${name}\n" + indentBlock(value))
            }
            unless (this.eat(",")) { break }
        }
        this.expect(")", "to close the argument list")
        return out
    }

    fun tuple(items: List<String>, spn: String, atLine: Int, atCol: Int): String {
        if (items.size < 2 or items.size > 5) {
            this.fail(
                atLine,
                atCol,
                "a tuple holds between 2 and 5 values, not ${items.size}"
            )
        }
        var out = "call ${spn}\n" + indentBlock("ident Tuple${items.size} ${spn}")
        for (i in items) {
            out += "\n" + indentBlock(wrap("arg", i))
        }
        return out
    }

    fun primary(): String {
        val t = this.peek()
        val spn = this.sp()
        if (t.kind == "int") {
            this.advance()
            return "int ${t.text} ${spn}"
        }
        if (t.kind == "float") {
            this.advance()
            return "float ${t.text} ${spn}"
        }
        if (t.kind == "true" or t.kind == "false") {
            this.advance()
            return "bool ${t.kind} ${spn}"
        }
        if (t.kind == "null") {
            this.advance()
            return "null " + spn
        }
        if (t.kind == "this") {
            this.advance()
            return "this " + spn
        }
        if (t.kind == "ident") {
            this.advance()
            return "ident ${t.text} ${spn}"
        }
        if (t.kind == "str") {
            this.advance()
            return this.stringExpr(t, spn)
        }
        if (t.kind == "(") {
            this.advance()
            val first = this.expr()
            unless (this.at(",")) {
                this.expect(")", "to close a parenthesised expression")
                return first
            }
            val items: List<String> = [first]
            while (this.eat(",")) {
                this.skipSemis()
                if (this.at(")")) { break }
                items.add(this.expr())
            }
            this.expect(")", "to close a tuple")
            return this.tuple(items, spn, t.line, t.col)
        }
        if (t.kind == "[") {
            this.advance()
            var out = "list " + spn
            while (not this.at("]")) {
                this.skipSemis()
                if (this.at("]")) { break }
                out += "\n" + indentBlock(this.expr())
                this.skipSemis()
                unless (this.eat(",")) { break }
            }
            this.skipSemis()
            this.expect("]", "to close a list literal")
            return out
        }
        if (t.kind == "if" or t.kind == "unless") { return this.ifExpr() }
        if (t.kind == "when") { return this.whenExpr() }
        if (t.kind == "{") { return this.braceExpr() }
        this.failHere("expected an expression, found ${describeToken(t)}")
        return ""
    }

    fun stringExpr(t: Token, spn: String): String {
        if (t.parts.size == 1 and t.parts[0].isLit) {
            return "str ${esc(t.parts[0].text)} ${spn}"
        }
        var out = "interp " + spn
        for (p in t.parts) {
            if (p.isLit) {
                out += "\n" + indentBlock("lit " + esc(p.text))
            } else {
                val sub = Parser(lexFragment(p.text, p.line, p.col))
                out += "\n" + indentBlock(sub.exprOnly())
            }
        }
        return out
    }

    /// A whole fragment as one expression — `${...}` holes and nothing else.
    fun exprOnly(): String {
        val e = this.expr()
        this.skipSemis()
        unless (this.at("eof")) {
            this.failHere("unexpected trailing input in expression")
        }
        return e
    }

    fun ifExpr(): String {
        val spn = this.sp()
        val negated = this.at("unless")
        val word = if (negated) { "unless" } else { "if" }
        if (negated) {
            this.advance()
        } else {
            this.expect("if", "to start an `if`")
        }
        this.expect("(", "after `${word}`")
        var cond = this.expr()
        this.expect(")", "after the `${word}` condition")
        if (negated) {
            // `unless (c)` is `if (not c)`, at the condition node's own span.
            cond = "unary not ${headSpan(cond)}\n" + indentBlock(cond)
        }
        val then = this.block("then")

        var out = "if ${spn}\n" + indentBlock(wrap("cond", cond)) + "\n" + indentBlock(then)
        // A newline before `else` inserted a `;`; skip it only if `else`
        // really follows.
        val save = this.pos
        this.skipSemis()
        if (this.eat("else")) {
            if (this.at("if") or this.at("unless")) {
                out += "\n" + indentBlock(wrap("elseif", this.ifExpr()))
            } else {
                out += "\n" + indentBlock(this.block("else"))
            }
        } else {
            this.pos = save
        }
        return out
    }

    fun whenExpr(): String {
        val spn = this.sp()
        this.expect("when", "to start a `when`")
        var out = "when " + spn
        if (this.eat("(")) {
            val subject = this.expr()
            this.expect(")", "after the `when` subject")
            out += "\n" + indentBlock(wrap("subject", subject))
        }
        this.expect("{", "to open a `when` body")
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            out += "\n" + indentBlock(this.whenArm())
        }
        this.expect("}", "to close the `when` body")
        return out
    }

    fun whenArm(): String {
        val spn = this.sp()
        var isElse = false
        var pattern = ""
        if (this.eat("else")) {
            isElse = true
            pattern = "pattern else"
        } else if (this.eat("is")) {
            val tyTok = this.peek()
            val (line, isNamed, name) = this.typeExpr()
            if (this.at("(")) {
                unless (isNamed) {
                    this.fail(
                        tyTok.line,
                        tyTok.col,
                        "only a class or record can be destructured"
                    )
                }
                val binds = this.bindList(tyTok.line, tyTok.col)
                val _ = name
                pattern = "pattern is ${line}(${binds.join(", ")})"
            } else {
                pattern = "pattern is " + line
            }
        } else if (this.at("!") and (this.peekAt(1).kind == "is" or this.peekAt(1).kind == "in")) {
            this.advance()
            if (this.eat("is")) {
                val (line, _, _) = this.typeExpr()
                pattern = "pattern isnot " + line
            } else {
                this.advance()
                pattern = "pattern notin\n" + indentBlock(this.expr())
            }
        } else if (this.eat("in")) {
            pattern = "pattern in\n" + indentBlock(this.expr())
        } else {
            pattern = "pattern values"
            var going = true
            while (going) {
                pattern += "\n" + indentBlock(this.expr())
                going = this.eat(",")
            }
        }

        var guard = ""
        if (this.at("if")) {
            if (isElse) {
                this.failHere("`else` cannot have a guard")
            }
            this.advance()
            this.expect("(", "after `if` in a guard")
            guard = this.expr()
            this.expect(")", "after a guard condition")
        }
        this.expect("->", "after a `when` pattern")

        // Inside a `when` arm, `{` means a block, not a lambda.
        var body = ""
        if (this.at("{")) {
            body = this.block("body")
        } else {
            val e = this.expr()
            body = "body\n" + indentBlock("expr ${headSpan(e)}\n" + indentBlock(e))
        }
        var out = "arm ${spn}\n" + indentBlock(pattern)
        unless (guard == "") { out += "\n" + indentBlock(wrap("guard", guard)) }
        out += "\n" + indentBlock(body)
        return out
    }

    /// `{` opens a lambda with parameters, a map literal, or a lambda whose
    /// one parameter is the implicit `it` — tried in that order.
    fun braceExpr(): String {
        val spn = this.sp()
        this.expect("{", "to open a lambda or map literal")
        val save = this.pos

        this.quiet += 1
        val (matched, params) = this.lambdaParams(spn)
        this.quiet -= 1
        if (matched and not this.failed) {
            return this.lambdaBody(spn, params)
        }
        this.failed = false
        this.pos = save

        val (isMap, mapDump) = this.tryMapLiteral(spn)
        if (isMap) {
            return mapDump
        }
        this.failed = false
        this.pos = save

        val implicit: List<String> = ["param it ${spn}"]
        return this.lambdaBody(spn, implicit)
    }

    /// Tries to read `x: T, y ->`. On anything else the caller rolls back.
    fun lambdaParams(spn: String): (Bool, List<String>) {
        val out: List<String> = []
        if (this.at("->")) {
            this.advance()
            return true, out
        }
        while (true) {
            val pspn = this.sp()
            unless (this.at("ident")) { return false, out }
            val name = this.advance().text
            var node = "param ${name}"
            if (this.eat(":")) {
                val (line, _, _) = this.typeExpr()
                if (this.failed) { return false, out }
                node += ": " + line
            }
            out.add(node + " " + pspn)
            if (this.eat(",")) { continue }
            if (this.eat("->")) { return true, out }
            return false, out
        }
        return false, out
    }

    fun lambdaBody(spn: String, params: List<String>): String {
        var out = "lambda " + spn
        for (p in params) { out += "\n" + indentBlock(p) }
        var body = "body"
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            body += "\n" + indentBlock(this.stmt())
        }
        this.expect("}", "to close the lambda")
        return out + "\n" + indentBlock(body)
    }

    /// `{}` and `{ k: v, ... }`; rolled back by the caller when the braces
    /// hold something else. Only the first key is tentative: once its `:` is
    /// seen this is a map, and later errors are real errors.
    fun tryMapLiteral(spn: String): (Bool, String) {
        this.skipSemis()
        if (this.eat("}")) {
            return true, "map " + spn
        }
        this.quiet += 1
        val firstKey = this.expr()
        this.quiet -= 1
        if (this.failed) { return false, "" }
        unless (this.at(":")) { return false, "" }
        this.advance()
        var out = "map " + spn
        out += "\n" + indentBlock(wrap("key", firstKey))
        out += "\n" + indentBlock(wrap("value", this.expr()))
        while (this.eat(",")) {
            this.skipSemis()
            if (this.at("}")) { break }
            val key = this.expr()
            this.expect(":", "between a map key and its value")
            out += "\n" + indentBlock(wrap("key", key))
            out += "\n" + indentBlock(wrap("value", this.expr()))
        }
        this.skipSemis()
        this.expect("}", "to close a map literal")
        return true, out
    }

    // ---- types ----------------------------------------------------------

    /// A type, rendered on one line, plus whether it is a bare named type
    /// and what that name is — the `is` pattern needs both.
    fun typeExpr(): (String, Bool, String) {
        val t = this.peek()
        var line = ""
        var isNamed = false
        var name = ""
        if (t.kind == "ident") {
            this.advance()
            isNamed = true
            name = t.text
            line = t.text
            if (this.at("<")) {
                this.advance()
                var argsLine = ""
                var going = true
                while (going) {
                    val (a, _, _) = this.typeExpr()
                    if (argsLine == "") { argsLine = a } else { argsLine += ", " + a }
                    going = this.eat(",")
                }
                this.expect(">", "to close type arguments")
                line += "<" + argsLine + ">"
            }
        } else if (t.kind == "(") {
            this.advance()
            val params: List<String> = []
            while (not this.at(")")) {
                val (p, _, _) = this.typeExpr()
                params.add(p)
                unless (this.eat(",")) { break }
            }
            this.expect(")", "to close a function type's parameters")
            // `(A, B) -> C` is a function; `(A, B)` alone is a tuple.
            unless (this.at("->")) {
                if (params.size < 2 or params.size > 5) {
                    this.fail(
                        t.line,
                        t.col,
                        "a tuple type holds between 2 and 5 types, not ${params.size}"
                    )
                }
                isNamed = true
                name = "Tuple${params.size}"
                line = "Tuple${params.size}<" + params.join(", ") + ">"
            } else {
                this.advance()
                val (r, _, _) = this.typeExpr()
                line = "(" + params.join(", ") + ") -> " + r
            }
        } else {
            this.failHere("expected a type, found ${describeToken(t)}")
            return "", false, ""
        }
        while (this.eat("?")) {
            line += "?"
            isNamed = false
        }
        return line, isNamed, name
    }
}

/// A dump node's own span — the last field of its first line.
fun headSpan(s: String): String {
    var line = s
    val nl = s.indexOf("\n")
    if (nl >= 0) { line = s.substring(0, nl) }
    var sp = line.length - 1
    while (sp >= 0 and line.substring(sp, sp + 1) != " ") { sp -= 1 }
    return line.substring(sp + 1, line.length)
}

fun firstWord(s: String): String {
    val sp = s.indexOf(" ")
    val nl = s.indexOf("\n")
    var cut = s.length
    if (sp >= 0 and sp < cut) { cut = sp }
    if (nl >= 0 and nl < cut) { cut = nl }
    return s.substring(0, cut)
}

// ---- driver ------------------------------------------------------------

val argv = args()
if (argv.size != 1) {
    println("usage: keal selfhost/parser.keal <file.keal>")
    exit(2)
}
val source = readFile(argv[0])
if (source == null) {
    println("error: cannot read `${argv[0]}`")
    exit(1)
}
val parser = Parser(lexFile(source))
println(parser.program())
