// The parse-tree dump driver: `keal selfhost/parser.keal file` prints what
// `keal ast file` prints, byte for byte. The parser itself lives in
// parsing.keal and builds a real tree; astprint.keal renders it. Both are
// shared with the checker.

import "./parsing.keal"
import "./astprint.keal"

val argv = args()
if (argv.size != 1) {
    println("usage: keal selfhost/parser.keal <file.keal>")
    exit(2)
}
val source = readFile(argv[0])
if (source == null) {
    println("error: cannot read `${argv[0]}`")
    exit(1)
}
val parser = Parser(lexFile(source))
println(printProgram(parser.program()))
