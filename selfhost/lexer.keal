// The token-dump driver: `keal selfhost/lexer.keal file` prints what
// `keal tokens file` prints, byte for byte. The lexing itself lives in
// lexing.keal, shared with the parser.

import "./lexing.keal"

val argv = args()
if (argv.size != 1) {
    println("usage: keal selfhost/lexer.keal <file.keal>")
    exit(2)
}
val source = readFile(argv[0])
if (source == null) {
    println("error: cannot read `${argv[0]}`")
    exit(1)
}
for (t in lexFile(source)) {
    println(tokenDumpLine(t))
}
