// The Keal parser, in Keal — now building a real tree.
//
// It mirrors src/parser.rs decision for decision; selfhost/astprint.keal
// renders the tree in the `keal ast` format, and the suite holds the pair to
// byte-for-byte agreement with the Rust parser, error messages and exit codes
// included.
//
// Failure is loud by default: print the error the oracle prints, and stop.
// The places the grammar backtracks — is `{` a lambda or a map, is this a
// lambda parameter list — run with `quiet` raised, where a failure only sets
// a flag for the caller to roll back on. A quiet failure may return a dummy
// node; the caller always rolls back before it could be seen.
//
// `errorPrefix` sits in front of the `L:C` in error lines: the parser driver
// leaves it empty, the checker driver sets it to `path:` so a failure inside
// an imported module says which file it came from.

import "./lexing.keal"
import "./ast.keal"

/// How an expected token reads in an error message.
func describeKind(kind: String): String {
    return when (kind) {
        "eof" -> "end of file"
        ";" -> "end of statement"
        else -> "`${kind}`"
    }
}

/// The word an operator token contributes to a `binary` node.
func binaryOpOf(kind: String): String {
    return when (kind) {
        "==", "!=", "<", "<=", ">", ">=", "<=>", "+", "-", "*", "/", "%", "**", "^/" -> kind
        else -> ""
    }
}

func binaryPowerOf(kind: String): Int {
    return when (kind) {
        "==", "!=" -> 2
        "<", "<=", ">", ">=", "<=>" -> 3
        "+", "-" -> 7
        "*", "/", "%" -> 8
        "**", "^/" -> 9
        else -> 0
    }
}

/// The bit operator a token spells. Words only: `and`, `or` and `xor` are
/// the `Bool` ones and `^` is already `xor`, so a sigil here would be a
/// second spelling of something the reader has to look up anyway.
///
/// They share one level — 6, tighter than comparison so that
/// `flag band 2 != 0` reads as it looks, which is the one thing C got wrong
/// here. Against arithmetic the level settles nothing: `mixing` refuses
/// that pair outright.
func bitOpOf(kind: String): String {
    if (isBitOp(kind)) { return kind }
    return ""
}

/// True for an operator that reads an `Int` as a number rather than as bits.
func isArithOp(op: String): Bool {
    return when (op) {
        "+", "-", "*", "/", "%", "**", "^/" -> true
        else -> false
    }
}

/// The connective a token spells, with `&&`, `||` and `^` as aliases.
func logicalOpOf(kind: String): String {
    return when (kind) {
        "and", "&&" -> "and"
        "or", "||" -> "or"
        "xor", "^" -> "xor"
        "xnor" -> "xnor"
        "nand" -> "nand"
        "nor" -> "nor"
        "implies" -> "implies"
        else -> ""
    }
}

func isAssignOp(kind: String): Bool {
    return when (kind) {
        "=", "+=", "-=", "*=", "/=", "%=", "**=", "^/=" -> true
        else -> false
    }
}

/// What a compound assignment contributes to the tree: `+=` reads as `+`,
/// and plain `=` as itself.
func assignOpName(kind: String): String {
    return when (kind) {
        "+=" -> "+"
        "-=" -> "-"
        "*=" -> "*"
        "/=" -> "/"
        "%=" -> "%"
        "**=" -> "**"
        "^/=" -> "^/"
        // A word operator and `=` are two tokens, so the first one already
        // carries the name: `x band= 3`.
        "band", "bor", "bxor", "shl", "shr", "ushr" -> kind
        else -> "="
    }
}

/// Whether parse errors carry their notes (` -- note`). The `ast` dump
/// oracle prints them bare; the checker and emitter oracles print the note.
package var parseNoteMode = false

package class Parser(val toks: List<Token>) {
    var pos: Int = 0
    var quiet: Int = 0
    var failed: Bool = false
    package var errorPrefix: String = ""

    func peek(): Token {
        val i = this.pos.min(this.toks.size - 1)
        return this.toks[i]
    }

    /// How many tokens the operator of an assignment ahead is spelled with:
    /// 0 when what is ahead is not one, 1 for `=` and `+=`, 2 for a word
    /// operator and `=` — `band=` is a keyword followed by the assignment
    /// rather than a token of its own.
    func assignTokens(): Int {
        val k = this.peek().kind
        if (isAssignOp(k)) { return 1 }
        unless (bitOpOf(k) == "") {
            if (this.peekAt(1).kind == "=") { return 2 }
        }
        return 0
    }

    /// Refuses two operators that have no relative precedence side by side.
    ///
    /// Keal already asks this of the logical connectives, for the reason
    /// `docs/language.md` §4 gives: where an order would have to be invented
    /// and then remembered, the language asks instead. The bits are the same
    /// case twice over. `a band b bor c` has no reading anyone would bet on,
    /// and `a shl 2 + 1` has two that differ — C picked one and has been
    /// producing that bug ever since.
    proc mixing(prev: String, next: String, line: Int, col: Int) {
        if (prev == "") { return }
        val nextBit = bitOpOf(next) != ""
        unless (nextBit or isArithOp(next)) { return }
        val prevBit = bitOpOf(prev) != ""
        if (prevBit == nextBit and (not prevBit or prev == next)) { return }
        val note = if (prevBit and nextBit) {
            "bit operators have no relative precedence in Keal"
        } else {
            "a bit operator and an arithmetic one have no relative precedence in Keal"
        }
        this.failNote(
            line, col,
            "`${prev}` and `${next}` need parentheses to say which applies first",
            "${note}; write `(a ${prev} b) ${next} c` or `a ${prev} (b ${next} c)`"
        )
    }

    func peekAt(k: Int): Token {
        val i = (this.pos + k).min(this.toks.size - 1)
        return this.toks[i]
    }

    func advance(): Token {
        val t = this.peek()
        if (this.pos < this.toks.size - 1) { this.pos += 1 }
        return t
    }

    func at(kind: String): Bool { this.peek().kind == kind }

    func eat(kind: String): Bool {
        if (this.at(kind)) {
            this.advance()
            return true
        }
        return false
    }

    proc fail(atLine: Int, atCol: Int, msg: String) {
        this.failNote(atLine, atCol, msg, "")
    }

    proc failNote(atLine: Int, atCol: Int, msg: String, note: String) {
        if (this.quiet > 0) {
            this.failed = true
            return
        }
        var out = "error ${this.errorPrefix}${atLine}:${atCol} ${msg}"
        if (parseNoteMode and note != "") { out += " -- ${note}" }
        println(out)
        exit(1)
    }

    proc failHere(msg: String) {
        val t = this.peek()
        this.fail(t.line, t.col, msg)
    }

    proc expect(kind: String, ctx: String) {
        if (this.at(kind)) {
            this.advance()
            return
        }
        this.failHere(
            "expected ${describeKind(kind)} ${ctx}, found ${describeToken(this.peek())}"
        )
    }

    /// The name, or "" after a quiet failure.
    func expectIdent(ctx: String): String {
        if (this.at("ident")) {
            return this.advance().text
        }
        this.failHere("expected ${ctx}, found ${describeToken(this.peek())}")
        return ""
    }

    proc skipSemis() {
        while (this.at(";")) { this.advance() }
    }

    /// True when the token after this one could name a declaration.
    func namesDeclaration(): Bool { this.peekAt(1).kind == "ident" }

    /// A visibility modifier, when one is written.
    ///
    /// The five words are reserved, so nothing has to be looked ahead at to
    /// know one: `public`, `package` and `private` say who may name a
    /// declaration, while `internal` and `protected` are held for
    /// visibilities the language does not have yet and are refused where
    /// they appear rather than silently ignored.
    func visibility(): String {
        val t = this.peek()
        val k = t.kind
        if (k == "internal" or k == "protected") {
            this.advance()
            this.failNote(
                t.line, t.col,
                "`${k}` is reserved, but names no visibility yet",
                "Keal has `private` — which is the default — `package` and `public`"
            )
            return ""
        }
        if (k == "private" or k == "public" or k == "package") {
            this.advance()
            return k
        }
        return ""
    }

    // ---- program --------------------------------------------------------

    package func program(): ProgramN {
        val out = ProgramN()
        while (true) {
            this.skipSemis()
            if (this.at("eof")) { return out }
            out.items.add(this.item())
        }
        return out
    }

    /// The `as name` after an import, when one is written. `as` is not a
    /// reserved word: it is only this clause, and only right here.
    func importAlias(): String {
        val t = this.peek()
        unless (t.kind == "ident" and t.text == "as") { return "" }
        unless (this.peekAt(1).kind == "ident") { return "" }
        this.advance()
        return this.expectIdent("a name for the imported module")
    }

    func item(): ItemN {
        val vis = this.visibility()
        return this.itemAfterVis(vis)
    }

    /// `constexpr` is contextual, like `record` and `weak`: it introduces a
    /// declaration only when `val` or `func` follows, so `val constexpr = 3`
    /// stays a perfectly good binding.
    func atConstexpr(): Bool {
        val t = this.peek()
        unless (t.kind == "ident" and t.text == "constexpr") { return false }
        val n = this.peekAt(1).kind
        return n == "val" or n == "func" or n == "var" or n == "proc"
    }

    /// The word this language used to spell `func`. It is lexed rather than
    /// read as a name so that an old file gets one clear sentence instead of
    /// a cascade of nonsense, and it is refused rather than accepted so that
    /// there is one spelling and not two.
    proc refuseOldFun() {
        if (this.at("fun")) {
            val t = this.peek()
            this.failNote(
                t.line, t.col,
                "`fun` is spelled `func`",
                "the word changed; nothing else about the declaration did"
            )
        }
    }

    /// A word held for a feature the language does not have. Refused where
    /// it is written rather than read as a name, so that the day the feature
    /// arrives no program has to be renamed — and so nobody builds on one in
    /// the meantime.
    proc refuseHeld() {
        val t = this.peek()
        val word = t.kind
        var note = ""
        if (word == "async" or word == "await") {
            note = "Keal's concurrency is actors: `spawn` a handler, `send` it a message"
        }
        if (word == "yield") {
            note = "a lazy series is a `Sequence`; `seq(xs)` and `iterate(seed, step)` build one"
        }
        if (word == "sealed") {
            note = "a closed set of names is an `enum`, and a `when` over one needs no `else`"
        }
        if (word == "super") {
            note = "there is no inheritance here: compose, or give a trait a default method"
        }
        if (word == "static") {
            note = "a value that belongs to no instance is a top-level `val`"
        }
        if (word == "typealias") {
            note = "name the type where it is used, or wrap it in a `record` of one field"
        }
        unless (note == "") {
            this.failNote(t.line, t.col, "`${word}` is reserved, and means nothing yet", note)
        }
    }

    func itemAfterVis(vis: String): ItemN {
        this.refuseHeld()
        this.refuseOldFun()
        val t = this.peek()
        if (this.atConstexpr()) {
            if (this.peekAt(1).kind == "func") {
                this.advance()
                val i = ItemN("func", t.line, t.col)
                val f = this.funDecl(vis)
                f.constexpr = true
                i.funDecl = f
                return i
            }
            // `constexpr val` is a statement; `stmt` eats the word itself,
            // so the same code serves a binding inside a body.
            val i = ItemN("stmt", t.line, t.col)
            val s = this.stmt()
            s.vis = vis
            i.stmt = s
            return i
        }
        if (t.kind == "func" or t.kind == "proc") {
            val i = ItemN("func", t.line, t.col)
            i.funDecl = this.funDecl(vis)
            return i
        }
        if (t.kind == "class") {
            val i = ItemN("class", t.line, t.col)
            i.classDecl = this.classDecl(false, vis)
            return i
        }
        if (t.kind == "ident" and t.text == "enum" and this.namesDeclaration()) {
            val i = ItemN("enum", t.line, t.col)
            i.enumDecl = this.enumDecl(vis)
            return i
        }
        if (t.kind == "ident" and t.text == "macro" and this.namesDeclaration()) {
            val i = ItemN("macro", t.line, t.col)
            i.macroDecl = this.macroDecl(vis)
            return i
        }
        if (t.kind == "ident" and t.text == "record" and this.namesDeclaration()) {
            this.advance()
            val i = ItemN("class", t.line, t.col)
            i.classDecl = this.classDecl(true, vis)
            return i
        }
        if (t.kind == "ident" and t.text == "trait" and this.namesDeclaration()) {
            val i = ItemN("trait", t.line, t.col)
            i.traitDecl = this.traitDecl(vis)
            return i
        }
        if (t.kind == "ident" and t.text == "native" and this.peekAt(1).kind == "str") {
            this.advance()
            val strTok = this.advance()
            if (strTok.parts.size == 1 and strTok.parts[0].isLit) {
                val i = ItemN("native", t.line, t.col)
                i.text = strTok.parts[0].text
                return i
            }
            this.failNote(
                t.line, t.col, "a `native` block cannot interpolate",
                "it is passed to the C compiler verbatim"
            )
            return ItemN("native", t.line, t.col)
        }
        if (t.kind == "ident" and t.text == "extern"
            and (this.peekAt(1).kind == "func" or this.peekAt(1).kind == "proc")) {
            val i = ItemN("extern", t.line, t.col)
            i.externDecl = this.externDecl(vis)
            return i
        }
        if (t.kind == "import") {
            this.advance()
            val next = this.peek()
            if (next.kind == "str") {
                this.advance()
                if (next.parts.size == 1 and next.parts[0].isLit) {
                    val i = ItemN("import", t.line, t.col)
                    i.text = next.parts[0].text
                    i.alias = this.importAlias()
                    return i
                }
                this.fail(t.line, t.col, "import path must be a plain string literal")
                return ItemN("import", t.line, t.col)
            }
            if (next.kind == "ident") {
                // `import java.time.LocalDate, java.time.DayOfWeek` — the
                // jbind sugar: dotted class names, comma-separated, become
                // the path of the cached generated module.
                var classes = ""
                var more = true
                while (more) {
                    var fq = ""
                    var dotted = true
                    while (dotted) {
                        val part = this.peek()
                        if (part.kind == "ident") {
                            this.advance()
                            fq = fq + part.text
                        } else {
                            this.failHere(
                                "expected a Java class name part, found ${describeToken(part)}"
                            )
                            return ItemN("import", t.line, t.col)
                        }
                        if (this.peek().kind == ".") {
                            this.advance()
                            fq = fq + "."
                        } else {
                            dotted = false
                        }
                    }
                    if (classes == "") {
                        classes = fq
                    } else {
                        classes = classes + "+" + fq
                    }
                    if (this.peek().kind == ",") {
                        this.advance()
                    } else {
                        more = false
                    }
                }
                val i = ItemN("import", t.line, t.col)
                i.text = ".jbind/" + classes + ".keal"
                i.alias = this.importAlias()
                return i
            }
            this.failHere(
                "expected an import path string, found ${describeToken(next)}"
            )
            return ItemN("import", t.line, t.col)
        }
        val i = ItemN("stmt", t.line, t.col)
        val st = this.stmt()
        if (st.kind == "let") {
            st.vis = vis
        } else {
            unless (vis == "") {
                this.failNote(
                    t.line, t.col,
                    "`${vis}` can only precede a declaration",
                    "a visibility is written on a `func`, `proc`, `class`, `record`, `trait`, `val` or `var`"
                )
            }
        }
        i.stmt = st
        return i
    }

    // ---- declarations ---------------------------------------------------

    /// `enum Suit { Hearts, Diamonds }` — names, separated by commas or by
    /// newlines or by both. Nothing else: a variant that wants fields is a
    /// `record`, and one that wants a number is a function with a `when`.
    func enumDecl(vis: String): EnumN {
        val start = this.peek()
        this.advance()
        val name = this.expectIdent("an enum name")
        val en = EnumN(name, start.line, start.col)
        en.vis = vis
        this.expect("{", "to open the enum body")
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            val vt = this.peek()
            val vname = this.expectIdent("a variant name")
            if (this.at("(")) {
                this.failNote(
                    vt.line, vt.col,
                    "an enum variant cannot have fields",
                    "a variant that carries something is a `record`"
                )
            }
            if (this.at("=")) {
                this.failNote(
                    vt.line, vt.col,
                    "an enum variant cannot have a value",
                    "write a function with a `when` over the enum: the day a variant is added, that function is an error rather than a wrong number"
                )
            }
            var seen = false
            for (v in en.variants) {
                if (v.name == vname) { seen = true }
            }
            if (seen) {
                this.fail(vt.line, vt.col, "`${vname}` is declared twice in this enum")
            }
            if (vname == "values") {
                this.failNote(
                    vt.line, vt.col,
                    "`values` cannot name a variant",
                    "`values()` is the list of an enum's variants"
                )
            }
            en.variants.add(VariantN(vname, vt.line, vt.col))
            this.skipSemis()
            val _comma = this.eat(",")
        }
        this.expect("}", "to close the enum body")
        if (en.variants.size == 0) {
            this.failNote(
                start.line, start.col,
                "`${name}` needs at least one variant",
                "a type with no values cannot be built; `Nothing` already means that"
            )
        }
        return en
    }

    /// `macro name(a, b) { ... }`. The parameters are bare names: a macro
    /// takes syntax, not values, so there is nothing to declare a type for.
    func macroDecl(vis: String): MacroN {
        val start = this.peek()
        this.advance()
        val name = this.expectIdent("a macro name")
        val m = MacroN(name, start.line, start.col)
        m.vis = vis
        this.expect("(", "to start a macro's parameter list")
        while (not this.at(")")) {
            m.params.add(this.expectIdent("a macro parameter name"))
            unless (this.eat(",")) { break }
        }
        this.expect(")", "to close a macro's parameter list")
        m.body = this.block()
        return m
    }

    /// One argument to a macro. A macro takes syntax rather than a value, so
    /// an assignment is allowed here even though it is a statement anywhere
    /// else: `twice!(n += 5)` is exactly the kind of thing a macro is for.
    func macroArg(): Ex {
        val start = this.peek()
        val target = this.expr()
        val opTok = this.peek()
        val opTokens = this.assignTokens()
        if (opTokens == 0) { return target }
        var consumed = 0
        while (consumed < opTokens) {
            this.advance()
            consumed += 1
        }
        unless (target.kind == "ident" or target.kind == "field" or target.kind == "index") {
            this.failNote(
                opTok.line, opTok.col,
                "left side of an assignment is not assignable",
                "only variables, fields and indexed elements can be assigned"
            )
        }
        val value = this.expr()
        val node = Ex("assign", start.line, start.col)
        node.file = target.file
        node.assignOp = assignOpName(opTok.kind)
        node.kids = [target, value]
        return node
    }

    func funDecl(vis: String): FunN {
        val start = this.peek()
        val isFun = this.at("func")
        this.advance() // func or proc
        val name = this.expectIdent(if (isFun) { "a function name" } else { "a name" })
        val f = FunN(name, start.line, start.col)
        f.vis = vis
        f.typeParams = this.typeParamList()
        f.params = this.paramList()
        f.ret = this.returnType(isFun, name)
        f.body = this.block()
        return f
    }

    /// The `: T` after a parameter list — required on `func`, rejected on
    /// `proc`, which is the point of the split.
    func returnType(isFun: Bool, name: String): TypeEx? {
        unless (isFun) {
            if (this.at(":")) {
                val t = this.peek()
                this.failNote(
                    t.line, t.col, "`proc ${name}` cannot declare a return type",
                    "a `proc` returns nothing; use `func` if it produces a value"
                )
            }
            return null
        }
        unless (this.at(":")) {
            val t = this.peek()
            this.failNote(
                t.line, t.col, "`func ${name}` must declare what it returns",
                "write `: Type`, or declare it with `proc` if it returns nothing"
            )
            return null
        }
        this.advance()
        return this.typeExpr()
    }

    func typeParamList(): List<TParamN> {
        val out: List<TParamN> = []
        unless (this.at("<")) { return out }
        this.advance()
        while (not this.at(">")) {
            val name = this.expectIdent("a type parameter name")
            val tp = TParamN(name)
            if (this.eat(":")) {
                var going = true
                while (going) {
                    tp.bounds.add(this.typeExpr())
                    going = this.eat("+")
                }
            }
            out.add(tp)
            unless (this.eat(",")) { break }
        }
        this.expect(">", "to close the type parameter list")
        if (out.size == 0) {
            this.failHere("a type parameter list cannot be empty")
        }
        return out
    }

    func paramList(): List<ParamN> {
        this.expect("(", "to start a parameter list")
        val out: List<ParamN> = []
        while (not this.at(")")) {
            val start = this.peek()
            // `var` before the name says this function may change what the
            // parameter holds. Without it, the contents belong to whoever
            // passed them.
            val mutable = this.eat("var")
            val name = this.expectIdent("a parameter name")
            this.expect(":", "after a parameter name")
            val p = ParamN(name, start.line, start.col)
            p.mutable = mutable
            p.tyEx = this.typeExpr()
            if (this.eat("=")) {
                p.default = this.expr()
            }
            out.add(p)
            unless (this.eat(",")) { break }
        }
        this.expect(")", "to close the parameter list")
        return out
    }

    func classDecl(isRecord: Bool, vis: String): ClassN {
        val start = this.peek()
        unless (isRecord) { this.expect("class", "to start a class declaration") }
        val name = this.expectIdent(
            if (isRecord) { "a record name" } else { "a class name" }
        )
        val c = ClassN(name, isRecord, start.line, start.col)
        c.vis = vis
        c.typeParams = this.typeParamList()

        if (this.at("(")) {
            this.advance()
            while (not this.at(")")) {
                val pvis = this.visibility()
                val pstart = this.peek()
                // `weak` is contextual, like `record`: it is a modifier only
                // where a field is being declared, and stays a usable name
                // everywhere else.
                val nextKind = this.peekAt(1).kind
                val isWeak = pstart.kind == "ident" and pstart.text == "weak" and (nextKind == "val" or nextKind == "var")
                if (isWeak) { this.advance() }
                var kw = ""
                if (this.eat("val")) {
                    kw = "val"
                } else if (this.at("var")) {
                    if (isRecord) {
                        val t = this.peek()
                        this.failNote(
                            t.line, t.col, "a record's fields cannot be `var`",
                            "records are immutable; declare it as a `class` if it must change"
                        )
                    }
                    this.advance()
                    kw = "var"
                } else if (isRecord) {
                    // In a record every parameter is a field; `val` is implied.
                    kw = "val"
                }
                val pname = this.expectIdent("a constructor parameter name")
                this.expect(":", "after a constructor parameter name")
                val cp = CtorN(pname, pstart.line, pstart.col)
                cp.vis = pvis
                cp.fieldKind = kw
                cp.weak = isWeak
                cp.tyEx = this.typeExpr()
                if (this.eat("=")) {
                    cp.default = this.expr()
                }
                c.ctor.add(cp)
                unless (this.eat(",")) { break }
            }
            this.expect(")", "to close the constructor parameter list")
        }

        if (this.eat(":")) {
            var going = true
            while (going) {
                c.traits.add(this.typeExpr())
                going = this.eat(",")
            }
        }

        // A class whose state is entirely in its constructor needs no body.
        unless (this.at("{")) { return c }
        this.advance()
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            val mvis = this.visibility()
            val m = this.peek()
            if (m.kind == "func" or m.kind == "proc") {
                c.methods.add(this.funDecl(mvis))
            } else if (m.kind == "val" or m.kind == "var" or (m.kind == "ident" and m.text == "weak" and (this.peekAt(1).kind == "val" or this.peekAt(1).kind == "var"))) {
                val isWeak = m.kind == "ident"
                if (isWeak) { this.advance() }
                val mutable = this.advance().kind == "var"
                if (mutable and isRecord) {
                    this.failNote(
                        m.line, m.col, "a record's fields cannot be `var`",
                        "records are immutable; use a `class` instead"
                    )
                }
                val fname = this.expectIdent("a field name")
                val fd = FieldN(fname, m.line, m.col)
                fd.vis = mvis
                fd.mutable = mutable
                fd.weak = isWeak
                if (this.eat(":")) {
                    fd.tyEx = this.typeExpr()
                }
                if (this.eat("=")) {
                    fd.init = this.expr()
                }
                if (fd.tyEx == null and fd.init == null) {
                    this.fail(
                        m.line,
                        m.col,
                        "field `${fname}` needs either a type or an initializer"
                    )
                }
                c.fields.add(fd)
            } else {
                this.failHere(
                    "expected `func`, `proc`, `val` or `var` in a class body, found ${describeToken(m)}"
                )
            }
        }
        this.expect("}", "to close the class body")
        return c
    }

    func traitDecl(vis: String): TraitN {
        val start = this.peek()
        this.advance() // trait
        val name = this.expectIdent("a trait name")
        val t = TraitN(name, start.line, start.col)
        t.vis = vis
        this.expect("{", "to open the trait body")
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            val mstart = this.peek()
            val isFun = this.at("func")
            if (isFun) {
                this.advance()
            } else {
                this.expect("proc", "to start a trait member")
            }
            val mname = this.expectIdent("a method name")
            val decl = FunN(mname, mstart.line, mstart.col)
            decl.typeParams = this.typeParamList()
            decl.params = this.paramList()
            decl.ret = this.returnType(isFun, mname)
            val hasDefault = this.at("{")
            if (hasDefault) {
                decl.body = this.block()
            }
            t.methods.add(TraitMethodN(decl, hasDefault))
        }
        this.expect("}", "to close the trait body")
        return t
    }

    /// `extern func` names a C function with a result; `extern proc` names
    /// one that returns `void`. The boundary keeps the distinction the
    /// language makes on its own side rather than making a `void` function
    /// claim an `Int` nobody reads.
    func externDecl(vis: String): ExternN {
        val start = this.peek()
        this.advance() // extern
        val returnsValue = this.at("func")
        if (returnsValue) {
            this.expect("func", "after `extern`")
        } else {
            this.expect("proc", "after `extern`")
        }
        val name = this.expectIdent("a function name")
        val x = ExternN(name, start.line, start.col)
        x.vis = vis
        x.params = this.paramList()
        x.ret = this.returnType(returnsValue, name)
        x.symbol = name
        if (this.eat("=")) {
            // The token is consumed before it is judged, so a bad one is
            // reported at whatever follows it — as the oracle does.
            val t = this.advance()
            if (t.kind == "str") {
                if (t.parts.size == 1 and t.parts[0].isLit) {
                    x.symbol = t.parts[0].text
                } else {
                    this.fail(
                        start.line,
                        start.col,
                        "a symbol name cannot interpolate"
                    )
                }
            } else {
                this.failHere(
                    "expected a C symbol string, found ${describeToken(t)}"
                )
            }
        }
        return x
    }

    // ---- statements -----------------------------------------------------

    func block(): BlockN {
        this.expect("{", "to open a block")
        val out = BlockN()
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            out.stmts.add(this.stmt())
        }
        this.expect("}", "to close the block")
        return out
    }

    func stmt(): StmtN {
        this.refuseHeld()
        this.refuseOldFun()
        val t = this.peek()
        var isConstexpr = false
        if (this.atConstexpr()) {
            this.advance()
            isConstexpr = true
            unless (this.at("val")) {
                this.failNote(
                    t.line,
                    t.col,
                    "`constexpr` goes before `val` or `func`",
                    "a `var` can be assigned to and a `proc` returns nothing, so neither has one value to compute"
                )
            }
        }
        if (t.kind == "val" or t.kind == "var" or isConstexpr) {
            val kw = this.advance().kind
            // `val (a, b) = t` names a tuple's elements.
            if (this.at("(")) {
                val pstart = this.peek()
                val binds = this.bindList(pstart.line, pstart.col)
                if (binds.size < 2 or binds.size > 5) {
                    this.fail(
                        pstart.line,
                        pstart.col,
                        "a tuple pattern names between 2 and 5 values"
                    )
                }
                this.expect("=", "in a destructuring declaration")
                val s = StmtN("destructure", t.line, t.col)
                s.mutable = kw == "var"
                s.pattern = DestrN("Tuple${binds.size}", binds, pstart.line, pstart.col)
                s.init = this.expr()
                return s
            }
            // `val Point(x, y) = p` destructures; `val p = ...` binds.
            if (this.at("ident") and this.peekAt(1).kind == "(") {
                val nameTok = this.advance()
                val binds = this.bindList(nameTok.line, nameTok.col)
                this.expect("=", "in a destructuring declaration")
                val s = StmtN("destructure", t.line, t.col)
                s.mutable = kw == "var"
                s.pattern = DestrN(nameTok.text, binds, nameTok.line, nameTok.col)
                s.init = this.expr()
                return s
            }
            val name = this.expectIdent("a variable name")
            val s = StmtN("let", t.line, t.col)
            s.name = name
            s.constexpr = isConstexpr
            s.mutable = kw == "var"
            if (this.eat(":")) {
                s.tyEx = this.typeExpr()
            }
            this.expect("=", "in a variable declaration")
            s.init = this.expr()
            return s
        }
        if (t.kind == "return") {
            this.advance()
            // `return if (cond) v` is a guarded return — sugar for
            // `if (cond) { return v }`, and the code below it still runs
            // when the guard fails. `return if (cond) { .. }` keeps its
            // old meaning, told apart by the `{` after the condition.
            if (this.guardedReturnAhead()) {
                val negated = this.at("unless")
                val word = if (negated) { "unless" } else { "if" }
                val ifTok = this.peek()
                this.advance()
                this.expect("(", "after `${word}`")
                var cond = this.expr()
                this.expect(")", "after the `${word}` condition")
                if (negated) {
                    val neg = Ex("unary", cond.line, cond.col)
                    neg.text = "not"
                    neg.kids = [cond]
                    cond = neg
                }
                val ret = StmtN("return", t.line, t.col)
                unless (this.at(";") or this.at("}") or this.at("eof")) {
                    var value = this.expr()
                    if (this.at(",")) {
                        val items: List<Ex> = [value]
                        while (this.eat(",")) {
                            items.add(this.expr())
                        }
                        value = this.tuple(items, t)
                    }
                    ret.ex = value
                }
                val guard = Ex("if", ifTok.line, ifTok.col)
                guard.kids = [cond]
                val b = BlockN()
                b.stmts = [ret]
                guard.body = b
                val s = StmtN("expr", t.line, t.col)
                s.ex = guard
                return s
            }
            val s = StmtN("return", t.line, t.col)
            if (this.at(";") or this.at("}") or this.at("eof")) {
                return s
            }
            var value = this.expr()
            // `return a, b` returns both, as a tuple.
            if (this.at(",")) {
                val items: List<Ex> = [value]
                while (this.eat(",")) {
                    items.add(this.expr())
                }
                value = this.tuple(items, t)
            }
            s.ex = value
            return s
        }
        if (t.kind == "break") {
            this.advance()
            return StmtN("break", t.line, t.col)
        }
        if (t.kind == "continue") {
            this.advance()
            return StmtN("continue", t.line, t.col)
        }
        if (t.kind == "throw") {
            this.advance()
            val s = StmtN("throw", t.line, t.col)
            s.ex = this.expr()
            return s
        }
        if (t.kind == "try") {
            this.advance()
            val s = StmtN("try", t.line, t.col)
            s.body = this.block()
            // A newline between `}` and `catch` inserted a virtual `;`;
            // at least one `catch` is mandatory, so skipping is safe.
            this.skipSemis()
            var more = true
            while (more) {
                val ct = this.peek()
                this.expect("catch", "after the `try` block")
                this.expect("(", "after `catch`")
                val cname = this.expectIdent("a name for what is caught")
                val c = CatchN(cname, ct.line, ct.col)
                if (this.eat(":")) { c.tyEx = this.typeExpr() }
                this.expect(")", "after the caught value's name")
                c.handler = this.block()
                s.catches.add(c)
                // Another clause may follow, over a newline as `else` may.
                var i = 0
                while (this.peekAt(i).kind == ";") { i += 1 }
                if (this.peekAt(i).kind == "catch") { this.skipSemis() } else { more = false }
            }
            return s
        }
        if (t.kind == "while") {
            this.advance()
            this.expect("(", "after `while`")
            val s = StmtN("while", t.line, t.col)
            s.ex = this.expr()
            this.expect(")", "after the `while` condition")
            s.body = this.block()
            return s
        }
        if (t.kind == "for") {
            this.advance()
            this.expect("(", "after `for`")
            val v = this.expectIdent("a loop variable name")
            val s = StmtN("for", t.line, t.col)
            s.name = v
            if (this.eat(":")) {
                s.tyEx = this.typeExpr()
            }
            this.expect("in", "after the loop variable")
            s.ex = this.expr()
            this.expect(")", "after the `for` iterable")
            s.body = this.block()
            return s
        }
        if (t.kind == "func" or t.kind == "proc") {
            val s = StmtN("func", t.line, t.col)
            s.funDecl = this.funDecl("")
            return s
        }
        if (t.kind == "class") {
            val s = StmtN("class", t.line, t.col)
            s.classDecl = this.classDecl(false, "")
            return s
        }

        val target = this.expr()
        // `x++` and `x--` are statements, as Go has them: sugar for
        // `x += 1`, never expressions — no pre/post distinction to
        // mislearn.
        if (this.at("++") or this.at("--")) {
            val incTok = this.advance()
            unless (target.kind == "ident" or target.kind == "field"
                or target.kind == "index") {
                this.failNote(
                    incTok.line, incTok.col,
                    "left side of an assignment is not assignable",
                    "only variables, fields and indexed elements can be assigned"
                )
            }
            val one = Ex("int", incTok.line, incTok.col)
            one.iVal = 1
            val inc = Ex("assign", t.line, t.col)
            inc.assignOp = if (incTok.kind == "++") { "+" } else { "-" }
            inc.kids = [target, one]
            val s = StmtN("expr", t.line, t.col)
            s.ex = inc
            return s
        }
        val opTok = this.peek()
        val opTokens = this.assignTokens()
        if (opTokens == 0) {
            val s = StmtN("expr", t.line, t.col)
            s.ex = target
            return s
        }
        var consumed = 0
        while (consumed < opTokens) {
            this.advance()
            consumed += 1
        }
        unless (target.kind == "ident" or target.kind == "field" or target.kind == "index") {
            this.failNote(
                opTok.line, opTok.col,
                "left side of an assignment is not assignable",
                "only variables, fields and indexed elements can be assigned"
            )
        }
        val assign = Ex("assign", t.line, t.col)
        assign.assignOp = assignOpName(opTok.kind)
        assign.kids = [target, this.expr()]
        val s = StmtN("expr", t.line, t.col)
        s.ex = assign
        return s
    }

    /// True when the tokens ahead read `if (cond) X` or `unless (cond) X`
    /// with `X` not `{` — the guarded-return form. A `{` there means the
    /// old return-an-if-expression, which keeps its meaning.
    func guardedReturnAhead(): Bool {
        unless (this.at("if") or this.at("unless")) { return false }
        unless (this.peekAt(1).kind == "(") { return false }
        var depth = 0
        var i = 1
        while (true) {
            val k = this.peekAt(i).kind
            if (k == "(") {
                depth += 1
            } else if (k == ")") {
                depth -= 1
                if (depth == 0) {
                    return this.peekAt(i + 1).kind != "{"
                }
            } else if (k == "eof") {
                return false
            }
            i += 1
        }
        return false
    }

    /// `(a, _, c)` — the shared half of every destructuring form. An empty
    /// list is reported at the pattern's head — the type name, or the `(`
    /// of a tuple pattern — which is why the position comes from the caller.
    func bindList(atLine: Int, atCol: Int): List<String> {
        this.expect("(", "to start a destructuring pattern")
        val out: List<String> = []
        while (not this.at(")")) {
            if (this.at("(")) {
                val t = this.peek()
                this.failNote(
                    t.line, t.col, "a pattern cannot nest inside another",
                    "bind the inner value first, then destructure it"
                )
            }
            val name = this.expectIdent("a field name, or `_` to skip one")
            out.add(name)
            unless (this.eat(",")) { break }
        }
        this.expect(")", "to close the destructuring pattern")
        if (out.size == 0) {
            this.failNote(
                atLine, atCol, "a destructuring pattern needs at least one name",
                "to test the type alone, write `is Name` without parentheses"
            )
        }
        return out
    }

    // ---- expressions ----------------------------------------------------

    func expr(): Ex {
        val cond = this.binary(0)
        // The ternary sits below everything else: `c ? a : b` selects on a
        // `Bool`, and a third branch (`c ? less : equal : greater`) selects
        // on a `Comp` — which of the two the checker decides by the
        // condition's type. Branches parse greedily, so a nested ternary
        // binds its own colons first.
        unless (this.at("?")) { return cond }
        val t = this.peek()
        this.advance()
        val e = Ex("ternary", t.line, t.col)
        e.kids.add(cond)
        e.kids.add(this.expr())
        this.expect(":", "between the branches of `?`")
        e.kids.add(this.expr())
        if (this.at(":")) {
            this.advance()
            e.kids.add(this.expr())
        }
        return e
    }

    func binary(minBp: Int): Ex {
        var lhs = this.unary()
        // The last operator applied at this level, for the mixing rule. A
        // comparison clears it: it answers a `Bool`, so nothing it produces
        // can be an operand of either family.
        var prev = ""
        while (true) {
            val t = this.peek()

            val logical = logicalOpOf(t.kind)
            unless (logical == "") {
                if (1 < minBp) { return lhs }
                this.advance()
                val rhs = this.binary(2)
                val node = Ex("logical", t.line, t.col)
                node.text = logical
                node.kids = [lhs, rhs]
                lhs = node
                // No connective outranks another; only an associative repeat
                // may chain.
                val next = logicalOpOf(this.peek().kind)
                unless (next == "") {
                    val repeats = next == logical and (logical == "and" or logical == "or" or logical == "xor" or logical == "xnor")
                    unless (repeats) {
                        val what = if (next == logical) {
                            "`${logical}` does not chain"
                        } else {
                            "`${logical}` and `${next}` need parentheses to say which applies first"
                        }
                        val at = this.peek()
                        this.failNote(
                            at.line, at.col, what,
                            "logical operators have no relative precedence in Keal; write `(a ${logical} b) ${next} c` or `a ${logical} (b ${next} c)`"
                        )
                    }
                }
                prev = ""
                continue
            }

            // A bit operator takes a *unary* right operand rather than a
            // sub-expression: nothing may be absorbed on its right that the
            // mixing rule would have refused on its left.
            val bit = bitOpOf(t.kind)
            unless (bit == "") {
                // `x band= 3` is an assignment. Two tokens spell it, and the
                // statement parser owns both.
                if (this.peekAt(1).kind == "=") { return lhs }
                if (6 < minBp) { return lhs }
                this.mixing(prev, bit, t.line, t.col)
                this.advance()
                val node = Ex("binary", t.line, t.col)
                node.text = bit
                node.kids = [lhs, this.unary()]
                lhs = node
                prev = bit
                continue
            }

            if (t.kind == "?:" and 4 >= minBp) {
                this.advance()
                val node = Ex("elvis", t.line, t.col)
                node.kids = [lhs, this.binary(4)]
                lhs = node
                prev = ""
                continue
            }
            if (t.kind == ".." and 5 >= minBp) {
                this.advance()
                val node = Ex("range", t.line, t.col)
                node.kids = [lhs, this.binary(6)]
                lhs = node
                prev = ""
                continue
            }
            if (t.kind == "is" and 3 >= minBp) {
                this.advance()
                val node = Ex("is", t.line, t.col)
                node.tyEx = this.typeExpr()
                node.kids = [lhs]
                lhs = node
                prev = ""
                continue
            }
            if (t.kind == "!" and 3 >= minBp and (this.peekAt(1).kind == "is" or this.peekAt(1).kind == "in")) {
                this.advance()
                if (this.eat("is")) {
                    val node = Ex("is", t.line, t.col)
                    node.negated = true
                    node.tyEx = this.typeExpr()
                    node.kids = [lhs]
                    lhs = node
                } else {
                    this.advance() // in
                    val rhs = this.binary(4)
                    // `x !in xs` is `not xs.contains(x)`.
                    val call = Ex("method", t.line, t.col)
                    call.text = "contains"
                    call.kids = [rhs]
                    call.args = [ArgN("", lhs)]
                    val neg = Ex("unary", t.line, t.col)
                    neg.text = "not"
                    neg.kids = [call]
                    lhs = neg
                }
                prev = ""
                continue
            }
            if (t.kind == "in" and 3 >= minBp) {
                this.advance()
                val rhs = this.binary(4)
                // `x in xs` is `xs.contains(x)`.
                val call = Ex("method", t.line, t.col)
                call.text = "contains"
                call.kids = [rhs]
                call.args = [ArgN("", lhs)]
                lhs = call
                prev = ""
                continue
            }

            val op = binaryOpOf(t.kind)
            if (op == "") { return lhs }
            val bp = binaryPowerOf(t.kind)
            if (bp < minBp) { return lhs }
            this.mixing(prev, op, t.line, t.col)
            prev = if (isArithOp(op)) { op } else { "" }
            this.advance()
            // `**` and `^/` associate to the right, as powers do everywhere:
            // `2 ** 3 ** 2` is `2 ** (3 ** 2)`.
            val nextBp = if (op == "**" or op == "^/") { bp } else { bp + 1 }
            val node = Ex("binary", t.line, t.col)
            node.text = op
            node.kids = [lhs, this.binary(nextBp)]
            lhs = node
        }
        return lhs
    }

    func unary(): Ex {
        val t = this.peek()
        val op = when (t.kind) {
            "-" -> "neg"
            "!", "not" -> "not"
            // `bnot` is `not` for the bits, and binds where `not` does.
            "bnot" -> "bnot"
            else -> ""
        }
        if (op == "") { return this.postfix() }
        this.advance()
        val node = Ex("unary", t.line, t.col)
        node.text = op
        node.kids = [this.binary(9)]
        return node
    }

    func postfix(): Ex {
        // Errors about a call or an index point at the whole expression.
        val start = this.peek()
        var e = this.primary()
        while (true) {
            val t = this.peek()
            if (t.kind == "." or t.kind == "?.") {
                val safe = this.advance().kind == "?."
                val nameTok = this.peek()
                val name = this.expectIdent("a field or method name")
                if (this.at("(")) {
                    val node = Ex("method", nameTok.line, nameTok.col)
                    node.text = name
                    node.safe = safe
                    node.kids = [e]
                    node.args = this.argList()
                    e = node
                } else {
                    val node = Ex("field", nameTok.line, nameTok.col)
                    node.text = name
                    node.safe = safe
                    node.kids = [e]
                    e = node
                }
            } else if (t.kind == "!!") {
                this.advance()
                val node = Ex("notnull", start.line, start.col)
                node.kids = [e]
                e = node
            } else if (t.kind == "(") {
                val node = Ex("call", start.line, start.col)
                node.kids = [e]
                node.args = this.argList()
                e = node
            } else if (t.kind == "[") {
                this.advance()
                val index = this.expr()
                this.expect("]", "to close an index expression")
                val node = Ex("index", start.line, start.col)
                node.kids = [e, index]
                e = node
            } else {
                return e
            }
        }
        return e
    }

    func argList(): List<ArgN> {
        this.expect("(", "to start an argument list")
        val out: List<ArgN> = []
        while (not this.at(")")) {
            // `name = value` is a named argument; `name == value` is not.
            var name = ""
            if (this.at("ident") and this.peekAt(1).kind == "=") {
                name = this.advance().text
                this.advance()
            }
            out.add(ArgN(name, this.expr()))
            unless (this.eat(",")) { break }
        }
        this.expect(")", "to close the argument list")
        return out
    }

    func tuple(items: List<Ex>, t: Token): Ex {
        if (items.size < 2 or items.size > 5) {
            this.failNote(
                t.line, t.col,
                "a tuple holds between 2 and 5 values, not ${items.size}",
                "for more, declare a record: named fields read better than positions"
            )
        }
        val callee = Ex("ident", t.line, t.col)
        callee.text = "Tuple${items.size}"
        val node = Ex("call", t.line, t.col)
        node.kids = [callee]
        for (i in items) { node.args.add(ArgN("", i)) }
        return node
    }

    func primary(): Ex {
        val t = this.peek()
        if (t.kind == "int") {
            this.advance()
            val node = Ex("int", t.line, t.col)
            node.iVal = t.text.toInt() ?: 0
            return node
        }
        if (t.kind == "float") {
            this.advance()
            val node = Ex("float", t.line, t.col)
            node.fVal = t.text.toFloat() ?: 0.0
            return node
        }
        if (t.kind == "true" or t.kind == "false") {
            this.advance()
            val node = Ex("bool", t.line, t.col)
            node.text = t.kind
            return node
        }
        if (t.kind == "null") {
            this.advance()
            return Ex("null", t.line, t.col)
        }
        if (t.kind == "this") {
            this.advance()
            return Ex("this", t.line, t.col)
        }
        if (t.kind == "ident") {
            this.advance()
            // `name!(...)` is a macro, spliced where it is written. The `!`
            // is not decoration: a macro can do things a call cannot — assign
            // to what it was given, run it twice, return from the function
            // around it — and a reader has to be told.
            if (this.at("!") and this.peekAt(1).kind == "(") {
                this.advance()
                this.advance()
                val call = Ex("macrocall", t.line, t.col)
                call.text = t.text
                while (not this.at(")")) {
                    call.kids.add(this.macroArg())
                    unless (this.eat(",")) { break }
                }
                this.expect(")", "to close a macro's arguments")
                return call
            }
            val node = Ex("ident", t.line, t.col)
            node.text = t.text
            return node
        }
        if (t.kind == "str") {
            this.advance()
            return this.stringExpr(t)
        }
        if (t.kind == "(") {
            this.advance()
            val first = this.expr()
            unless (this.at(",")) {
                this.expect(")", "to close a parenthesised expression")
                return first
            }
            val items: List<Ex> = [first]
            while (this.eat(",")) {
                this.skipSemis()
                if (this.at(")")) { break }
                items.add(this.expr())
            }
            this.expect(")", "to close a tuple")
            return this.tuple(items, t)
        }
        if (t.kind == "[") {
            this.advance()
            val node = Ex("list", t.line, t.col)
            while (not this.at("]")) {
                this.skipSemis()
                if (this.at("]")) { break }
                node.kids.add(this.expr())
                this.skipSemis()
                unless (this.eat(",")) { break }
            }
            this.skipSemis()
            this.expect("]", "to close a list literal")
            return node
        }
        if (t.kind == "if" or t.kind == "unless") { return this.ifExpr() }
        if (t.kind == "when") { return this.whenExpr() }
        if (t.kind == "{") { return this.braceExpr() }
        this.failHere("expected an expression, found ${describeToken(t)}")
        return Ex("null", t.line, t.col)
    }

    func stringExpr(t: Token): Ex {
        if (t.parts.size == 1 and t.parts[0].isLit) {
            val node = Ex("str", t.line, t.col)
            node.text = t.parts[0].text
            return node
        }
        val node = Ex("interp", t.line, t.col)
        for (p in t.parts) {
            val part = PartN(p.isLit)
            if (p.isLit) {
                part.text = p.text
            } else {
                val sub = Parser(lexFragment(p.text, p.line, p.col))
                sub.errorPrefix = this.errorPrefix
                part.ex = sub.exprOnly()
            }
            node.parts.add(part)
        }
        return node
    }

    /// A whole fragment as one expression — `${...}` holes and nothing else.
    func exprOnly(): Ex {
        val e = this.expr()
        this.skipSemis()
        unless (this.at("eof")) {
            this.failHere("unexpected trailing input in expression")
        }
        return e
    }

    func ifExpr(): Ex {
        val start = this.peek()
        val negated = this.at("unless")
        val word = if (negated) { "unless" } else { "if" }
        if (negated) {
            this.advance()
        } else {
            this.expect("if", "to start an `if`")
        }
        this.expect("(", "after `${word}`")
        var cond = this.expr()
        this.expect(")", "after the `${word}` condition")
        if (negated) {
            // `unless (c)` is `if (not c)`, at the condition node's own span.
            val neg = Ex("unary", cond.line, cond.col)
            neg.text = "not"
            neg.kids = [cond]
            cond = neg
        }
        val node = Ex("if", start.line, start.col)
        node.kids = [cond]
        node.body = this.block()

        // A newline before `else` inserted a `;`; skip it only if `else`
        // really follows.
        val save = this.pos
        this.skipSemis()
        if (this.eat("else")) {
            if (this.at("if") or this.at("unless")) {
                node.elseif = this.ifExpr()
            } else {
                node.els = this.block()
            }
        } else {
            this.pos = save
        }
        return node
    }

    func whenExpr(): Ex {
        val start = this.peek()
        this.expect("when", "to start a `when`")
        val node = Ex("when", start.line, start.col)
        if (this.eat("(")) {
            node.subject = this.expr()
            this.expect(")", "after the `when` subject")
        }
        this.expect("{", "to open a `when` body")
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            node.arms.add(this.whenArm())
        }
        this.expect("}", "to close the `when` body")
        return node
    }

    func whenArm(): ArmN {
        val start = this.peek()
        val arm = ArmN(start.line, start.col)
        if (this.eat("else")) {
            arm.patternKind = "else"
        } else if (this.eat("is")) {
            arm.patternKind = "is"
            val tyTok = this.peek()
            val te = this.typeExpr()
            arm.patTyEx = te
            if (this.at("(")) {
                unless (te.kind == "named") {
                    this.fail(
                        tyTok.line,
                        tyTok.col,
                        "only a class or record can be destructured"
                    )
                }
                val binds = this.bindList(tyTok.line, tyTok.col)
                arm.binds = DestrN(te.name, binds, tyTok.line, tyTok.col)
            }
        } else if (this.at("!") and (this.peekAt(1).kind == "is" or this.peekAt(1).kind == "in")) {
            this.advance()
            if (this.eat("is")) {
                arm.patternKind = "is"
                arm.patNegated = true
                arm.patTyEx = this.typeExpr()
            } else {
                this.advance()
                arm.patternKind = "in"
                arm.patNegated = true
                arm.values = [this.expr()]
            }
        } else if (this.eat("in")) {
            arm.patternKind = "in"
            arm.values = [this.expr()]
        } else {
            arm.patternKind = "values"
            var going = true
            while (going) {
                arm.values.add(this.expr())
                going = this.eat(",")
            }
        }

        if (this.at("if")) {
            if (arm.patternKind == "else") {
                val t = this.peek()
                this.failNote(
                    t.line, t.col, "`else` cannot have a guard",
                    "write the condition as its own arm above the `else`"
                )
            }
            this.advance()
            this.expect("(", "after `if` in a guard")
            arm.guard = this.expr()
            this.expect(")", "after a guard condition")
        }
        this.expect("->", "after a `when` pattern")

        // Inside a `when` arm, `{` means a block, not a lambda.
        if (this.at("{")) {
            arm.body = this.block()
        } else {
            val e = this.expr()
            val s = StmtN("expr", e.line, e.col)
            s.ex = e
            val b = BlockN()
            b.stmts = [s]
            arm.body = b
        }
        return arm
    }

    /// `{` opens a lambda with parameters, a map literal, or a lambda whose
    /// one parameter is the implicit `it` — tried in that order.
    func braceExpr(): Ex {
        val start = this.peek()
        this.expect("{", "to open a lambda or map literal")
        val save = this.pos

        this.quiet += 1
        val (matched, params) = this.lambdaParams()
        this.quiet -= 1
        if (matched and not this.failed) {
            return this.lambdaBody(start, params)
        }
        this.failed = false
        this.pos = save

        val (isMap, mapNode) = this.tryMapLiteral(start)
        if (isMap) {
            return mapNode
        }
        this.failed = false
        this.pos = save

        val implicit: List<ParamN> = [ParamN("it", start.line, start.col)]
        return this.lambdaBody(start, implicit)
    }

    /// Tries to read `x: T, y ->`. On anything else the caller rolls back.
    func lambdaParams(): (Bool, List<ParamN>) {
        val out: List<ParamN> = []
        if (this.at("->")) {
            this.advance()
            return true, out
        }
        while (true) {
            val start = this.peek()
            unless (this.at("ident")) { return false, out }
            val name = this.advance().text
            val p = ParamN(name, start.line, start.col)
            if (this.eat(":")) {
                p.tyEx = this.typeExpr()
                if (this.failed) { return false, out }
            }
            out.add(p)
            if (this.eat(",")) { continue }
            if (this.eat("->")) { return true, out }
            return false, out
        }
        return false, out
    }

    func lambdaBody(start: Token, params: List<ParamN>): Ex {
        val node = Ex("lambda", start.line, start.col)
        node.params = params
        val b = BlockN()
        while (true) {
            this.skipSemis()
            if (this.at("}") or this.at("eof")) { break }
            b.stmts.add(this.stmt())
        }
        this.expect("}", "to close the lambda")
        node.body = b
        return node
    }

    /// `{}` and `{ k: v, ... }`; rolled back by the caller when the braces
    /// hold something else. Only the first key is tentative: once its `:` is
    /// seen this is a map, and later errors are real errors.
    func tryMapLiteral(start: Token): (Bool, Ex) {
        val node = Ex("map", start.line, start.col)
        this.skipSemis()
        if (this.eat("}")) {
            return true, node
        }
        this.quiet += 1
        val firstKey = this.expr()
        this.quiet -= 1
        if (this.failed) { return false, node }
        unless (this.at(":")) { return false, node }
        this.advance()
        node.keys.add(firstKey)
        node.values.add(this.expr())
        while (this.eat(",")) {
            this.skipSemis()
            if (this.at("}")) { break }
            val key = this.expr()
            this.expect(":", "between a map key and its value")
            node.keys.add(key)
            node.values.add(this.expr())
        }
        this.skipSemis()
        this.expect("}", "to close a map literal")
        return true, node
    }

    // ---- types ----------------------------------------------------------

    func typeExpr(): TypeEx {
        val t = this.peek()
        // `borrow T` / `own T`: an ownership mode, contextual — `borrow`
        // alone can still name a type, so the word only counts when a type
        // follows it.
        if (t.kind == "ident" and (t.text == "borrow" or t.text == "own") and this.peekAt(1).kind == "ident") {
            this.advance()
            val b = TypeEx("boundary", t.line, t.col)
            b.name = t.text
            b.inner = this.typeExpr()
            return b
        }
        var out = TypeEx("named", t.line, t.col)
        if (t.kind == "ident") {
            this.advance()
            out.name = t.text
            // `text.Node` — a type reached through an import alias. The
            // checker resolves the pair; the parser only records it.
            if (this.at(".") and this.peekAt(1).kind == "ident") {
                this.advance()
                val member = this.expectIdent("a type name after the module")
                out.name = out.name + "." + member
            }
            if (this.at("<")) {
                this.advance()
                var going = true
                while (going) {
                    out.args.add(this.typeExpr())
                    going = this.eat(",")
                }
                this.expect(">", "to close type arguments")
            }
        } else if (t.kind == "(") {
            this.advance()
            val params: List<TypeEx> = []
            while (not this.at(")")) {
                params.add(this.typeExpr())
                unless (this.eat(",")) { break }
            }
            this.expect(")", "to close a function type's parameters")
            // `(A, B) -> C` is a function; `(A, B)` alone is a tuple.
            unless (this.at("->")) {
                if (params.size < 2 or params.size > 5) {
                    this.failNote(
                        t.line, t.col,
                        "a tuple type holds between 2 and 5 types, not ${params.size}",
                        "a function type needs its `->` and a result"
                    )
                }
                out.name = "Tuple${params.size}"
                out.args = params
            } else {
                this.advance()
                out = TypeEx("func", t.line, t.col)
                out.args = params
                out.ret = this.typeExpr()
            }
        } else {
            this.failHere("expected a type, found ${describeToken(t)}")
            return out
        }
        while (this.eat("?")) {
            val wrapped = TypeEx("nullable", t.line, t.col)
            wrapped.inner = out
            out = wrapped
        }
        return out
    }
}
