{
  "name": "keal",
  "displayName": "Keal",
  "description": "Syntax highlighting, editing support and inline diagnostics for the Keal language.",
  "version": "0.1.0",
  "publisher": "geneacta",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/geneacta/keal.git" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Snippets"],
  "contributes": {
    "languages": [
      {
        "id": "keal",
        "aliases": ["Keal", "keal"],
        "extensions": [".keal"],
        "configuration": "./language-configuration.json",
        "firstLine": "^#!.*\\bkeal\\b"
      }
    ],
    "grammars": [
      {
        "language": "keal",
        "scopeName": "source.keal",
        "path": "./syntaxes/keal.tmLanguage.json"
      }
    ],
    "snippets": [{ "language": "keal", "path": "./snippets/keal.json" }],
    "problemMatchers": [
      {
        "name": "keal",
        "owner": "keal",
        "source": "keal",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "severity": "error",
        "pattern": [
          { "regexp": "^(error|runtime error):\\s+(.*)$", "message": 2 },
          { "regexp": "^\\s*-->\\s+(.*):(\\d+):(\\d+)$", "file": 1, "line": 2, "column": 3 }
        ]
      }
    ],
    "taskDefinitions": [{ "type": "keal", "required": ["file"] }],
    "configurationDefaults": {
      "[keal]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    }
  }
}
