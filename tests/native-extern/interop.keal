// C and C++ interop: a libm function through its header, C written inline
// in a native block, and C++ from the companion .cpp behind extern "C".
// The suite builds this with the real compilers and snapshots what it prints.

// C from the standard library, through a header.
native "#include <math.h>"

extern func sin(x: Float): Float
extern func llabs(n: Int): Int

// C written inline, in the native block itself.
native """
static int64_t triple(int64_t n) { return n * 3; }
"""
extern func triple(n: Int): Int

// C++ from a separate file, behind an extern "C" wrapper. The symbol is
// declared here, as every extern's must be — by a native block or a header.
native """
extern int64_t fib_cpp(int64_t n);
"""
extern func fib_cpp(n: Int): Int

println(sin(0.0))
println(llabs(-42))
println(triple(14))
println(fib_cpp(20))
