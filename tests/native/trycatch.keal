// Panics caught on all three engines, byte for byte — including through
// deep frames that hold references the unwind must release exactly.

func deep(n: Int, s: String): String {
    val local = s + "-" + n.toString()
    if (n == 0) { throw "bottom reached with " + local }
    return deep(n - 1, local)
}

try {
    println(deep(3, "x"))
} catch (e) {
    println("caught: " + e)
}

// A panic inside a closure crosses the frames of `map`.
try {
    val parts = ["4", "0", "2"].map({ t -> 10 / t.toInt()!! })
    println(parts.size)
} catch (e) {
    println("map: " + e)
}

// The guard idiom, natively.
func safeDiv(a: Int, b: Int): Int {
    try { return a / b } catch (e) { return -1 }
}
println(safeDiv(84, 2))
println(safeDiv(84, 0))

// Nested try with a rethrow that carries the inner message out.
try {
    try {
        val l = [1, 2, 3]
        println(l[9])
    } catch (e) {
        throw "wrapped: " + e
    }
} catch (e) {
    println(e)
}

// A caught panic leaves the world consistent: state built before the try
// survives, and the loop goes on.
val log: List<String> = []
var i = 0
while (i < 4) {
    try {
        if (i == 2) { throw "skip ${i}" }
        log.add("ok ${i}")
    } catch (e) {
        log.add(e)
    }
    i++
}
println(log.join(", "))

// A `throw` carries a value, and a `catch` may name the type it takes.
// Natively the value crosses as an `Any` — tag and payload — and the tag
// is what a typed clause tests.
record Refused(val why: String, val at: Int)

func classify(n: Int): String {
    try {
        if (n > 10) { throw Refused("too big", n) }
        if (n < 0) { throw n }
        if (n == 7) { throw "seven is unlucky" }
        return "fine"
    } catch (e: Refused) {
        return "refused ${e.why} at ${e.at}"
    } catch (e: Int) {
        return "an Int: ${e}"
    } catch (e) {
        return "a message: ${e}"
    }
}
println(classify(3))
println(classify(20))
println(classify(-1))
println(classify(7))

// A clause matching nothing lets the panic go on unwinding, to the clause
// outside that does match it.
func outer(): String {
    try {
        try {
            throw Refused("inner", 1)
        } catch (e: Int) {
            return "wrong"
        }
    } catch (e: Refused) {
        return "the outer clause took it: ${e.why}"
    }
    return "unreached"
}
println(outer())

// A built-in failure is a thrown String, so a typed clause can name it.
try {
    val big = 9223372036854775807
    println(big + 1)
} catch (e: String) {
    println("caught: ${e}")
}

// A throw out of a method call inside a `try` reaches the catch whatever
// the method returns — nothing, a scalar, or a value the caller must own —
// and through a `?.` as well. The backend checks for the unwind after the
// call in every one of these shapes, not only the owned one.
class Gate(val limit: Int) {
    proc check(n: Int) {
        if (n > this.limit) { throw "over the limit: ${n}" }
    }
    func half(n: Int): Int {
        if (n % 2 != 0) { throw "odd: ${n}" }
        return n / 2
    }
    func name(n: Int): String {
        if (n < 0) { throw "negative: ${n}" }
        return "n${n}"
    }
}
val gate = Gate(10)
try {
    gate.check(3)
    gate.check(30)
    println("unreached")
} catch (e) {
    println("check: " + e)
}
try {
    println(gate.half(8))
    println(gate.half(9))
} catch (e) {
    println("half: " + e)
}
try {
    println(gate.name(1))
    println(gate.name(-1))
} catch (e) {
    println("name: " + e)
}
try {
    if (gate.half(9) > 0) { println("unreached") }
} catch (e) {
    println("cond: " + e)
}
val maybe: Gate? = Gate(1)
try {
    println(maybe?.half(2))
    println(maybe?.half(3))
} catch (e) {
    println("guarded: " + e)
}
