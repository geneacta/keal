// Default and named arguments compiled natively, and top-level bindings as
// C globals. A missing argument's default is emitted at the call site, with
// the callee's earlier parameters aliased to the argument temps already
// computed — so a default that mentions one, or one with a side effect,
// behaves exactly as on the interpreters.

func greet(name: String, greeting: String = "hello", punct: String = "!"): String {
    return "${greeting}, ${name}${punct}"
}

// A later default may read an earlier parameter.
func rectangle(width: Int, height: Int = width): Int { width * height }

record Account(val owner: String, val balance: Int = 0)

class Counter {
    var n: Int = 0
    proc bump(by: Int = 1) { this.n += by }
}

println(greet("Ada"))
println(greet("Ada", "hi"))
println(greet("Ada", punct = "?"))
println(greet(greeting = "yo", name = "Alan"))
println(rectangle(3))
println(rectangle(3, 4))
println(Account("Ada"))
println(Account("Grace", 100))
println(Account(balance = 5, owner = "X"))

val c = Counter()
c.bump()
c.bump(10)
println(c.n)

// Defaults on a generic, written in terms of T's instantiation.
func pad<T>(xs: List<T>, filler: T, upTo: Int = 3): List<T> {
    val out = xs.map({ x: T -> x })
    while (out.size < upTo) { out.add(filler) }
    return out
}
println(pad([1], 0))
println(pad(["a"], "?", 5))

// A default whose evaluation has a side effect runs only when needed.
var calls = 0
func tick(): Int { calls += 1; return calls }
func withTick(n: Int = tick()): Int { n }
println(withTick(99))
println(calls)
println(withTick())
println(calls)
