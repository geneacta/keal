// Power, root and Comp through the C backend, held to the interpreters.

println(2 ** 10)
println(2 ** 3 ** 2)
println(27 ^/ 3)
println(26 ^/ 3)
println(2.0 ** 0.5)
println(16.0 ^/ 2.0)
println(3.5 ** 2.0)

var p = 3
p **= 4
println(p)
var q = 6561
q ^/= 2
println(q)
var k = 7
k++
k--
k++
println(k)

val base = 2.0
println(base ** 10)

println(compare(3, 7))
println(compare("zebra", "ant"))
println(compare(1.5, 1.5))
println(compare(9, 2) == greater)

func cheapest<T: Ord>(a: T, b: T): T {
    return if (compare(a, b) != greater) a
    return b
}
println(cheapest(4, 9))
println(cheapest("pear", "fig"))
println(cheapest(2.5, 1.5))
