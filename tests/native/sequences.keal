// Lazy sequences, compiled to native: generic classes, closures over cells,
// and the whole pipeline machinery — all through the C backend.

val doubled = seq([1, 2, 3]).map({ it * 2 }).toList()
println(doubled)

var pulls = 0
val two = seq([10, 20, 30, 40]).map({ n ->
    pulls += 1
    n + 1
}).take(2).toList()
println(two)
println(pulls)

val odds = seq([1, 2, 3, 4, 5]).filter({ it % 2 == 1 }).map({ it * it }).toList()
println(odds)
println(seq([1, 2, 3, 4]).drop(2).toList())
println(seq([1, 2, 9, 1]).takeWhile({ it < 5 }).toList())
println(seq([1, 2, 9, 1]).dropWhile({ it < 5 }).toList())
println(seq([1, 3]).flatMap({ n -> seq([n, n + 1]) }).toList())
println(iterate(1, { it * 2 }).take(6).toList())
println(seq(["a", "b", "c"]).fold("", { acc, s -> acc + s }))
println(seq([5, 6, 7]).count())
println(seq([5, 6, 7]).any({ it == 6 }))
println(seq([5, 6, 7]).all({ it > 4 }))
println(seq(["x"]).first() ?: "-")
val nothing: List<String> = []
println(seq(nothing).first() ?: "-")
