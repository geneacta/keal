// An operand is evaluated exactly once, on every engine.
//
// `maybe() == null` used to call `maybe` TWICE natively and once on both
// interpreters: the backend emitted both sides, then the presence test asked
// for the nullable side a second time instead of using what it had. Nothing
// in the corpus could see it, because everything compared against null there
// is pure — the defect only shows when the subject does something, and it
// was found by chasing an unused-variable warning in the emitted C.

var calls = 0
func maybe(): Int? { calls += 1 return null }
func present(): Int? { calls += 1 return 7 }

calls = 0
assert(maybe() == null, "absent")
assert(calls == 1, "`== null` evaluates its subject once: ${calls}")

calls = 0
assert(present() != null, "present")
assert(calls == 1, "`!= null` too: ${calls}")

// The same question for the reference form, which takes a different path in
// the backend — a pointer test rather than a tag.
var refCalls = 0
func maybeStr(): String? { refCalls += 1 return null }
refCalls = 0
assert(maybeStr() == null, "a nullable reference")
assert(refCalls == 1, "and it is evaluated once: ${refCalls}")

// And the other operators that read a nullable, for the same reason.
calls = 0
val fallback = maybe() ?: 3
assert(fallback == 3 and calls == 1, "`?:` evaluates its left side once: ${calls}")
