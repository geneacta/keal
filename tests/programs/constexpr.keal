// `constexpr` — the work happens when the program is compiled. Every
// assertion below is about a value that existed before this program ran.

constexpr val KB = 1024
constexpr val MB = KB * KB
assert(MB == 1048576, "a constant built from a constant")

constexpr val NAME = "keal"
constexpr val BANNER = ("the " + NAME).toUpper()
assert(BANNER == "THE KEAL", "strings fold, methods included")

constexpr val RULE = "ab".repeat(3)
assert(RULE == "ababab", "repeat is bounded by the compiler's budget")

// Interpolation folds: the hole is evaluated at compile time too.
constexpr val LABEL = "${KB} bytes"
assert(LABEL == "1024 bytes", "interpolation folds")

// A `constexpr func` is one the compile-time evaluator is allowed to run.
constexpr func square(n: Int): Int { return n * n }
constexpr val SQ = square(12)
assert(SQ == 144, "a call folds")

constexpr func sumTo(n: Int): Int {
    var total = 0
    for (i in 0..n) { total += i }
    return total
}
assert(sumTo(101) == 5050, "a `for` over a range folds")

// Recursion, bounded by the compiler's frame limit.
constexpr func fib(n: Int): Int {
    if (n < 2) { return n }
    return fib(n - 1) + fib(n - 2)
}
constexpr val FIB = fib(20)
assert(FIB == 6765, "recursion folds")

// `while` and `break`.
constexpr func digits(n: Int): Int {
    var left = n
    var count = 0
    while (true) {
        count += 1
        left = left / 10
        if (left == 0) { break }
    }
    return count
}
constexpr val D = digits(31415926)
assert(D == 8, "a `while` with a `break` folds")

// `when` used for its value, and `if` used as an expression.
constexpr func grade(n: Int): String {
    return when {
        n >= 90 -> "A"
        n >= 80 -> "B"
        else -> "C"
    }
}
constexpr val G = grade(85)
assert(G == "B", "a `when` folds")

constexpr val PICK = if (KB > 1000) { "big" } else { "small" }
assert(PICK == "big", "an `if` expression folds")

// A container is the one thing a `constexpr` may change in place, and only
// through a name it bound itself — which is how a table gets built.
constexpr func squares(n: Int): List<Int> {
    var out: List<Int> = []
    for (i in 1..n) { out.add(i * i) }
    return out
}
constexpr val TABLE: List<Int> = squares(6)
assert(TABLE.size == 5, "a table built at compile time")
assert(TABLE[4] == 25, "and its last element")

constexpr func lengths(words: List<String>): Map<String, Int> {
    var out: Map<String, Int> = {}
    for (w in words) { out[w] = w.length }
    return out
}
constexpr val LOOKUP: Map<String, Int> = lengths(["one", "three"])
assert(LOOKUP.size == 2, "a map built at compile time")
assert(LOOKUP["three"] == 5, "and what it holds")

// A `constexpr` inside a body folds exactly as one at the top level.
func local(): Int {
    constexpr val HALF = 4096 / 2
    return HALF
}
assert(local() == 2048, "a local `constexpr`")

// The word is contextual: it names a declaration only before `val` or
// `func`, so it stays an ordinary name everywhere else.
val constexpr = 7
assert(constexpr == 7, "`constexpr` is still a name")

// The folded value is the value the program would have computed — the
// point is when the work happens, not what it comes to.
val computed = 1024 * 1024
assert(computed == MB, "folding changes nothing but the timing")
