// if / when / loops, and the fact that blocks are expressions.

// `if` is an expression: a block's value is its last expression.
val sign = if (-4 < 0) { "neg" } else { "pos" }
assert(sign == "neg", "if as an expression")

val grade = if (95 >= 90) { "A" } else if (95 >= 80) { "B" } else { "C" }
assert(grade == "A", "else if chain")

val computed = if (true) {
    val a = 2
    val b = 3
    a * b
} else {
    0
}
assert(computed == 6, "a block's value is its last expression")

// `when` with a subject.
fun describe(n: Int): String {
    return when (n) {
        0 -> "zero"
        1, 2, 3 -> "small"
        in 4..10 -> "medium"
        else -> "large"
    }
}
assert(describe(0) == "zero", "when: single value")
assert(describe(2) == "small", "when: several values in one arm")
assert(describe(7) == "medium", "when: range arm")
assert(describe(99) == "large", "when: else")

// `when` without a subject behaves like a chain of conditions.
fun bucket(n: Int): String {
    return when {
        n < 0 -> "negative"
        n == 0 -> "zero"
        else -> "positive"
    }
}
assert(bucket(-1) == "negative", "subject-less when")
assert(bucket(0) == "zero", "subject-less when")
assert(bucket(1) == "positive", "subject-less when")

// `when` with `is` narrows the subject inside the arm.
fun render(v: Any): String {
    return when (v) {
        is Int -> "int:${v + 1}"
        is String -> "str:${v.toUpper()}"
        is List -> "list:${v.size}"
        else -> "other"
    }
}
assert(render(1) == "int:2", "is Int narrows to Int")
assert(render("a") == "str:A", "is String narrows to String")
assert(render([1, 2]) == "list:2", "is List narrows to a list")
assert(render(1.5) == "other", "is falls through to else")

// while, break and continue.
var i = 0
var seen = 0
while (true) {
    i += 1
    if (i % 2 == 0) { continue }
    if (i > 7) { break }
    seen += i
}
assert(seen == 1 + 3 + 5 + 7, "while with continue and break")

// Nested loops: break only leaves the innermost one.
var pairs = 0
for (a in 0..3) {
    for (b in 0..3) {
        if (b == 2) { break }
        pairs += 1
    }
}
assert(pairs == 6, "break leaves only the inner loop")

// Short-circuit evaluation.
var calls = 0
fun bump(): Bool {
    calls += 1
    return true
}
assert((false and bump()) == false, "`and` short-circuits on a false left operand")
assert(calls == 0, "the right operand of `and` was never evaluated")
assert((true or bump()) == true, "`or` short-circuits on a true left operand")
assert(calls == 0, "the right operand of `or` was never evaluated")

// ---- unless ------------------------------------------------------------
//
// `unless (c)` is `if (not c)`. It takes an `else`, works as an expression,
// and narrows types exactly as the `if` it stands for would.

fun classify(n: Int): String {
    unless (n > 0) { return "not positive" }
    return "positive"
}
assert(classify(5) == "positive", "unless as a guard")
assert(classify(-1) == "not positive", "the guard fired")

fun parity(n: Int): String {
    return unless (n % 2 == 0) { "odd" } else { "even" }
}
assert(parity(3) == "odd", "unless as an expression")
assert(parity(4) == "even", "its else branch")

// Chains mix freely: `if`, `else unless`, `else if`, `else`.
fun size(n: Int): String {
    if (n > 100) {
        return "huge"
    } else unless (n > 10) {
        return "small"
    } else {
        return "medium"
    }
}
assert(size(500) == "huge", "if branch")
assert(size(5) == "small", "else unless branch")
assert(size(50) == "medium", "final else")

// Smart casts pass through untouched, in both directions.
fun lengthOf(s: String?): Int {
    unless (s != null) { return 0 }
    return s.length
}
assert(lengthOf("abcd") == 4, "narrowed after an unless guard")
assert(lengthOf(null) == 0, "the guard returned")

fun firstChar(s: String?): String {
    unless (s == null) { return s[0] }
    return "?"
}
assert(firstChar("xyz") == "x", "narrowed inside an unless body")
assert(firstChar(null) == "?", "fallback")

// `unless` is exactly the negated `if`, and equal to it in every position.
for (b in [true, false]) {
    val viaIf = if (not b) { 1 } else { 2 }
    val viaUnless = unless (b) { 1 } else { 2 }
    assert(viaIf == viaUnless, "unless (c) is if (not c)")
}

// Every shape of the if/unless/else family, since they compose freely.
fun ifElse(n: Int): String { if (n > 0) { "pos" } else { "neg" } }
fun unlessElse(n: Int): String { unless (n > 0) { "neg" } else { "pos" } }
fun ifElseIfElse(n: Int): String {
    if (n > 10) { "big" } else if (n > 0) { "small" } else { "neg" }
}
fun ifElseUnlessElse(n: Int): String {
    if (n > 10) { "big" } else unless (n > 0) { "neg" } else { "small" }
}
fun unlessElseIfElse(n: Int): String {
    unless (n > 0) { "neg" } else if (n > 10) { "big" } else { "small" }
}
fun unlessElseUnlessElse(n: Int): String {
    unless (n > 10) { "small" } else unless (n > 100) { "big" } else { "huge" }
}

for (n in [-5, 5, 50]) {
    val expected = if (n > 10) { "big" } else if (n > 0) { "small" } else { "neg" }
    assert(ifElseIfElse(n) == expected, "if / else if / else")
    assert(ifElseUnlessElse(n) == expected, "if / else unless / else")
    assert(unlessElseIfElse(n) == expected, "unless / else if / else")
    val two = if (n > 0) { "pos" } else { "neg" }
    assert(ifElse(n) == two, "if / else")
    assert(unlessElse(n) == two, "unless / else")
}
assert(unlessElseUnlessElse(5) == "small", "unless / else unless / else")
assert(unlessElseUnlessElse(50) == "big", "unless / else unless / else")
assert(unlessElseUnlessElse(500) == "huge", "unless / else unless / else")

// And each on its own, with no else at all.
var fired = 0
proc bumpUnless(n: Int) { unless (n > 0) { fired += 1 } }
proc bumpIf(n: Int) { if (n > 0) { fired += 1 } }
bumpUnless(-1)
bumpUnless(1)
bumpIf(1)
bumpIf(-1)
assert(fired == 2, "a bare `unless` and a bare `if` each fired once")
