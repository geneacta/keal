// One program running another.
//
// No shell is involved: the list is the argument vector, so a path with a
// space in it stays one argument and nothing is ever re-parsed. That is the
// part worth testing, and the part a shell string gets wrong.

// Null is "could not be started at all", which is not the same as a command
// that ran and failed — a program that confuses the two retries the wrong
// thing. These two hold on every platform.
assert(runCommand([]) == null, "an empty vector names no program")
assert(runCommand(["keal-no-such-program-1234"]) == null, "nor does a missing one")

// The rest needs a program that is there. `/bin/sh` is not on Windows, and
// `echo` is not a program there at all, so this asks before it assumes.
if (isFile("/bin/sh")) {
    val ok = runCommand(["/bin/sh", "-c", "echo out; echo err 1>&2; exit 3"])
    assert(ok != null, "a shell that exists starts")
    val r = ok ?: []
    assert(r.size == 3, "three parts: code, output, error")
    assert(r[0] == "3", "the exit code is the child's: ${r[0]}")
    assert(lines(r[1]) == ["out"], "standard output: ${r[1]}")
    assert(lines(r[2]) == ["err"], "standard error, kept apart: ${r[2]}")

    // A command that ran and failed is not absence: it has an exit code.
    val failed = runCommand(["/bin/sh", "-c", "exit 42"]) ?: []
    assert(failed.size == 3 and failed[0] == "42", "a failure still reports")

    // And the argument vector is a vector. A shell would split this.
    val spaced = runCommand(["/bin/sh", "-c", "printf %s \"$1\"", "sh", "a b c"]) ?: []
    assert(spaced[1] == "a b c", "one argument stayed one argument: ${spaced[1]}")
}

// A program named, not located. Everything above hands `runCommand` a path it
// has just checked with `isFile` — and that gesture, the one that makes those
// lines portable, is exactly what kept anything from ever being resolved. A
// backend that could not look a name up at all passed this file for as long as
// it existed.
//
// The lookup is what a caller writes in practice: `git`, `python`, `cc`. When
// it fails, `runCommand` answers `null`, which is the language's word for "no
// such command" — so the machine that cannot reach an installed tool and the
// machine that does not have it give the same answer.
val shell = isFile("/bin/sh") ? "sh" : "cmd"
val flag = isFile("/bin/sh") ? "-c" : "/c"
if (isFile("/bin/sh") or isFile("C:/Windows/System32/cmd.exe")) {
    val named = runCommand([shell, flag, "exit 7"]) ?: []
    assert(named.size == 3, "`${shell}` is on this machine, but not reachable by name")
    assert(named[0] == "7", "the named program ran: ${named[0]}")
}

// The other half of the same rule, and this half holds on every platform: a
// first argument containing a directory is a LOCATION, not a name. Nothing
// lives at this one, and the search path does not rescue it — otherwise a
// mistyped path would silently run whatever shares its last component.
assert(runCommand(["./nowhere-at-all/" + shell, flag, "exit 3"]) == null,
    "a path with a directory in it is not looked up on the search path")

// And that `null` needs a positive control of the same shape, or it could be
// passing because this FORM of call always fails rather than because nothing
// lives at that path. Same rule, opposite outcome: a directory that IS there.
if (isFile("/bin/sh")) {
    val viaDir = runCommand(["/bin/../bin/sh", "-c", "exit 5"]) ?: []
    assert(viaDir.size == 3 and viaDir[0] == "5", "a path with a directory is used as one")
}

// That control is an ABSOLUTE path; the assertion it controls is a RELATIVE
// one. On Unix any slash short-circuits the search and the two are the same
// case — but that is a platform's rule, not this language's, and the three
// places the engines have disagreed this week were all about the FORM of a
// name. So the relative form gets its own control, and it is not conditional:
// the one executable at a known relative path on every machine that runs this
// file is the compiler the suite just built. Like `filesystem.keal`, this file
// runs from the repository root.
val built = isFile("target/release/keal.exe") ? "./target/release/keal.exe" : "./target/release/keal"
val own = runCommand([built, "version"]) ?: []
assert(own.size == 3 and own[0] == "0",
    "a relative path with directories runs, or you are not at the repository root: ${built}")

// A second argument is what the child reads on its standard input. Without
// one it reads nothing, which is what it always did.
if (isFile("/bin/sh")) {
    val fed = runCommand(["/bin/sh", "-c", "cat"], "bonjour") ?: []
    assert(fed[1] == "bonjour", "the child read what it was sent: ${fed[1]}")
    val counted = runCommand(["/bin/sh", "-c", "wc -c"], "12345") ?: []
    assert(counted[1].trim() == "5", "and all of it: ${counted[1].trim()}")
    val none = runCommand(["/bin/sh", "-c", "cat; echo end"], "") ?: []
    assert(none[1].trim() == "end", "an empty input is end of file at once")

    // THE ONE THAT MATTERS, and it is the flood above turned around. A child
    // that answers while it is still reading fills the output pipe while the
    // parent is still filling the input one. Writing the input to the end
    // first deadlocks — and so does waiting on all three descriptors together
    // and then blocking in the write, which is what a `write` of 64 KiB does
    // on a pipe `poll` said was writable. It wedges for ever, both ways.
    var big = "0123456789"
    var k = 0
    while (k < 15) { big = big + big k++ }
    val echoed = runCommand(["/bin/sh", "-c", "cat"], big) ?: []
    assert(echoed[1].length == big.length, "every byte came back: ${echoed[1].length}")
    assert(echoed[0] == "0", "and the child ended well")

    // A child that stops reading is not an absence: it ran, so it has an exit
    // code. Only a program that never started is null.
    val deaf = runCommand(["/bin/sh", "-c", "exit 7"], big) ?: []
    assert(deaf.size == 3 and deaf[0] == "7", "a child that ignores its input still reports")
}
