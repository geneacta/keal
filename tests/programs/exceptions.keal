// throw + catch, basic
var hit = ""
try {
    throw "boom"
    hit = "unreached"
} catch (e) {
    hit = e
}
assert(hit == "boom", "caught the thrown message")

// runtime panics are catchable: division by zero, overflow, index, assert
var msgs: List<String> = []
fun boomDiv(): Int { val z = 0  return 1 / z }
try { boomDiv() } catch (e) { msgs.add(e) }
try { val big = 9223372036854775807  val r = big + 1  println(r) } catch (e) { msgs.add(e) }
try { val l = [1, 2]  println(l[5]) } catch (e) { msgs.add(e) }
try { assert(false, "told you") } catch (e) { msgs.add(e) }
assert(msgs.size == 4, "caught four panics, got ${msgs.size}")
assert(msgs[3] == "told you", "assert message came through")

// nested try; rethrow
var order = ""
try {
    try {
        throw "inner"
    } catch (e) {
        order += "a:" + e
        throw "outer:" + e
    }
    order += "unreached"
} catch (e) {
    order += " b:" + e
}
assert(order == "a:inner b:outer:inner", order)

// return through try passes uncaught
fun escape(): Int {
    try { return 42 } catch (e) { return 0 }
}
assert(escape() == 42, "return passes through try")

// break out of try inside loop; loop continues clean, later throw caught by outer
var log = ""
try {
    var i = 0
    while (i < 3) {
        try {
            if (i == 1) { break }
        } catch (e) { log += "x" }
        i += 1
    }
    throw "after:${i}"
} catch (e) { log += e }
assert(log == "after:1", log)

// catch inside a called function catches callee-deeper panics
fun safeDiv(a: Int, b: Int): Int {
    try { return a / b } catch (e) { return -1 }
}
assert(safeDiv(10, 2) == 5, "clean path")
assert(safeDiv(10, 0) == -1, "caught path")

// closures called through natives (map) with handler outside
var caught = ""
try {
    val r = [1, 0, 2].map({ n -> 10 / n })
    println(r)
} catch (e) { caught = e }
assert(caught != "", "panic crossed the native map call")

// A `throw` carries a value, and a `catch` may name the type it will take.
// The clauses are tried in order; the one without a type catches whatever
// is left and binds the message, which every value has.
record Refused(val why: String, val at: Int)

fun classify(n: Int): String {
    try {
        if (n > 10) { throw Refused("too big", n) }
        if (n < 0) { throw n }
        if (n == 7) { throw "seven is unlucky" }
        return "fine"
    } catch (e: Refused) {
        return "refused ${e.why} at ${e.at}"
    } catch (e: Int) {
        return "an Int: ${e}"
    } catch (e) {
        return "a message: ${e}"
    }
}

assert(classify(3) == "fine", "no throw")
assert(classify(20) == "refused too big at 20", "a record, caught whole")
assert(classify(-1) == "an Int: -1", "a scalar, caught by type")
assert(classify(7) == "a message: seven is unlucky", "a string falls to the last clause")

// A clause that matches nothing lets the panic go on unwinding.
fun outer(): String {
    try {
        try {
            throw Refused("inner", 1)
        } catch (e: Int) {
            return "wrong"
        }
    } catch (e: Refused) {
        return "the outer clause took it: ${e.why}"
    }
    return "unreached"
}
assert(outer() == "the outer clause took it: inner", "an unmatched clause rethrows")

// A built-in failure is a thrown String, so a typed clause can name it.
fun overflowMessage(): String {
    try {
        val big = 9223372036854775807
        println(big + 1)
        return "no overflow"
    } catch (e: String) {
        return "caught: ${e}"
    }
    // A clause that names a type is not a promise to catch: the function
    // still has to say what it does when nothing did.
    return "unreached"
}
assert(overflowMessage() == "caught: integer overflow", "built-ins throw their message")
