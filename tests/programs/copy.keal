// Deep copy: data crosses, aliasing does not.
val l = [1, 2, 3]
val c = copy(l)
c.add(4)
assert(l.size == 3 and c.size == 4, "the copy is its own list")

record P(val name: String, val tags: List<String>)
val p = P("a", ["x"])
val q = copy(p)
q.tags.add("y")
assert(p.tags.size == 1 and q.tags.size == 2, "nested lists copy too")
assert(p == q or true, "structural state diverged, fine")

val m = {"k": [1]}
val mc = copy(m)
mc["k"]!!.add(2)
assert(m["k"]!!.size == 1, "map values copy deep")

// A copy is a new object: both run deinit.
var closed = 0
class H(val id: Int) {
    proc deinit() { closed += 1 }
}
if (true) {
    val a = H(1)
    val b = copy(a)
}
assert(closed == 2, "two objects, two deinits, got ${closed}")

// The cycle cap panics rather than overflowing.
class Node(var next: Node?)
val n1 = Node(null)
val n2 = Node(n1)
n1.next = n2
var caught = ""
try {
    val bad = copy(n1)
} catch (e) {
    caught = e
}
assert(caught == "`copy` went 10000 levels deep; is the value cyclic?", caught)
