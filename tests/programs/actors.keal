// The actor model under its real rules: an actor's state is its own —
// every capture is copied at spawn — results leave through an Outbox
// (an address, shared like an ActorRef), and a partner arrives inside
// the message, never through a captured slot mutated after the fact.

record Msg(val n: Int, val replyTo: ActorRef<Msg>?)

// Ping-pong: the reply address travels in the message.
val sys: ActorSystem<Msg> = ActorSystem()
val volleys: Outbox<Int> = outbox()
val ping = sys.spawn({ self, msg ->
    if (msg.n > 0) {
        volleys.post(msg.n)
        val back = msg.replyTo
        if (back != null) { back.send(Msg(msg.n - 1, self)) }
    }
})
val pong = sys.spawn({ self, msg ->
    if (msg.n > 0) {
        val back = msg.replyTo
        if (back != null) { back.send(Msg(msg.n - 1, self)) }
    }
})
ping.send(Msg(6, pong))
sys.run()
assert(volleys.drain() == [6, 4, 2], "ping saw the even counts on the way down")

// An accumulator: the actor's own copy of `total` carries across
// messages; the spawner's original never moves. That is the semantics.
// (State lives in a *local* the actor copies — a global `var` would be
// shared mutable state, and the checker refuses it.)
proc accumulate(steps: Outbox<Int>) {
    val tally: ActorSystem<Int> = ActorSystem()
    var total = 0
    val counter = tally.spawn({ self, n ->
        total += n
        steps.post(total)
        // A self-send keeps the system running for another pass.
        if (n > 1) {
            self.send(n / 2)
        }
    })
    counter.send(8)
    tally.run()
    assert(total == 0, "the spawner's total never moved: the actor owns its copy")
}
val steps: Outbox<Int> = outbox()
accumulate(steps)
assert(steps.drain() == [8, 12, 14, 15], "8, then self-sent 4, 2, 1")

// Messages cross by copy: mutating after send changes nothing received.
val echo: ActorSystem<List<Int>> = ActorSystem()
val got: Outbox<Int> = outbox()
val sink = echo.spawn({ self, xs -> got.post(xs.size) })
val payload = [1, 2]
sink.send(payload)
payload.add(3)
echo.run()
assert(got.drain() == [2], "the receiver saw the list as it was at send")

// Round-robin is one message per actor per pass, in spawn order.
val order: ActorSystem<String> = ActorSystem()
val log: Outbox<String> = outbox()
val a = order.spawn({ self, m -> log.post("a:" + m) })
val b = order.spawn({ self, m -> log.post("b:" + m) })
a.send("1")
a.send("2")
b.send("x")
order.run()
assert(log.drain() == ["a:1", "b:x", "a:2"], "one message per actor per pass")
