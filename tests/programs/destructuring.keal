// Destructuring: naming a value's constructor fields in one step, in a
// binding or in a `when` arm.

record Point(val x: Int, val y: Int)
record Pair<A, B>(val first: A, val second: B)
record Circle(val radius: Float)
record Square(val side: Float)

// A class with a primary constructor destructures too; only the constructor
// fields are positional, so the body field below plays no part.
class Named(val name: String, val age: Int) {
    var nickname: String = "?"
}

val Point(x, y) = Point(3, 4)
assert(x == 3 and y == 4, "a record's fields, by position")

// `_` names a field you do not want.
val Point(_, onlyY) = Point(9, 8)
assert(onlyY == 8, "skipped field")

val Pair(a, b) = Pair("hello", 42)
assert(a == "hello" and b == 42, "a generic record binds at its arguments")
assert(a.toUpper() == "HELLO", "and the bindings have the right types")

val Pair(nested, count) = Pair(Point(1, 2), 3)
assert(nested == Point(1, 2), "a field that is itself a record")
assert(count == 3, "alongside a plain one")

val Named(who, howOld) = Named("Ada", 36)
assert(who == "Ada" and howOld == 36, "a class with a primary constructor")

// `var` makes the bindings assignable, like any other declaration.
var Point(mx, my) = Point(10, 20)
mx += 1
assert(mx == 11 and my == 20, "mutable destructuring")

// In a `when` arm, `is T(...)` tests the type and binds in one move.
fun area(shape: Any): Float {
    return when (shape) {
        is Circle(r) -> 3.0 * r * r
        is Square(s) -> s * s
        else -> 0.0
    }
}
assert(area(Circle(2.0)) == 12.0, "is Circle(r)")
assert(area(Square(3.0)) == 9.0, "is Square(s)")
assert(area("neither") == 0.0, "else")

// The bindings belong to the arm, so a later arm may reuse the names.
fun describe(v: Any): String {
    return when (v) {
        is Point(a, b) -> "point ${a + b}"
        is Pair(a, b) -> "pair ${a} ${b}"
        else -> "other"
    }
}
assert(describe(Point(1, 2)) == "point 3", "first arm")
assert(describe(Pair(1, 2)) == "pair 1 2", "second arm reuses the names")

// Destructuring inside a loop, including a closure capturing a binding.
val points = [Point(1, 2), Point(3, 4)]
val sums: List<Int> = []
for (pt in points) {
    val Point(px, py) = pt
    sums.add(px + py)
}
assert(sums == [3, 7], "destructuring in a loop")

val readers: List<() -> Int> = []
for (pt in points) {
    val Point(px, _) = pt
    readers.add({ -> px })
}
assert(readers.map({ f -> f() }) == [1, 3], "each closure captured its own turn")

// A destructured binding is an ordinary binding: it narrows, it shadows in an
// inner scope, and it works inside a function.
fun originDistance(p: Point): Int {
    val Point(px, py) = p
    return px.abs() + py.abs()
}
assert(originDistance(Point(-3, 4)) == 7, "inside a function")
