// The eight logical connectives: NOT, AND, OR, XOR, XNOR, NAND, NOR and
// IMPLIES, their laws, their short-circuiting, and their precedence.

/// The four rows of a two-input truth table, in TT TF FT FF order.
fun rows(f: (Bool, Bool) -> Bool): List<Bool> {
    return [f(true, true), f(true, false), f(false, true), f(false, false)]
}

assert(rows({ a, b -> a && b }) == [true, false, false, false], "AND")
assert(rows({ a, b -> a || b }) == [true, true, true, false], "OR")
assert(rows({ a, b -> a xor b }) == [false, true, true, false], "XOR")
assert(rows({ a, b -> a xnor b }) == [true, false, false, true], "XNOR")
assert(rows({ a, b -> a nand b }) == [false, true, true, true], "NAND")
assert(rows({ a, b -> a nor b }) == [false, false, false, true], "NOR")
assert(rows({ a, b -> a implies b }) == [true, false, true, true], "IMPLIES")

assert(!true == false, "NOT")
assert(!false == true, "NOT")

// De Morgan and friends, checked exhaustively.
for (a in [true, false]) {
    for (b in [true, false]) {
        assert((a nand b) == !(a && b), "nand is negated and")
        assert((a nor b) == !(a || b), "nor is negated or")
        assert((a xor b) == !(a xnor b), "xor is negated xnor")
        assert((a implies b) == (!a || b), "implication")
        assert((a nand b) == (!a || !b), "de Morgan")
        assert((a nor b) == (!a && !b), "de Morgan")
    }
}

// Short-circuiting: the right operand must not be evaluated.
var calls = 0
fun touch(): Bool { calls += 1; return true }
assert((false nand touch()), "nand short-circuits on false")
assert(!(true nor touch()), "nor short-circuits on true")
assert((false implies touch()), "implies short-circuits on false")
assert(calls == 0, "no right operand was evaluated")
assert((true xor touch()) == false, "xor always evaluates the right operand")
assert(calls == 1, "xor evaluated it")

// `implies` guards its right operand, so a null check carries across it.
fun safe(s: String?): Bool { s != null implies s.length > 0 }
assert(safe(null), "vacuously true")
assert(safe("ab"), "true side")
assert(!safe(""), "false side")

// `implies` chains to the right.
assert((false implies false implies false) == true, "right-associative")

// Precedence: the word operators bind more loosely than `&&` and `||`.
assert((true && false implies false || true) == true, "&& and || bind tighter")
assert((true implies true && false) == false, "&& bound tighter than implies")
