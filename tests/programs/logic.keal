// The eight logical connectives: NOT, AND, OR, XOR, XNOR, NAND, NOR and
// IMPLIES, their laws, their short-circuiting, and their precedence.

/// The four rows of a two-input truth table, in TT TF FT FF order.
func rows(f: (Bool, Bool) -> Bool): List<Bool> {
    return [f(true, true), f(true, false), f(false, true), f(false, false)]
}

assert(rows({ a, b -> a and b }) == [true, false, false, false], "AND")
assert(rows({ a, b -> a or b }) == [true, true, true, false], "OR")
assert(rows({ a, b -> a xor b }) == [false, true, true, false], "XOR")
assert(rows({ a, b -> a xnor b }) == [true, false, false, true], "XNOR")
assert(rows({ a, b -> a nand b }) == [false, true, true, true], "NAND")
assert(rows({ a, b -> a nor b }) == [false, false, false, true], "NOR")
assert(rows({ a, b -> a implies b }) == [true, false, true, true], "IMPLIES")

assert(not true == false, "NOT")
assert(not false == true, "NOT")

// De Morgan and friends, checked exhaustively.
for (a in [true, false]) {
    for (b in [true, false]) {
        assert((a nand b) == not (a and b), "nand is negated and")
        assert((a nor b) == not (a or b), "nor is negated or")
        assert((a xor b) == not (a xnor b), "xor is negated xnor")
        assert((a implies b) == (not a or b), "implication")
        assert((a nand b) == (not a or not b), "de Morgan")
        assert((a nor b) == (not a and not b), "de Morgan")
    }
}

// Short-circuiting: the right operand must not be evaluated.
var calls = 0
func touch(): Bool { calls += 1; return true }
assert((false nand touch()), "nand short-circuits on false")
assert(not (true nor touch()), "nor short-circuits on true")
assert((false implies touch()), "implies short-circuits on false")
assert(calls == 0, "no right operand was evaluated")
assert((true xor touch()) == false, "xor always evaluates the right operand")
assert(calls == 1, "xor evaluated it")

// `implies` guards its right operand, so a null check carries across it.
func safe(s: String?): Bool { s != null implies s.length > 0 }
assert(safe(null), "vacuously true")
assert(safe("ab"), "true side")
assert(not safe(""), "false side")

// Keal gives the connectives no relative precedence: two different ones side
// by side is a syntax error, so grouping is always explicit and always means
// what it looks like.
assert(((true and false) implies (false or true)) == true, "explicit grouping")
assert((true implies (true and false)) == false, "grouped one way")
assert(((true implies true) and false) == false, "grouped the other way")

// Comparison binds tighter than the connectives, so the common case needs no
// parentheses at all.
assert(1 < 2 and 3 > 2, "comparison binds tighter than `and`")

// Words and symbols are the same operators.
assert((true and false) == (true && false), "`and` is `&&`")
assert((true or false) == (true || false), "`or` is `||`")
assert((true xor false) == (true ^ false), "`xor` is `^`")
assert((not true) == (!true), "`not` is `!`")
