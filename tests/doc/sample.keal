/// Turns a raw score into a grade label.
///
/// Scores below zero are `invalid`; the scale is the usual one.
func grade(score: Int): String {
    return score < 0 ? "invalid" : "graded"
}

/// A measurement with its unit, comparable by magnitude.
record Measure(val value: Float, val unit: String) : Ord {
    /// Magnitude order; the unit is a label, not a dimension.
    func compareTo(other: Measure): Int {
        return this.value < other.value ? -1 : (this.value > other.value ? 1 : 0)
    }
}

/// Anything that can render itself for a report.
trait Reportable {
    func report(): String
    /// A one-line summary, derived from `report` unless overridden.
    func summary(): String { return this.report() }
}
