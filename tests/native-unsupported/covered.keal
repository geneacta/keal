// Everything here is beyond the C backend for now. Each one must be named
// rather than silently mis-compiled, so the snapshot is the promise.

// Capturing a `var` is refused: sharing it would need a heap cell, and
// copying it would silently diverge from the interpreters.
fun captureVar(): Int {
    var counter = 0
    val bump = { -> counter + 1 }
    return bump()
}

// `when` compiles, except an `is` arm, which needs run-time type information.
fun useIsArm(v: Any): String {
    return when (v) {
        is Int -> "int"
        else -> "other"
    }
}

// A nullable *reference* compiles; a nullable value would need a tag beside
// it, which is not built yet.
fun useNullableInt(n: Int?): Int { n ?: 0 }

fun useMethodOnBuiltin(s: String): Int { s.length }

println(useIsArm(1))
