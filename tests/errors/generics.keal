trait Show {
    func show(): String
}

class Plain(val n: Int)
class Shown(val n: Int) : Show {
    func show(): String { "${this.n}" }
}

func identity<T>(value: T): T { value }
func describe<T: Show>(value: T): String { value.show() }
func nothing<T>(): Int { 1 }

func opaque<T>(value: T): Int {
    return value.length
}

func untestable<T>(value: T): Bool {
    return value is T
}

val notATrait: List<Int> = []
func bad<T: Plain>(value: T): Int { 1 }

val unsolved = nothing()
val wrongBound = describe(Plain(1))
val badArity: Shown<Int> = Shown(1)
val fine = describe(Shown(2))
val asValue = identity
