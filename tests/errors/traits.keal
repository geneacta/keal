trait Show {
    func show(): String
    func tag(prefix: String): String
}

trait Ordered {
    func compareTo(other: Self): Int
}

// Missing `tag` entirely, and `show` has the wrong return type.
class Broken(val n: Int) : Show {
    func show(): Int { this.n }
}

// `Self` must be read as the implementing class, not as anything else.
class Wrong(val n: Int) : Ordered {
    func compareTo(other: Int): Int { this.n - other }
}

class Missing(val n: Int) : Ordered

class Twice(val n: Int) : Show, Show {
    func show(): String { "" }
    func tag(prefix: String): String { prefix }
}

class NotATrait(val n: Int) : Broken
