// What a downloaded release must be able to do, checked on the machine that
// downloaded it rather than on the one that built it.
//
// Everything here is new in 1.1.0 or older, and all of it is what a first
// program uses: reading a file, a date, a directory, a subprocess, the list
// methods, and `main` itself. The program prints nothing and asserts
// everything, so the smoke job's output is empty when the release is sound.

func main(argv: List<String>): Int {
    // `main` ran at all, with its argument vector.
    assert(argv.size >= 0, "main received a vector")

    // The collection surface a first program leans on.
    assert([3, 1, 2].reversed() == [2, 1, 3], "reversed")
    assert([1, 2, 3].sum() == 6, "sum")
    assert([1, 2].first() == 1 and [1, 2].last() == 2, "first and last")
    assert("héllo".length == 5, "a string is counted in characters")
    assert("日本語".reversed() == "語本日", "and reversed by character")

    // The calendar, against a value a person can check by hand.
    assert(utcAt(0).iso() == "1970-01-01T00:00:00Z", "the epoch")
    assert(localOffset(0) % 60 == 0, "an offset is whole minutes")

    // The file system, made and taken away again.
    val dir = "keal-smoke-dir"
    assert(makeDir("${dir}/inner"), "made a tree")
    assert(isDir("${dir}/inner") and exists(dir), "and can see it")
    assert(writeFile("${dir}/f.txt", "written"), "wrote a file")
    assert(readFile("${dir}/f.txt") == "written", "and read it back")
    assert((listDir(dir) ?: []) == ["f.txt", "inner"], "listed, sorted")
    assert(removePath("${dir}/f.txt") and removePath("${dir}/inner")
        and removePath(dir), "and took it all away")

    // Starting another program, and telling absence from failure.
    assert(runCommand([]) == null, "an empty vector names no program")
    assert(runCommand(["keal-no-such-program-1234"]) == null, "nor a missing one")

    println("ok")
    return 0
}
